# Copy to .env.deploy and keep the real file private (it is gitignored).
MPH_SERVER_HOST=51.161.113.128
MPH_SERVER_USER=ubuntu
MPH_SERVER_DIR=/srv/project-prime
MPH_SERVER_DATA=/srv/project-prime/AMHE1
MPH_SERVER_DATA_VERSION=AMHE1
# The VPS stack generates configuration in /srv/project-prime/state.
# Backend database is supplied privately at deployment time.
# ConnectionStrings__Backend=<secret>
# Production systemd startup requires this value to be present and non-empty.
PRIME_NODE_PUBLIC_HOST=rebooty.xyz
PRIME_NODE_PUBLIC_CONTROL_URI=wss://rebooty.xyz:8443/v1/control
MPH_SERVER_RID=linux-x64
# Leave blank to build a fresh bundle, or point at build-all.sh's linux-x64 output.
PRIME_DEPLOY_BUNDLE=
# MPH_SERVER_BUNDLE remains supported as a compatibility alias.
# MPH_SERVER_PASS=use-ssh-keys-when-possible
# MPH_SERVER_HEALTH_URL=https://127.0.0.1:8443/health
# MPH_SERVER_HEALTH_TIMEOUT=180
# MPH_SERVER_KEEP_RELEASES=3
