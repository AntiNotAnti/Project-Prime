# Copy to .env.deploy and keep the real file private (it is gitignored).
MPH_SERVER_HOST=games.example.com
MPH_SERVER_USER=gameuser
MPH_SERVER_DIR=/home/gameuser/project-prime
MPH_SERVER_CONFIG=/absolute/local/path/appsettings.production.json
MPH_SERVER_DATA=/srv/project-prime-content/AMHE1
MPH_SERVER_DATA_VERSION=AMHE1
MPH_SERVER_RID=linux-arm64
