<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);PROJECTPRIME_RMLUI_ANDROID_EXPERIMENT</DefineConstants>
    <!-- Linked current menu/Host owners intentionally shadow the prebuilt engine's copies. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MphRead/MphRead.csproj" />
    <Compile Include="../../src/MphRead/Mods/Launcher/RmlUi/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../src/MphRead/Mods/Launcher/RmlUi/Host/*.cs" Link="Host/%(Filename)%(Extension)" />
    <Compile Include="../../src/MphRead/Mods/Launcher/Portable/RmlUiPointerMapping.cs" Link="RmlUiPointerMapping.cs" />
    <Compile Include="../../src/MphRead.Android/RmlUiAndroidSaveWork.cs" Link="RmlUiAndroidSaveWork.cs" />
    <Compile Include="../rmlui-live-menu-check/*.cs" Link="ExistingAcceptance/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
