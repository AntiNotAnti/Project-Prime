+QJsonObject snapSurface( QJsonObject mesh ){
+	// Nearest-surface queries consume positions. Tiny projected UVs keep large
+	// source walls within the runtime UV bound without adding corner channels or
+	// changing the selected mesh's material table.
+	mesh["material"] = 0; mesh["faceMaterials"] = QJsonArray(); mesh["faceTexcoords"] = QJsonArray(); mesh["faceUv"] = QJsonObject(); mesh.remove( "quakeFaces" );
+	mesh["uv"] = QJsonObject{ { "scale", QJsonArray{ 1e-20, 1e-20 } }, { "offset", QJsonArray{ 0, 0 } }, { "rotation", 0 } };
+	return mesh;
+}
