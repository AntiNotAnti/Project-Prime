+// Prime's companion positions are absolute Quake coordinates. Read the whole
+// value before changing anything: the ordinary origin parser intentionally
+// accepts malformed values by replacing them with zero, which is not safe for
+// moving the second endpoint or a trigger's opposite corner.
+inline bool prime_finite_vector( const Vector3& value ){
+	return std::isfinite( value[0] ) && std::isfinite( value[1] ) && std::isfinite( value[2] );
+}
+
+inline bool prime_read_numbers( const char* text, float* values, std::size_t count ){
+	for ( std::size_t i = 0; i < count; ++i ) {
+		while ( std::isspace( static_cast<unsigned char>( *text ) ) )
+			++text;
+		const char* token = text;
+		if ( *text == '+' || *text == '-' )
+			++text;
+		bool digits = false;
+		while ( *text >= '0' && *text <= '9' ) {
+			digits = true;
+			++text;
+		}
+		if ( *text == '.' ) {
+			++text;
+			while ( *text >= '0' && *text <= '9' ) {
+				digits = true;
+				++text;
+			}
+		}
+		if ( !digits )
+			return false;
+		if ( *text == 'e' || *text == 'E' ) {
+			++text;
+			if ( *text == '+' || *text == '-' )
+				++text;
+			const char* exponent = text;
+			while ( *text >= '0' && *text <= '9' )
+				++text;
+			if ( exponent == text )
+				return false;
+		}
+		char* end;
+		errno = 0;
+		values[i] = std::strtof( token, &end );
+		if ( end != text || errno == ERANGE || !std::isfinite( values[i] ) )
+			return false;
+		if ( i + 1 < count && !std::isspace( static_cast<unsigned char>( *text ) ) )
+			return false;
+	}
+	while ( std::isspace( static_cast<unsigned char>( *text ) ) )
+		++text;
+	return *text == '\0';
+}
+
+inline bool prime_read_vector( const char* text, Vector3& value ){
+	Vector3 parsed;
+	if ( !prime_read_numbers( text, parsed.data(), 3 ) )
+		return false;
+	value = parsed;
+	return true;
+}
+
+inline void prime_write_vector( Entity& entity, const char* key, const Vector3& value ){
+	char text[128];
+	// Round-trip float precision keeps companion offsets intact across saves.
+	std::snprintf( text, sizeof( text ), "%.9g %.9g %.9g", value[0], value[1], value[2] );
+	entity.setKeyValue( key, text );
+}
+
+class RenderablePrimePointGuide : public OpenGLRenderable
+{
+public:
+	bool enabled = false;
+	Vector3 endpoint = Vector3( 0, 0, 0 );
+	AABB endpointBounds;
+
+	void setEndpoint( const Vector3& value ){
+		endpoint = value;
+		endpointBounds = AABB( endpoint, Vector3( 4, 4, 4 ) );
+		enabled = true;
+	}
+
+	void render( RenderStateFlags state ) const override {
+		if ( !enabled )
+			return;
+		gl().glBegin( GL_LINES );
+		gl().glVertex3f( 0, 0, 0 );
+		gl().glVertex3fv( endpoint.data() );
+		const double length = vector3_length( endpoint );
+		if ( length > 1e-4 ) {
+			const Vector3 direction = vector3_scaled( endpoint, 1.0 / length );
+			const Vector3 axis = std::fabs( direction[2] ) < 0.9 ? Vector3( 0, 0, 1 ) : Vector3( 0, 1, 0 );
+			const Vector3 side = vector3_scaled( vector3_normalised( vector3_cross( direction, axis ) ), 4 );
+			const Vector3 back = vector3_subtracted( endpoint, vector3_scaled( direction, std::min( length * 0.25, 12.0 ) ) );
+			const Vector3 tip1 = vector3_added( back, side );
+			const Vector3 tip2 = vector3_subtracted( back, side );
+			gl().glVertex3fv( endpoint.data() );
+			gl().glVertex3fv( tip1.data() );
+			gl().glVertex3fv( endpoint.data() );
+			gl().glVertex3fv( tip2.data() );
+		}
+		gl().glEnd();
+		aabb_draw_wire( endpointBounds );
+	}
+};
