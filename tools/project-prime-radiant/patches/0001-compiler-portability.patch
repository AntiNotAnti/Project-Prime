+void PrimeMeshTools_showProperties(){
+	const auto selected = targets( true );
+	if( selected.empty() ) { error( "Select a Prime mesh first." ); return; }
+	if( !editable( selected, true ) ) return;
+	const QJsonObject mesh = selected.front().before.value( "mesh" ).toObject();
+	QJsonObject changes;
+	auto mixed = [&]( const char* key, const QJsonValue& fallback ){
+		const QJsonValue first = mesh.value( key ).isUndefined() ? fallback : mesh.value( key );
+		return std::any_of( selected.begin(), selected.end(), [&]( const Target& target ){
+			const QJsonObject value = target.before.value( "mesh" ).toObject(); return ( value.value( key ).isUndefined() ? fallback : value.value( key ) ) != first;
+		} );
+	};
+	QDialog dialog( MainFrame_getWindow() ); dialog.setWindowTitle( "Prime Mesh Properties" );
+	auto* layout = new QVBoxLayout( &dialog );
+	layout->addWidget( new QLabel( QString( "%1 selected mesh(es). Only fields you change apply to the selection." ).arg( int( selected.size() ) ) ) );
+	auto* form = new QFormLayout; layout->addLayout( form );
+	for( const auto& field : { std::make_pair( "label", "Label" ), std::make_pair( "layer", "Layer" ) } ){
+		const QString key = field.first, fallback = key == "label" ? "Geometry" : "Architecture";
+		auto* entry = new QLineEdit;
+		if( mixed( field.first, fallback ) ) entry->setPlaceholderText( "Mixed — unchanged" );
+		else entry->setText( mesh.value( key ).toString( fallback ) );
+		form->addRow( field.second, entry );
+		QObject::connect( entry, &QLineEdit::textEdited, &dialog, [&, key]( const QString& text ){ changes[key] = text; } );
+	}
+	auto* terrain = new QComboBox;
+	terrain->addItems( { "Metal", "OrangeHolo", "GreenHolo", "BlueHolo", "Ice", "Snow", "Sand", "Rock", "Lava", "Acid", "Gorea", "Unknown11", "All" } );
+	if( mixed( "terrain", "Metal" ) ) { terrain->insertItem( 0, "Mixed — unchanged", QVariant() ); terrain->setCurrentIndex( 0 ); }
+	else terrain->setCurrentText( mesh.value( "terrain" ).toString( "Metal" ) );
+	form->addRow( "Terrain", terrain );
+	QObject::connect( terrain, QOverload<int>::of( &QComboBox::activated ), &dialog, [&]( int index ){
+		if( terrain->itemText( index ) == "Mixed — unchanged" ) changes.remove( "terrain" ); else changes["terrain"] = terrain->itemText( index );
+	} );
+	auto* shade = number( form, mixed( "shade", 1 ) ? "Shade (mixed; unchanged)" : "Shade", mesh.value( "shade" ).toDouble( 1 ), 0, 1 );
+	QObject::connect( shade, QOverload<double>::of( &QDoubleSpinBox::valueChanged ), &dialog, [&]( double value ){ changes["shade"] = value; } );
+	auto* slip = new QSpinBox; slip->setRange( 0, 3 ); slip->setValue( mesh.value( "slipperiness" ).toInt() );
+	form->addRow( mixed( "slipperiness", 0 ) ? "Slipperiness (mixed; unchanged)" : "Slipperiness", slip );
+	QObject::connect( slip, QOverload<int>::of( &QSpinBox::valueChanged ), &dialog, [&]( int value ){ changes["slipperiness"] = value; } );
+	for( const auto& item : std::vector<std::pair<const char*, const char*>>{
+		{ "solid", "Solid collision" }, { "damaging", "Damaging" }, { "collisionOnly", "Collision proxy only" },
+		{ "reflectBeams", "Reflect beams" }, { "ignorePlayers", "Ignore players / camera" }, { "ignoreBeams", "Ignore beams" },
+		{ "ignoreScan", "Ignore scan" }, { "hidden", "Hidden" }, { "locked", "Locked" } } ){
+		const QString key = item.first; const bool fallback = key == "solid";
+		auto* flag = new QCheckBox;
+		if( mixed( item.first, fallback ) ) { flag->setTristate( true ); flag->setCheckState( Qt::PartiallyChecked ); flag->setToolTip( "Mixed values. Leave partial to preserve each mesh's value." ); }
+		else flag->setChecked( mesh.value( key ).toBool( fallback ) );
+		form->addRow( item.second, flag );
+		QObject::connect( flag, &QCheckBox::stateChanged, &dialog, [&, key]( int state ){
+			if( state == Qt::PartiallyChecked ) changes.remove( key ); else changes[key] = state == Qt::Checked;
+		} );
+	}
+	buttons( dialog, layout ); if( dialog.exec() != QDialog::Accepted ) return;
+	if( changes.isEmpty() ) return;
+	edit( [&]( Target& target, QString& ){
+		QJsonObject value = target.after.value( "mesh" ).toObject();
+		for( auto i = changes.begin(); i != changes.end(); ++i ) value[i.key()] = i.value();
+		target.after["mesh"] = value; return true;
+	}, "primeMesh properties", true, true );
+}
