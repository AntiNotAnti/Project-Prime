+	std::vector<Vector3> vertices;
+	std::vector<std::vector<unsigned int>> faces;
+	std::vector<std::vector<unsigned int>> triangles;
+	std::vector<std::pair<unsigned int, unsigned int>> edges;
+	PrimeMeshGeometry( const Callback<void()>& evaluate, const Callback<void()>& boundsChanged ) :
+		m_wireShader( GlobalShaderCache().capture( "$LATTICE" ) ),
+		m_pointShader( GlobalShaderCache().capture( "$POINT" ) ), m_evaluate( evaluate ), m_boundsChanged( boundsChanged ), m_points( GL_POINTS ){
+		m_payload = QJsonObject{ { "schema", 1 }, { "units", 16 }, { "materials", QJsonArray() },
+			{ "mesh", QJsonObject{ { "kind", "mesh" }, { "vertices", QJsonArray() }, { "faces", QJsonArray() } } } };
+	}
+	~PrimeMeshGeometry(){
+		releaseMaterials();
+		GlobalShaderCache().release( "$POINT" ); GlobalShaderCache().release( "$LATTICE" );
+	}
+	QJsonObject payload() const override { return m_payload; }
+	bool visible() const { return !m_payload.value( "mesh" ).toObject().value( "hidden" ).toBool(); }
+	bool editable() const { return visible() && !m_payload.value( "reference" ).toBool() && !m_payload.value( "mesh" ).toObject().value( "locked" ).toBool(); }
+	bool setPayload( const QJsonObject& payload ) override {
+		QString error;
+		if ( !PrimeMesh_validatePayload( payload, &error ) ){
+			globalErrorStream() << "Prime mesh: " << error.toUtf8().constData() << '\n'; return false;
+		}
+		if ( payload == m_payload ) return true;
+		undoSave(); m_payload = payload; m_transformChanged = false; buildGeometry(); return true;
+	}
+	void undoSave(){ if ( m_map ) m_map->changed(); if ( m_undoObserver ) m_undoObserver->save( this ); }
+	UndoMemento* exportState() const override { return new SavedState( m_payload ); }
+	void importState( const UndoMemento* state ) override {
+		undoSave(); m_payload = static_cast<const SavedState*>( state )->payload; m_transformChanged = false; buildGeometry();
+	}
+	void instanceAttach( const scene::Path& path, PrimeMeshInstance* observer ){
+		m_observers.insert( observer );
+		if ( ++m_instances == 1 ){
+			m_map = path_find_mapfile( path.begin(), path.end() ); m_undoObserver = GlobalUndoSystem().observer( this );
+			for ( const auto& group : m_materials ) group->shader->incrementUsed();
+		}
+	}
+	void instanceDetach( PrimeMeshInstance* observer ){
+		m_observers.erase( observer );
+		if ( --m_instances == 0 ){
+			for ( const auto& group : m_materials ) group->shader->decrementUsed();
+			m_map = nullptr; m_undoObserver = nullptr; GlobalUndoSystem().release( this );
+		}
+	}
+	const char* name() const override { return m_label.isEmpty() ? "Polygon mesh" : m_label.constData(); }
+	void attach( const NameCallback& ) override {}
+	void detach( const NameCallback& ) override {}
+	const Matrix4& localToParent() const override { return g_matrix4_identity; }
+	const AABB& localAABB() const override { const_cast<PrimeMeshGeometry*>( this )->evaluateTransform(); return m_bounds; }
+	VolumeIntersectionValue intersectVolume( const VolumeTest& volume, const Matrix4& localToWorld ) const override { return volume.TestAABB( localAABB(), localToWorld ); }
+	void transformChanged(){
+		m_transformChanged = true; m_boundsChanged(); SceneChangeNotify();
+	}
+	typedef MemberCaller<PrimeMeshGeometry, void(), &PrimeMeshGeometry::transformChanged> TransformChangedCaller;
+	void evaluateTransform(){
+		if ( m_transformChanged && !m_evaluating ){
+			m_evaluating = true; vertices = m_original; m_evaluate(); buildRender(); m_transformChanged = false; m_evaluating = false;
+		}
+	}
+	void previewTransform( const Matrix4& matrix, const std::vector<bool>* selected ){
+		if ( !editable() ) return;
+		for ( std::size_t i = 0; i < vertices.size(); ++i ) if ( selected == nullptr || ( i < selected->size() && ( *selected )[i] ) ) matrix4_transform_point( matrix, vertices[i] );
+	}
+	void applyTransform( const Matrix4& matrix, const std::vector<bool>* selected ){
+		if ( !editable() ) return;
+		QJsonObject payload = m_payload, mesh = payload.value( "mesh" ).toObject();
+		const QMatrix4x4 coordinates = basis( 16 ), local = primeTransform( mesh );
+		const QMatrix4x4 delta = coordinates.inverted() * qtMatrix( matrix ) * coordinates;
+		QJsonObject transform = mesh.value( "transform" ).toObject();
+		if ( selected == nullptr && decompose( delta * local, transform ) ) mesh.insert( "transform", transform );
+		else {
+			bool invertible;
+			const QMatrix4x4 inverse = local.inverted( &invertible );
+			if ( !invertible ) { globalErrorStream() << "Prime mesh: transform scale is too small for this component edit.\n"; return; }
+			const QMatrix4x4 edit = inverse * delta * local;
+			QJsonArray vertices = mesh.value( "vertices" ).toArray();
+			for ( int i = 0; i < vertices.size(); ++i )
+				if ( selected == nullptr || ( std::size_t( i ) < selected->size() && ( *selected )[i] ) ) vertices[i] = write3( edit.map( read3( vertices[i] ) ) );
+			mesh.insert( "vertices", vertices );
+		}
+		payload.insert( "mesh", mesh ); setPayload( payload );
+	}
+	void snap( float snap, const std::vector<bool>* selected ){
+		if ( !editable() || snap <= 0 || !std::isfinite( snap ) ) return;
+		QJsonObject payload = m_payload, mesh = payload.value( "mesh" ).toObject();
+		const QMatrix4x4 matrix = basis( 16 ) * primeTransform( mesh );
+		bool invertible;
+		const QMatrix4x4 inverse = matrix.inverted( &invertible );
+		if ( !invertible ) { globalErrorStream() << "Prime mesh: transform scale is too small for grid snapping.\n"; return; }
+		QJsonArray vertices = mesh.value( "vertices" ).toArray();
+		for ( int i = 0; i < vertices.size(); ++i ){
+			if ( selected && ( std::size_t( i ) >= selected->size() || !( *selected )[i] ) ) continue;
+			Vector3 p = nativeVector( matrix.map( read3( vertices[i] ) ) ); vector3_snap( p, snap ); vertices[i] = write3( inverse.map( qtVector( p ) ) );
+		}
+		mesh.insert( "vertices", vertices ); payload.insert( "mesh", mesh ); setPayload( payload );
+	}
+	void snapto( float snap ) override { this->snap( snap, nullptr ); }
+	void renderSolid( Renderer& renderer, const Matrix4& matrix ){
+		evaluateTransform();
+		for ( const auto& group : m_materials ){
+			renderer.SetState( group->shader, Renderer::eFullMaterials ); renderer.addRenderable( group->solid, matrix );
+		}
+	}
+	void renderWire( Renderer& renderer, const Matrix4& matrix ){
+		evaluateTransform(); renderer.SetState( m_wireShader, Renderer::eWireframeOnly ); renderer.SetState( m_wireShader, Renderer::eFullMaterials ); renderer.addRenderable( m_wire, matrix );
+	}
+	void renderPoints( Renderer& renderer, const Matrix4& matrix ){
+		evaluateTransform();
+		if ( m_points.empty() ) return;
+		renderer.SetState( m_pointShader, Renderer::eWireframeOnly ); renderer.SetState( m_pointShader, Renderer::eFullMaterials ); renderer.addRenderable( m_points, matrix );
+	}
+	void renderMarkers( Renderer& renderer, const RenderablePointVector& points, const Matrix4& matrix ){
+		if ( points.empty() ) return;
+		renderer.SetState( m_pointShader, Renderer::eWireframeOnly ); renderer.SetState( m_pointShader, Renderer::eFullMaterials ); renderer.addRenderable( points, matrix );
+	}
+	void testFace( std::size_t face, SelectionTest& test, SelectionIntersection& intersection ) const {
+		if ( face >= triangles.size() || triangles[face].empty() || vertices.empty() ) return;
+		test.TestTriangles( VertexPointer( vertices[0].data(), sizeof( Vector3 ) ), IndexPointer( triangles[face].data(), triangles[face].size() ), intersection );
+	}
+	bool importTokens( Tokeniser& tokeniser ) override {
+		tokeniser.nextLine();
+		if ( !Tokeniser_parseToken( tokeniser, "{" ) ) return false;
+		tokeniser.nextLine();
+		if ( !Tokeniser_parseToken( tokeniser, "version" ) ) return false;
+		if ( !Tokeniser_parseToken( tokeniser, "1" ) ) return false;
+		tokeniser.nextLine();
+		if ( !Tokeniser_parseToken( tokeniser, "data" ) ) return false;
+		const char* countToken = tokeniser.getToken();
+		if ( countToken == nullptr || *countToken == '\0' ) return false;
+		int count = 0;
+		for ( const char* p = countToken; *p != '\0'; ++p ){
+			if ( *p < '0' || *p > '9' || count > ( MaxChunks - ( *p - '0' ) ) / 10 ) return false;
+			count = count * 10 + ( *p - '0' );
+		}
+		if ( count <= 0 ) return false;
+		QByteArray encoded; encoded.reserve( std::min( count * ChunkLength, MaxEncoded ) );
+		for ( int i = 0; i < count; ++i ){
+			tokeniser.nextLine(); const char* token = tokeniser.getToken();
+			if ( token == nullptr ) return false;
+			const std::size_t length = std::strlen( token );
+			if ( length == 0 || length > ChunkLength || length % 4 != 0 || encoded.size() + int( length ) > MaxEncoded
+			  || ( i + 1 != count && std::memchr( token, '=', length ) != nullptr ) ) return false;
+			encoded.append( token, int( length ) );
+		}
+		// Qt 5's decoder is deliberately permissive. Validate and round-trip the
+		// alphabet/padding before accepting data, including non-canonical encodings.
+		for ( char c : encoded ) if ( !( c >= 'A' && c <= 'Z' ) && !( c >= 'a' && c <= 'z' ) && !( c >= '0' && c <= '9' ) && c != '+' && c != '/' && c != '=' ) return false;
+		if ( encoded.size() % 4 != 0 ) return false;
+		const QByteArray decoded = QByteArray::fromBase64( encoded );
+		if ( decoded.isEmpty() || decoded.size() > MaxBytes || decoded.toBase64() != encoded ) return false;
+		if ( QString::fromUtf8( decoded ).toUtf8() != decoded ) return false;
+		QJsonParseError error;
+		const QJsonDocument document = QJsonDocument::fromJson( decoded, &error );
+		if ( error.error != QJsonParseError::NoError || !document.isObject() || !UniqueJsonProperties( decoded ).check()
+		  || !PrimeMesh_validatePayload( document.object() ) ) return false;
+		tokeniser.nextLine(); if ( !Tokeniser_parseToken( tokeniser, "}" ) ) return false;
+		tokeniser.nextLine(); if ( !Tokeniser_parseToken( tokeniser, "}" ) ) return false;
+		// Commit only after complete bounded decoding and both delimiters validate.
+		return setPayload( document.object() );
+	}
+	void exportTokens( TokenWriter& writer ) const override {
+		const QByteArray encoded = QJsonDocument( m_payload ).toJson( QJsonDocument::Compact ).toBase64();
+		writer.writeToken( "{" ); writer.nextLine(); writer.writeToken( "primeMeshDef" ); writer.nextLine(); writer.writeToken( "{" ); writer.nextLine();
+		writer.writeToken( "version" ); writer.writeInteger( 1 ); writer.nextLine();
+		writer.writeToken( "data" ); writer.writeUnsigned( ( encoded.size() + ChunkLength - 1 ) / ChunkLength ); writer.nextLine();
+		for ( int offset = 0; offset < encoded.size(); offset += ChunkLength ){
+			writer.writeString( encoded.mid( offset, ChunkLength ).constData() ); writer.nextLine();
+		}
+		writer.writeToken( "}" ); writer.nextLine(); writer.writeToken( "}" ); writer.nextLine();
+	}
+};
