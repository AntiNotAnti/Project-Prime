+void copyUv(){
+	if( g_running ) return;
+	const auto selected = targets();
+	if( !editable( selected ) ) return;
+	for( const Target& target : selected ){
+		const auto faces = selectedFaces( target );
+		if( faces.isEmpty() ) continue;
+		struct Guard { Guard(){ g_running = true; } ~Guard(){ g_running = false; } } guard;
+		QProgressDialog progress( "Copying face UV…", "Cancel", 0, 1, MainFrame_getWindow() ); progress.setWindowModality( Qt::ApplicationModal ); progress.setMinimumDuration( 0 ); progress.show();
+		const int face = faces[0].toInt(); QJsonObject response; QString message;
+		QJsonObject request{ { "schema", 1 }, { "operation", "uvTransform" }, { "payload", target.before },
+			{ "selection", QJsonObject{ { "faces", QJsonArray{ face } } } }, { "mode", "Face" } };
+		if( !callWorker( request, response, progress, message ) ) { progress.hide(); error( message ); return; }
+		if( !PrimeMesh_validatePayload( response.value( "payload" ).toObject(), &message ) ) { progress.hide(); error( message ); return; }
+		g_copiedUv = response.value( "payload" ).toObject().value( "mesh" ).toObject().value( "faceTexcoords" ).toArray().at( face ).toArray();
+		return;
+	}
+}
