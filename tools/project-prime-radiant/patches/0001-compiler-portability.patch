+	for( const auto& category : std::vector<std::pair<const char*, std::vector<const char*>>>{
+		{ "Faces", { "Extrude region", "Extrude individual", "Inset region", "Bevel face", "Subdivide face", "Delete face", "Duplicate faces", "Duplicate to object", "Separate", "Join meshes", "Fill", "Triangulate", "Dissolve triangles", "Flip normals", "Recalculate winding" } },
+		{ "Edges", { "Bevel", "Split edge", "Dissolve edge", "Collapse edge", "Collapse to A", "Collapse to B", "Collapse to cursor", "Slide edge" } },
+		{ "Vertices", { "Merge center", "Merge first", "Merge last", "Merge by distance", "Weld", "Connect vertices", "Rip vertex", "Slide vertex", "Flatten X", "Flatten Y", "Flatten Z", "Snap to surface", "Clean unused vertices" } },
+		{ "Selection", { "Select boundary", "Select linked", "Grow", "Shrink", "Select all faces", "Select connected faces", "Select faces with same material" } } } ){
