+void PrimeMeshTools_setShader( const char* shader ){
+	QString name = QString::fromUtf8( shader );
+	if( name.startsWith( "textures/" ) ) name.remove( 0, 9 );
+	edit( [name]( Target& target, QString& message ){
+		if( name.isEmpty() || name.size() > 128 || name.contains( ".." ) ) { message = "Invalid Prime material name."; return false; }
+		const int index = materialIndex( target.after, name );
+		QJsonObject mesh = target.after.value( "mesh" ).toObject(); QJsonArray faceMaterials = mesh.value( "faceMaterials" ).toArray();
+		while( faceMaterials.size() < mesh.value( "faces" ).toArray().size() ) faceMaterials.append( mesh.value( "material" ).toInt() );
+		for( const auto face : selectedFaces( target ) ) faceMaterials[face.toInt()] = index;
+		if( GlobalSelectionSystem().Mode() != SelectionSystem::eComponent ) mesh["material"] = index;
+		mesh["faceMaterials"] = faceMaterials; target.after["mesh"] = mesh; return true;
+	}, "primeMesh material" );
+}
+
+bool PrimeMeshTools_getSurface( TextureProjection& projection, QString& shader ){
+	const auto selected = targets();
+	for( const Target& target : selected ){
+		const QJsonArray selection = selectedFaces( target );
+		if( selection.isEmpty() ) continue;
+		const int face = selection[0].toInt(); const QJsonObject mesh = target.before.value( "mesh" ).toObject();
+		const QJsonArray faceMaterials = mesh.value( "faceMaterials" ).toArray(), materials = target.before.value( "materials" ).toArray();
+		const int material = face < faceMaterials.size() ? faceMaterials[face].toInt() : mesh.value( "material" ).toInt();
+		const QJsonObject description = materials[material].toObject(); shader = description.value( "name" ).toString();
+		if( !shader.startsWith( "textures/" ) ) shader.prepend( "textures/" );
+		QJsonObject uv = mesh.value( "faceUv" ).toObject().value( QString::number( face ) ).toObject();
+		if( uv.isEmpty() ) uv = mesh.value( "uv" ).toObject();
+		const QJsonArray scale = uv.value( "scale" ).toArray(), offset = uv.value( "offset" ).toArray();
+		TexDef_Construct_Default( projection );
+		const double factor = target.before.value( "units" ).toDouble( 16 ) / description.value( "texScale" ).toDouble( 16 );
+		for( int axis = 0; axis < 2; ++axis ){
+			projection.m_texdef.scale[axis] = float( factor / ( scale.size() == 2 ? scale[axis].toDouble( 1 ) : 1 ) );
+			projection.m_texdef.shift[axis] = float( offset.size() == 2 ? offset[axis].toDouble() : 0 );
+		}
+		projection.m_texdef.rotate = float( uv.value( "rotation" ).toDouble() ); return true;
+	}
+	return false;
+}
