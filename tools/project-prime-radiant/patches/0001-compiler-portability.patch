+// Never invoke a shell, search PATH, run a project, or accept an executable from map data.
+bool callWorker( const QJsonObject& request, QJsonObject& response, QProgressDialog& progress, QString& message, QJsonObject* lifecycle = nullptr ){
+	const QFileInfo executable( QDir::cleanPath( workerPath() ) );
+	if( lifecycle ) *lifecycle = QJsonObject{ { "executable", executable.absoluteFilePath() }, { "started", false }, { "reaped", false } };
+	QFileInfo component = executable;
+	while( true ){
+		if( component.isSymLink() ){
+			message = "The bundled mesh worker path contains a symbolic link. Reinstall the Studio desktop package."; return false;
+		}
+		const QDir parent = component.absoluteDir();
+		if( component.absoluteFilePath() == parent.absolutePath() ) break;
+		component.setFile( parent.absolutePath() );
+	}
+	if( !executable.isFile() || !executable.isExecutable() ){
+		message = "The bundled ProjectPrimeStudio mesh worker is unavailable. Reinstall the Studio desktop package.";
+		return false;
+	}
+	const QByteArray input = QJsonDocument( request ).toJson( QJsonDocument::Compact );
+	if( input.size() > MaximumWorkerBytes ) { message = "The mesh operation exceeds the 32 MiB worker request limit."; return false; }
+	QProcess process;
+	process.setProgram( executable.absoluteFilePath() );
+	process.setArguments( { "--radiant-mesh-worker" } );
+	process.setWorkingDirectory( executable.absolutePath() );
+	process.setProcessChannelMode( QProcess::SeparateChannels );
+	process.start();
+	QElapsedTimer elapsed; elapsed.start();
+	QByteArray output, diagnostic;
+	qint64 sent = 0;
+	qint64 processId = 0;
+	bool closed = false, killed = false;
+	auto recordLifecycle = [&](){
+		if( lifecycle ){
+			lifecycle->insert( "started", processId != 0 ); lifecycle->insert( "processId", QString::number( processId ) );
+			lifecycle->insert( "reaped", process.state() == QProcess::NotRunning ); lifecycle->insert( "killRequested", killed );
+			lifecycle->insert( "elapsedMs", double( elapsed.elapsed() ) ); lifecycle->insert( "stdoutBytes", output.size() ); lifecycle->insert( "stderrBytes", diagnostic.size() );
+		}
+	};
+	while( true ){
+		QCoreApplication::processEvents();
+		if( process.processId() != 0 ) processId = process.processId();
+		if( progress.wasCanceled() ) { message = "Mesh operation canceled."; break; }
+		if( elapsed.elapsed() > WorkerTimeoutMs ) { message = "The mesh worker exceeded its two minute time limit."; break; }
+		if( process.state() == QProcess::Running && sent < input.size() ){
+			const qint64 written = process.write( input.constData() + sent, input.size() - sent );
+			if( written < 0 ) { message = "Could not write the mesh worker request."; break; }
+			sent += written;
+		}
+		if( sent == input.size() && !closed ) { process.closeWriteChannel(); closed = true; }
+		process.waitForReadyRead( 20 );
+		output += process.readAllStandardOutput();
+		diagnostic += process.readAllStandardError();
+		if( output.size() > MaximumWorkerBytes || diagnostic.size() > MaximumWorkerErrors ){
+			message = "The mesh worker exceeded its bounded output limit."; break;
+		}
+		if( process.state() == QProcess::NotRunning ){
+			if( process.error() == QProcess::FailedToStart ) message = "Could not start the bundled mesh worker.";
+			else if( process.exitStatus() != QProcess::NormalExit ) message = "The mesh worker failed. " + QString::fromUtf8( diagnostic.left( 2048 ) );
+			else {
+				QJsonParseError parse;
+				const QJsonDocument document = QJsonDocument::fromJson( output, &parse );
+				if( parse.error != QJsonParseError::NoError || !document.isObject() ) message = "The mesh worker returned invalid JSON.";
+				else {
+					response = document.object();
+					if( response.value( "schema" ).toInt() != 1 || !response.value( "success" ).isBool() ) message = "The mesh worker returned an unsupported response.";
+					else if( !response.value( "success" ).toBool() ) message = response.value( "error" ).toString( "The mesh operation failed." );
+					else if( process.exitCode() != 0 ) message = "The mesh worker exited unsuccessfully.";
+					else { recordLifecycle(); return true; }
+				}
+			}
+			break;
+		}
+	}
+	if( process.state() != QProcess::NotRunning ){
+		killed = true;
+		process.kill();
+		process.waitForFinished( 3000 );
+	}
+	recordLifecycle();
+	return false;
+}
+
+QJsonObject newObjectPayload( QJsonObject payload, const QString& identity ){
+	QJsonObject mesh = payload.value( "mesh" ).toObject(); mesh["id"] = identity; payload["mesh"] = mesh;
+	// A new object has no original source to restore. Keep all unrelated metadata,
+	// including immutable-reference protection, but discard the whole recovery set.
+	payload.remove( "originalGeometry" ); payload.remove( "originalMeshSha256" ); payload.remove( "originalLegacyBrush" );
+	return payload;
+}
+
+// Validate every response and stage every new node before the first graph mutation.
+bool apply( std::vector<Target>& selected, const char* name, bool ownUndo ){
+	QString problem;
+	struct Addition { NodeSmartReference mesh, container; Addition( scene::Node& m, scene::Node& c ) : mesh( m ), container( c ) {} };
+	std::vector<Addition> additions;
+	for( Target& target : selected ){
+		if( !GlobalSceneGraph().find( target.path ) || PrimeMesh_getPayload( target.node ) != target.original ) { error( "The map changed while the mesh operation was running. No mesh changes were applied." ); return false; }
+		if( !target.remove && !PrimeMesh_validatePayload( target.after, &problem ) ) { error( problem ); return false; }
+		for( QJsonObject payload : target.additional ){
+			const QString id = QUuid::createUuid().toString( QUuid::WithoutBraces );
+			payload = newObjectPayload( payload, id );
+			if( !PrimeMesh_validatePayload( payload, &problem ) ) { error( problem ); return false; }
+			NodeSmartReference node( PrimeMesh_createNode() );
+			if( !PrimeMesh_setPayload( node, payload ) ) { error( "Could not stage the new mesh." ); return false; }
+			NodeSmartReference container( GlobalEntityCreator().createEntity( GlobalEntityClassManager().findOrInsert( "func_group", true ) ) );
+			Node_getEntity( container )->setKeyValue( "prime_geometry", "1" );
+			Node_getEntity( container )->setKeyValue( "prime_id", id.toUtf8().constData() );
+			Node_getTraversable( container )->insert( node );
+			additions.emplace_back( node, container );
+		}
+	}
+	bool changed = !additions.empty();
+	for( const Target& target : selected ) changed = changed || target.remove || target.original != target.after;
+	std::unique_ptr<UndoableCommand> undo;
+	if( changed && ownUndo ) undo.reset( new UndoableCommand( name ) );
+	std::vector<Target*> applied;
+	for( Target& target : selected ){
+		if( !target.remove && target.after != target.original ){
+			if( !PrimeMesh_setPayload( target.node, target.after ) ){
+				// Setters have already validated; retain a rollback for allocation/runtime failures.
+				for( Target* old : applied ) PrimeMesh_setPayload( old->node, old->original );
+				error( "Could not apply the mesh operation. Previous meshes were restored." ); return false;
+			}
+			applied.push_back( &target );
+		}
+	}
+	for( Target& target : selected ){
+		if( target.remove ){
+			NodeSmartReference parent( target.path.parent().get() );
+			Node_getTraversable( parent )->erase( target.node );
+			Entity* entity = Node_getEntity( parent );
+			if( entity && *entity->getKeyValue( "prime_id" ) && Node_getTraversable( parent )->empty() && target.path.size() > 2 )
+				Node_getTraversable( target.path[target.path.size() - 3] )->erase( parent );
+		}
+		else if( scene::Instance* instance = GlobalSceneGraph().find( target.path ) ){
+			PrimeMesh_setSelection( *instance, target.resultSelection );
+			const QString resultMode = target.resultSelection.value( "mode" ).toString();
+			if( resultMode == "Edge" && GlobalSelectionSystem().Mode() == SelectionSystem::eComponent ) GlobalSelectionSystem().SetComponentMode( SelectionSystem::eEdge );
+		}
+	}
+	if( !additions.empty() ){
+		GlobalSelectionSystem().setSelectedAllComponents( false );
+		GlobalSelectionSystem().setSelectedAll( false );
+		for( Addition& addition : additions ){
+			Node_getTraversable( GlobalSceneGraph().root() )->insert( addition.container );
+			scene::Path path( makeReference( GlobalSceneGraph().root() ) ); path.push( makeReference( addition.container.get() ) ); path.push( makeReference( addition.mesh.get() ) );
+			if( scene::Instance* instance = GlobalSceneGraph().find( path ) ) Instance_setSelected( *instance, true );
+		}
+	}
+	SceneChangeNotify();
+	return true;
+}
+
+QString mode(){
+	if( GlobalSelectionSystem().Mode() == SelectionSystem::eComponent ){
+		if( GlobalSelectionSystem().ComponentMode() == SelectionSystem::eVertex ) return "Vertex";
+		if( GlobalSelectionSystem().ComponentMode() == SelectionSystem::eEdge ) return "Edge";
+	}
+	return "Face";
+}
