+void PrimeMeshTools_setTexdef( const TextureProjection& projection, bool resetBasis ){
+	if( resetBasis ){
+		run( "uvSetProjection", { { "uv", QJsonObject{ { "scale", QJsonArray{ 1, 1 } }, { "offset", QJsonArray{ 0, 0 } }, { "rotation", 0 } } } }, false, true );
+		return;
+	}
+	const auto& texdef = projection.m_texdef;
+	PrimeMeshTools_setTexdef( &texdef.shift[0], &texdef.shift[1], &texdef.scale[0], &texdef.scale[1], &texdef.rotate );
+}
