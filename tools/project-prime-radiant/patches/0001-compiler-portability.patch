+bool run( const QString& operation, const QJsonObject& options = {}, bool ownUndo = true, bool facesOnly = false ){
+	if( g_running ) return false;
+	auto selected = targets();
+	if( selected.empty() ) return true;
+	if( !editable( selected ) ) return false;
+	struct Guard { Guard(){ g_running = true; } ~Guard(){ g_running = false; } } guard;
+	QProgressDialog progress( "Editing original mesh topology…", "Cancel", 0, int( selected.size() ), MainFrame_getWindow() );
+	progress.setWindowTitle( "Prime Mesh" ); progress.setWindowModality( Qt::ApplicationModal ); progress.setMinimumDuration( 0 ); progress.show();
+	std::vector<Target> sceneTargets;
+	if( operation == "Join meshes" || operation == "Snap to surface" ) GlobalSceneGraph().traverse( Collect( sceneTargets, operation == "Join meshes" ) );
+	QString problem;
+	std::vector<QJsonObject> nativeSurfaces;
+	if( operation == "Snap to surface" ){
+		nativeSurfaces = nativeSurfaceContexts( problem );
+		if( !problem.isEmpty() ) { progress.hide(); error( problem ); return false; }
+	}
+	for( size_t i = 0; i < selected.size(); ++i ){
+		Target& target = selected[i];
+		if( facesOnly ){
+			const QJsonArray faces = selectedFaces( target );
+			if( faces.isEmpty() ) continue;
+			target.selection["faces"] = faces;
+		}
+		else if( !hasSelection( target.selection ) && GlobalSelectionSystem().Mode() != SelectionSystem::eComponent ) target.selection["faces"] = selectedFaces( target );
+		QJsonObject request = options, payload = target.before;
+		QJsonArray otherMeshes, materials = payload.value( "materials" ).toArray();
+		for( const Target& context : sceneTargets ){
+			if( context.node.get_pointer() == target.node.get_pointer() ) continue;
+			QJsonObject mesh = context.before.value( "mesh" ).toObject();
+			if( operation == "Snap to surface" ) { otherMeshes.append( snapSurface( mesh ) ); continue; }
+			const QJsonArray sourceMaterials = context.before.value( "materials" ).toArray(); std::vector<int> remap;
+			for( const auto source : sourceMaterials ){
+				int slot = -1;
+				for( int m = 0; m < materials.size(); ++m ) if( materials[m] == source ) { slot = m; break; }
+				if( slot < 0 ) { slot = materials.size(); materials.append( source ); } remap.push_back( slot );
+			}
+			mesh["material"] = remap[size_t( mesh.value( "material" ).toInt() )]; QJsonArray faceMaterials = mesh.value( "faceMaterials" ).toArray();
+			for( int f = 0; f < faceMaterials.size(); ++f ) faceMaterials[f] = remap[size_t( faceMaterials[f].toInt() )];
+			mesh["faceMaterials"] = faceMaterials; otherMeshes.append( mesh );
+		}
+		for( const QJsonObject& surface : nativeSurfaces ) otherMeshes.append( snapSurface( surface ) );
+		payload["materials"] = materials;
+		request["schema"] = 1; request["operation"] = operation; request["payload"] = payload;
+		request["selection"] = target.selection; request["mode"] = facesOnly ? "Face" : mode();
+		if( !request.contains( "amount" ) ) request["amount"] = g_amount;
+		if( !request.contains( "segments" ) ) request["segments"] = g_segments;
+		request["cursor"] = g_cursor;
+		if( !otherMeshes.isEmpty() ) request["meshes"] = otherMeshes;
+		QJsonObject response;
+		if( !callWorker( request, response, progress, problem ) ) { progress.cancel(); error( problem ); return false; }
+		target.remove = response.value( "removeSource" ).toBool();
+		if( !target.remove && !response.value( "payload" ).isObject() ) { error( "The mesh worker omitted its canonical payload." ); return false; }
+		target.after = response.value( "payload" ).toObject();
+		if( !target.remove && !PrimeMesh_validatePayload( target.after, &problem ) ) { error( problem ); return false; }
+		if( !response.value( "selection" ).isObject() ) { error( "The mesh worker omitted its component selection." ); return false; }
+		target.resultSelection = response.value( "selection" ).toObject();
+		if( response.contains( "additionalMeshes" ) && !response.value( "additionalMeshes" ).isArray() ) { error( "The mesh worker returned invalid additional meshes." ); return false; }
+		for( const QJsonValue value : response.value( "additionalMeshes" ).toArray() ){
+			if( !value.isObject() ) { error( "The mesh worker returned an invalid new mesh." ); return false; }
+			QJsonObject additional = payload; additional["mesh"] = value;
+			target.additional.push_back( additional );
+		}
+		progress.setValue( int( i + 1 ) );
+		if( operation == "Join meshes" ){
+			for( size_t j = 1; j < selected.size(); ++j ) selected[j].remove = true;
+			break;
+		}
+	}
+	progress.hide();
+	const QByteArray name = ( "primeMesh " + operation ).toUtf8();
+	return apply( selected, name.constData(), ownUndo );
+}
+
+using Edit = std::function<bool( Target&, QString& )>;
+bool edit( const Edit& change, const char* name, bool ownUndo = false, bool allowLocked = false ){
+	if( g_running ) return false;
+	auto selected = targets( allowLocked );
+	if( selected.empty() ) return true;
+	if( !editable( selected, allowLocked ) ) return false;
+	QString problem;
+	for( Target& target : selected ) if( !change( target, problem ) ) { error( problem ); return false; }
+	return apply( selected, name, ownUndo );
+}
