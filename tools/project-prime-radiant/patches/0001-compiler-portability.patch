+	return value.isDouble() && std::isfinite( value.toDouble() ) && std::isfinite( float( value.toDouble() ) );
+}
+bool vectorValue( const QJsonValue& value, int count, bool positive = false ){
+	if ( !value.isArray() || value.toArray().size() != count ) return false;
+	for ( const QJsonValue& v : value.toArray() )
+		if ( !finiteNumber( v ) || ( positive && float( v.toDouble() ) <= 0 ) ) return false;
+	return true;
+}
+bool indexValue( const QJsonValue& value, int count ){
+	return finiteNumber( value ) && value.toDouble() == std::floor( value.toDouble() )
+		&& value.toDouble() >= 0 && value.toDouble() < count;
+}
+bool finiteTree( const QJsonValue& value, int depth = 0 ){
+	if ( depth > 48 ) return false;
+	if ( value.isDouble() ) return std::isfinite( value.toDouble() );
+	if ( value.isArray() ){
+		for ( const QJsonValue& child : value.toArray() )
+			if ( !finiteTree( child, depth + 1 ) ) return false;
+	}
+	else if ( value.isObject() ){
+		const QJsonObject object = value.toObject();
+		for ( auto i = object.begin(); i != object.end(); ++i )
+			if ( !finiteTree( i.value(), depth + 1 ) ) return false;
+	}
+	return true;
+}
+bool validUv( const QJsonValue& value ){
+	if ( !value.isObject() ) return false;
+	const QJsonObject uv = value.toObject();
+	return ( !uv.contains( "scale" ) || vectorValue( uv.value( "scale" ), 2, true ) )
+		&& ( !uv.contains( "offset" ) || vectorValue( uv.value( "offset" ), 2 ) )
+		&& ( !uv.contains( "rotation" ) || finiteNumber( uv.value( "rotation" ) ) );
+}
+
+// QJsonDocument intentionally keeps the last occurrence of a repeated key.
+// Scan the already syntax-checked source as well, so import cannot silently
+// discard an authored property before it reaches the opaque JSON store.
+class UniqueJsonProperties
+{
+	const QByteArray& m_source;
+	int m_pos = 0;
+	void whitespace(){
+		while ( m_pos < m_source.size() && ( m_source[m_pos] == ' ' || m_source[m_pos] == '\t' || m_source[m_pos] == '\r' || m_source[m_pos] == '\n' ) ) ++m_pos;
+	}
+	bool take( char c ){
+		whitespace(); if ( m_pos == m_source.size() || m_source[m_pos] != c ) return false; ++m_pos; return true;
+	}
+	QByteArray string(){
+		whitespace(); const int begin = m_pos;
+		if ( m_pos >= m_source.size() || m_source[m_pos++] != '"' ) return {};
+		while ( m_pos < m_source.size() ){
+			const char c = m_source[m_pos++];
+			if ( c == '"' ) return m_source.mid( begin, m_pos - begin );
+			if ( c == '\\' ) ++m_pos;
+		}
+		return {};
+	}
+	bool value( int depth ){
+		if ( depth > 48 ) return false;
+		whitespace(); if ( m_pos >= m_source.size() ) return false;
+		const char type = m_source[m_pos];
+		if ( type == '{' ){
+			++m_pos; std::set<QString> keys;
+			if ( take( '}' ) ) return true;
+			while ( true ){
+				const QByteArray token = string(); if ( token.isEmpty() ) return false;
+				const QJsonDocument decoded = QJsonDocument::fromJson( '[' + token + ']' );
+				if ( !decoded.isArray() || decoded.array().size() != 1 || !keys.insert( decoded.array()[0].toString() ).second ) return false;
+				if ( !take( ':' ) || !value( depth + 1 ) ) return false;
+				if ( take( '}' ) ) return true;
+				if ( !take( ',' ) ) return false;
+			}
+		}
+		if ( type == '[' ){
+			++m_pos; if ( take( ']' ) ) return true;
+			while ( true ){
+				if ( !value( depth + 1 ) ) return false;
+				if ( take( ']' ) ) return true;
+				if ( !take( ',' ) ) return false;
+			}
+		}
+		if ( type == '"' ) return !string().isEmpty();
+		const int start = m_pos;
+		while ( m_pos < m_source.size() ){
+			const char c = m_source[m_pos];
+			if ( c == ',' || c == ']' || c == '}' || c == ' ' || c == '\t' || c == '\r' || c == '\n' ) break;
+			++m_pos;
+		}
+		return m_pos > start;
+	}
+public:
+	explicit UniqueJsonProperties( const QByteArray& source ) : m_source( source ){}
+	bool check(){
+		if ( m_source.startsWith( "\xef\xbb\xbf" ) ) m_pos = 3;
+		if ( !value( 0 ) ) return false;
+		whitespace(); return m_pos == m_source.size();
+	}
+};
+QVector3D read3( const QJsonValue& value, const QVector3D& fallback = QVector3D() ){
+	if ( !value.isArray() || value.toArray().size() != 3 ) return fallback;
+	const QJsonArray a = value.toArray();
+	return QVector3D( a[0].toDouble(), a[1].toDouble(), a[2].toDouble() );
+}
+QJsonArray write3( const QVector3D& value ){
+	return QJsonArray{ double( value.x() ), double( value.y() ), double( value.z() ) };
+}
+QMatrix4x4 primeTransform( const QJsonObject& mesh ){
+	const QJsonObject transform = mesh.value( "transform" ).toObject();
+	const QJsonArray q = transform.value( "rotation" ).toArray();
+	QMatrix4x4 matrix;
+	matrix.translate( read3( transform.value( "position" ) ) );
+	if ( q.size() == 4 ) matrix.rotate( QQuaternion( q[3].toDouble(), q[0].toDouble(), q[1].toDouble(), q[2].toDouble() ) );
+	matrix.scale( read3( transform.value( "scale" ), QVector3D( 1, 1, 1 ) ) );
+	return matrix;
+}
+QMatrix4x4 basis( double units ){
+	return QMatrix4x4( units, 0, 0, 0,
+	                  0, 0, -units, 0,
+	                  0, units, 0, 0,
+	                  0, 0, 0, 1 );
+}
+QMatrix4x4 qtMatrix( const Matrix4& m ){
+	QMatrix4x4 result;
+	for ( int row = 0; row < 4; ++row )
+		for ( int col = 0; col < 4; ++col ) result( row, col ) = m[col * 4 + row];
+	return result;
+}
+Vector3 nativeVector( const QVector3D& v ){ return Vector3( v.x(), v.y(), v.z() ); }
+QVector3D qtVector( const Vector3& v ){ return QVector3D( v.x(), v.y(), v.z() ); }
+
+/// Decompose only a finite affine matrix with orthogonal axes and positive scale.
+/// Reflection/shear is represented by edited local vertices instead of invalid TRS.
+bool decompose( const QMatrix4x4& matrix, QJsonObject& transform ){
+	QVector3D axes[3] = { matrix.column( 0 ).toVector3D(), matrix.column( 1 ).toVector3D(), matrix.column( 2 ).toVector3D() };
+	QVector3D scale( axes[0].length(), axes[1].length(), axes[2].length() );
+	if ( scale.x() < 1e-8 || scale.y() < 1e-8 || scale.z() < 1e-8 ) return false;
+	for ( int i = 0; i < 3; ++i ) axes[i] /= scale[i];
+	if ( std::abs( QVector3D::dotProduct( axes[0], axes[1] ) ) > 1e-5
+	  || std::abs( QVector3D::dotProduct( axes[0], axes[2] ) ) > 1e-5
+	  || std::abs( QVector3D::dotProduct( axes[1], axes[2] ) ) > 1e-5
+	  || QVector3D::dotProduct( QVector3D::crossProduct( axes[0], axes[1] ), axes[2] ) < .9999 ) return false;
+	QMatrix3x3 rotation;
+	for ( int row = 0; row < 3; ++row )
+		for ( int col = 0; col < 3; ++col ) rotation( row, col ) = axes[col][row];
+	const QQuaternion q = QQuaternion::fromRotationMatrix( rotation ).normalized();
+	transform.insert( "position", write3( matrix.column( 3 ).toVector3D() ) );
+	transform.insert( "rotation", QJsonArray{ double( q.x() ), double( q.y() ), double( q.z() ), double( q.scalar() ) } );
+	transform.insert( "scale", write3( scale ) );
+	return finiteTree( transform );
+}
+
+// Triangles carry original face-corner numbers, so explicit corner UV seams survive.
+using Triangle = std::array<unsigned int, 3>;
+struct Point2 { double x, y; };
+double orient2( const Point2& a, const Point2& b, const Point2& c ){
+	return ( b.x - a.x ) * ( c.y - a.y ) - ( b.y - a.y ) * ( c.x - a.x );
+}
+std::vector<Triangle> triangulate( const std::vector<unsigned int>& face, const std::vector<Vector3>& vertices ){
+	std::vector<Triangle> result;
+	if ( face.size() < 3 || face.size() > MaxCorners ) return result;
+	QVector3D normal;
+	for ( std::size_t i = 0; i < face.size(); ++i ){
+		const QVector3D a = qtVector( vertices[face[i]] ), b = qtVector( vertices[face[( i + 1 ) % face.size()]] );
+		normal += QVector3D( ( a.y() - b.y() ) * ( a.z() + b.z() ),
+		                      ( a.z() - b.z() ) * ( a.x() + b.x() ),
+		                      ( a.x() - b.x() ) * ( a.y() + b.y() ) );
+	}
+	if ( normal.lengthSquared() < 1e-16f ) return result;
+	int drop = 0;
+	if ( std::abs( normal.y() ) > std::abs( normal[drop] ) ) drop = 1;
+	if ( std::abs( normal.z() ) > std::abs( normal[drop] ) ) drop = 2;
+	std::vector<Point2> points;
+	double extent = 1;
+	const Vector3 origin = vertices[face[0]];
+	for ( unsigned int index : face ){
+		const Vector3 v = vertices[index] - origin;
+		const Point2 p{ v[( drop + 1 ) % 3], v[( drop + 2 ) % 3] };
+		points.push_back( p );
+		extent = std::max( extent, std::max( std::abs( p.x ), std::abs( p.y ) ) );
+	}
+	const double epsilon = extent * extent * 1e-11;
+	double area = 0;
+	for ( std::size_t i = 0; i < points.size(); ++i )
+		area += points[i].x * points[( i + 1 ) % points.size()].y - points[( i + 1 ) % points.size()].x * points[i].y;
+	if ( std::abs( area ) < epsilon ) return result;
+	const double winding = area > 0 ? 1 : -1;
+	std::vector<unsigned int> remaining;
+	for ( unsigned int i = 0; i < face.size(); ++i ) remaining.push_back( i );
+	while ( remaining.size() > 3 ){
+		bool clipped = false;
+		for ( std::size_t i = 0; i < remaining.size(); ++i ){
+			const unsigned int a = remaining[( i + remaining.size() - 1 ) % remaining.size()], b = remaining[i], c = remaining[( i + 1 ) % remaining.size()];
+			const double cross = winding * orient2( points[a], points[b], points[c] );
+			// Collinear corners stay in the authored polygon; only the transient ring omits them.
+			if ( std::abs( cross ) <= epsilon ){
+				remaining.erase( remaining.begin() + i ); clipped = true; break;
+			}
+			if ( cross < 0 ) continue;
+			bool contains = false;
+			for ( unsigned int p : remaining ){
+				if ( p == a || p == b || p == c ) continue;
+				if ( winding * orient2( points[a], points[b], points[p] ) >= -epsilon
+				  && winding * orient2( points[b], points[c], points[p] ) >= -epsilon
+				  && winding * orient2( points[c], points[a], points[p] ) >= -epsilon ) { contains = true; break; }
+			}
+			if ( !contains ){
+				result.push_back( Triangle{ a, b, c } ); remaining.erase( remaining.begin() + i ); clipped = true; break;
+			}
+		}
+		if ( !clipped ) return {}; // invalid/self-intersecting projection: no fabricated fan.
+	}
+	if ( remaining.size() == 3 && winding * orient2( points[remaining[0]], points[remaining[1]], points[remaining[2]] ) > epsilon )
+		result.push_back( Triangle{ remaining[0], remaining[1], remaining[2] } );
+	return result;
+}
+
+class SolidRenderable final : public OpenGLRenderable
+{
+public:
+	std::vector<ArbitraryMeshVertex> vertices;
+	std::vector<Vector3> boundary;
+	void render( RenderStateFlags state ) const override {
+		if ( !( state & RENDER_FILL ) ){
+			if ( boundary.empty() ) return;
+			gl().glVertexPointer( 3, GL_FLOAT, sizeof( Vector3 ), &boundary[0] );
+			gl().glDrawArrays( GL_LINES, 0, GLsizei( boundary.size() ) );
+			return;
+		}
+		if ( vertices.empty() ) return;
+		gl().glVertexPointer( 3, GL_FLOAT, sizeof( ArbitraryMeshVertex ), &vertices[0].vertex );
+		if ( state & RENDER_LIGHTING ) gl().glNormalPointer( GL_FLOAT, sizeof( ArbitraryMeshVertex ), &vertices[0].normal );
+		if ( state & RENDER_TEXTURE ) gl().glTexCoordPointer( 2, GL_FLOAT, sizeof( ArbitraryMeshVertex ), &vertices[0].texcoord );
+		if ( state & RENDER_BUMP ){
+			gl().glVertexAttribPointer( c_attr_TexCoord0, 2, GL_FLOAT, GL_FALSE, sizeof( ArbitraryMeshVertex ), &vertices[0].texcoord );
+			gl().glVertexAttribPointer( c_attr_Tangent, 3, GL_FLOAT, GL_FALSE, sizeof( ArbitraryMeshVertex ), &vertices[0].tangent );
+			gl().glVertexAttribPointer( c_attr_Binormal, 3, GL_FLOAT, GL_FALSE, sizeof( ArbitraryMeshVertex ), &vertices[0].bitangent );
+		}
+		gl().glDrawArrays( GL_TRIANGLES, 0, GLsizei( vertices.size() ) );
+	}
+};
+class LineRenderable final : public OpenGLRenderable
+{
+	mutable std::vector<Colour4b> m_colours;
+public:
+	std::vector<Vector3> vertices;
+	void render( RenderStateFlags state ) const override {
+		if ( vertices.empty() ) return;
+		if ( state & RENDER_COLOURARRAY ){
+			m_colours.assign( vertices.size(), Colour4b( 0, 0, 255, 255 ) );
+			gl().glColorPointer( 4, GL_UNSIGNED_BYTE, sizeof( Colour4b ), m_colours.data() );
+		}
+		gl().glVertexPointer( 3, GL_FLOAT, sizeof( Vector3 ), &vertices[0] );
+		gl().glDrawArrays( GL_LINES, 0, GLsizei( vertices.size() ) );
+	}
+};
+struct MaterialGroup
+{
+	std::string name;
+	Shader* shader;
+	SolidRenderable solid;
+	explicit MaterialGroup( const std::string& name ) : name( name ), shader( GlobalShaderCache().capture( name.c_str() ) ){}
+	~MaterialGroup(){ GlobalShaderCache().release( name.c_str() ); }
+};
+}
+
+bool PrimeMesh_validatePayload( const QJsonObject& payload, QString* error ){
+	auto fail = [error]( const char* message ){ if ( error ) *error = QString::fromLatin1( message ); return false; };
+	if ( payload.value( "schema" ).toInt( -1 ) != 1 || payload.value( "schema" ).toDouble() != 1
+	  || payload.value( "units" ).toDouble() != 16 ) return fail( "Mesh requires schema 1 and units 16." );
+	if ( !finiteTree( payload ) ) return fail( "Mesh contains a non-finite, oversized, or excessively nested value." );
+	if ( !payload.value( "mesh" ).isObject() ) return fail( "Mesh payload has no mesh object." );
+	const QJsonObject mesh = payload.value( "mesh" ).toObject();
+	if ( mesh.value( "kind" ).toString() != "mesh" ) return fail( "Mesh kind must be mesh." );
+	if ( !mesh.value( "vertices" ).isArray() || !mesh.value( "faces" ).isArray() ) return fail( "Mesh requires indexed vertices and polygon faces." );
+	const QJsonArray vertices = mesh.value( "vertices" ).toArray(), faces = mesh.value( "faces" ).toArray();
+	if ( vertices.size() < 3 || faces.isEmpty() || vertices.size() > MaxElements || faces.size() > MaxElements ) return fail( "Mesh requires 3 to 65535 vertices and 1 to 65535 faces." );
+	for ( const QJsonValue& vertex : vertices )
+		if ( !vectorValue( vertex, 3 ) ) return fail( "Mesh vertex requires three finite coordinates." );
+	for ( const QJsonValue& value : faces ){
+		if ( !value.isArray() || value.toArray().size() < 3 || value.toArray().size() > MaxCorners ) return fail( "Mesh polygons require 3 to 32 corners." );
+		std::set<int> unique;
+		for ( const QJsonValue& index : value.toArray() ){
+			if ( !indexValue( index, vertices.size() ) ) return fail( "Mesh face has an invalid vertex index." );
+			unique.insert( index.toInt() );
+		}
+		if ( unique.size() != std::size_t( value.toArray().size() ) ) return fail( "Mesh face repeats a vertex index." );
+	}
+	for ( const char* flag : { "solid", "damaging", "hidden", "locked", "collisionOnly", "reflectBeams", "ignorePlayers", "ignoreBeams", "ignoreScan" } )
+		if ( mesh.contains( flag ) && !mesh.value( flag ).isBool() ) return fail( "Mesh flags must be boolean values." );
+	if ( mesh.contains( "shade" ) && !finiteNumber( mesh.value( "shade" ) ) ) return fail( "Mesh shade must be finite." );
+	if ( mesh.contains( "slipperiness" ) && !indexValue( mesh.value( "slipperiness" ), 4 ) ) return fail( "Mesh slipperiness must be an integer from 0 to 3." );
+	for ( const char* text : { "label", "layer", "terrain" } )
+		if ( mesh.contains( text ) && !mesh.value( text ).isString() ) return fail( "Mesh authoring labels must be strings." );
+	if ( mesh.contains( "transform" ) ){
+		if ( !mesh.value( "transform" ).isObject() ) return fail( "Mesh transform must be an object." );
+		const QJsonObject t = mesh.value( "transform" ).toObject();
+		if ( ( t.contains( "position" ) && !vectorValue( t.value( "position" ), 3 ) )
+		  || ( t.contains( "scale" ) && !vectorValue( t.value( "scale" ), 3, true ) )
+		  || ( t.contains( "rotation" ) && !vectorValue( t.value( "rotation" ), 4 ) ) ) return fail( "Mesh transform requires finite vectors, positive scale, and a quaternion." );
+		if ( t.contains( "rotation" ) ){
+			double length = 0;
+			for ( const QJsonValue& q : t.value( "rotation" ).toArray() ) length += q.toDouble() * q.toDouble();
+			if ( std::abs( length - 1 ) > .001 ) return fail( "Mesh quaternion must be normalized." );
+		}
+	}
+	if ( !payload.value( "materials" ).isArray() || payload.value( "materials" ).toArray().isEmpty() || payload.value( "materials" ).toArray().size() > MaxElements ) return fail( "Mesh requires 1 to 65535 materials." );
+	const QJsonArray materials = payload.value( "materials" ).toArray();
+	for ( const QJsonValue& material : materials ){
+		if ( !material.isObject() ) return fail( "Mesh material must be an object." );
+		const QJsonObject m = material.toObject();
+		const QString name = m.value( "name" ).toString();
+		if ( !m.value( "name" ).isString() || name.trimmed().isEmpty() || name.size() > 128
+		  || std::any_of( name.begin(), name.end(), []( QChar c ){ return c.category() == QChar::Other_Control; } )
+		  || !finiteNumber( m.value( "texScale" ) ) || float( m.value( "texScale" ).toDouble() ) <= 0
+		  || !indexValue( m.value( "width" ), 16385 ) || m.value( "width" ).toInt() == 0
+		  || !indexValue( m.value( "height" ), 16385 ) || m.value( "height" ).toInt() == 0 ) return fail( "Mesh material requires a name, positive texScale, and integer dimensions from 1 to 16384." );
+	}
+	const int materialCount = std::max( 1, materials.size() );
+	if ( mesh.contains( "material" ) && !indexValue( mesh.value( "material" ), materialCount ) ) return fail( "Mesh material index is invalid." );
+	if ( mesh.contains( "faceMaterials" ) ){
+		const QJsonValue fm = mesh.value( "faceMaterials" );
+		if ( !fm.isArray() || fm.toArray().size() > faces.size() ) return fail( "Mesh face materials do not match its faces." );
+		for ( const QJsonValue& material : fm.toArray() )
+			if ( !indexValue( material, materialCount ) ) return fail( "Mesh face material index is invalid." );
+	}
+	if ( mesh.contains( "faceTexcoords" ) ){
+		if ( !mesh.value( "faceTexcoords" ).isArray() ) return fail( "Mesh face UVs must be an array." );
+		const QJsonArray coords = mesh.value( "faceTexcoords" ).toArray();
+		if ( coords.size() > faces.size() ) return fail( "Mesh face UV count exceeds face count." );
+		for ( int f = 0; f < coords.size(); ++f ){
+			if ( coords[f].isNull() ) continue;
+			if ( !coords[f].isArray() || coords[f].toArray().size() != faces[f].toArray().size() ) return fail( "Mesh face UVs require one coordinate per corner." );
+			for ( const QJsonValue& uv : coords[f].toArray() )
+				if ( !vectorValue( uv, 2 ) ) return fail( "Mesh corner UVs require two finite texel coordinates." );
+		}
+	}
+	if ( mesh.contains( "uv" ) && !validUv( mesh.value( "uv" ) ) ) return fail( "Mesh UV projection is invalid." );
+	if ( mesh.contains( "faceUv" ) ){
+		if ( !mesh.value( "faceUv" ).isObject() ) return fail( "Mesh faceUv must be an object." );
+		const QJsonObject faceUv = mesh.value( "faceUv" ).toObject();
+		for ( auto i = faceUv.begin(); i != faceUv.end(); ++i ){
+			bool ok = false; const int face = i.key().toInt( &ok );
+			if ( !ok || face < 0 || face >= faces.size() || !validUv( i.value() ) ) return fail( "Mesh per-face UV projection is invalid." );
+		}
+	}
+	const QMatrix4x4 native = basis( 16 ) * primeTransform( mesh );
+	for ( const QJsonValue& vertex : vertices ){
+		const QVector3D p = native.map( read3( vertex ) );
+		if ( !std::isfinite( p.x() ) || !std::isfinite( p.y() ) || !std::isfinite( p.z() )
+		  || std::abs( p.x() ) > 1e9 || std::abs( p.y() ) > 1e9 || std::abs( p.z() ) > 1e9 ) return fail( "Transformed mesh coordinates exceed editor limits." );
+	}
+	if ( QJsonDocument( payload ).toJson( QJsonDocument::Compact ).size() > MaxBytes ) return fail( "Mesh payload exceeds 16 MiB." );
+	if ( error ) error->clear();
+	return true;
+}
+
+class PrimeMeshGeometry final : public PrimeMesh, public TransformNode, public Bounded, public Cullable,
+	public Snappable, public Undoable, public Nameable, public MapImporter, public MapExporter
+{
+	class SavedState final : public UndoMemento
+	{
+	public:
+		QJsonObject payload;
+		explicit SavedState( const QJsonObject& value ) : payload( value ){}
+		void release() override { delete this; }
+	};
+	QJsonObject m_payload;
+	QByteArray m_label;
+	std::vector<Vector3> m_original;
+	std::set<PrimeMeshInstance*> m_observers;
+	std::vector<std::unique_ptr<MaterialGroup>> m_materials;
+	Shader* m_wireShader;
+	Shader* m_pointShader;
+	MapFile* m_map = nullptr;
+	UndoObserver* m_undoObserver = nullptr;
+	std::size_t m_instances = 0;
+	bool m_transformChanged = false;
+	bool m_evaluating = false;
+	Callback<void()> m_evaluate;
+	Callback<void()> m_boundsChanged;
+	AABB m_bounds;
+	LineRenderable m_wire;
+	RenderablePointVector m_points;
+	void notifyTopology();
+	void releaseMaterials(){
+		if ( m_instances != 0 ) for ( const auto& group : m_materials ) group->shader->decrementUsed();
+		m_materials.clear();
+	}
+	void buildGeometry(){
+		const QJsonObject mesh = m_payload.value( "mesh" ).toObject();
+		m_original.clear();
+		const QMatrix4x4 matrix = basis( 16 ) * primeTransform( mesh );
+		for ( const QJsonValue& vertex : mesh.value( "vertices" ).toArray() ) m_original.push_back( nativeVector( matrix.map( read3( vertex ) ) ) );
+		vertices = m_original;
+		faces.clear();
+		std::set<std::pair<unsigned int, unsigned int>> uniqueEdges;
+		for ( const QJsonValue& value : mesh.value( "faces" ).toArray() ){
+			std::vector<unsigned int> face;
+			for ( const QJsonValue& index : value.toArray() ) face.push_back( index.toInt() );
+			for ( std::size_t i = 0; i < face.size(); ++i ){
+				const unsigned int a = face[i], b = face[( i + 1 ) % face.size()];
+				if ( a != b ) uniqueEdges.emplace( std::min( a, b ), std::max( a, b ) );
+			}
+			faces.push_back( std::move( face ) );
+		}
+		edges.assign( uniqueEdges.begin(), uniqueEdges.end() );
+		m_label = mesh.value( "label" ).toString( "Polygon mesh" ).toUtf8();
+		buildRender();
+		notifyTopology();
+		m_boundsChanged();
+		SceneChangeNotify();
+	}
+	void buildRender(){
+		releaseMaterials();
+		const QJsonObject mesh = m_payload.value( "mesh" ).toObject();
+		const QJsonArray materials = m_payload.value( "materials" ).toArray();
+		const QJsonArray faceMaterials = mesh.value( "faceMaterials" ).toArray();
+		const QJsonArray texcoords = mesh.value( "faceTexcoords" ).toArray();
+		const QJsonObject faceUv = mesh.value( "faceUv" ).toObject();
+		const QMatrix4x4 toPrime = basis( 16 ).inverted();
+		std::map<int, MaterialGroup*> groups;
+		triangles.clear(); triangles.resize( faces.size() );
+		m_bounds = AABB();
+		m_wire.vertices.clear();
+		m_points.clear();
+		for ( const Vector3& v : vertices ){
+			aabb_extend_by_point_safe( m_bounds, v );
+			m_points.push_back( PointVertex( Vertex3f( v.x(), v.y(), v.z() ), Colour4b( 0, 220, 255, 255 ) ) );
+		}
+		for ( const auto& edge : edges ){
+			m_wire.vertices.push_back( vertices[edge.first] ); m_wire.vertices.push_back( vertices[edge.second] );
+		}
+		for ( std::size_t f = 0; f < faces.size(); ++f ){
+			const auto& face = faces[f];
+			const int material = f < std::size_t( faceMaterials.size() ) ? faceMaterials[int( f )].toInt() : mesh.value( "material" ).toInt();
+			const QJsonObject description = material < materials.size() ? materials[material].toObject() : QJsonObject();
+			MaterialGroup*& group = groups[material];
+			if ( group == nullptr ){
+				QString name = description.value( "name" ).toString();
+				if ( name.isEmpty() ) name = QString::fromLatin1( texdef_name_default() );
+				else if ( !name.startsWith( "textures/" ) && !name.startsWith( '$' ) ) name.prepend( "textures/" );
+				m_materials.emplace_back( new MaterialGroup( name.toStdString() ) ); group = m_materials.back().get();
+				if ( m_instances != 0 ) group->shader->incrementUsed();
+			}
+			const double width = description.value( "width" ).toDouble( 64 ), height = description.value( "height" ).toDouble( 64 );
+			for ( std::size_t c = 0; c < face.size(); ++c ){
+				group->solid.boundary.push_back( vertices[face[c]] );
+				group->solid.boundary.push_back( vertices[face[( c + 1 ) % face.size()]] );
+			}
+			const double texScale = description.value( "texScale" ).toDouble( 16 );
+			QJsonObject projection = faceUv.value( QString::number( f ) ).toObject();
+			if ( projection.isEmpty() ) projection = mesh.value( "uv" ).toObject();
+			const QJsonArray uvScale = projection.value( "scale" ).toArray(), uvOffset = projection.value( "offset" ).toArray();
+			const double scaleU = uvScale.size() == 2 ? uvScale[0].toDouble() : 1, scaleV = uvScale.size() == 2 ? uvScale[1].toDouble() : 1;
+			const double offsetU = uvOffset.size() == 2 ? uvOffset[0].toDouble() : 0, offsetV = uvOffset.size() == 2 ? uvOffset[1].toDouble() : 0;
+			const double angle = projection.value( "rotation" ).toDouble() * 3.14159265358979323846 / 180;
+			const QJsonArray explicitUv = f < std::size_t( texcoords.size() ) ? texcoords[int( f )].toArray() : QJsonArray();
+			QVector3D normal;
+			const QVector3D first = toPrime.map( qtVector( vertices[face[0]] ) );
+			std::vector<QVector3D> primePoints;
+			for ( unsigned int v : face ) primePoints.push_back( toPrime.map( qtVector( vertices[v] ) ) );
+			for ( std::size_t i = 0; i < face.size(); ++i ) normal += QVector3D::crossProduct( primePoints[i] - first, primePoints[( i + 1 ) % face.size()] - first );
+			normal.normalize();
+			QVector3D u = ( primePoints[1] - first ).normalized();
+			const QVector3D v = QVector3D::crossProduct( normal, u );
+			std::vector<TexCoord2f> cornerUv;
+			for ( std::size_t c = 0; c < face.size(); ++c ){
+				double s, t;
+				if ( explicitUv.size() == int( face.size() ) && explicitUv[int( c )].isArray() ){
+					const QJsonArray coord = explicitUv[int( c )].toArray(); s = coord[0].toDouble(); t = coord[1].toDouble();
+				}
+				else {
+					const QVector3D delta = primePoints[c] - first;
+					const double x = QVector3D::dotProduct( delta, u ) * texScale * scaleU, y = QVector3D::dotProduct( delta, v ) * texScale * scaleV;
+					s = x * std::cos( angle ) - y * std::sin( angle ) + offsetU;
+					t = x * std::sin( angle ) + y * std::cos( angle ) + offsetV;
+				}
+				cornerUv.emplace_back( s / width, t / height );
+			}
+			for ( const Triangle& triangle : triangulate( face, vertices ) ){
+				triangles[f].push_back( face[triangle[0]] ); triangles[f].push_back( face[triangle[1]] ); triangles[f].push_back( face[triangle[2]] );
+				const QVector3D a = qtVector( vertices[face[triangle[0]]] ), b = qtVector( vertices[face[triangle[1]]] ), c = qtVector( vertices[face[triangle[2]]] );
+				const QVector3D n = QVector3D::crossProduct( b - a, c - a ).normalized();
+				for ( unsigned int corner : triangle ){
+					const Vector3& p = vertices[face[corner]];
+					group->solid.vertices.emplace_back( Vertex3f( p.x(), p.y(), p.z() ), Normal3f( n.x(), n.y(), n.z() ), cornerUv[corner] );
+				}
+			}
+		}
+	}
