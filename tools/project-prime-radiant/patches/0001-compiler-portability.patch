+#if defined( __APPLE__ )
+		// QOpenGLWidget calls initializeGL before allocating its draw FBO.
+		// Cocoa shader validation requires a complete current framebuffer.
+		auto *functions = widget.context()->functions();
+		const bool separateFramebuffers = QOpenGLFramebufferObject::hasOpenGLFramebufferBlit();
+		GLint drawFramebuffer, readFramebuffer, renderbuffer, activeTexture, texture;
+		GLint viewport[4];
