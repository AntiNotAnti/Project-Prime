+// Only Project Prime's geometry workspace needs one persistent identity per
+// primitive. Gather references before changing the graph, then keep the same
+// brush/patch nodes so authored surfaces and UVs remain untouched.
+class PrimeGeometrySaveCollector : public scene::Graph::Walker
+{
+public:
+	struct Primitive {
+		NodeSmartReference node;
+		scene::Path path;
+	};
+	mutable std::vector<Primitive> worldPrimitives;
+	mutable std::vector<NodeSmartReference> plainGroups;
+	mutable bool valid = true;
+	bool pre( const scene::Path& path, scene::Instance& instance ) const override {
+		Entity* entity = Node_getEntity( path.top() );
+		if ( !entity ) return true;
+		const bool world = string_equal( entity->getClassName(), "worldspawn" );
+		const bool group = string_equal( entity->getClassName(), "func_group" );
+		if ( !world && !group ) return false;
+		struct Children : scene::Traversable::Walker {
+			mutable std::vector<NodeSmartReference> nodes;
+			bool pre( scene::Node& node ) const override { nodes.emplace_back( node ); return false; }
+		} children;
+		Node_getTraversable( path.top() )->traverse( children );
+		if ( world ) {
+			for ( const auto& child : children.nodes ) {
+				if ( !Node_isPrimitive( child ) ) { valid = false; continue; }
+				scene::Path childPath( path );
+				childPath.push( makeReference( child.get() ) );
+				worldPrimitives.push_back( { child, childPath } );
+			}
+		}
+		else if ( !children.nodes.empty() ) {
+			if ( children.nodes.size() != 1 || !Node_isPrimitive( children.nodes.front() ) )
+				valid = false; // never silently split a group with existing identity/intent
+			else if ( !string_equal( entity->getKeyValue( "prime_geometry" ), "1" ) ) {
+				struct PlainGroup : Entity::Visitor {
+					bool plain = true;
+					void visit( const char* key, const char* value ) override {
+						if ( !string_equal( key, "classname" ) ) plain = false;
+					}
+				} test;
+				entity->forEachKeyValue( test );
+				if ( test.plain ) plainGroups.emplace_back( path.top().get() );
+				else valid = false;
+			}
+		}
+		return false;
+	}
+};
+
+void PrimeGeometry_setIdentity( scene::Node& group, bool patch ){
+	Entity& entity = *Node_getEntity( group );
+	entity.setKeyValue( "prime_geometry", "1" );
+	const auto id = QUuid::createUuid().toString( QUuid::WithoutBraces ).toLatin1();
+	entity.setKeyValue( "prime_id", id.constData() );
+	if ( patch ) {
+		entity.setKeyValue( "prime_patch_solid", "true" );
+		entity.setKeyValue( "prime_patch_tessellation", "3" ); // QuakePatchDef2 importer default
+	}
+}
+
+bool PrimeGeometry_normaliseForSave(){
+	if ( !g_pGameDescription || !string_equal( g_pGameDescription->mGameFile.c_str(), "projectprime.game" ) )
+		return true;
+	PrimeGeometrySaveCollector plan;
+	GlobalSceneGraph().traverse( plan );
+	if ( !plan.valid ) {
+		qt_MessageBox( MainFrame_getWindow(),
+			"Prime geometry groups must contain exactly one brush or patch. Ungroup multiple primitives before saving. "
+			"Groups with unsupported properties must be reconciled in Studio; no source was saved.",
+			"Project Prime geometry identities", EMessageBoxType::Error );
+		return false;
+	}
+	if ( plan.worldPrimitives.empty() && plan.plainGroups.empty() ) return true;
+	{
+		UndoableCommand undo( "assignPrimeGeometryIdentities" );
+		for ( const auto& group : plan.plainGroups ) {
+			struct PatchChild : scene::Traversable::Walker {
+				mutable bool patch = false;
+				bool pre( scene::Node& node ) const override { patch = Node_isPatch( node ); return false; }
+			} child;
+			Node_getTraversable( group )->traverse( child );
+			PrimeGeometry_setIdentity( group, child.patch );
+		}
+		for ( const auto& primitive : plan.worldPrimitives ) {
+			scene::Instance& original = findInstance( primitive.path );
+			const bool selected = Instance_isSelected( original );
+			NodeSmartReference group( GlobalEntityCreator().createEntity( GlobalEntityClassManager().findOrInsert( "func_group", true ) ) );
+			group.get().m_layer = primitive.node.get().m_layer;
+			Node_getTraversable( GlobalSceneGraph().root() )->insert( group );
+			PrimeGeometry_setIdentity( group, Node_isPatch( primitive.node ) );
+			Node_getTraversable( group )->insert( primitive.node );
+			scene::Path newPath( makeReference( GlobalSceneGraph().root() ) );
+			newPath.push( makeReference( group.get() ) );
+			newPath.push( makeReference( primitive.node.get() ) );
+			scene::Instance& replacement = findInstance( newPath );
+			// Copy component selection while both instances still exist.
+			if ( BrushInstance* oldBrush = Instance_getBrush( original ) ) {
+				std::vector<FaceInstance*> faces;
+				Brush_ForEachFaceInstance( *oldBrush, [&]( FaceInstance& face ){ faces.push_back( &face ); } );
+				std::size_t index = 0;
+				Brush_ForEachFaceInstance( *Instance_getBrush( replacement ), [&]( FaceInstance& face ){
