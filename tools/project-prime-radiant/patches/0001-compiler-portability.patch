+void createMesh( bool cube ){
+	if( g_running ) return;
+	QJsonObject payload = primitivePayload( cube ), mesh = payload.value( "mesh" ).toObject();
+	QString problem;
+	if( !PrimeMesh_validatePayload( payload, &problem ) ) { error( problem ); return; }
+	NodeSmartReference node( PrimeMesh_createNode() );
+	if( !PrimeMesh_setPayload( node, payload ) ) return;
+	NodeSmartReference container( GlobalEntityCreator().createEntity( GlobalEntityClassManager().findOrInsert( "func_group", true ) ) );
+	Entity* entity = Node_getEntity( container ); entity->setKeyValue( "prime_geometry", "1" ); entity->setKeyValue( "prime_id", mesh.value( "id" ).toString().toUtf8().constData() );
+	Node_getTraversable( container )->insert( node );
+	UndoableCommand undo( cube ? "primeMesh create cube" : "primeMesh create plane" );
+	GlobalSelectionSystem().setSelectedAllComponents( false ); GlobalSelectionSystem().setSelectedAll( false );
+	Node_getTraversable( GlobalSceneGraph().root() )->insert( container );
+	scene::Path path( makeReference( GlobalSceneGraph().root() ) ); path.push( makeReference( container.get() ) ); path.push( makeReference( node.get() ) );
+	if( auto* instance = GlobalSceneGraph().find( path ) ) Instance_setSelected( *instance, true );
+	GlobalSelectionSystem().SetMode( SelectionSystem::ePrimitive ); SceneChangeNotify();
+}
