+QJsonObject brushPayload( const scene::Path& path, scene::Instance& instance, BrushInstance& brush, bool surfaceOnly ){
+	QJsonObject payload = newPayload( surfaceOnly ? "Brush snap surface" : "Converted Brush", "common/caulk" ), mesh = payload.value( "mesh" ).toObject();
+	QJsonObject transform = mesh.value( "transform" ).toObject(); transform["position"] = QJsonArray{ 0, 0, 0 }; mesh["transform"] = transform;
+	if( !surfaceOnly ) if( Entity* parent = Node_getEntity( path.parent() ) ){
+		const QUuid id( QString::fromUtf8( parent->getKeyValue( "prime_id" ) ) ); if( !id.isNull() ) mesh["id"] = id.toString( QUuid::WithoutBraces );
+	}
+	QJsonArray vertices, faces, materials, faceMaterials, uv;
+	std::map<std::tuple<qint64, qint64, qint64>, int> shared;
+	brush.getBrush().evaluateBRep();
+	Brush_forEachFace( brush.getBrush(), [&]( Face& face ){
+		const Winding& winding = face.getWinding(); if( winding.numpoints < 3 ) return;
+		int material = 0;
+		if( !surfaceOnly ){
+			QString shader = QString::fromUtf8( face.GetShader() ); if( shader.startsWith( "textures/" ) ) shader.remove( 0, 9 ); material = -1;
+			for( int i = 0; i < materials.size(); ++i ) if( materials[i].toObject().value( "name" ).toString() == shader ) { material = i; break; }
+			if( material < 0 ) { material = materials.size(); materials.append( QJsonObject{ { "name", shader }, { "texScale", 16 }, { "width", int( face.getShader().width() ) }, { "height", int( face.getShader().height() ) } } ); }
+		}
+		QJsonArray polygon, corners; std::vector<Vector3> polygonPoints;
+		for( const WindingVertex& vertex : winding ){
+			const Vector3 point = matrix4_transformed_point( instance.localToWorld(), static_cast<Vector3>( vertex.vertex ) );
+			const auto key = std::make_tuple( qint64( std::llround( point[0] * 100000 ) ), qint64( std::llround( point[1] * 100000 ) ), qint64( std::llround( point[2] * 100000 ) ) );
+			auto found = shared.find( key ); int index;
+			if( found == shared.end() ) { index = vertices.size(); shared.emplace( key, index ); vertices.append( QJsonArray{ point[0] / 16.0, point[2] / 16.0, -point[1] / 16.0 } ); }
+			else index = found->second;
+			polygon.append( index );
+			if( surfaceOnly ) polygonPoints.push_back( point );
+			if( !surfaceOnly ) corners.append( QJsonArray{ vertex.texcoord[0] * face.getShader().width(), vertex.texcoord[1] * face.getShader().height() } );
+		}
+		if( surfaceOnly ){
+			// Brush faces are convex, so the fan is exact and also handles source
+			// windings with more corners than an authored Prime polygon permits.
+			for( int corner = 1; corner + 1 < polygon.size(); ++corner )
+				if( polygon[0] != polygon[corner] && polygon[corner] != polygon[corner + 1] && polygon[0] != polygon[corner + 1]
+				 && vector3_length_squared( vector3_cross( polygonPoints[size_t( corner )] - polygonPoints[0], polygonPoints[size_t( corner + 1 )] - polygonPoints[0] ) ) > 1e-6 )
+					faces.append( QJsonArray{ polygon[0], polygon[corner], polygon[corner + 1] } );
+		}
+		else { faces.append( polygon ); uv.append( corners ); faceMaterials.append( material ); }
+	} );
+	mesh["vertices"] = vertices; mesh["faces"] = faces; mesh["faceTexcoords"] = uv; mesh["faceMaterials"] = faceMaterials;
+	payload["mesh"] = mesh; if( !surfaceOnly ) payload["materials"] = materials;
+	return payload;
+}
+
+QJsonObject patchSurface( const scene::Path& path, scene::Instance& instance, Patch& patch, QString& problem ){
+	const size_t width = patch.getWidth(), height = patch.getHeight();
+	if( width < 3 || height < 3 || width % 2 == 0 || height % 2 == 0 ) return {};
+	int subdivisions = 3;
+	if( Entity* parent = Node_getEntity( path.parent() ) ){
+		if( string_equal_nocase( parent->getKeyValue( "prime_patch_solid" ), "false" ) ) return {};
+		bool ok = false; const int value = QString::fromUtf8( parent->getKeyValue( "prime_patch_tessellation" ) ).toInt( &ok );
+		if( ok ) subdivisions = std::clamp( value, 1, 64 );
+	}
+	const size_t stepsX = patch.m_patchDef3 ? std::clamp( patch.m_subdivisions_x, size_t( 1 ), size_t( 64 ) ) : size_t( subdivisions );
+	const size_t stepsY = patch.m_patchDef3 ? std::clamp( patch.m_subdivisions_y, size_t( 1 ), size_t( 64 ) ) : size_t( subdivisions );
+	const size_t columns = ( width - 1 ) / 2 * stepsX + 1, rows = ( height - 1 ) / 2 * stepsY + 1;
+	if( columns * rows > 65535 || ( columns - 1 ) * ( rows - 1 ) * 2 > 65535 ) { problem = "A patch exceeds the bounded snapping surface budget. Reduce its subdivisions before snapping."; return {}; }
+	patch.evaluateTransform(); const auto& controls = patch.getControlPointsTransformed();
+	QJsonObject payload = newPayload( "Patch snap surface", "common/caulk" ), mesh = payload.value( "mesh" ).toObject();
+	QJsonObject transform = mesh.value( "transform" ).toObject(); transform["position"] = QJsonArray{ 0, 0, 0 }; mesh["transform"] = transform;
+	QJsonArray vertices, faces; std::vector<Vector3> points;
+	for( size_t row = 0; row < rows; ++row ) for( size_t column = 0; column < columns; ++column ){
+		const size_t blockX = std::min( column / stepsX, ( width - 3 ) / 2 ), blockY = std::min( row / stepsY, ( height - 3 ) / 2 );
+		const double u = double( column - blockX * stepsX ) / stepsX, v = double( row - blockY * stepsY ) / stepsY;
+		const double bx[3] = { ( 1 - u ) * ( 1 - u ), 2 * u * ( 1 - u ), u * u }, by[3] = { ( 1 - v ) * ( 1 - v ), 2 * v * ( 1 - v ), v * v };
+		Vector3 point( 0, 0, 0 );
+		for( size_t y = 0; y < 3; ++y ) for( size_t x = 0; x < 3; ++x ) point += controls[( blockY * 2 + y ) * width + blockX * 2 + x].m_vertex * float( bx[x] * by[y] );
+		point = matrix4_transformed_point( instance.localToWorld(), point ); points.push_back( point );
+		vertices.append( QJsonArray{ point[0] / 16.0, point[2] / 16.0, -point[1] / 16.0 } );
+	}
+	auto triangle = [&]( size_t a, size_t b, size_t c ){
+		if( vector3_length_squared( vector3_cross( points[b] - points[a], points[c] - points[a] ) ) > 1e-6 ) faces.append( QJsonArray{ int( a ), int( b ), int( c ) } );
+	};
+	for( size_t row = 0; row + 1 < rows; ++row ) for( size_t column = 0; column + 1 < columns; ++column ){
+		const size_t a = row * columns + column, b = a + 1, c = a + columns, d = c + 1; triangle( a, c, b ); triangle( b, c, d );
+	}
+	if( faces.isEmpty() ) return {};
+	mesh["vertices"] = vertices; mesh["faces"] = faces; return mesh;
+}
+
+std::vector<QJsonObject> nativeSurfaceContexts( QString& problem ){
+	class Surfaces final : public scene::Graph::Walker {
+	public:
+		mutable std::vector<QJsonObject> meshes;
+		mutable QString problem;
+		mutable size_t vertices = 0, faces = 0;
+		bool pre( const scene::Path& path, scene::Instance& instance ) const override {
+			if( !problem.isEmpty() || !path.top().get().visible() ) return false;
+			QJsonObject mesh;
+			if( BrushInstance* brush = Instance_getBrush( instance ) ) mesh = brushPayload( path, instance, *brush, true ).value( "mesh" ).toObject();
+			else if( PatchInstance* patch = Instance_getPatch( instance ) ) mesh = patchSurface( path, instance, patch->getPatch(), problem );
+			if( mesh.isEmpty() || mesh.value( "faces" ).toArray().isEmpty() ) return true;
+			vertices += size_t( mesh.value( "vertices" ).toArray().size() ); faces += size_t( mesh.value( "faces" ).toArray().size() );
+			if( meshes.size() >= 4096 || vertices > 262144 || faces > 262144 ) { problem = "Visible brush and patch surfaces exceed the bounded snapping context. Hide distant geometry before snapping."; return false; }
+			meshes.push_back( mesh ); return false;
+		}
+	} surfaces;
+	GlobalSceneGraph().traverse( surfaces ); problem = surfaces.problem; return surfaces.meshes;
+}
+
+QJsonObject primitivePayload( bool cube, const QString& material = {} ){
+	QJsonObject payload = newPayload( cube ? "Mesh Cube" : "Mesh Plane", material ), mesh = payload.value( "mesh" ).toObject();
+	if( cube ){
+		mesh["vertices"] = QJsonArray{ QJsonArray{ -1, -1, -1 }, QJsonArray{ 1, -1, -1 }, QJsonArray{ 1, 1, -1 }, QJsonArray{ -1, 1, -1 },
+			QJsonArray{ -1, -1, 1 }, QJsonArray{ 1, -1, 1 }, QJsonArray{ 1, 1, 1 }, QJsonArray{ -1, 1, 1 } };
+		mesh["faces"] = QJsonArray{ QJsonArray{ 0, 3, 2, 1 }, QJsonArray{ 4, 5, 6, 7 }, QJsonArray{ 0, 1, 5, 4 },
+			QJsonArray{ 3, 7, 6, 2 }, QJsonArray{ 0, 4, 7, 3 }, QJsonArray{ 1, 2, 6, 5 } };
+	}
+	else {
+		mesh["vertices"] = QJsonArray{ QJsonArray{ -1, 0, -1 }, QJsonArray{ 1, 0, -1 }, QJsonArray{ 1, 0, 1 }, QJsonArray{ -1, 0, 1 } };
+		mesh["faces"] = QJsonArray{ QJsonArray{ 0, 3, 2, 1 } };
+	}
+	payload["mesh"] = mesh;
+	return payload;
+}
