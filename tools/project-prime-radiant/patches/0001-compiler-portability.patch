+QJsonObject describeMaterial( const QString& name ){
+	const QByteArray shaderName = ( name.startsWith( '$' ) || name.startsWith( "textures/" ) ? name : "textures/" + name ).toUtf8();
+	const auto release = []( IShader* shader ){ if( shader ) shader->DecRef(); };
+	const std::unique_ptr<IShader, decltype( release )> shader( QERApp_Shader_ForName( shaderName.constData() ), release );
+	const qtexture_t* texture = shader ? shader->getTexture() : nullptr;
+	// Missing shaders use the editor's bitmap loader. Its placeholder dimensions
+	// do not describe the requested material's canonical texel coordinates.
+	const bool resolved = texture && texture->texture_number != 0 && texture->load == GlobalTexturesCache().defaultLoader()
+		&& texture->width > 0 && texture->height > 0;
+	return { { "name", name }, { "texScale", 16 }, { "width", resolved ? int( texture->width ) : 64 }, { "height", resolved ? int( texture->height ) : 64 } };
+}
+
+int materialIndex( QJsonObject& payload, const QString& name ){
+	QJsonArray materials = payload.value( "materials" ).toArray();
+	for( int i = 0; i < materials.size(); ++i ){
+		QString existing = materials[i].toObject().value( "name" ).toString(); if( existing.startsWith( "textures/" ) ) existing.remove( 0, 9 );
+		if( existing.compare( name, Qt::CaseInsensitive ) == 0 ) return i;
+	}
+	const int index = materials.size(); materials.append( describeMaterial( name ) ); payload["materials"] = materials; return index;
+}
