+	Collect( std::vector<Target>& targets, bool selectedOnly = true, bool includeHidden = false ) : m_targets( targets ), m_selectedOnly( selectedOnly ), m_includeHidden( includeHidden ) {}
+	bool pre( const scene::Path& path, scene::Instance& instance ) const override {
+		if( !m_includeHidden && !path.top().get().visible() ) return false;
+		if( Node_getPrimeMesh( path.top().get() ) != nullptr &&
+			( !m_selectedOnly || Instance_isSelected( instance ) || Instance_isSelectedComponents( instance ) ) )
+			m_targets.emplace_back( path.top().get(), path, instance );
+		return true;
+	}
+};
