+QJsonObject PrimeMesh_runSelfTests(){
+	SelfTestReport report;
+	LoadedMeshCount loaded( report );
+	GlobalSceneGraph().traverse( loaded );
+	const std::size_t loadedCounter = g_meshCount.get();
+	report.check( "native mesh counter matches loaded scene", loadedCounter == std::size_t( loaded.meshes ) );
+	auto result = [&](){
+		return QJsonObject{ { "schema", 1 }, { "success", report.success }, { "checkCount", report.checks.size() }, { "checks", report.checks },
+			{ "loadedMeshCount", loaded.meshes }, { "loadedVertices", double( loaded.vertices ) }, { "loadedFaces", double( loaded.faces ) }, { "loadedMeshes", loaded.summaries },
+			{ "scope", "Native parser, scene, selection API, transforms and undo; no GUI interaction or source-map save." } };
+	};
+	const QJsonObject fixture = selfTestPayload();
+	QString error;
+	if ( !PrimeMesh_validatePayload( fixture, &error ) ){
+		report.check( "fixture validates", false, error ); return result();
+	}
+	report.check( "fixture validates", true );
+	NodeSmartReference source( PrimeMesh_createNode() ), parsed( PrimeMesh_createNode() );
+	report.check( "payload setter", PrimeMesh_setPayload( source, fixture ) );
+	const QByteArray encoded = exportSelfTestNode( source );
+	report.check( "real tokenizer imports exported primitive", importSelfTestNode( parsed, encoded ) );
+	report.check( "opaque source fields and corner UVs survive", PrimeMesh_getPayload( parsed ) == fixture );
+	report.check( "no-op re-export is stable", exportSelfTestNode( parsed ) == encoded );
+	NodeSmartReference clone( NodeTypeCast<scene::Cloneable>::cast( source )->clone() );
+	report.check( "clone retains exact payload including subordinate source identity", PrimeMesh_getPayload( clone ) == fixture );
+	QJsonObject edited = fixture, mesh = edited.value( "mesh" ).toObject(); mesh.insert( "label", "Edited clone" ); edited.insert( "mesh", mesh );
+	PrimeMesh_setPayload( clone, edited );
+	report.check( "clone mutation is independent", PrimeMesh_getPayload( source ) == fixture && PrimeMesh_getPayload( clone ) == edited );
+	auto* geometry = static_cast<PrimeMeshGeometry*>( Node_getPrimeMesh( source ) );
