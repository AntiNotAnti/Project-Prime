+	if( !g_pGameDescription || ( !string_equal_nocase( g_pGameDescription->getKeyValue( "name" ), "Project Prime" )
+	 && !string_equal_nocase( g_pGameDescription->mGameFile.c_str(), "projectprime.game" ) ) ) return result;
+	GlobalSceneGraph().traverse( Collect( result, true, includeHidden ) );
+	return result;
