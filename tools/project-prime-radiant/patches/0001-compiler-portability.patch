+QJsonObject newPayload( const QString& label, QString material = {} ){
+	if( material.isEmpty() ) material = QString::fromUtf8( TextureBrowser_GetSelectedShader() );
+	if( material.startsWith( "textures/" ) ) material.remove( 0, 9 );
+	if( material.isEmpty() ) material = "common/caulk";
+	return { { "schema", 1 }, { "units", 16 },
+		{ "materials", QJsonArray{ describeMaterial( material ) } },
+		{ "mesh", QJsonObject{ { "kind", "mesh" }, { "id", QUuid::createUuid().toString( QUuid::WithoutBraces ) },
+			{ "label", label }, { "layer", "Architecture" }, { "material", 0 }, { "solid", true }, { "damaging", false },
+			{ "terrain", "Metal" }, { "shade", 1 }, { "hidden", false }, { "locked", false }, { "collisionOnly", false },
+			{ "slipperiness", 0 }, { "reflectBeams", false }, { "ignorePlayers", false }, { "ignoreBeams", false }, { "ignoreScan", false },
+			{ "transform", QJsonObject{ { "position", g_cursor }, { "scale", QJsonArray{ 1, 1, 1 } }, { "rotation", QJsonArray{ 0, 0, 0, 1 } } } },
+			{ "uv", QJsonObject{ { "scale", QJsonArray{ 1, 1 } }, { "offset", QJsonArray{ 0, 0 } }, { "rotation", 0 } } },
+			{ "faceUv", QJsonObject() }, { "faceMaterials", QJsonArray() }, { "faceTexcoords", QJsonArray() },
+			{ "vertices", QJsonArray() }, { "faces", QJsonArray() } } } };
+}
