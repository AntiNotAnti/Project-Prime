+QString workerPath(){
+	QDir application( QCoreApplication::applicationDirPath() );
+#if defined( Q_OS_MACOS ) || defined( Q_OS_MAC )
+	// Radiant.app/Contents/MacOS and Project Prime Studio.app share one parent.
+	application.cdUp(); application.cdUp(); application.cdUp();
+	return application.absoluteFilePath( "Project Prime Studio.app/Contents/MacOS/ProjectPrimeStudio" );
+#elif defined( Q_OS_WIN )
+	const QString direct = application.absoluteFilePath( "ProjectPrimeStudio.exe" );
+	return QFileInfo( direct ).isFile() ? direct : application.absoluteFilePath( "../Project Prime Studio/ProjectPrimeStudio.exe" );
+#else
+	const QString direct = application.absoluteFilePath( "ProjectPrimeStudio" );
+	return QFileInfo( direct ).isFile() ? direct : application.absoluteFilePath( "../Project Prime Studio/ProjectPrimeStudio" );
+#endif
+}
