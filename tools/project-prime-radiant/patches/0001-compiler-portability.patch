+QByteArray exportSelfTestNode( scene::Node& node ){
+	BufferOutputStream stream;
+	{ SimpleTokenWriter writer( stream ); NodeTypeCast<MapExporter>::cast( node )->exportTokens( writer ); }
+	return QByteArray( stream.data(), int( stream.size() ) );
+}
+bool importSelfTestNode( scene::Node& node, const QByteArray& bytes ){
+	BufferInputStream stream( bytes.constData(), bytes.size() );
+	ScriptTokeniser tokeniser( stream, false, true );
+	tokeniser.nextLine();
+	if ( !Tokeniser_parseToken( tokeniser, "{" ) ) return false;
+	tokeniser.nextLine();
+	if ( !Tokeniser_parseToken( tokeniser, "primeMeshDef" ) ) return false;
+	return NodeTypeCast<MapImporter>::cast( node )->importTokens( tokeniser );
+}
+QByteArray frameSelfTestJson( const QByteArray& json ){
+	const QByteArray encoded = json.toBase64();
+	QByteArray result = "{\nprimeMeshDef\n{\nversion 1\ndata " + QByteArray::number( ( encoded.size() + ChunkLength - 1 ) / ChunkLength ) + '\n';
+	for ( int i = 0; i < encoded.size(); i += ChunkLength ) result += '"' + encoded.mid( i, ChunkLength ) + "\"\n";
+	return result + "}\n}\n";
+}
+bool sameNativePositions( const std::vector<Vector3>& before, const std::vector<Vector3>& after, const Matrix4& matrix, const std::vector<bool>* mask = nullptr ){
+	if ( before.size() != after.size() ) return false;
+	for ( std::size_t i = 0; i < before.size(); ++i ){
+		const Vector3 expected = mask == nullptr || ( *mask )[i] ? matrix4_transformed_point( matrix, before[i] ) : before[i];
+		if ( vector3_length( after[i] - expected ) > .002 ) return false;
+	}
+	return true;
+}
