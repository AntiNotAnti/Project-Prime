+void PrimeMeshTools_projectTexture( const texdef_t& texdef, const Vector3* direction ){
+	edit( [=]( Target& target, QString& message ){
+		if( texdef.scale[0] == 0 || texdef.scale[1] == 0 ) { message = "UV projection scales must be nonzero."; return false; }
+		QJsonObject mesh = target.after.value( "mesh" ).toObject(); const QJsonArray vertices = mesh.value( "vertices" ).toArray(), faces = mesh.value( "faces" ).toArray();
+		QJsonObject transform = mesh.value( "transform" ).toObject(); const auto position = transform.value( "position" ).toArray(), scale = transform.value( "scale" ).toArray(), rotation = transform.value( "rotation" ).toArray();
+		QQuaternion quaternion( rotation[3].toDouble(), rotation[0].toDouble(), rotation[1].toDouble(), rotation[2].toDouble() );
+		const double units = target.after.value( "units" ).toDouble( 16 );
+		auto world = [&]( int index ){
+			auto point = vertices[index].toArray(); QVector3D value( point[0].toDouble() * scale[0].toDouble(), point[1].toDouble() * scale[1].toDouble(), point[2].toDouble() * scale[2].toDouble() );
+			value = quaternion.rotatedVector( value ) + QVector3D( position[0].toDouble(), position[1].toDouble(), position[2].toDouble() );
+			return QVector3D( value.x() * units, -value.z() * units, value.y() * units );
+		};
+		QJsonArray uv = mesh.value( "faceTexcoords" ).toArray(); while( uv.size() < faces.size() ) uv.append( QJsonValue::Null );
+		const double radians = texdef.rotate * 3.14159265358979323846 / 180, cosine = std::cos( radians ), sine = std::sin( radians );
+		for( const auto index : selectedFaces( target ) ){
+			const QJsonArray face = faces[index.toInt()].toArray();
+			QVector3D normal = direction ? QVector3D( ( *direction )[0], ( *direction )[1], ( *direction )[2] ) : QVector3D::crossProduct( world( face[1].toInt() ) - world( face[0].toInt() ), world( face[2].toInt() ) - world( face[0].toInt() ) );
+			normal = QVector3D( std::abs( normal.x() ), std::abs( normal.y() ), std::abs( normal.z() ) );
+			QVector3D u( 1, 0, 0 ), v( 0, -1, 0 );
+			if( normal.x() > normal.z() && normal.x() >= normal.y() ) { u = QVector3D( 0, 1, 0 ); v = QVector3D( 0, 0, -1 ); }
+			else if( normal.y() > normal.z() ) v = QVector3D( 0, 0, -1 );
+			QJsonArray corners;
+			for( const auto vertex : face ){
+				const QVector3D p = world( vertex.toInt() ); const double x = QVector3D::dotProduct( p, u ), y = QVector3D::dotProduct( p, v );
+				corners.append( QJsonArray{ ( x * cosine - y * sine ) / texdef.scale[0] + texdef.shift[0], ( x * sine + y * cosine ) / texdef.scale[1] + texdef.shift[1] } );
+			}
+			uv[index.toInt()] = corners;
+		}
+		mesh["faceTexcoords"] = uv; target.after["mesh"] = mesh; return true;
+	}, "primeMesh project texture" );
+}
+void PrimeMeshTools_projectTexture( const TextureProjection& projection, const Vector3& normal ){ PrimeMeshTools_projectTexture( projection.m_texdef, &normal ); }
