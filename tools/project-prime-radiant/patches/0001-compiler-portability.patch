+QJsonObject PrimeMeshTools_runSelfTests(){
+	QJsonArray checks;
+	bool success = true;
+	auto check = [&]( const QString& name, bool passed, const QString& detail = QString() ){
+		QJsonObject entry{ { "name", name }, { "passed", passed } };
+		if( !detail.isEmpty() ) entry["detail"] = detail;
+		checks.append( entry ); success = success && passed;
+	};
+	auto currentMapState = [](){
+		class Snapshot final : public scene::Graph::Walker {
+		public:
+			mutable QCryptographicHash hash{ QCryptographicHash::Sha256 };
+			mutable int nodes = 0;
+			bool pre( const scene::Path& path, scene::Instance& instance ) const override {
+				++nodes;
+				QJsonObject state{ { "selected", Instance_isSelected( instance ) }, { "visible", path.top().get().visible() } };
+				if( Node_getPrimeMesh( path.top().get() ) ) state["selection"] = PrimeMesh_selection( instance );
+				if( Entity* entity = Node_getEntity( path.top() ) ){
+					struct Properties : Entity::Visitor {
+						QJsonObject values;
+						void visit( const char* key, const char* value ) override { values[QString::fromUtf8( key )] = QString::fromUtf8( value ); }
+					} properties;
+					entity->forEachKeyValue( properties ); state["entity"] = properties.values;
+				}
+				hash.addData( QJsonDocument( state ).toJson( QJsonDocument::Compact ) );
+				if( MapExporter* exporter = NodeTypeCast<MapExporter>::cast( path.top().get() ) ){
+					BufferOutputStream stream;
+					{ SimpleTokenWriter writer( stream ); exporter->exportTokens( writer ); }
+					hash.addData( stream.data(), int( stream.size() ) );
+				}
+				return true;
+			}
+		} snapshot;
+		GlobalSceneGraph().traverse( snapshot );
+		return QJsonObject{ { "name", QString::fromUtf8( Map_Name( g_map ) ) }, { "modified", Map_Modified( g_map ) },
+			{ "undoSize", double( GlobalUndoSystem().size() ) }, { "nodes", snapshot.nodes },
+			{ "sceneSha256", QString::fromLatin1( snapshot.hash.result().toHex() ) },
+			{ "selected", double( GlobalSelectionSystem().countSelected() ) }, { "selectedComponents", double( GlobalSelectionSystem().countSelectedComponents() ) } };
+	};
+	const QJsonObject mapBefore = currentMapState();
+	QJsonObject lifecycle;
+	if( g_running ) check( "worker command guard is available", false, "Another mesh worker command is running." );
+	else {
+		struct Guard { Guard(){ g_running = true; } ~Guard(){ g_running = false; } } guard;
+		// Optional integration fixture supplied by the self-test launcher: a real
+		// 32x32 texture in the configured native VFS, never a fabricated shader.
+		QString textureFixture = QString::fromUtf8( qgetenv( "PRIME_MESH_TEST_SHADER" ) );
+		if( textureFixture.startsWith( "textures/" ) ) textureFixture.remove( 0, 9 );
+		QJsonObject texturePlane;
+		if( !textureFixture.isEmpty() ){
+			auto has32 = []( const QJsonObject& material ){ return material.value( "width" ).toInt() == 32 && material.value( "height" ).toInt() == 32; };
+			texturePlane = primitivePayload( false, textureFixture );
+			const QJsonObject textureCube = primitivePayload( true, textureFixture );
+			check( "real native 32x32 shader dimensions reach Create Plane and Cube", has32( texturePlane.value( "materials" ).toArray()[0].toObject() )
+				&& has32( textureCube.value( "materials" ).toArray()[0].toObject() ), textureFixture );
+			QJsonObject assignment = primitivePayload( false, "common/caulk" );
+			const int added = materialIndex( assignment, textureFixture );
+			check( "new shader assignment acquires real native 32x32 dimensions", added == 1 && has32( assignment.value( "materials" ).toArray()[added].toObject() ) );
+			QJsonArray authoritative = assignment.value( "materials" ).toArray(); QJsonObject retained = authoritative[added].toObject();
+			retained["width"] = 128; retained["height"] = 64; retained["texScale"] = 8; authoritative[added] = retained; assignment["materials"] = authoritative;
+			check( "existing payload material dimensions and density remain authoritative", materialIndex( assignment, textureFixture.toUpper() ) == added
+				&& assignment.value( "materials" ).toArray() == authoritative );
+		}
+		QJsonObject fixture = primitivePayload( true, "common/caulk" ), mesh = fixture.value( "mesh" ).toObject();
+		const QString identity = "c051e802-b9c8-49a9-89ee-d44e361924fe";
+		mesh["id"] = identity;
+		QJsonObject transform = mesh.value( "transform" ).toObject(); transform["position"] = QJsonArray{ 0, 0, 0 }; mesh["transform"] = transform;
+		mesh["faceTexcoords"] = QJsonArray{ QJsonArray{ QJsonArray{ 0, 0 }, QJsonArray{ 32, 0 }, QJsonArray{ 32, 32 }, QJsonArray{ 0, 32 } } };
+		fixture["mesh"] = mesh;
+		// These interchange fields are opaque to the modeling boundary. Their
+		// deliberately identifiable values must survive without interpretation.
+		fixture["originalGeometry"] = QJsonObject{ { "kind", "box" }, { "id", identity }, { "label", "Native worker provenance fixture" } };
+		fixture["originalMeshSha256"] = QString( 64, QChar( 'a' ) );
+		QString message;
+		const bool fixtureValid = PrimeMesh_validatePayload( fixture, &message );
+		check( "canonical cube fixture validates", fixtureValid, fixtureValid ? QString() : message );
+		QJsonObject recovered = fixture;
+		recovered["originalLegacyBrush"] = QJsonObject{ { "id", identity }, { "label", "Legacy recovery fixture" } };
+		recovered["reference"] = true;
+		const QString newIdentity = "73a6055d-b3a8-4819-86bb-4df759148b6d";
+		const QJsonObject newObject = newObjectPayload( recovered, newIdentity );
+		check( "new objects discard every recovery channel and preserve reference protection", !newObject.contains( "originalGeometry" )
+			&& !newObject.contains( "originalMeshSha256" ) && !newObject.contains( "originalLegacyBrush" ) && newObject.value( "reference" ).toBool()
+			&& newObject.value( "mesh" ).toObject().value( "id" ).toString() == newIdentity && newObject.value( "materials" ) == fixture.value( "materials" )
+			&& recovered.contains( "originalLegacyBrush" ) && recovered.value( "mesh" ).toObject().value( "id" ).toString() == identity );
+		if( fixtureValid ){
+			QJsonObject request{ { "schema", 1 }, { "operation", "uvTransform" }, { "payload", fixture }, { "mode", "Face" },
+				{ "selection", QJsonObject{ { "faces", QJsonArray{ 0 } }, { "edges", QJsonArray() }, { "vertices", QJsonArray() } } } };
+			QJsonObject response;
+			QProgressDialog progress( "Checking bundled mesh worker…", "Cancel", 0, 0, MainFrame_getWindow() );
+			progress.setWindowModality( Qt::ApplicationModal ); progress.setMinimumDuration( 0 ); progress.show();
+			const bool roundtrip = callWorker( request, response, progress, message, &lifecycle );
+			const QJsonObject returned = response.value( "payload" ).toObject();
+			QString validation;
+			check( "fixed sibling QProcess round trip and normal reaping", roundtrip && lifecycle.value( "started" ).toBool() && lifecycle.value( "reaped" ).toBool()
+				&& PrimeMesh_validatePayload( returned, &validation ), roundtrip ? validation : message );
+			check( "opaque interchange provenance survives worker boundary", roundtrip && returned.value( "originalGeometry" ) == fixture.value( "originalGeometry" )
+				&& returned.value( "originalMeshSha256" ) == fixture.value( "originalMeshSha256" ) );
+			if( !texturePlane.isEmpty() ){
+				QJsonObject fitRequest = request; fitRequest["operation"] = "uvFit"; fitRequest["payload"] = texturePlane;
+				QJsonObject fitted; QString fitMessage;
+				const bool fit = callWorker( fitRequest, fitted, progress, fitMessage );
+				const QJsonArray corners = fitted.value( "payload" ).toObject().value( "mesh" ).toObject().value( "faceTexcoords" ).toArray();
+				double minU = 1e100, minV = 1e100, maxU = -1e100, maxV = -1e100;
+				if( !corners.isEmpty() ) for( const QJsonValue& corner : corners[0].toArray() ){
+					const QJsonArray uv = corner.toArray(); if( uv.size() != 2 ) continue;
+					minU = std::min( minU, uv[0].toDouble() ); maxU = std::max( maxU, uv[0].toDouble() );
+					minV = std::min( minV, uv[1].toDouble() ); maxV = std::max( maxV, uv[1].toDouble() );
+				}
+				check( "canonical worker fits one real 32x32 texture repeat in 32 texels", fit && std::abs( maxU - minU - 32 ) < 1e-5
+					&& std::abs( maxV - minV - 32 ) < 1e-5, fitMessage );
+			}
+			request["operation"] = "Extrude region"; request["amount"] = .5;
+			response = QJsonObject(); message.clear();
+			const bool extruded = callWorker( request, response, progress, message );
+			const QJsonObject result = response.value( "payload" ).toObject(), resultMesh = result.value( "mesh" ).toObject();
+			const int vertices = resultMesh.value( "vertices" ).toArray().size(), faces = resultMesh.value( "faces" ).toArray().size();
+			bool bounded = response.value( "selection" ).isObject();
+			const QJsonObject selection = response.value( "selection" ).toObject();
+			auto boundedIndex = []( const QJsonValue& value, int count ){
+				return value.isDouble() && value.toDouble() == std::floor( value.toDouble() ) && value.toDouble() >= 0 && value.toDouble() < count;
+			};
+			for( const auto& channel : { std::make_pair( "faces", faces ), std::make_pair( "vertices", vertices ) } ){
+				const QJsonValue list = selection.value( channel.first ); bounded = bounded && list.isArray() && list.toArray().size() <= channel.second;
+				for( const auto index : list.toArray() ) bounded = bounded && boundedIndex( index, channel.second );
+			}
+			bounded = bounded && selection.value( "edges" ).isArray() && selection.value( "edges" ).toArray().size() <= 1048576;
+			for( const auto value : selection.value( "edges" ).toArray() ){
+				const auto edge = value.toArray(); bounded = bounded && edge.size() == 2;
+				if( edge.size() == 2 ) bounded = bounded && boundedIndex( edge[0], vertices ) && boundedIndex( edge[1], vertices ) && edge[0] != edge[1];
+			}
+			validation.clear();
+			check( "canonical extrude changes original topology with bounded selection", extruded && vertices > 8 && faces > 6 && bounded
+				&& PrimeMesh_validatePayload( result, &validation ), extruded ? validation : message );
+			request["selection"] = QJsonObject{ { "faces", QJsonArray{ 999999 } } };
+			response = QJsonObject(); message.clear();
+			const bool malformedAccepted = callWorker( request, response, progress, message );
+			check( "malformed selection returns structured rejection", !malformedAccepted && response.value( "schema" ).toInt() == 1
+				&& response.value( "success" ).isBool() && !response.value( "success" ).toBool() && !response.value( "error" ).toString().isEmpty(), message );
+			progress.hide();
+			QProgressDialog canceled( "Checking worker cancellation…", "Cancel", 0, 0, MainFrame_getWindow() ); canceled.cancel();
+			QJsonObject cancellation; response = QJsonObject(); message.clear();
+			const bool canceledAccepted = callWorker( request, response, canceled, message, &cancellation );
+			check( "cancellation kills and reaps the worker within its bound", !canceledAccepted && cancellation.value( "reaped" ).toBool()
+				&& cancellation.value( "elapsedMs" ).toDouble() < 5000 && message == "Mesh operation canceled.", message );
+			lifecycle["cancellation"] = cancellation;
+		}
+	}
+	const QJsonObject mapAfter = currentMapState();
+	const bool unchanged = mapBefore == mapAfter;
+	check( "no current map, selection or undo changes", unchanged );
+	return { { "schema", 1 }, { "success", success }, { "checkCount", checks.size() }, { "checks", checks },
+		{ "worker", lifecycle }, { "noCurrentMapChanges", unchanged }, { "before", mapBefore }, { "after", mapAfter },
+		{ "scope", "Actual fixed sibling QProcess boundary; isolated fixture requests only, no scene insertion or source save." } };
+}
