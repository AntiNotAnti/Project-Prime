+class PrimeMeshInstance final : public scene::Instance, public Selectable, public Renderable,
+	public SelectionTestable, public ComponentSelectionTestable, public ComponentEditable,
+	public ComponentSnappable, public LightCullable
+{
+	class TypeCasts
+	{
+		InstanceTypeCastTable m_casts;
+	public:
+		TypeCasts(){
+			InstanceStaticCast<PrimeMeshInstance, Selectable>::install( m_casts );
+			InstanceContainedCast<PrimeMeshInstance, Bounded>::install( m_casts );
+			InstanceContainedCast<PrimeMeshInstance, Cullable>::install( m_casts );
+			InstanceContainedCast<PrimeMeshInstance, Transformable>::install( m_casts );
+			InstanceStaticCast<PrimeMeshInstance, Renderable>::install( m_casts );
+			InstanceStaticCast<PrimeMeshInstance, SelectionTestable>::install( m_casts );
+			InstanceStaticCast<PrimeMeshInstance, ComponentSelectionTestable>::install( m_casts );
+			InstanceStaticCast<PrimeMeshInstance, ComponentEditable>::install( m_casts );
+			InstanceStaticCast<PrimeMeshInstance, ComponentSnappable>::install( m_casts );
+			InstanceIdentityCast<PrimeMeshInstance>::install( m_casts );
+		}
+		InstanceTypeCastTable& get(){ return m_casts; }
+	};
+	typedef LazyStatic<TypeCasts> StaticTypeCasts;
+	using Components = std::vector<std::unique_ptr<ObservedSelectable>>;
+	PrimeMeshGeometry& m_mesh;
+	ObservedSelectable m_selectable;
+	Components m_vertices, m_edges, m_faces;
+	TransformModifier m_transform;
+	const LightList* m_lightList;
+	Shader* m_selectedShader;
+	mutable AABB m_componentBounds;
+	mutable RenderablePointVector m_selectedPoints;
+	mutable RenderablePointVector m_componentPoints;
+	mutable LineRenderable m_selectedLines;
+	void sizeComponents( Components& components, std::size_t size ){
+		if ( components.size() == size ) return;
+		components.clear(); components.reserve( size );
+		for ( std::size_t i = 0; i < size; ++i ) components.emplace_back( new ObservedSelectable( SelectedChangedComponentCaller( *this ) ) );
+	}
+	static bool any( const Components& values ){
+		return std::any_of( values.begin(), values.end(), []( const std::unique_ptr<ObservedSelectable>& value ){ return value->isSelected(); } );
+	}
+	std::vector<bool> selectedVertexUnion() const {
+		std::vector<bool> selected( m_mesh.vertices.size(), false );
+		for ( std::size_t i = 0; i < m_vertices.size(); ++i ) if ( m_vertices[i]->isSelected() ) selected[i] = true;
+		for ( std::size_t i = 0; i < m_edges.size(); ++i ) if ( m_edges[i]->isSelected() ){
+			selected[m_mesh.edges[i].first] = true; selected[m_mesh.edges[i].second] = true;
+		}
+		for ( std::size_t i = 0; i < m_faces.size(); ++i ) if ( m_faces[i]->isSelected() )
+			for ( unsigned int vertex : m_mesh.faces[i] ) selected[vertex] = true;
+		return selected;
+	}
+	void renderSelected( Renderer& renderer ) const {
+		const std::vector<bool> selected = selectedVertexUnion();
+		m_selectedPoints.clear(); m_selectedLines.vertices.clear();
+		for ( std::size_t i = 0; i < selected.size(); ++i ) if ( selected[i] ){
+			const Vector3& p = m_mesh.vertices[i]; m_selectedPoints.push_back( PointVertex( Vertex3f( p.x(), p.y(), p.z() ), Colour4b( 0, 0, 255, 255 ) ) );
+		}
+		std::set<std::pair<unsigned int, unsigned int>> selectedEdges;
+		for ( std::size_t i = 0; i < m_edges.size(); ++i ) if ( m_edges[i]->isSelected() ) selectedEdges.insert( m_mesh.edges[i] );
+		for ( std::size_t i = 0; i < m_faces.size(); ++i ) if ( m_faces[i]->isSelected() ){
+			const auto& face = m_mesh.faces[i];
+			for ( std::size_t c = 0; c < face.size(); ++c ){
+				const unsigned int a = face[c], b = face[( c + 1 ) % face.size()]; selectedEdges.emplace( std::min( a, b ), std::max( a, b ) );
+			}
+		}
+		for ( const auto& edge : selectedEdges ){
+			m_selectedLines.vertices.push_back( m_mesh.vertices[edge.first] ); m_selectedLines.vertices.push_back( m_mesh.vertices[edge.second] );
+		}
+		if ( !m_selectedPoints.empty() ){
+			renderer.Highlight( Renderer::ePrimitive, false );
+			renderer.SetState( m_selectedShader, Renderer::eWireframeOnly ); renderer.SetState( m_selectedShader, Renderer::eFullMaterials );
+			renderer.addRenderable( m_selectedPoints, localToWorld() );
+			if ( !m_selectedLines.vertices.empty() ) renderer.addRenderable( m_selectedLines, localToWorld() );
+		}
+	}
+	void testEdge( std::size_t edge, SelectionTest& test, SelectionIntersection& intersection ) const {
+		const auto& pair = m_mesh.edges[edge];
+		const Vector3 points[2] = { m_mesh.vertices[pair.first], m_mesh.vertices[pair.second] };
+		test.TestLines( VertexPointer( points[0].data(), sizeof( Vector3 ) ), 2, intersection );
+	}
+	void testComponentFace( std::size_t face, SelectionTest& test, SelectionIntersection& intersection ) const {
+		if ( test.getVolume().fill() ) m_mesh.testFace( face, test, intersection );
+		else {
+			Vector3 center( 0, 0, 0 );
+			for ( unsigned int vertex : m_mesh.faces[face] ) center += m_mesh.vertices[vertex];
+			center /= float( m_mesh.faces[face].size() );
+			test.TestPoint( center, intersection );
+		}
+	}
+	Components& components( SelectionSystem::EComponentMode mode ){
+		if ( mode == SelectionSystem::eFace ) return m_faces;
+		if ( mode == SelectionSystem::eEdge ) return m_edges;
+		return m_vertices;
+	}
+public:
+	STRING_CONSTANT( Name, "PrimeMeshInstance" );
+	PrimeMeshInstance( const scene::Path& path, scene::Instance* parent, PrimeMeshGeometry& mesh ) :
+		Instance( path, parent, this, StaticTypeCasts::instance().get() ), m_mesh( mesh ),
+		m_selectable( SelectedChangedCaller( *this ) ),
+		m_transform( PrimeMeshGeometry::TransformChangedCaller( mesh ), ApplyTransformCaller( *this ) ),
+		m_lightList( &GlobalShaderCache().attach( *this ) ),
+		m_selectedShader( GlobalShaderCache().capture( "$SELPOINT" ) ), m_selectedPoints( GL_POINTS ), m_componentPoints( GL_POINTS ){
+		m_mesh.instanceAttach( path, this ); topologyChanged();
+		Instance::setTransformChangedCallback( LightsChangedCaller( *this ) );
+		g_meshCount.increment();
+	}
+	~PrimeMeshInstance(){
+		Instance::setTransformChangedCallback( Callback<void()>() );
+		// Component observers must be removed while this instance is still attached.
+		m_vertices.clear(); m_edges.clear(); m_faces.clear(); m_selectable.setSelected( false );
+		g_meshCount.decrement();
+		m_mesh.instanceDetach( this );
+		GlobalShaderCache().detach( *this ); GlobalShaderCache().release( "$SELPOINT" );
+	}
+	Bounded& get( NullType<Bounded> ){ return m_mesh; }
+	Cullable& get( NullType<Cullable> ){ return m_mesh; }
+	Transformable& get( NullType<Transformable> ){ return m_transform; }
+	void topologyChanged(){
+		sizeComponents( m_vertices, m_mesh.vertices.size() ); sizeComponents( m_edges, m_mesh.edges.size() ); sizeComponents( m_faces, m_mesh.faces.size() );
+		m_lightList->lightsChanged();
+	}
+	void lightsChanged(){ m_lightList->lightsChanged(); }
+	typedef MemberCaller<PrimeMeshInstance, void(), &PrimeMeshInstance::lightsChanged> LightsChangedCaller;
+	void selectedChanged( const Selectable& selectable ){
+		GlobalSelectionSystem().getObserver( SelectionSystem::ePrimitive )( selectable );
+		GlobalSelectionSystem().onSelectedChanged( *this, selectable ); Instance::selectedChanged();
+	}
+	typedef MemberCaller<PrimeMeshInstance, void(const Selectable&), &PrimeMeshInstance::selectedChanged> SelectedChangedCaller;
+	void selectedChangedComponent( const Selectable& selectable ){
+		GlobalSelectionSystem().getObserver( SelectionSystem::eComponent )( selectable );
+		GlobalSelectionSystem().onComponentSelection( *this, selectable );
+	}
+	typedef MemberCaller<PrimeMeshInstance, void(const Selectable&), &PrimeMeshInstance::selectedChangedComponent> SelectedChangedComponentCaller;
+	void setSelected( bool select ) override {
+		if ( select && !m_mesh.editable() ) return;
+		m_selectable.setSelected( select );
+		if ( !select && parent() ){
+			Selectable* selectable = Instance_getSelectable( *parent() );
+			if ( selectable && selectable->isSelected() ) selectable->setSelected( false );
+		}
+	}
+	bool isSelected() const override { return m_selectable.isSelected(); }
+	void renderSolid( Renderer& renderer, const VolumeTest& ) const override {
+		if ( !m_mesh.visible() ) return;
+		m_mesh.evaluateTransform(); renderer.setLights( *m_lightList );
+		renderer.Highlight( Renderer::ePrimitiveWire ); m_mesh.renderSolid( renderer, localToWorld() );
+		// The authored boundary is the wire overlay. Rendering triangle diagonals
+		// would expose temporary tessellation as editable topology.
+		renderSelected( renderer );
+	}
+	void renderWireframe( Renderer& renderer, const VolumeTest& ) const override {
+		if ( !m_mesh.visible() ) return;
+		m_mesh.renderWire( renderer, localToWorld() ); renderSelected( renderer );
+	}
+	void renderComponents( Renderer& renderer, const VolumeTest& ) const override {
+		if ( !m_mesh.visible() ) return;
+		m_mesh.renderWire( renderer, localToWorld() );
+		const auto mode = GlobalSelectionSystem().ComponentMode();
+		if ( mode == SelectionSystem::eVertex ) m_mesh.renderPoints( renderer, localToWorld() );
+		else {
+			m_componentPoints.clear();
+			if ( mode == SelectionSystem::eEdge ){
+				for ( const auto& edge : m_mesh.edges ){
+					const Vector3 center = ( m_mesh.vertices[edge.first] + m_mesh.vertices[edge.second] ) * .5f;
+					m_componentPoints.push_back( PointVertex( Vertex3f( center.x(), center.y(), center.z() ), Colour4b( 0, 220, 255, 255 ) ) );
+				}
+			}
+			else if ( mode == SelectionSystem::eFace ){
+				for ( const auto& face : m_mesh.faces ){
+					Vector3 center( 0, 0, 0 ); for ( unsigned int vertex : face ) center += m_mesh.vertices[vertex]; center /= float( face.size() );
+					m_componentPoints.push_back( PointVertex( Vertex3f( center.x(), center.y(), center.z() ), Colour4b( 0, 255, 0, 255 ) ) );
+				}
+			}
+			m_mesh.renderMarkers( renderer, m_componentPoints, localToWorld() );
+		}
+	}
+	void testSelect( Selector& selector, SelectionTest& test ) override {
+		if ( !m_mesh.editable() ) return;
+		m_mesh.evaluateTransform(); test.BeginMesh( localToWorld(), true );
+		SelectionIntersection intersection;
+		if ( test.getVolume().fill() )
+			for ( std::size_t i = 0; i < m_mesh.faces.size(); ++i ) m_mesh.testFace( i, test, intersection );
+		else
+			for ( std::size_t i = 0; i < m_mesh.edges.size(); ++i ) testEdge( i, test, intersection );
+		if ( intersection.valid() ) selector.addIntersection( intersection );
+	}
+	bool isSelectedComponents() const override { return any( m_vertices ) || any( m_edges ) || any( m_faces ); }
+	void setSelectedComponents( bool select, SelectionSystem::EComponentMode mode ) override {
+		if ( select && !m_mesh.editable() ) return;
+		for ( const auto& component : components( mode ) ) component->setSelected( select );
+	}
+	void testSelectComponents( Selector& selector, SelectionTest& test, SelectionSystem::EComponentMode mode ) override {
+		if ( !m_mesh.editable() ) return;
+		m_mesh.evaluateTransform(); test.BeginMesh( localToWorld(), true );
+		Components& values = components( mode );
+		for ( std::size_t i = 0; i < values.size(); ++i ){
+			SelectionIntersection intersection;
+			if ( mode == SelectionSystem::eFace ) testComponentFace( i, test, intersection );
+			else if ( mode == SelectionSystem::eEdge ) testEdge( i, test, intersection );
+			else test.TestPoint( m_mesh.vertices[i], intersection );
+			if ( intersection.valid() ) Selector_add( selector, *values[i], intersection );
+		}
+	}
+	void gatherComponentsHighlight( std::vector<std::vector<Vector3>>& polygons, SelectionIntersection& intersection, SelectionTest& test, SelectionSystem::EComponentMode mode ) const override {
+		if ( !m_mesh.editable() ) return;
+		m_mesh.evaluateTransform(); test.BeginMesh( localToWorld(), true );
+		const std::size_t count = mode == SelectionSystem::eFace ? m_faces.size() : mode == SelectionSystem::eEdge ? m_edges.size() : m_vertices.size();
+		for ( std::size_t i = 0; i < count; ++i ){
+			SelectionIntersection candidate;
+			if ( mode == SelectionSystem::eFace ) testComponentFace( i, test, candidate );
+			else if ( mode == SelectionSystem::eEdge ) testEdge( i, test, candidate );
+			else test.TestPoint( m_mesh.vertices[i], candidate );
+			if ( SelectionIntersection_closer( candidate, intersection ) ){
+				intersection = candidate; polygons.clear(); polygons.emplace_back();
+				if ( mode == SelectionSystem::eFace ) for ( unsigned int index : m_mesh.faces[i] ) polygons.back().push_back( m_mesh.vertices[index] );
+				else if ( mode == SelectionSystem::eEdge ){
+					polygons.back().push_back( m_mesh.vertices[m_mesh.edges[i].first] ); polygons.back().push_back( m_mesh.vertices[m_mesh.edges[i].second] );
+				}
+				else polygons.back().push_back( m_mesh.vertices[i] );
+			}
+		}
+	}
+	const AABB& getSelectedComponentsBounds() const override {
+		m_mesh.evaluateTransform(); m_componentBounds = AABB();
+		const std::vector<bool> selected = selectedVertexUnion();
+		for ( std::size_t i = 0; i < selected.size(); ++i ) if ( selected[i] ) aabb_extend_by_point_safe( m_componentBounds, m_mesh.vertices[i] );
+		return m_componentBounds;
+	}
+	void gatherSelectedComponents( const Vector3Callback& callback ) const override {
+		m_mesh.evaluateTransform(); const std::vector<bool> selected = selectedVertexUnion();
+		for ( std::size_t i = 0; i < selected.size(); ++i ) if ( selected[i] ) callback( DoubleVector3( m_mesh.vertices[i].x(), m_mesh.vertices[i].y(), m_mesh.vertices[i].z() ) );
+	}
+	void snapComponents( float snap ) override { const std::vector<bool> selected = selectedVertexUnion(); m_mesh.snap( snap, &selected ); }
+	void evaluateTransform(){
+		const Matrix4 matrix = m_transform.calculateTransform();
+		if ( m_transform.getType() == TRANSFORM_PRIMITIVE ) m_mesh.previewTransform( matrix, nullptr );
+		else { const std::vector<bool> selected = selectedVertexUnion(); m_mesh.previewTransform( matrix, &selected ); }
+	}
+	void applyTransform(){
+		const Matrix4 matrix = m_transform.calculateTransform();
+		if ( m_transform.getType() == TRANSFORM_PRIMITIVE ) m_mesh.applyTransform( matrix, nullptr );
+		else { const std::vector<bool> selected = selectedVertexUnion(); m_mesh.applyTransform( matrix, &selected ); }
+	}
+	typedef MemberCaller<PrimeMeshInstance, void(), &PrimeMeshInstance::applyTransform> ApplyTransformCaller;
+	bool testLight( const RendererLight& light ) const override { return light.testAABB( worldAABB() ); }
+	QJsonObject selection() const {
+		QJsonArray vertices, edges, faces;
+		for ( std::size_t i = 0; i < m_vertices.size(); ++i ) if ( m_vertices[i]->isSelected() ) vertices.append( int( i ) );
+		for ( std::size_t i = 0; i < m_edges.size(); ++i ) if ( m_edges[i]->isSelected() ) edges.append( QJsonArray{ int( m_mesh.edges[i].first ), int( m_mesh.edges[i].second ) } );
+		for ( std::size_t i = 0; i < m_faces.size(); ++i ) if ( m_faces[i]->isSelected() ) faces.append( int( i ) );
+		return QJsonObject{ { "vertices", vertices }, { "edges", edges }, { "faces", faces } };
+	}
+	void setSelection( const QJsonObject& selection ){
+		for ( auto* components : { &m_vertices, &m_edges, &m_faces } ) for ( const auto& c : *components ) c->setSelected( false );
+		for ( const QJsonValue& i : selection.value( "vertices" ).toArray() ) if ( indexValue( i, int( m_vertices.size() ) ) ) m_vertices[i.toInt()]->setSelected( true );
+		for ( const QJsonValue& i : selection.value( "faces" ).toArray() ) if ( indexValue( i, int( m_faces.size() ) ) ) m_faces[i.toInt()]->setSelected( true );
+		for ( const QJsonValue& edge : selection.value( "edges" ).toArray() ){
+			if ( edge.isDouble() && indexValue( edge, int( m_edges.size() ) ) ) m_edges[edge.toInt()]->setSelected( true );
+			else if ( edge.isArray() && edge.toArray().size() == 2 ){
+				const QJsonArray values = edge.toArray();
+				if ( !indexValue( values[0], int( m_vertices.size() ) ) || !indexValue( values[1], int( m_vertices.size() ) ) ) continue;
+				const unsigned int a = values[0].toInt(), b = values[1].toInt();
+				const auto pair = std::make_pair( std::min( a, b ), std::max( a, b ) );
+				const auto found = std::lower_bound( m_mesh.edges.begin(), m_mesh.edges.end(), pair );
+				if ( found != m_mesh.edges.end() && *found == pair ) m_edges[found - m_mesh.edges.begin()]->setSelected( true );
+			}
+		}
+		SceneChangeNotify();
+	}
+};
