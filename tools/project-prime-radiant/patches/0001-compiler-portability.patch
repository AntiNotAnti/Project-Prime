+	bool pre( const scene::Path& path, scene::Instance& ) const override {
+		if ( PrimeMesh* source = Node_getPrimeMesh( path.top() ) ){
+			auto& self = *const_cast<LoadedMeshCount*>( this );
+			const QJsonObject payload = source->payload(), mesh = payload.value( "mesh" ).toObject();
+			const int vertexCount = mesh.value( "vertices" ).toArray().size(), faceCount = mesh.value( "faces" ).toArray().size();
+			++self.meshes; self.vertices += vertexCount; self.faces += faceCount;
+			const QByteArray fingerprint = QCryptographicHash::hash( QJsonDocument( payload ).toJson( QJsonDocument::Compact ), QCryptographicHash::Sha256 ).toHex();
+			self.fingerprints.push_back( fingerprint );
+			QString error;
+			self.m_report.check( "loaded mesh payload validates", PrimeMesh_validatePayload( payload, &error ), QString::number( self.meshes ) + ": " + error );
+			self.summaries.append( QJsonObject{ { "label", mesh.value( "label" ) }, { "vertices", vertexCount }, { "faces", faceCount }, { "reference", payload.value( "reference" ).toBool() }, { "payloadSha256", QString::fromLatin1( fingerprint ) } } );
+		}
+		return true;
+	}
