+		}
+		// Destroy the temporary attachments before restoring Qt's exact bindings.
+		if ( separateFramebuffers ) {
+			functions->glBindFramebuffer( GL_DRAW_FRAMEBUFFER, drawFramebuffer );
+			functions->glBindFramebuffer( GL_READ_FRAMEBUFFER, readFramebuffer );
+		}
+		else {
+			functions->glBindFramebuffer( GL_FRAMEBUFFER, drawFramebuffer );
+		}
+		functions->glBindRenderbuffer( GL_RENDERBUFFER, renderbuffer );
+		functions->glActiveTexture( activeTexture );
+		functions->glBindTexture( GL_TEXTURE_2D, texture );
+		functions->glViewport( viewport[0], viewport[1], viewport[2], viewport[3] );
+#else
 		GLWidget_sharedContextCreated();
+#endif
