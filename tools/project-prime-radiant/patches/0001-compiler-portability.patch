+void pasteUv(){
+	edit( []( Target& target, QString& message ){
+		if( g_copiedUv.isEmpty() ) { message = "Copy a face UV first."; return false; }
+		QJsonObject mesh = target.after.value( "mesh" ).toObject(); const auto faces = mesh.value( "faces" ).toArray();
+		QJsonArray uv = mesh.value( "faceTexcoords" ).toArray(); while( uv.size() < faces.size() ) uv.append( QJsonValue::Null );
+		for( const auto index : selectedFaces( target ) ){
+			if( faces[index.toInt()].toArray().size() != g_copiedUv.size() ) { message = "Pasted UVs require faces with the same number of corners."; return false; }
+			uv[index.toInt()] = g_copiedUv;
+		}
+		mesh["faceTexcoords"] = uv; target.after["mesh"] = mesh; return true;
+	}, "primeMesh paste UV", true );
+}
