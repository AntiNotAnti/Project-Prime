+void showOrUnlockAll( bool unlock ){
+	if( g_running ) return;
+	std::vector<Target> all; GlobalSceneGraph().traverse( Collect( all, false, true ) );
+	all.erase( std::remove_if( all.begin(), all.end(), []( const Target& target ){ return target.before.value( "reference" ).toBool(); } ), all.end() );
+	for( Target& target : all ){
+		QJsonObject mesh = target.after.value( "mesh" ).toObject(); mesh[unlock ? "locked" : "hidden"] = false; target.after["mesh"] = mesh;
+	}
+	if( apply( all, unlock ? "primeMesh unlock all" : "primeMesh show all", true ) && !unlock ){
+		for( Target& target : all ){
+			target.node.get().disable( scene::Node::eHidden );
+			if( target.path.size() > 1 ) target.path.parent().get().disable( scene::Node::eHidden );
+		}
+		SceneChangeNotify();
+	}
+}
