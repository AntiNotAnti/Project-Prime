+void PrimeMeshTools_showIssues(){
+	if( g_running ) return;
+	auto selected = targets( true );
+	if( selected.empty() ) { error( "Select a Prime mesh to inspect its geometry issues." ); return; }
+	struct Issue { size_t target; QJsonObject problem; };
+	std::vector<Issue> issues; int total = 0;
+	{
+		struct Guard { Guard(){ g_running = true; } ~Guard(){ g_running = false; } } guard;
+		QProgressDialog progress( "Analyzing original mesh topology…", "Cancel", 0, int( selected.size() ), MainFrame_getWindow() );
+		progress.setWindowModality( Qt::ApplicationModal ); progress.setMinimumDuration( 0 ); progress.show();
+		for( size_t index = 0; index < selected.size(); ++index ){
+			QJsonObject response; QString message;
+			const Target& target = selected[index];
+			const QJsonObject request{ { "schema", 1 }, { "operation", "analyzeMesh" }, { "payload", target.before }, { "selection", target.selection }, { "mode", mode() } };
+			if( !callWorker( request, response, progress, message ) ) { progress.hide(); error( message ); return; }
+			if( response.value( "payload" ).toObject() != target.before || !response.value( "issues" ).isArray() ){
+				progress.hide(); error( "The mesh analyzer returned an invalid read-only response." ); return;
+			}
+			for( const auto problem : response.value( "issues" ).toArray() ){
+				if( !problem.isObject() ) { progress.hide(); error( "The mesh analyzer returned an invalid issue." ); return; }
+				++total; if( issues.size() < 2000 ) issues.push_back( { index, problem.toObject() } );
+			}
+			progress.setValue( int( index + 1 ) );
+		}
+	}
+	QDialog dialog( MainFrame_getWindow() ); dialog.setWindowTitle( "Prime Mesh Geometry Issues" ); dialog.resize( 820, 460 );
+	auto* layout = new QVBoxLayout( &dialog );
+	layout->addWidget( new QLabel( total == 0 ? "No geometry issues found." : QString( "%1 issue(s)%2. Select a row to inspect its original face, edge or vertex." ).arg( total ).arg( total > int( issues.size() ) ? QString( "; showing the first %1" ).arg( int( issues.size() ) ) : QString() ) ) );
+	auto* tree = new QTreeWidget; tree->setHeaderLabels( { "Mesh", "Severity", "Issue" } ); tree->setRootIsDecorated( false ); tree->setAlternatingRowColors( true );
+	tree->header()->setSectionResizeMode( 0, QHeaderView::ResizeToContents ); tree->header()->setSectionResizeMode( 1, QHeaderView::ResizeToContents ); tree->header()->setStretchLastSection( true ); layout->addWidget( tree );
+	for( size_t index = 0; index < issues.size(); ++index ){
+		const Issue& issue = issues[index]; const QJsonObject mesh = selected[issue.target].before.value( "mesh" ).toObject();
+		auto* item = new QTreeWidgetItem( tree, { mesh.value( "label" ).toString( "Mesh" ), issue.problem.value( "severity" ).toString(), issue.problem.value( "message" ).toString() } ); item->setData( 0, Qt::UserRole, int( index ) );
+	}
+	auto* actions = new QHBoxLayout; layout->addLayout( actions );
+	auto* edgeButton = new QPushButton( "Select edge" ); auto* faceButton = new QPushButton( "Focus face" ); auto* vertexButton = new QPushButton( "Select vertex" );
+	for( auto* button : { edgeButton, faceButton, vertexButton } ) { button->setEnabled( false ); actions->addWidget( button ); }
+	actions->addStretch();
+	auto current = [&]() -> const Issue* {
+		const auto* item = tree->currentItem(); if( !item ) return nullptr;
+		const int index = item->data( 0, Qt::UserRole ).toInt(); return index >= 0 && size_t( index ) < issues.size() ? &issues[size_t( index )] : nullptr;
+	};
+	auto boundedIndex = []( const QJsonValue& value, int count ){ return value.isDouble() && value.toDouble() == std::floor( value.toDouble() ) && value.toDouble() >= 0 && value.toDouble() < count; };
+	auto canSelect = [&]( const Issue& issue ){
+		const auto& target = selected[issue.target]; const auto mesh = target.before.value( "mesh" ).toObject();
+		return !target.before.value( "reference" ).toBool() && !mesh.value( "locked" ).toBool() && !mesh.value( "hidden" ).toBool();
+	};
+	auto update = [&](){
+		const Issue* issue = current();
+		if( !issue ) { edgeButton->setEnabled( false ); faceButton->setEnabled( false ); vertexButton->setEnabled( false ); return; }
+		const QJsonObject mesh = selected[issue->target].before.value( "mesh" ).toObject(); const int vertices = mesh.value( "vertices" ).toArray().size();
+		const auto edge = issue->problem.value( "edge" ).toArray();
+		edgeButton->setEnabled( canSelect( *issue ) && edge.size() == 2 && boundedIndex( edge[0], vertices ) && boundedIndex( edge[1], vertices ) );
+		faceButton->setEnabled( boundedIndex( issue->problem.value( "face" ), mesh.value( "faces" ).toArray().size() ) );
+		vertexButton->setEnabled( canSelect( *issue ) && boundedIndex( issue->problem.value( "vertex" ), vertices ) );
+	};
+	QObject::connect( tree, &QTreeWidget::itemSelectionChanged, &dialog, update );
+	auto selectIssue = [&]( const char* channel, SelectionSystem::EComponentMode component ){
+		const Issue* issue = current(); if( !issue || !canSelect( *issue ) ) return;
+		Target& target = selected[issue->target]; scene::Instance* instance = GlobalSceneGraph().find( target.path );
+		if( !instance || PrimeMesh_getPayload( target.node ) != target.original ) { error( "The mesh changed. Analyze its issues again." ); return; }
+		QJsonObject selection{ { "faces", QJsonArray() }, { "edges", QJsonArray() }, { "vertices", QJsonArray() } };
+		selection[channel] = QJsonArray{ issue->problem.value( component == SelectionSystem::eEdge ? "edge" : component == SelectionSystem::eFace ? "face" : "vertex" ) };
+		GlobalSelectionSystem().setSelectedAllComponents( false ); GlobalSelectionSystem().setSelectedAll( false ); Instance_setSelected( *instance, true );
+		GlobalSelectionSystem().SetMode( SelectionSystem::eComponent ); GlobalSelectionSystem().SetComponentMode( component ); PrimeMesh_setSelection( *instance, selection ); SceneChangeNotify();
+	};
+	QObject::connect( edgeButton, &QPushButton::clicked, &dialog, [&](){ selectIssue( "edges", SelectionSystem::eEdge ); } );
+	QObject::connect( vertexButton, &QPushButton::clicked, &dialog, [&](){ selectIssue( "vertices", SelectionSystem::eVertex ); } );
+	QObject::connect( faceButton, &QPushButton::clicked, &dialog, [&](){
+		const Issue* issue = current(); if( !issue ) return;
+		Target& target = selected[issue->target]; scene::Instance* instance = GlobalSceneGraph().find( target.path );
+		if( !instance || PrimeMesh_getPayload( target.node ) != target.original ) { error( "The mesh changed. Analyze its issues again." ); return; }
+		const QJsonObject mesh = target.before.value( "mesh" ).toObject(), transform = mesh.value( "transform" ).toObject();
+		const QJsonArray vertices = mesh.value( "vertices" ).toArray(), face = mesh.value( "faces" ).toArray()[issue->problem.value( "face" ).toInt()].toArray();
+		QJsonArray position = transform.value( "position" ).toArray(), scale = transform.value( "scale" ).toArray(), rotation = transform.value( "rotation" ).toArray();
+		if( position.size() != 3 ) position = QJsonArray{ 0, 0, 0 }; if( scale.size() != 3 ) scale = QJsonArray{ 1, 1, 1 }; if( rotation.size() != 4 ) rotation = QJsonArray{ 0, 0, 0, 1 };
+		const QQuaternion quaternion( rotation[3].toDouble(), rotation[0].toDouble(), rotation[1].toDouble(), rotation[2].toDouble() );
+		const double units = target.before.value( "units" ).toDouble( 16 ); AABB bounds;
+		for( const auto vertex : face ){
+			const auto point = vertices[vertex.toInt()].toArray(); QVector3D value( point[0].toDouble() * scale[0].toDouble(), point[1].toDouble() * scale[1].toDouble(), point[2].toDouble() * scale[2].toDouble() );
+			value = quaternion.rotatedVector( value ) + QVector3D( position[0].toDouble(), position[1].toDouble(), position[2].toDouble() );
+			aabb_extend_by_point_safe( bounds, matrix4_transformed_point( instance->localToWorld(), Vector3( value.x() * units, -value.z() * units, value.y() * units ) ) );
+		}
+		if( canSelect( *issue ) ) selectIssue( "faces", SelectionSystem::eFace );
+		if( g_pParentWnd ){
+			g_pParentWnd->forEachXYWnd( [&]( XYWnd* window ){ window->FocusOnBounds( bounds ); } );
+			if( CamWnd* camera = g_pParentWnd->GetCamWnd() ) Camera_setOrigin( *camera, bounds.origin + Camera_getViewVector( *camera ) * std::max( 64.f, float( vector3_length( bounds.extents ) ) * 3.f ) );
+		}
+		SceneChangeNotify();
+	} );
+	auto* close = new QDialogButtonBox( QDialogButtonBox::Close ); layout->addWidget( close ); QObject::connect( close, &QDialogButtonBox::rejected, &dialog, &QDialog::reject );
+	if( tree->topLevelItemCount() ) tree->setCurrentItem( tree->topLevelItem( 0 ) ); dialog.exec();
+}
