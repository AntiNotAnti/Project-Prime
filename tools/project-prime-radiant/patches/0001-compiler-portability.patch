+struct Target {
+	NodeSmartReference node;
+	scene::Path path;
+	QJsonObject original, before, selection, after, resultSelection;
+	bool remove = false;
+	std::vector<QJsonObject> additional;
+	Target( scene::Node& n, const scene::Path& p, scene::Instance& instance )
+		: node( n ), path( p ), original( PrimeMesh_getPayload( n ) ), before( original ), selection( PrimeMesh_selection( instance ) ), resultSelection( selection ) {
+		// Group identity is authoritative after ordinary Radiant duplication. Keep
+		// the actual node state separately so an unsuccessful operation writes nothing
+		// and undo restores the exact original payload, including its previous ID.
+		if( p.size() > 1 ) if( Entity* parent = Node_getEntity( p.parent() ) ){
+			const QUuid identity( QString::fromUtf8( parent->getKeyValue( "prime_id" ) ) );
+			if( string_equal( parent->getClassName(), "func_group" ) && !identity.isNull() ){
+				QJsonObject mesh = before.value( "mesh" ).toObject();
+				mesh["id"] = identity.toString( QUuid::WithoutBraces ); before["mesh"] = mesh;
+			}
+		}
