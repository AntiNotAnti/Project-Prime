+void PrimeMeshTools_setTexdef( const float* hShift, const float* vShift, const float* hScale, const float* vScale, const float* rotation ){
+	QJsonObject request;
+	if( hShift ) request["hShift"] = *hShift;
+	if( vShift ) request["vShift"] = *vShift;
+	if( hScale ) request["hScale"] = *hScale;
+	if( vScale ) request["vScale"] = *vScale;
+	if( rotation ) request["rotation"] = *rotation;
+	run( "uvSetTexdef", request, false, true );
+}
