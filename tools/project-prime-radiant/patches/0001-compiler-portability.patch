+		functions->glGetIntegerv( GL_RENDERBUFFER_BINDING, &renderbuffer );
+		functions->glGetIntegerv( GL_ACTIVE_TEXTURE, &activeTexture );
+		functions->glGetIntegerv( GL_TEXTURE_BINDING_2D, &texture );
