+void convertBrushes(){
+	if( g_running ) return;
+	struct Conversion { NodeSmartReference source, mesh; scene::Path path;
+		Conversion( scene::Node& source, scene::Node& mesh, const scene::Path& path ) : source( source ), mesh( mesh ), path( path ) {} };
+	std::vector<Conversion> conversions;
+	class Convert : public scene::Graph::Walker {
+		std::vector<Conversion>& m_conversions;
+	public:
+		mutable QString problem;
+		explicit Convert( std::vector<Conversion>& conversions ) : m_conversions( conversions ) {}
+		bool pre( const scene::Path& path, scene::Instance& instance ) const override {
+			if( !path.top().get().visible() ) return false;
+			BrushInstance* brush = Instance_getBrush( instance );
+			if( !brush || !Instance_isSelected( instance ) ) return true;
+			QJsonObject payload = brushPayload( path, instance, *brush, false );
+			if( payload.value( "mesh" ).toObject().value( "faces" ).toArray().isEmpty() || !PrimeMesh_validatePayload( payload, &problem ) ) { if( problem.isEmpty() ) problem = "The brush has no valid polygon faces."; return false; }
+			NodeSmartReference node( PrimeMesh_createNode() ); if( !PrimeMesh_setPayload( node, payload ) ) { problem = "Could not stage converted brush."; return false; }
+			m_conversions.emplace_back( path.top().get(), node, path ); return false;
+		}
+	} collect( conversions );
+	GlobalSceneGraph().traverse( collect );
+	if( !collect.problem.isEmpty() ) { error( collect.problem ); return; }
+	if( conversions.empty() ) { error( "Select one or more brushes to convert." ); return; }
+	UndoableCommand undo( "primeMesh convert brushes" );
+	GlobalSelectionSystem().setSelectedAllComponents( false ); GlobalSelectionSystem().setSelectedAll( false );
+	for( auto& conversion : conversions ){
+		Node_getTraversable( conversion.path.parent() )->erase( conversion.source );
+		Node_getTraversable( conversion.path.parent() )->insert( conversion.mesh );
+		scene::Path path = conversion.path; path.pop(); path.push( makeReference( conversion.mesh.get() ) );
+		if( auto* instance = GlobalSceneGraph().find( path ) ) Instance_setSelected( *instance, true );
+	}
+	GlobalSelectionSystem().SetMode( SelectionSystem::ePrimitive ); SceneChangeNotify();
+}
