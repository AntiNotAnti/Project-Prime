<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);PROJECTPRIME_RMLUI_ANDROID_EXPERIMENT</DefineConstants>
  </PropertyGroup>
  <!-- Source-only owner/input checks. Native bridge and GLES are instrumented
       fakes; this does not compile Android or execute any EGL/GLES operation. -->
  <ItemGroup>
    <Compile Include="../../src/MphRead/Mods/Launcher/RmlUi/Host/*.cs" Link="Host/%(Filename)%(Extension)" />
    <Compile Include="../../src/MphRead/Mods/Launcher/Portable/RmlUiPointerMapping.cs" Link="RmlUiPointerMapping.cs" />
    <Compile Include="../../src/MphRead.Android/RmlUiAndroidInputQueue.cs" Link="RmlUiAndroidInputQueue.cs" />
    <Compile Include="../../src/MphRead.Android/RmlUiAndroidDrawListSession.cs" Link="RmlUiAndroidDrawListSession.cs" />
  </ItemGroup>
</Project>
