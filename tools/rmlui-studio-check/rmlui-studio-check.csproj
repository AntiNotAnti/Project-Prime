<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><Compile Remove="DiagnosticsStub.cs" /></ItemGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)' != ''">
    <Reference Include="ProjectPrime"><HintPath>$(PrimeAssemblyDirectory)/ProjectPrime.dll</HintPath></Reference>
    <Reference Include="ProjectPrime.Studio.Protocol"><HintPath>$(PrimeAssemblyDirectory)/ProjectPrime.Studio.Protocol.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)' == ''">
    <Compile Include="DiagnosticsStub.cs" />
    <ProjectReference Include="../../src/ProjectPrime.Studio.Protocol/ProjectPrime.Studio.Protocol.csproj" />
    <Compile Include="../../src/MphRead/Mods/Launcher/Core/Studio*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../src/MphRead/Mods/Launcher/RmlUi/Host/*.cs" Link="Host/%(Filename)%(Extension)" />
    <Compile Include="../../src/MphRead/Mods/Launcher/RmlUi/Pages/studio/StudioPagePresenter.cs" Link="StudioPagePresenter.cs" />
    <Compile Include="../../src/MphRead/Mods/Launcher/Portable/RmlUiPointerMapping.cs" Link="RmlUiPointerMapping.cs" />
    <Compile Include="../../src/MphRead/Mods/Launcher/Portable/NativeFilePicker.cs" Link="NativeFilePicker.cs" />
    <Compile Include="../../src/MphRead/Mods/StudioIntegration/StudioApplicationLauncher.cs" Link="StudioApplicationLauncher.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../src/MphRead/Mods/Launcher/RmlUi/Assets/prime_home.*" Link="rmlui/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MphRead/Mods/Launcher/RmlUi/Pages/**/*.rml;../../src/MphRead/Mods/Launcher/RmlUi/Pages/**/*.rcss" Link="rmlui/pages/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MphRead/Mods/Launcher/RmlUi/Components/**/*.rml;../../src/MphRead/Mods/Launcher/RmlUi/Components/**/*.rcss" Link="rmlui/components/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MphRead/Mods/Launcher/RmlUi/Themes/**/*.rcss" Link="rmlui/themes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MphRead/Assets/Fonts/Rajdhani-*.ttf;../../src/MphRead/Assets/Fonts/JetBrainsMono-Regular.ttf" Link="rmlui/fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
