<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>nettest</AssemblyName>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="ReFuel.StbImage" Version="2.1.1" /></ItemGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)' == ''">
    <ProjectReference Include="../../src/MphRead/MphRead.csproj" AdditionalProperties="MphReadRmlUi=true" />
  </ItemGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)' != ''">
    <Reference Include="ProjectPrime"><HintPath>$(PrimeAssemblyDirectory)/ProjectPrime.dll</HintPath></Reference>
    <Reference Include="$(PrimeAssemblyDirectory)/OpenTK.*.dll" /><Reference Include="SkiaSharp"><HintPath>$(PrimeAssemblyDirectory)/SkiaSharp.dll</HintPath></Reference><Reference Include="ProjectPrime.Studio.Protocol"><HintPath>$(PrimeAssemblyDirectory)/ProjectPrime.Studio.Protocol.dll</HintPath></Reference>
    <None Include="$(PrimeAssemblyDirectory)/*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PrimeAssemblyDirectory)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PrimeAssemblyDirectory)/runtimes/**/*" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
