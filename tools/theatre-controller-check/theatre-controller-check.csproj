<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants Condition="'$(MphReadRmlUi)' == 'true' or '$(MphReadRmlUiPoc)' == 'true'">$(DefineConstants);MPHREAD_RMLUI_POC</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)' == ''"><ProjectReference Include="../../src/MphRead/MphRead.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)' != ''">
    <Reference Include="ProjectPrime"><HintPath>$(PrimeAssemblyDirectory)/ProjectPrime.dll</HintPath></Reference>
    <PackageReference Include="ReFuel.StbImage" Version="2.1.1" />
  </ItemGroup>
</Project>
