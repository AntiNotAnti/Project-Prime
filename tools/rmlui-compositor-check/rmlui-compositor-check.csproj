<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable>
    <MphReadRmlUi>true</MphReadRmlUi>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/MphRead/MphRead.csproj" AdditionalProperties="MphReadRmlUi=true" /></ItemGroup>
  <!-- ProjectReference copies the NuGet loader alias again after the game has
       normalized its own output. Normalize this tool's independent output too. -->
  <Target Name="IdentifyRmlUiCheckMacVulkanLoader" AfterTargets="CopyFilesToOutputDirectory"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('$(TargetDir)libvulkan.dylib')">
    <Exec Command="install_name_tool -id libvulkan.dylib &quot;$(TargetDir)libvulkan.dylib&quot;" />
    <Exec Command="codesign --force --sign - &quot;$(TargetDir)libvulkan.dylib&quot;" />
  </Target>
</Project>
