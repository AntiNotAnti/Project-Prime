<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <!-- Runtime HUD theme colors use Vector4, but these headless tests need no GL/window host. -->
  <ItemGroup>
    <PackageReference Include="OpenTK.Mathematics" Version="4.9.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/MphRead/Mods/Settings/SettingsPersistence.cs" Link="SettingsPersistence.cs" />
    <Compile Include="../../src/MphRead/Mods/Render/Hud/*.cs" Exclude="../../src/MphRead/Mods/Render/Hud/SceneHudLayout.cs" Link="Hud/%(Filename)%(Extension)" />
    <Compile Include="../../src/MphRead/Mods/Render/Crosshair.cs" Link="Crosshair.cs" />
  </ItemGroup>
</Project>
