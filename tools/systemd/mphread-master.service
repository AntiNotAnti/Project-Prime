# The always-on directory and lobby allocator.
#
# It keeps the browser list in memory and owns a bounded host-port pool. Player
# Create Lobby requests cause isolated authoritative lobby children to be
# started only when needed; the allocator itself runs no gameplay simulation.
#
# Point 51.161.113.128 at this machine and open UDP 27889 to it.
#
# __USER__ and __DIR__ are placeholders; see mphread-server.service.
[Unit]
Description=Project Prime server directory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
# Hosted child game servers inherit the private career reporter credential.
EnvironmentFile=-__DIR__/career.env
ExecStart=__DIR__/ProjectPrime -masterserver -port 27889 -public __PUBLIC__ -hostports 27900-27919
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
