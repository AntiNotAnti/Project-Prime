# Data-free directory. To enable hosted matches, explicitly add -data DIRECTORY,
# -dataversion AMHE1, -hostports FIRST-LAST and -public REACHABLE_HOST.
[Unit]
Description=Prime Hunters server directory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory="__DIR__"
ExecStart="__DIR__/FruityPrimeServer" -masterserver -port 27889 -hostports none
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
