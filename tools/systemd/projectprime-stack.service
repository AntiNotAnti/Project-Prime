# Project Prime VPS Backend + Node + managed Worker stack.
[Unit]
Description=Project Prime complete server stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
UMask=0077
WorkingDirectory=__ROOT__/current
Environment=PRIME_DEV_ENV_FILE=__ROOT__/state/dev.env
Environment=PRIME_DEV_STATE_DIR=__ROOT__/state
Environment=PRIME_SERVER_PACKAGE=__ROOT__/current
Environment=PRIME_CONTENT_DIRECTORY=__ROOT__/AMHE1
Environment=PRIME_REQUIRE_BACKEND_DATABASE=1
ExecStart=__ROOT__/current/start-stack-dev.sh --with-backend --package-dir __ROOT__/current --content-dir __ROOT__/AMHE1 --state-dir __ROOT__/state
KillMode=mixed
TimeoutStopSec=75
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__ROOT__/state
ReadWritePaths=__ROOT__/AMHE1
ReadWritePaths=-__ROOT__/current/ProjectPrimeServer -__ROOT__/current/worker/ProjectPrime.Server.Worker
# The first rollback target is the untouched pre-rename bundle.
ReadWritePaths=-__ROOT__/current/FruityPrimeServer -__ROOT__/current/worker/FruityPrime.Server.Worker

[Install]
WantedBy=multi-user.target
