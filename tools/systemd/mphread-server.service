# Authoritative game server. Install content separately and replace placeholders
# with tools/render-server-unit.py or deploy-server.sh before installing the unit.
[Unit]
Description=Fruity Prime authoritative dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory="__DIR__"
# Listing is disabled unless -master HOST:PORT is configured explicitly.
ExecStart="__DIR__/FruityPrimeServer" -server -data "__DATA__" -dataversion "__DATA_VERSION__" -port 27888 -players 8 -servername "Fruity Prime" __LISTING__
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
