# Combined Project Prime control Node and local authoritative Worker pool.
# Replace placeholders with deploy-server.sh or an explicit operator install.
[Unit]
Description=Project Prime server Node and Worker pool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
UMask=0077
WorkingDirectory="__DIR__/current"
ExecStart="__DIR__/current/ProjectPrimeServer" --contentRoot "__CONFIG_DIR__"
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="__DIR__"

[Install]
WantedBy=multi-user.target
