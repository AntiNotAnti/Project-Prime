<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><NoWarn>0436</NoWarn></PropertyGroup>
  <PropertyGroup Condition="'$(MphReadRmlUi)'=='true'"><DefineConstants>$(DefineConstants);MPHREAD_RMLUI_POC</DefineConstants></PropertyGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)'==''"><ProjectReference Include="../../src/MphRead/MphRead.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)'!=''"><Reference Include="ProjectPrime"><HintPath>$(PrimeAssemblyDirectory)/ProjectPrime.dll</HintPath></Reference></ItemGroup>
  <!-- Native presenters accept the real project's controller types. Linking a
       second copy here would create distinct types with the same full names. -->
  <ItemGroup Condition="'$(MphReadRmlUi)'!='true'"><Compile Include="../../src/MphRead/Mods/Launcher/Core/NewsCatalog.cs;../../src/MphRead/Mods/Launcher/Core/NewsController.cs" /></ItemGroup>
</Project>
