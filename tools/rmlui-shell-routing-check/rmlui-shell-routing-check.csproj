<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>nettest</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)' == ''">
    <ProjectReference Include="../../src/MphRead/MphRead.csproj" AdditionalProperties="MphReadRmlUi=true" />
  </ItemGroup>
  <ItemGroup Condition="'$(PrimeAssemblyDirectory)' != ''">
    <Reference Include="ProjectPrime"><HintPath>$(PrimeAssemblyDirectory)/ProjectPrime.dll</HintPath></Reference>
    <Reference Include="ProjectPrime.Studio.Protocol"><HintPath>$(PrimeAssemblyDirectory)/ProjectPrime.Studio.Protocol.dll</HintPath></Reference>
    <None Include="$(PrimeAssemblyDirectory)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PrimeAssemblyDirectory)/runtimes/**/*" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
