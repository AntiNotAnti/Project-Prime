<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- Exercise the production value contract and fixed-step clock without
       building the application, loading assets, or creating a GL context. -->
  <ItemGroup>
    <PackageReference Include="OpenTK.Mathematics" Version="4.9.4" />
    <Compile Include="../../src/MphRead/Mods/Render/DisplayPoseHistory.cs" Link="DisplayPoseHistory.cs" />
    <Compile Include="../../src/MphRead/Mods/Render/FrameTiming.cs" Link="FrameTiming.cs" />
  </ItemGroup>
</Project>
