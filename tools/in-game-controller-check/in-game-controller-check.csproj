<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks><DefineConstants>$(DefineConstants);MPHREAD_RMLUI_POC;MPHREAD_RMLUI_ANDROID</DefineConstants><NoWarn>$(NoWarn);0436</NoWarn></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MphRead/MphRead.csproj" />
    <Compile Include="../../src/MphRead/Mods/Launcher/RmlUi/Host/*.cs" Exclude="../../src/MphRead/Mods/Launcher/RmlUi/Host/RmlUiDesktopInput.cs" Link="Host/%(Filename)%(Extension)" />
    <Compile Include="../../src/MphRead/Mods/Launcher/Portable/RmlUiPointerMapping.cs" Link="RmlUiPointerMapping.cs" />
    <Compile Include="../../src/MphRead/Mods/Launcher/RmlUi/Pages/ingame/*.cs" Link="Presenters/%(Filename)%(Extension)" />
    <Compile Include="../../src/MphRead.Android/AndroidRmlUiResultsSession.cs" Link="AndroidRmlUiResultsSession.cs" />
    <None Include="../../src/MphRead/Mods/Launcher/RmlUi/Assets/**/*" Link="rmlui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MphRead/Mods/Launcher/RmlUi/Pages/**/*.rml;../../src/MphRead/Mods/Launcher/RmlUi/Pages/**/*.rcss" Link="rmlui/pages/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MphRead/Mods/Launcher/RmlUi/Themes/**/*" Link="rmlui/themes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MphRead/Mods/Launcher/RmlUi/Components/**/*" Link="rmlui/components/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MphRead/Assets/Fonts/Rajdhani-*.ttf;../../src/MphRead/Assets/Fonts/JetBrainsMono-Regular.ttf" Link="rmlui/fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
