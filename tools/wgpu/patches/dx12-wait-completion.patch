+#[cfg(test)]
+mod prime_dx12_fence_completion_tests {
+    use super::*;
+
+    #[test]
+    fn removed_device_is_never_reported_as_completed_work() {
+        assert!(matches!(prime_checked_fence_value(u64::MAX), Err(DeviceError::Lost)));
+    }
+
+    #[test]
+    fn real_zero_older_target_and_later_completion_values_are_preserved() {
+        for value in [0, 3, 7, 8, u64::MAX - 1] {
+            assert_eq!(prime_checked_fence_value(value).unwrap(), value);
+        }
+    }
