+// Keep completion selection shared by the real maintenance path and its
+// regression tests. A successful wait trusts the HAL contract; after timeout
+// only a fresh native fence query may advance ownership and map callbacks.
+fn prime_completed_submission_after_wait<E>(
+    wait_completed: bool,
+    requested: hal::FenceValue,
+    observe: impl FnOnce() -> Result<hal::FenceValue, E>,
+) -> Result<hal::FenceValue, E> {
+    if wait_completed { Ok(requested) } else { observe() }
+}
+
+fn prime_report_incomplete_wait(requested: hal::FenceValue, completed: hal::FenceValue,
+    elapsed: std::time::Duration) {
+    // The warning records a timeout, not a device-loss or shader diagnosis.
+    // Preserve the existing wait budget and bound callback/log volume.
+    static REPORTS: AtomicU64 = AtomicU64::new(0);
+    if std::env::var("PRIME_WGPU_VALIDATION").as_deref() == Ok("1")
+        && REPORTS.fetch_add(1, Ordering::Relaxed) < 8 {
+        log::warn!("GPU fence wait incomplete: wait_completed=false requested={} actual_completed={} elapsed_ms={} wait_budget_ms={}",
+            requested, completed, elapsed.as_millis(), CLEANUP_WAIT_MS);
+    }
+}
