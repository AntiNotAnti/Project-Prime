+#[cfg(test)]
+mod prime_wait_completion_tests {
+    use super::{prime_completed_submission_after_wait, CommandAllocator, LifetimeTracker, UserClosures};
+    use crate::device::queue::{SubmittedWorkDoneClosure, TempResource};
+    use std::{
+        cell::Cell,
+        sync::{
+            atomic::{AtomicUsize, Ordering},
+            Arc,
+        },
+    };
+
+    type Empty = hal::api::Empty;
+    const OLDER: hal::FenceValue = 3;
+    const REQUESTED: hal::FenceValue = 5;
+
+    // Use the actual lifetime tracker and submitted-work callbacks. The empty
+    // HAL supplies only the type: no GPU, fake tracker, or timeout sleep is used.
+    fn tracked_work() -> (
+        LifetimeTracker<Empty>,
+        CommandAllocator<Empty>,
+        Arc<AtomicUsize>,
+        Arc<AtomicUsize>,
+    ) {
+        let mut tracker = LifetimeTracker::<Empty>::new();
+        let older_calls = Arc::new(AtomicUsize::new(0));
+        let requested_calls = Arc::new(AtomicUsize::new(0));
+        for (index, calls) in [(OLDER, &older_calls), (REQUESTED, &requested_calls)] {
+            tracker.track_submission(index, std::iter::empty::<TempResource<Empty>>(), Vec::new());
+            let calls = Arc::clone(calls);
+            tracker.add_work_done_closure(SubmittedWorkDoneClosure::from_rust(Box::new(move || {
+                calls.fetch_add(1, Ordering::SeqCst);
+            })));
+        }
+        (
+            tracker,
+            CommandAllocator { free_encoders: Vec::new() },
+            older_calls,
+            requested_calls,
+        )
+    }
+
+    fn maintain_tracked_work(
+        tracker: &mut LifetimeTracker<Empty>,
+        allocator: &mut CommandAllocator<Empty>,
+        wait_completed: bool,
+        observe: impl FnOnce() -> Result<hal::FenceValue, &'static str>,
+    ) -> Result<hal::FenceValue, &'static str> {
+        // Call the production selector used by Device::maintain, then the real
+        // submission triage and callback firing APIs in their production order.
+        let completed = prime_completed_submission_after_wait(wait_completed, REQUESTED, observe)?;
+        let submissions = tracker.triage_submissions(completed, allocator);
+        UserClosures { submissions, ..Default::default() }.fire();
+        Ok(completed)
+    }
+
+    fn assert_false_wait_completion(actual: hal::FenceValue, older_done: bool, requested_done: bool) {
+        let (mut tracker, mut allocator, older_calls, requested_calls) = tracked_work();
+        let observations = Cell::new(0);
+        let selected = maintain_tracked_work(&mut tracker, &mut allocator, false, || {
+            observations.set(observations.get() + 1);
+            Ok(actual)
+        });
+        assert_eq!(selected, Ok(actual));
+        assert_eq!(observations.get(), 1);
+        assert_eq!(older_calls.load(Ordering::SeqCst), if older_done { 1 } else { 0 });
+        assert_eq!(requested_calls.load(Ordering::SeqCst), if requested_done { 1 } else { 0 });
+        assert_eq!(tracker.queue_empty(), requested_done);
+
+        // A later observed completion must still fire each retained callback
+        // exactly once. Repeating the observation must not fire it again.
+        for _ in 0..2 {
+            assert_eq!(
+                maintain_tracked_work(&mut tracker, &mut allocator, false, || Ok(REQUESTED)),
+                Ok(REQUESTED),
+            );
+            assert!(tracker.queue_empty());
+            assert_eq!(older_calls.load(Ordering::SeqCst), 1);
+            assert_eq!(requested_calls.load(Ordering::SeqCst), 1);
+        }
+    }
+
+    #[test]
+    fn incomplete_wait_at_zero_preserves_all_active_work_and_callbacks() {
+        assert_false_wait_completion(0, false, false);
+    }
+
+    #[test]
+    fn incomplete_wait_retires_only_the_observed_older_submission() {
+        assert_false_wait_completion(OLDER, true, false);
+    }
+
+    #[test]
+    fn completion_racing_to_requested_after_timeout_is_retired() {
+        assert_false_wait_completion(REQUESTED, true, true);
+    }
+
+    #[test]
+    fn completion_racing_past_requested_retires_actual_later_work() {
+        let (mut tracker, mut allocator, older_calls, requested_calls) = tracked_work();
+        let later = REQUESTED + 2;
+        let later_calls = Arc::new(AtomicUsize::new(0));
+        tracker.track_submission(later, std::iter::empty::<TempResource<Empty>>(), Vec::new());
+        let callback_calls = Arc::clone(&later_calls);
+        tracker.add_work_done_closure(SubmittedWorkDoneClosure::from_rust(Box::new(move || {
+            callback_calls.fetch_add(1, Ordering::SeqCst);
+        })));
+
+        assert_eq!(
+            maintain_tracked_work(&mut tracker, &mut allocator, false, || Ok(later)),
+            Ok(later),
+        );
+        assert!(tracker.queue_empty());
+        assert_eq!(older_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(requested_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(later_calls.load(Ordering::SeqCst), 1);
+
+        assert_eq!(
+            maintain_tracked_work(&mut tracker, &mut allocator, false, || Ok(later)),
+            Ok(later),
+        );
+        assert_eq!(older_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(requested_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(later_calls.load(Ordering::SeqCst), 1);
+    }
+
+    #[test]
+    fn completed_wait_uses_requested_without_observing_the_fence_again() {
+        let (mut tracker, mut allocator, older_calls, requested_calls) = tracked_work();
+        assert_eq!(
+            maintain_tracked_work(&mut tracker, &mut allocator, true, || {
+                panic!("a completed wait must not query the fence again")
+            }),
+            Ok(REQUESTED),
+        );
+        assert!(tracker.queue_empty());
+        assert_eq!(older_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(requested_calls.load(Ordering::SeqCst), 1);
+    }
+
+    #[test]
+    fn failed_completion_observation_never_triages_or_fires_callbacks() {
+        let (mut tracker, mut allocator, older_calls, requested_calls) = tracked_work();
+        let observations = Cell::new(0);
+        assert_eq!(
+            maintain_tracked_work(&mut tracker, &mut allocator, false, || {
+                observations.set(observations.get() + 1);
+                Err("native fence observation failed")
+            }),
+            Err("native fence observation failed"),
+        );
+        assert_eq!(observations.get(), 1);
+        assert!(!tracker.queue_empty());
+        assert_eq!(older_calls.load(Ordering::SeqCst), 0);
+        assert_eq!(requested_calls.load(Ordering::SeqCst), 0);
+
+        // Failure must retain, rather than silently discard, the callbacks.
+        assert_eq!(
+            maintain_tracked_work(&mut tracker, &mut allocator, false, || Ok(REQUESTED)),
+            Ok(REQUESTED),
+        );
+        assert!(tracker.queue_empty());
+        assert_eq!(older_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(requested_calls.load(Ordering::SeqCst), 1);
+    }
+}
