+// D3D12 reports UINT64_MAX on device removal, not an all-complete fence.
+// Use the same guard for Poll and both Wait paths before any comparison.
+fn prime_checked_fence_value(value: crate::FenceValue) -> Result<crate::FenceValue, DeviceError> {
+    if value == u64::MAX { Err(DeviceError::Lost) } else { Ok(value) }
+}
