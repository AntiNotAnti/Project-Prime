+        let capture = &*(userdata as *const Mutex<Vec<(native::WGPULogLevel, Vec<u8>)>>);
+        capture.lock().unwrap().push((level, CStr::from_ptr(message).to_bytes().to_vec()));
+    }
+
+    struct RegistrationGuard {
+        callback: native::WGPULogCallback,
+        userdata: *mut c_void,
+    }
+    impl Drop for RegistrationGuard {
+        fn drop(&mut self) {
+            let mut logger = LOGGER_INFO.write();
+            logger.callback = self.callback;
+            logger.userdata = self.userdata;
+        }
+    }
+
+    #[test]
+    fn actual_logger_c_callback_receives_complete_diagnostics_at_original_levels() {
+        let capture = Box::new(Mutex::new(Vec::<(native::WGPULogLevel, Vec<u8>)>::new()));
+        // The guard is declared after capture, so it restores the global pointer
+        // before captured storage is released, including assertion-unwind paths.
+        let registration = {
+            let mut logger = LOGGER_INFO.write();
+            let old = RegistrationGuard { callback: logger.callback, userdata: logger.userdata };
+            logger.callback = Some(capture_log);
+            logger.userdata = (&*capture as *const Mutex<_>).cast_mut().cast();
+            old
+        };
+        Logger.log(&Record::builder().args(format_args!("{}", OBSERVED_FXC_DIAGNOSTIC)).level(Level::Error).build());
+        Logger.log(&Record::builder().args(format_args!("{}", "prefix\0\0λ\nsuffix\0")).level(Level::Warn).build());
+        drop(registration);
+        let received = capture.lock().unwrap();
+        assert_eq!(received.len(), 2);
+        assert_eq!(received[0], (native::WGPULogLevel_Error, OBSERVED_FXC_DIAGNOSTIC.replace('\0', "\\0").into_bytes()));
+        assert_eq!(received[1], (native::WGPULogLevel_Warn, b"prefix\\0\\0\xCE\xBB\nsuffix\\0".to_vec()));
+    }
