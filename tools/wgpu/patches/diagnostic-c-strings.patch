 struct Logger;
 
+// Compiler diagnostics may contain a terminating or embedded C NUL. Preserve
+// every byte as visible text for the C callback instead of truncating or panicking.
+pub(crate) fn diagnostic_c_string(message: String) -> CString {
+    match CString::new(message) {
+        Ok(message) => message,
+        Err(error) => {
+            let original = error.into_vec();
+            let mut escaped = Vec::with_capacity(original.len());
+            for byte in original {
+                if byte == 0 {
+                    escaped.extend_from_slice(b"\\0");
+                } else {
+                    escaped.push(byte);
+                }
+            }
+            CString::new(escaped).expect("diagnostic NUL bytes have been escaped")
+        }
+    }
+}
