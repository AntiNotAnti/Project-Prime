+#[cfg(test)]
+mod prime_diagnostic_string_tests {
+    use super::*;
+
+    unsafe extern "C" fn capture_error(typ: native::WGPUErrorType, message: *const std::os::raw::c_char, userdata: *mut std::os::raw::c_void) {
+        let capture = &mut *(userdata as *mut Vec<(native::WGPUErrorType, Vec<u8>)>);
+        capture.push((typ, CStr::from_ptr(message).to_bytes().to_vec()));
+    }
+
+    #[test]
+    fn actual_uncaptured_error_sink_keeps_validation_failure_and_complete_c_message() {
+        let description = "FXC failure 0x80004005\0\0λ\nerror X3511 suffix\0";
+        let mut capture = Vec::<(native::WGPUErrorType, Vec<u8>)>::new();
+        let mut sink = ErrorSinkRaw::new(DEFAULT_DEVICE_LOST_HANDLER);
+        sink.uncaptured_handler = UncapturedErrorCallback {
+            callback: Some(capture_error), userdata: (&mut capture as *mut Vec<_>).cast(),
+        };
+        sink.handle_error(Error::Validation {
+            source: Box::new(std::io::Error::other("compiler failure")), description: description.to_owned(),
+        });
+        assert_eq!(capture.len(), 1);
+        assert_eq!(capture[0].0, native::WGPUErrorType_Validation);
+        assert_ne!(capture[0].0, native::WGPUErrorType_NoError);
+        assert_eq!(capture[0].1, description.replace('\0', "\\0").into_bytes());
+    }
+
+    #[test]
+    fn error_scope_retains_the_original_failure_before_c_message_encoding() {
+        let description = "FXC failed\0λ\nfull suffix\0";
+        let mut capture = Vec::<(native::WGPUErrorType, Vec<u8>)>::new();
+        let mut sink = ErrorSinkRaw::new(DEFAULT_DEVICE_LOST_HANDLER);
+        sink.uncaptured_handler = UncapturedErrorCallback {
+            callback: Some(capture_error), userdata: (&mut capture as *mut Vec<_>).cast(),
+        };
+        sink.scopes.push(ErrorScope { error: None, filter: ErrorFilter::Validation });
+        sink.handle_error(Error::Validation {
+            source: Box::new(std::io::Error::other("compiler failure")), description: description.to_owned(),
+        });
+        assert!(capture.is_empty());
+        let error = sink.scopes.pop().unwrap().error.unwrap();
+        assert!(matches!(error, Error::Validation { .. }));
+        assert_eq!(error.to_string(), description);
+        assert_eq!(logging::diagnostic_c_string(error.to_string()).to_str().unwrap(), description.replace('\0', "\\0"));
+    }
+}
