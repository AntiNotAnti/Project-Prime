+#[cfg(test)]
+mod prime_diagnostic_string_tests {
+    use super::*;
+    use log::Log as _;
+    use std::ffi::{c_char, c_void, CStr};
+    use std::sync::Mutex;
+
+    const OBSERVED_FXC_DIAGNOSTIC: &str = "Device::create_render_pipeline error: Internal error in ShaderStages(FRAGMENT) shader: FXC D3DCompile error (0x80004005): (295,21-124): warning X3570: gradient instruction used in a loop with varying iteration, attempting to unroll the loop\n(1787,5-15): error X3511: unable to unroll loop, loop does not appear to terminate in a timely manner (26 iterations) or unrolled loop is too large, use the [unroll(n)] attribute to force an exact higher number\n\0";
+
+    #[test]
+    fn observed_fxc_terminal_nul_is_preserved_without_the_previous_panic() {
+        let previous = CString::new(OBSERVED_FXC_DIAGNOSTIC).unwrap_err();
+        assert_eq!(previous.nul_position(), 452);
+        assert_eq!(OBSERVED_FXC_DIAGNOSTIC.len(), 453);
+        let encoded = diagnostic_c_string(OBSERVED_FXC_DIAGNOSTIC.to_owned());
+        assert_eq!(encoded.to_str().unwrap(), OBSERVED_FXC_DIAGNOSTIC.replace('\0', "\\0"));
+        assert!(encoded.to_str().unwrap().contains("error X3511"));
+        assert!(encoded.to_str().unwrap().ends_with("\n\\0"));
+    }
+
+    #[test]
+    fn embedded_adjacent_nuls_retain_unicode_newlines_and_the_entire_suffix() {
+        for message in ["", "normal\nUTF-8 λ 漢字", "before\0\0after λ\nlast\0", "\0\0"] {
+            let encoded = diagnostic_c_string(message.to_owned());
+            assert_eq!(encoded.as_bytes(), message.replace('\0', "\\0").as_bytes());
+            assert_eq!(encoded.as_bytes_with_nul().last(), Some(&0));
+            assert!(!encoded.as_bytes().contains(&0));
+        }
+    }
+
