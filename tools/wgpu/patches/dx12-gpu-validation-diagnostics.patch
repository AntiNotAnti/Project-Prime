 use super::SurfaceTarget;
 use crate::auxil::{self, dxgi::result::HResult as _};
 use std::{mem, sync::Arc};
+
+fn prime_gpu_validation_requested(validation: bool, diagnostic: Option<&str>) -> bool {
+    validation && diagnostic == Some("1")
+}
+
+#[cfg(test)]
+mod prime_dx12_gpu_validation_diagnostic_tests {
+    use super::prime_gpu_validation_requested;
+
+    #[test]
+    fn default_and_nonexact_optins_never_enable_gpu_validation() {
+        for diagnostic in [None, Some(""), Some("0"), Some("true"), Some(" 1")] {
+            assert!(!prime_gpu_validation_requested(true, diagnostic));
+            assert!(!prime_gpu_validation_requested(false, diagnostic));
+        }
+        assert!(!prime_gpu_validation_requested(false, Some("1")));
+    }
+
+    #[test]
+    fn gpu_validation_requires_both_explicit_native_validation_and_exact_optin() {
+        assert!(prime_gpu_validation_requested(true, Some("1")));
+    }
+}
 
