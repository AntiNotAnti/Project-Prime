+#[cfg(test)]
+mod prime_dx12_tests {
+    use super::*;
+    #[link(name = "kernel32")]
+    extern "system" {
+        fn CreateEventW(attributes: *mut std::ffi::c_void, manual_reset: i32,
+            initial_state: i32, name: *const u16) -> winnt::HANDLE;
+        fn CloseHandle(handle: winnt::HANDLE) -> i32;
+    }
+    #[test]
+    fn timed_out_acquire_does_not_touch_or_consume_back_buffer() {
+        // No DX12 device is needed: the unsignaled real Win32 event makes the
+        // wait time out before the deliberately null swapchain can be used.
+        let event = unsafe { CreateEventW(std::ptr::null_mut(), 0, 0, std::ptr::null()) };
+        assert!(!event.is_null());
+        let surface = Surface {
+            factory: d3d12::DxgiFactory::Factory1(d3d12::ComPtr::null()),
+            factory_media: None, target: SurfaceTarget::WndHandle(std::ptr::null_mut()),
+            supports_allow_tearing: false,
+            swap_chain: RwLock::new(Some(SwapChain {
+                raw: d3d12::ComPtr::null(), resources: Vec::new(), waitable: event,
+                acquired_count: 0, present_mode: wgt::PresentMode::Fifo,
+                format: wgt::TextureFormat::Rgba8Unorm,
+                size: wgt::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+            })),
+        };
+        let result = unsafe { <Surface as crate::Surface<Api>>::acquire_texture(
+            &surface, Some(std::time::Duration::ZERO)) };
+        unsafe { CloseHandle(event); }
+        assert!(matches!(result, Ok(None)));
+        assert_eq!(surface.swap_chain.read().as_ref().unwrap().acquired_count, 0);
+    }
+}
