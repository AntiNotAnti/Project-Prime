<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Compile the real mixer without requiring Android hardware or an audio device. -->
    <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MphRead/MphRead.csproj" />
    <Compile Include="../../src/MphRead/Mods/Sound/SfxMixer.cs" Link="SfxMixer.cs" />
  </ItemGroup>
</Project>
