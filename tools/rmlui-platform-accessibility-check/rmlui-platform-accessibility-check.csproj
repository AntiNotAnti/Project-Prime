<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks><DefineConstants>MPHREAD_RMLUI_POC</DefineConstants></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTK.Windowing.Desktop" Version="4.9.4" />
    <Compile Include="../../src/MphRead/Mods/Launcher/RmlUi/Host/*.cs" Exclude="../../src/MphRead/Mods/Launcher/RmlUi/Host/RmlUiLobbyBindings.cs" />
    <Compile Include="../../src/MphRead/Mods/Launcher/Portable/RmlUiPointerMapping.cs" />
    <Compile Include="../../src/MphRead/Mods/Launcher/RmlUi/Components/RmlUiAccessibility.cs;../../src/MphRead/Mods/Launcher/RmlUi/Components/RmlUiWindowsAccessibility.cs;../../src/MphRead/Mods/Launcher/RmlUi/Components/RmlUiLinuxAccessibility*.cs" />
    <None Include="../../src/MphRead/Mods/Launcher/RmlUi/Assets/prime_home.*" Link="rmlui/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MphRead/Assets/Fonts/Rajdhani-*.ttf;../../src/MphRead/Assets/Fonts/JetBrainsMono-Regular.ttf" Link="rmlui/fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="windows-client.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="atspi-client.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
