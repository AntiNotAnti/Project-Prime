<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Enable the SDK analyzers at the root, but keep style diagnostics
         advisory while the existing codebase is migrated incrementally. A
         project may opt into stricter warnings explicitly; this root file does
         not turn the entire repository into a style-failure gate. -->
    <EnableNETAnalyzers Condition="'$(EnableNETAnalyzers)' == ''">true</EnableNETAnalyzers>
    <!-- Keep the initial root baseline conservative. Individual projects may
         opt into a newer analysis level once their warnings are owned; this
         avoids turning the repository-wide migration into a warning flood or
         changing existing TreatWarningsAsErrors projects unexpectedly. -->
    <AnalysisLevel Condition="'$(AnalysisLevel)' == ''">latest-minimum</AnalysisLevel>
    <EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''">false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">false</GenerateDocumentationFile>
    <PrimeSourceGuards Condition="'$(PrimeSourceGuards)' == ''">false</PrimeSourceGuards>
    <!-- Client protection is an explicit release-publish concern. Keeping the
         default here makes ordinary build/test/run completely unaware of it. -->
    <PrimeProtectClient Condition="'$(PrimeProtectClient)' == ''">false</PrimeProtectClient>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PrimeProtectClient)' == 'true'">
    <!-- A protected publish changes compiler/debug settings throughout the
         client project-reference graph. Keep those outputs and incremental
         caches separate so a later ordinary build never observes a protected
         build's missing debug artifacts (or vice versa). -->
    <!-- The supported SDK artifacts layout isolates desktop and referenced
         managed builds. The Android app's outer/inner post-link graph requires
         its conventional project-local obj layout, so isolate only its bin. -->
    <ArtifactsPath Condition="'$(MSBuildProjectName)' != 'Android'">$(MSBuildThisFileDirectory)artifacts/prime-protection</ArtifactsPath>
    <BaseOutputPath Condition="'$(MSBuildProjectName)' == 'Android'">$(MSBuildThisFileDirectory)artifacts/prime-protection/bin/Android/</BaseOutputPath>
    <!-- Redirecting protected outputs can remove the SDK's implicit exclusion
         for each project's conventional obj/ tree. Keep old normal
         intermediates out of Compile/Content globs during protected builds. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**</DefaultItemExcludes>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- The source guard is opt-in for local builds and is enabled by the fast
       CI tier. Keeping it outside CoreCompile avoids recursive process calls
       and makes a guard failure explain its exact source boundary. -->
  <Target Name="PrimeSourceGuardrails" BeforeTargets="CoreCompile"
          Condition="'$(PrimeSourceGuards)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(PrimeSourceGuardProject)' != 'false'">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)tools/check-build-guardrails.py&quot; --root &quot;$(MSBuildThisFileDirectory)&quot; --source-only" />
  </Target>
</Project>
