<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The ordinary restore/build graph is desktop-only. Android opts into a
         single Android evaluation through its ProjectReference metadata, so a
         missing or desktop RID can never fan this project out to Android. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(PrimeEnableAndroidPresentation)' == 'true'">net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24</SupportedOSPlatformVersion>
    <RuntimeIdentifiers Condition="'$(PrimeEnableAndroidPresentation)' == 'true'">android-arm64;android-x64</RuntimeIdentifiers>
    <RootNamespace>MphRead</RootNamespace>
    <AssemblyName>ProjectPrime.Client.Presentation</AssemblyName>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- Android uses obj/android for this project's opt-in target. Keep every
         generated obj subtree out of default source discovery in both modes. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Android gives this project a private intermediate directory. Never
         propagate that directory into portable dependencies: they retain
         their own ordinary net10.0 restore graphs. -->
    <ProjectReference Include="../Client.Core/Client.Core.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <ProjectReference Include="../Game/Game.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <ProjectReference Include="../Imaging/Imaging.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <ProjectReference Include="../MapPlatform/MapPlatform.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <ProjectReference Include="../Renderer/Renderer.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <ProjectReference Include="../Server.Shared/Server.Shared.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <ProjectReference Include="../Shared.Replay/Shared.Replay.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <ProjectReference Include="../Audio.Ncsf/Audio.Ncsf.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />

    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="OpenTK" />
    <PackageReference Include="ReFuel.StbImage" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="**/*.axaml" />
    <AvaloniaResource Include="Assets/project-prime-title-screen.png" />
    <AvaloniaResource Include="Assets/project-prime-mark.png" />
    <AvaloniaResource Include="Assets/Cosmetics/**"
                      Exclude="Assets/Cosmetics/DeathAnimations/**" />
    <EmbeddedResource Include="Assets/Cosmetics/DeathAnimations/*.pda"
                      LogicalName="MphRead.Cosmetics.DeathAnimations.%(Filename)%(Extension)" />
    <AvaloniaXaml Include="Launcher/**/*.axaml" />
    <EmbeddedResource Include="Launcher/Resources/PrimeUiCopy.resx"
                      LogicalName="MphRead.Mods.Launcher.Resources.PrimeUiCopy.resources" />
    <Compile Include="../Shared/ContentImport/Extract.cs" Link="Shared/ContentImport/Extract.cs" />
    <Compile Include="../Shared/Imaging/TgaImageDecoder.cs" Link="Shared/Imaging/TgaImageDecoder.cs" />
    <Compile Include="../Shared/Transport/UdpTransport.cs" Link="Shared/Transport/UdpTransport.cs" />
    <Compile Include="../Shared/Hosting/RuntimePlatform.cs" Link="Shared/Hosting/RuntimePlatform.cs" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <!-- These two Renderer files are Android implementations behind compile
         guards; the portable Renderer assembly exposes their contracts. -->
    <Compile Include="../Renderer/Backends/Gles/GlesBackend.cs" Link="Renderer/Backends/Gles/GlesBackend.cs" />
    <Compile Include="../Renderer/Backends/Gles/GlesEnhancedRuntime.cs" Link="Renderer/Backends/Gles/GlesEnhancedRuntime.cs" />
    <Using Include="MphRead.Mods.Render.GlEs" Alias="GL" />
    <Using Include="MphRead.Mods.Sound.AlEs" Alias="AL" />
    <Using Include="MphRead.Mods.Sound.AlcEs" Alias="ALC" />
  </ItemGroup>
</Project>
