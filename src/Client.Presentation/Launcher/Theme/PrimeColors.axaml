<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Project Prime UI tokens. Amber is the product/primary-action identity;
       cyan is reserved for technology, network, and information semantics. -->
  <Styles.Resources>
    <!-- Hierarchy: background, primary/secondary surfaces, interactive
         controls, selection, and modal layers. Existing resource names stay
         available so current shell views keep their appearance while new
         views can choose a deliberate layer. -->
    <SolidColorBrush x:Key="PrimeBackgroundBrush" Color="#080B0F" />
    <SolidColorBrush x:Key="PrimeHeaderBrush" Color="#0A0F14" />
    <SolidColorBrush x:Key="PrimeFooterBrush" Color="#0A0F14" />
    <SolidColorBrush x:Key="PrimeSurfaceBrush" Color="#0F141A" />
    <SolidColorBrush x:Key="PrimePrimarySurfaceBrush" Color="#0F141A" />
    <SolidColorBrush x:Key="PrimeSurfaceRaisedBrush" Color="#1B242D" />
    <SolidColorBrush x:Key="PrimeSurfaceMutedBrush" Color="#0B1016" />
    <SolidColorBrush x:Key="PrimeSecondarySurfaceBrush" Color="#0B1016" />
    <SolidColorBrush x:Key="PrimeControlBrush" Color="#0C1218" />
    <SolidColorBrush x:Key="PrimeInteractiveSurfaceBrush" Color="#141B22" />
    <SolidColorBrush x:Key="PrimeSelectedBrush" Color="#332313" />
    <SolidColorBrush x:Key="PrimeSelectedSurfaceBrush" Color="#332313" />
    <SolidColorBrush x:Key="PrimeNavSelectedBrush" Color="#332313" />
    <SolidColorBrush x:Key="PrimeModalSurfaceBrush" Color="#1B242D" />
    <SolidColorBrush x:Key="PrimePanelBrush" Color="#0F141A" />
    <SolidColorBrush x:Key="PrimePanelRaisedBrush" Color="#1B242D" />
    <SolidColorBrush x:Key="PrimeFocusSurfaceBrush" Color="#10252B" />

    <!-- Brand, technology, content, and state semantics. -->
    <SolidColorBrush x:Key="PrimeBrandBrush" Color="#F29A2E" />
    <SolidColorBrush x:Key="PrimeBrandStrongBrush" Color="#FFB441" />
    <SolidColorBrush x:Key="PrimeBrandSurfaceBrush" Color="#332313" />
    <SolidColorBrush x:Key="PrimeBrandEdgeBrush" Color="#A96822" />
    <SolidColorBrush x:Key="PrimeTechBrush" Color="#19CFE6" />
    <SolidColorBrush x:Key="PrimeTechStrongBrush" Color="#51E6F5" />
    <SolidColorBrush x:Key="PrimeGunmetalBrush" Color="#34424F" />

    <SolidColorBrush x:Key="PrimeTextBrush" Color="#E4E7EA" />
    <SolidColorBrush x:Key="PrimeTextMutedBrush" Color="#9BA3AA" />
    <SolidColorBrush x:Key="PrimeTextDimBrush" Color="#707B84" />
    <SolidColorBrush x:Key="PrimeSuccessBrush" Color="#65D68A" />
    <SolidColorBrush x:Key="PrimeWarningBrush" Color="#FFB057" />
    <SolidColorBrush x:Key="PrimeErrorBrush" Color="#FF6469" />
    <SolidColorBrush x:Key="PrimeDestructiveBrush" Color="#FF6469" />
    <SolidColorBrush x:Key="PrimeInfoBrush" Color="#19CFE6" />
    <SolidColorBrush x:Key="PrimeFocusBrush" Color="#C7F3F8" />
    <SolidColorBrush x:Key="PrimeEdgeBrush" Color="#34424F" />
    <SolidColorBrush x:Key="PrimeEdgeStrongBrush" Color="#596978" />
    <SolidColorBrush x:Key="PrimeDividerBrush" Color="#27313B" />
    <SolidColorBrush x:Key="PrimeDotBrush" Color="#19CFE6" Opacity="0.24" />
    <SolidColorBrush x:Key="PrimeScrimBrush" Color="#D9080B0F" />

    <!-- Transitional aliases for existing views. New code uses Brand, Tech,
         and explicit status tokens instead of the ambiguous Accent/Warm names. -->
    <SolidColorBrush x:Key="PrimeAccentBrush" Color="#F29A2E" />
    <SolidColorBrush x:Key="PrimeAccentStrongBrush" Color="#FFB441" />
    <SolidColorBrush x:Key="PrimeOnBrandBrush" Color="#080B0F" />
    <SolidColorBrush x:Key="PrimeOnAccentBrush" Color="#080B0F" />
    <SolidColorBrush x:Key="PrimeWarmBrush" Color="#FFB057" />
    <SolidColorBrush x:Key="PrimeOrangeBrush" Color="#F29A2E" />
    <x:Double x:Key="PrimeCornerRadius">6</x:Double>
  </Styles.Resources>
</Styles>
