<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prime="clr-namespace:MphRead.Mods.Launcher.Gui"
             x:Class="MphRead.Mods.Launcher.Gui.PrimeShellView"
             x:Name="ShellRoot"
             Focusable="True"
             FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
             Background="{DynamicResource PrimeBackgroundBrush}">
  <UserControl.Styles>
    <StyleInclude Source="avares://ProjectPrime.Client.Presentation/Launcher/Theme/PrimeTheme.axaml" />
  </UserControl.Styles>

  <Grid>
  <!-- One native tree for desktop and Android. The dot grid is a static
       drawing surface; it does not tick, animate, or own any page state. -->
  <Grid x:Name="ShellGrid" RowDefinitions="58,*,34"
        Background="{DynamicResource PrimeBackgroundBrush}">
    <Border x:Name="HeaderBorder" Grid.Row="0" Height="58"
            Background="{DynamicResource PrimeHeaderBrush}"
            BorderBrush="{DynamicResource PrimeEdgeBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,0">
      <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="16" VerticalAlignment="Center">
        <StackPanel x:Name="BrandPanel" Grid.Column="0"
                    Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <prime:PrimeBrandMark Width="30" Height="30"
                                VerticalAlignment="Center" />
          <StackPanel x:Name="BrandTextPanel" Spacing="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="PROJECT PRIME" Classes="prime-brand" />
            </StackPanel>
            <!-- RouteTitle is updated by the shell and remains the only
                 context/status label in this compact brand block. -->
            <TextBlock x:Name="RouteTitle" Text="Gateway" Classes="prime-route-context"
                       IsVisible="False" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="NavPanel" Grid.Column="1"
                    Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

        <StackPanel x:Name="AccountPanel" Grid.Column="2"
                    Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border x:Name="ConnectionChip" Classes="prime-status-chip" VerticalAlignment="Center">
            <TextBlock x:Name="ConnectionText" Text="Offline"
                       Classes="prime-status-text" />
          </Border>
          <Button x:Name="AccountButton" Content="Sign in"
                  Classes="prime-button prime-quiet"
                  MinHeight="44" VerticalAlignment="Center" />
          <Button x:Name="SettingsButton" Content="Settings"
                  Classes="prime-button prime-quiet"
                  MinHeight="44" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <prime:PrimeDotGrid Grid.Row="1" IsHitTestVisible="False"
                        DotBrush="{DynamicResource PrimeDotBrush}"
                        DotSpacing="24" DotRadius="0.8" />

    <!-- PageGrid remains the codebehind's layout anchor. MaxWidth centers a
         readable viewport while preserving a full-width dot-grid surround. -->
    <Grid x:Name="PageGrid" Grid.Row="1" MaxWidth="1440"
          HorizontalAlignment="Stretch" Margin="24,18"
          RowDefinitions="*,Auto">
      <ScrollViewer x:Name="PageScroller" Grid.Row="0" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,0,2">
        <!-- Windowed desktop layouts scale this host before the outer
             scroller is needed. Header, footer, and modal chrome stay at a
             stable readable size. -->
        <LayoutTransformControl x:Name="PageScaleHost"
                                HorizontalAlignment="Stretch">
          <ContentControl x:Name="PageHost" />
        </LayoutTransformControl>
      </ScrollViewer>
      <Grid x:Name="ActionBar" Grid.Row="1"
            HorizontalAlignment="Stretch" Margin="0,10,0,0" />
      <Border x:Name="RouteScanAccent" Grid.RowSpan="2" Height="2"
              VerticalAlignment="Top" HorizontalAlignment="Stretch"
              Background="{DynamicResource PrimeTechBrush}"
              Opacity="0" IsHitTestVisible="False" ZIndex="20" />
    </Grid>

    <!-- Toasts sit above the page viewport so a transient status never
         reflows a form or steals the primary action's position. -->
    <Border x:Name="NotificationBar" Grid.Row="1"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            MaxWidth="540" Margin="24,16"
            IsVisible="False" Classes="prime-notification">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock x:Name="NotificationText" Classes="prime-body"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button x:Name="NotificationDismissButton" Grid.Column="1"
                Content="Dismiss" Classes="prime-button prime-quiet"
                MinHeight="44" MinWidth="44" Margin="0" Padding="8,4" />
      </Grid>
    </Border>

    <Border x:Name="FooterBorder" Grid.Row="2" Height="34"
            Background="{DynamicResource PrimeFooterBrush}"
            BorderBrush="{DynamicResource PrimeEdgeBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16"
            VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="" Classes="prime-system"
                   IsVisible="False"
                   VerticalAlignment="Center" TextWrapping="NoWrap" />
        <TextBlock x:Name="InputHintText" Grid.Column="1"
                   Text="Keyboard / Mouse" Classes="prime-system"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border x:Name="MobileNavigationBorder" Grid.Row="2" Height="72"
            IsVisible="False"
            Background="{DynamicResource PrimeFooterBrush}"
            BorderBrush="{DynamicResource PrimeEdgeBrush}"
            BorderThickness="0,1,0,0"
            Padding="8,4">
      <Grid x:Name="MobileNavPanel" ColumnDefinitions="*,*,*,*"
            ColumnSpacing="8" VerticalAlignment="Stretch" />
    </Border>

    <Border x:Name="OverlayRoot" Grid.RowSpan="3" IsVisible="False"
            Background="{DynamicResource PrimeScrimBrush}"
            Padding="24">
      <ContentControl x:Name="OverlayHost" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
    </Border>
  </Grid>
  <!-- The shell owns this one-time startup layer. Keeping it outside
       ShellGrid prevents route and modal content from receiving input while
       startup restoration is still resolving. -->
  <ContentControl x:Name="TitleHost" IsVisible="False"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch" />
  </Grid>
</UserControl>
