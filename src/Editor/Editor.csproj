<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <OutputType Condition="!$(RuntimeIdentifier.StartsWith('win'))">Exe</OutputType>
    <RootNamespace>ProjectPrime.Editor</RootNamespace>
    <AssemblyName>ProjectPrime.Editor</AssemblyName>
    <Product>Project Prime Editor</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The editor ships inside the public client package. Keep useful managed
         debug information embedded without publishing a standalone PDB. -->
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PrimeMapOwnsMapArtifacts>true</PrimeMapOwnsMapArtifacts>
    <ApplicationIcon Condition="$(RuntimeIdentifier.StartsWith('win'))">../Client/Assets/project-prime.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../Imaging/Imaging.csproj" />
    <ProjectReference Include="../MapPlatform/MapPlatform.csproj" />
    <ProjectReference Include="../Renderer/Renderer.csproj" />
    <PackageReference Include="OpenTK.Mathematics" />
    <PackageReference Include="ppy.SDL3-CS" ExcludeAssets="native" />
    <PackageReference Include="SDL3-CS.Windows" />
    <PackageReference Include="SDL3-CS.Linux" />
    <PackageReference Include="SDL3-CS.MacOS" />
    <None Include="../../WINDOWS_PREREQUISITES.txt"
          Condition="$(RuntimeIdentifier.StartsWith('win'))"
          Link="WINDOWS_PREREQUISITES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
