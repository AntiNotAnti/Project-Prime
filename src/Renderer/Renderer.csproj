<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MphRead</RootNamespace>
    <AssemblyName>ProjectPrime.Renderer</AssemblyName>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(PrimeProtectClient)' != 'true'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../Imaging/Imaging.csproj" />
    <ProjectReference Include="../MapPlatform/MapPlatform.csproj" />
    <PackageReference Include="OpenTK.Mathematics" />
    <PackageReference Include="OpenTK.Windowing.GraphicsLibraryFramework" />
    <PackageReference Include="ReFuel.StbImage" />
    <PackageReference Include="ppy.SDL3-CS" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK owns all C# files under this project. Renderer sources are
         physically local; no Client implementation is source-linked here. -->
    <None Update="Shaders/Generated/**/*" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="Rendering/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Update="Shaders/*.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="Rendering/Shaders/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
