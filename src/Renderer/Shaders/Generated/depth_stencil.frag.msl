#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_AlphaConstants
{
    float4 alphaOptions;
};

struct main_ps_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main_ps_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main_ps_out main_ps(main_ps_in in [[stage_in]], constant type_AlphaConstants& AlphaConstants [[buffer(0)]], texture2d<float> albedoTexture [[texture(0)]], sampler albedoSampler [[sampler(0)]])
{
    main_ps_out out = {};
    float _49;
    if (AlphaConstants.alphaOptions.x > 0.5)
    {
        _49 = albedoTexture.sample(albedoSampler, in.in_var_TEXCOORD0).w * AlphaConstants.alphaOptions.z;
    }
    else
    {
        _49 = AlphaConstants.alphaOptions.z;
    }
    if (AlphaConstants.alphaOptions.y < 1.5)
    {
        if (_49 != 1.0)
        {
            discard_fragment();
        }
    }
    else
    {
        if (_49 >= 1.0)
        {
            discard_fragment();
        }
    }
    out.out_var_SV_Target0 = float4(0.0, 0.0, 0.0, _49);
    return out;
}
