<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MphRead</RootNamespace>
    <AssemblyName>ProjectPrime.MapPlatform</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(PrimeProtectClient)' != 'true'">embedded</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../Imaging/Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/ContentPreparation/CollisionDataEditor.cs" Link="ContentPreparation/CollisionDataEditor.cs" />
    <Compile Include="../Shared/ContentPreparation/RepackModelPacking.cs" Link="ContentPreparation/RepackModelPacking.cs" />
    <Compile Include="../Shared/ContentPreparation/MapTextureBake.cs" Link="ContentPreparation/MapTextureBake.cs" />
    <Compile Include="../Shared/ContentPreparation/MapPreparation.cs" Link="ContentPreparation/MapPreparation.cs" />
    <Compile Include="../Shared/ContentPreparation/MapCollisionPacker.cs" Link="ContentPreparation/MapCollisionPacker.cs" />
    <Compile Include="../Shared/ContentPreparation/MapPacker.cs" Link="ContentPreparation/MapPacker.cs" />
    <Compile Include="../Shared/ContentPreparation/RepackEntityPacking.cs" Link="ContentPreparation/RepackEntityPacking.cs" />
    <Compile Include="../Shared/ContentPreparation/EntityMapEditors.cs" Link="ContentPreparation/EntityMapEditors.cs" />
    <Compile Include="../Shared/ContentPreparation/BuiltMap.cs" Link="ContentPreparation/BuiltMap.cs" />
    <Compile Include="../Shared/ContentPreparation/MapBuilder.cs" Link="ContentPreparation/MapBuilder.cs" />
    <Compile Include="../Shared/ContentPreparation/Q3Bsp.cs" Link="ContentPreparation/Q3Bsp.cs" />
    <Compile Include="../Shared/ContentPreparation/Q3Import.cs" Link="ContentPreparation/Q3Import.cs" />
    <Compile Include="../Shared/ContentPreparation/RawStructs.cs" Link="ContentPreparation/RawStructs.cs" />
    <Compile Include="../Shared/ContentPreparation/MapNodePacker.cs" Link="ContentPreparation/MapNodePacker.cs" />
    <Compile Include="../Shared/Maps/Compilation/*.cs" Link="Compilation/%(Filename)%(Extension)" />
    <Compile Include="../Shared/Maps/Packaging/*.cs" Link="Packaging/%(Filename)%(Extension)" />
    <Compile Include="Properties/AssemblyInfo.cs" />
  </ItemGroup>
</Project>
