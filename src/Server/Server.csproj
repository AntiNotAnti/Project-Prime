<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The server owns its entry point and references only Game. It must not pull
    Avalonia, full OpenTK, ReFuel, SoundFlow or any desktop native runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MphRead</RootNamespace>
    <!-- Dedicated server keeps one stable name on every platform. -->
    <AssemblyName>FruityPrimeServer</AssemblyName>
    <Product>Prime Hunters</Product>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationIcon Condition="$(RuntimeIdentifier.StartsWith('win'))">../Client/Assets/fruity-prime-server.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../Shared.Replay/Shared.Replay.csproj" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <!-- Preserve the existing custom-map bundle in server publishes. Working
       map recipes and source containers remain output-only, never published. -->
  <ItemGroup>
    <None Include="../../maps/**/*.fpmap;../../maps/*.json;../../maps/*.bsp;../../maps/*.tex"
          Link="maps/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../maps/**/*.json;../../maps/**/*.bsp;../../maps/**/*.tex;../../maps/**/*.pk3"
          Exclude="../../maps/*.json;../../maps/*.bsp;../../maps/*.tex"
          Link="maps/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>


  <ItemGroup>
    <Compile Include="../Shared/Transport/UdpTransport.cs" Link="Shared/Transport/UdpTransport.cs" />
    <Compile Include="../Shared/Hosting/BuildVersion.cs" Link="Shared/Hosting/BuildVersion.cs" />
    <Compile Include="../Shared/Hosting/ConsoleSetup.cs" Link="Shared/Hosting/ConsoleSetup.cs" />
    <Compile Include="../Shared/Hosting/RuntimePlatform.cs" Link="Shared/Hosting/RuntimePlatform.cs" />
    <Compile Include="../Shared/Hosting/ServerProcessHost.cs" Link="Shared/Hosting/ServerProcessHost.cs" />
  </ItemGroup>
</Project>
