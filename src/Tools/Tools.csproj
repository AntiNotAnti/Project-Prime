<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tools owns the CLI/export/CPU projection sources after the physical move.
    It references Game and source-links the CPU portion of the renamed NCSF
    tree because the current ROM extractor writes .ncsflib/.minincsf files
    through NCSFCommon.NCSF. It deliberately has no Audio.Ncsf project edge.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MphRead</RootNamespace>
    <AssemblyName>ProjectPrimeTools</AssemblyName>
    <!-- The linked NCSF CPU files use the same implicit-usings setting as the
         current NcsfPlay project. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <!-- Reuse only the CPU NCSF/SDAT closure; do not reference Audio.Ncsf. -->
  <Import Project="Tools.NcsfCpu.sources.props" />

  <ItemGroup>
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../Imaging/Imaging.csproj" />
    <ProjectReference Include="../MapPlatform/MapPlatform.csproj" />
    <!-- These were previously transitive through Audio.Ncsf. Keep them direct
         because Tools now source-links the CPU decoder instead of referencing
         the music-playing assembly. -->
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
    <!-- CPU image/map/movie exports use ReFuel.StbImage. -->
    <PackageReference Include="ReFuel.StbImage" Version="2.1.1" />
  </ItemGroup>


  <ItemGroup>
    <Compile Include="../Shared/ContentImport/Extract.cs" Link="Shared/ContentImport/Extract.cs" />
    <Compile Include="../Shared/Hosting/ConsoleSetup.cs" Link="Shared/Hosting/ConsoleSetup.cs" />
  </ItemGroup>
</Project>
