<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MphRead</RootNamespace>
    <AssemblyName>ProjectPrime</AssemblyName>
    <ApplicationId>com.antinotanti.projectprime</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
    <PrimeMapOwnsMapArtifacts>true</PrimeMapOwnsMapArtifacts>
    <AndroidBuildRuntimeIdentifiersInParallel>false</AndroidBuildRuntimeIdentifiersInParallel>
    <!-- Avalonia 11.3 uses SkiaSharp 2.88; its native page-size warning is tracked separately. -->
    <NoWarn>$(NoWarn);XA0141</NoWarn>
  </PropertyGroup>

  <!-- Protection runs after IL linking. Android AOT resolves its inputs earlier,
       so protected builds deliberately ship IL-only until an SDK-supported
       post-protection AOT hook is available. This is scoped to public clients. -->
  <PropertyGroup Condition="'$(PrimeProtectClient)' == 'true'">
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">android-arm64;android-x64</RuntimeIdentifiers>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidAotMode>None</AndroidAotMode>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidBuildRuntimeIdentifiersInParallel>false</AndroidBuildRuntimeIdentifiersInParallel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Client.Core/Client.Core.csproj" />
    <ProjectReference Include="../Client.Presentation/Client.Presentation.csproj"
                      SetTargetFramework="TargetFramework=net10.0-android36.0" />
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../Imaging/Imaging.csproj" />
    <ProjectReference Include="../MapPlatform/MapPlatform.csproj" />
    <ProjectReference Include="../Renderer/Renderer.csproj" />
    <ProjectReference Include="../Server.Shared/Server.Shared.csproj" />
    <ProjectReference Include="../Shared.Replay/Shared.Replay.csproj" />
    <ProjectReference Include="../Audio.Ncsf/Audio.Ncsf.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="OpenTK" />
    <PackageReference Include="ReFuel.StbImage" />
  </ItemGroup>

  <!-- Android owns only its platform entry points, SDK adapters and native
       surfaces. Cross-platform runtime and presentation compile in the two
       shared Client assemblies above. -->
  <ItemGroup>
    <Compile Include="AndroidApp.cs" />
    <Compile Include="AndroidConsole.cs" />
    <Compile Include="AndroidInput.cs" />
    <Compile Include="AndroidLogShare.cs" />
    <Compile Include="AndroidMaps.cs" />
    <Compile Include="AndroidMatch.cs" />
    <Compile Include="AndroidPng.cs" />
    <Compile Include="AndroidThumbnails.cs" />
    <Compile Include="AndroidUpdateInstaller.cs" />
    <Compile Include="ApkInstaller.cs" />
    <Compile Include="GameView.cs" />
    <Compile Include="GamepadBridge.cs" />
    <Compile Include="MainActivity.cs" />
    <Compile Include="OffscreenGl.cs" />
    <Compile Include="PreviewRun.cs" />
    <Compile Include="PreviewService.cs" />
    <Compile Include="PointerInputRouter.cs" />
    <Compile Include="TouchControls.cs" />
    <Compile Include="TouchOverlayView.cs" />
    <Compile Include="AndroidMapImageDecoder.cs" />
    <Compile Include="AndroidScreenCapture.cs" />
    <Compile Include="AndroidSecureSessionStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Resources/**/*.xml;Resources/**/*.png" />
    <TrimmerRootDescriptor Include="Properties/TrimmerRoots.xml" />
    <AndroidAsset Include="../../maps/*.json;../../maps/*.bsp;../../maps/*.tex"
                  Link="Assets/maps/%(Filename)%(Extension)" />
    <Using Include="MphRead.Mods.Render.GlEs" Alias="GL" />
    <Using Include="MphRead.Mods.Sound.AlEs" Alias="AL" />
    <Using Include="MphRead.Mods.Sound.AlcEs" Alias="ALC" />
  </ItemGroup>

  <!-- Imported for both modes so the first unprotected build after a protected
       publish can invalidate protection-sensitive Android intermediates. -->
  <Import Project="../../build/protection/AndroidClientProtection.targets" />
</Project>
