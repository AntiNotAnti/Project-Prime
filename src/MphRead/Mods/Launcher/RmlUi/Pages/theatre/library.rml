<rml>
<head>
    <title>Project Prime Replay Library</title>
    <link type="text/template" href="../../components/app-shell.rml"/>
    <link type="text/rcss" href="theatre.rcss"/>
</head>
<body template="prime-shell">
    <div id="theatre_page">
        <div class="theatre_heading">
            <div class="eyebrow">THEATRE // REPLAY ARCHIVE</div>
            <h1 id="theatre_title">YOUR RECORDINGS</h1>
            <div id="theatre_summary">SCANNING REPLAY LIBRARY</div>
        </div>
        <div class="theatre_search_bar">
            <input id="theatre_search" class="play_input" type="text" maxlength="512" placeholder="Search replay names, maps and details"/>
            <button id="theatre_search_submit" class="play_action" data-action="theatre:search">SEARCH</button>
            <button id="theatre_clear_search" class="play_action" data-action="theatre:clear-search">CLEAR</button>
        </div>
        <div class="theatre_toolbar">
            <button id="theatre_next_filter" class="play_action" data-action="theatre:next-filter">
                <span id="theatre_filter_label">ALL REPLAYS</span>
            </button>
            <button id="theatre_next_sort" class="play_action" data-action="theatre:next-sort">
                <span id="theatre_sort_label">NEWEST FIRST</span>
            </button>
            <button id="theatre_refresh" class="play_action" data-action="theatre:refresh">REFRESH</button>
        </div>
        <div class="theatre_columns">
            <div class="theatre_library">
                <div id="theatre_empty" class="theatre_notice"/>
                <button id="theatre_entry0" class="theatre_entry" data-action="theatre:entry:0">
                    <b id="theatre_entry0_title"/>
                    <span id="theatre_entry0_detail"/>
                </button>
                <button id="theatre_entry1" class="theatre_entry" data-action="theatre:entry:1">
                    <b id="theatre_entry1_title"/>
                    <span id="theatre_entry1_detail"/>
                </button>
                <button id="theatre_entry2" class="theatre_entry" data-action="theatre:entry:2">
                    <b id="theatre_entry2_title"/>
                    <span id="theatre_entry2_detail"/>
                </button>
                <button id="theatre_entry3" class="theatre_entry" data-action="theatre:entry:3">
                    <b id="theatre_entry3_title"/>
                    <span id="theatre_entry3_detail"/>
                </button>
                <button id="theatre_entry4" class="theatre_entry" data-action="theatre:entry:4">
                    <b id="theatre_entry4_title"/>
                    <span id="theatre_entry4_detail"/>
                </button>
                <button id="theatre_entry5" class="theatre_entry" data-action="theatre:entry:5">
                    <b id="theatre_entry5_title"/>
                    <span id="theatre_entry5_detail"/>
                </button>
                <button id="theatre_entry6" class="theatre_entry" data-action="theatre:entry:6">
                    <b id="theatre_entry6_title"/>
                    <span id="theatre_entry6_detail"/>
                </button>
                <button id="theatre_entry7" class="theatre_entry" data-action="theatre:entry:7">
                    <b id="theatre_entry7_title"/>
                    <span id="theatre_entry7_detail"/>
                </button>
                <div class="theatre_pagination">
                    <button id="theatre_previous_page" class="play_action" data-action="theatre:previous-page">PREVIOUS</button>
                    <span id="theatre_page_number">1 / 1</span>
                    <button id="theatre_next_page" class="play_action" data-action="theatre:next-page">NEXT</button>
                </div>
            </div>
            <div class="theatre_selected">
                <h2 id="theatre_selected_title">SELECT A REPLAY</h2>
                <div id="theatre_hero" class="theatre_hint">ARCHIVE STANDBY</div>
                <div id="theatre_metadata">Choose a recording to see its metadata.</div>
                <div id="theatre_no_preview" class="theatre_hint">Previews are available in full Replay Studio.</div>
                <div class="theatre_actions">
                    <button id="theatre_watch" class="play_action primary" data-action="theatre:watch">WATCH REPLAY</button>
                    <button id="theatre_favorite" class="play_action" data-action="theatre:favorite">TOGGLE FAVORITE</button>
                </div>
                <div class="theatre_actions">
                    <button id="theatre_studio" class="play_action" data-action="theatre:studio">OPEN FULL REPLAY STUDIO</button>
                    <button id="theatre_import" class="play_action" data-action="theatre:import">IMPORT / ADVANCED TOOLS</button>
                </div>
                <p class="theatre_hint">Studio handles virtual clips, recovery, integrity checks, video export, thumbnails, and file editing.</p>
            </div>
        </div>
        <div id="theatre_status" class="theatre_notice"/>
        <div id="theatre_error" class="theatre_notice theatre_error"/>
        <div id="theatre_launch_problem" class="theatre_notice theatre_error"/>
        <button id="theatre_cancel_job" class="play_action" data-action="theatre:cancel-job">CANCEL SCAN / CHECK</button>
        <div class="theatre_navigation">
            <button class="play_action" data-action="route:home">HOME</button>
        </div>
    </div>
</body>
</rml>