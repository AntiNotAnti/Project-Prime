<rml><head><title>Replay library</title><link type="text/template" href="../../components/app-shell.rml"/><link type="text/rcss" href="theatre.rcss"/></head>
<body template="prime-shell"><div id="theatre_page">
<div class="theatre_heading"><div class="eyebrow">THEATRE // REPLAY ARCHIVE</div><h1 id="theatre_title">REPLAY LIBRARY</h1><div id="theatre_summary"/></div>
<div class="theatre_search_bar"><input id="theatre_search" class="play_input" type="text" maxlength="512" placeholder="Find maps, hunters, players, tags..."/><button id="theatre_search_submit" class="play_action" data-action="theatre:search">SEARCH</button><button id="theatre_clear_search" class="play_action" data-action="theatre:clear-search">CLEAR</button></div>
<div class="theatre_toolbar"><button id="theatre_next_filter" class="play_action" data-action="theatre:next-filter"><span id="theatre_filter_label"/></button><button id="theatre_next_sort" class="play_action" data-action="theatre:next-sort"><span id="theatre_sort_label"/></button><button id="theatre_refresh" class="play_action" data-action="theatre:refresh">REFRESH</button><button id="theatre_import" class="play_action" data-action="theatre:import">IMPORT FILE</button></div>
<div class="theatre_columns"><div class="theatre_library"><div id="theatre_empty" class="theatre_notice"/><button id="theatre_entry0" class="theatre_entry" data-action="theatre:entry:0"><b id="theatre_entry0_title"/><span id="theatre_entry0_detail"/></button>
<button id="theatre_entry1" class="theatre_entry" data-action="theatre:entry:1"><b id="theatre_entry1_title"/><span id="theatre_entry1_detail"/></button>
<button id="theatre_entry2" class="theatre_entry" data-action="theatre:entry:2"><b id="theatre_entry2_title"/><span id="theatre_entry2_detail"/></button>
<button id="theatre_entry3" class="theatre_entry" data-action="theatre:entry:3"><b id="theatre_entry3_title"/><span id="theatre_entry3_detail"/></button>
<button id="theatre_entry4" class="theatre_entry" data-action="theatre:entry:4"><b id="theatre_entry4_title"/><span id="theatre_entry4_detail"/></button>
<button id="theatre_entry5" class="theatre_entry" data-action="theatre:entry:5"><b id="theatre_entry5_title"/><span id="theatre_entry5_detail"/></button>
<button id="theatre_entry6" class="theatre_entry" data-action="theatre:entry:6"><b id="theatre_entry6_title"/><span id="theatre_entry6_detail"/></button>
<button id="theatre_entry7" class="theatre_entry" data-action="theatre:entry:7"><b id="theatre_entry7_title"/><span id="theatre_entry7_detail"/></button>
<div class="theatre_pagination"><button id="theatre_previous_page" class="play_action" data-action="theatre:previous-page">PREVIOUS</button><span id="theatre_page_number"/><button id="theatre_next_page" class="play_action" data-action="theatre:next-page">NEXT</button></div>
<div class="theatre_actions"><button id="theatre_favorite_filtered" class="play_action" data-action="theatre:favorite-filtered">FAVORITE FILTERED</button><button id="theatre_validate_filtered" class="play_action" data-action="theatre:validate-filtered">CHECK FILTERED</button></div><p id="theatre_batch_hint" class="theatre_hint"/><div id="theatre_insights" class="theatre_hint"/></div>
<div class="theatre_selected"><h2 id="theatre_selected_title"/><div id="theatre_hero" class="theatre_hint"/>
<div class="theatre_preview_panel"><img id="theatre_preview"/><div id="theatre_no_preview"/></div><div class="theatre_thumbnails"><button id="theatre_thumbnail0" class="theatre_thumbnail" data-action="theatre:thumbnail:0"><img id="theatre_thumbnail_image0"/><span>PREVIEW 1</span></button>
<button id="theatre_thumbnail1" class="theatre_thumbnail" data-action="theatre:thumbnail:1"><img id="theatre_thumbnail_image1"/><span>PREVIEW 2</span></button>
<button id="theatre_thumbnail2" class="theatre_thumbnail" data-action="theatre:thumbnail:2"><img id="theatre_thumbnail_image2"/><span>PREVIEW 3</span></button></div>
<div id="theatre_metadata"/>
<div class="theatre_actions"><button id="theatre_watch" class="play_action primary" data-action="theatre:watch">WATCH</button><button id="theatre_favorite" class="play_action" data-action="theatre:favorite">FAVORITE</button><button id="theatre_validate" class="play_action" data-action="theatre:validate">CHECK INTEGRITY</button><button id="theatre_recover" class="play_action" data-action="theatre:recover">RECOVER RECORDING</button><button id="theatre_export" class="play_action" data-action="theatre:export">EXPORT</button><button id="theatre_studio" class="play_action" data-action="theatre:studio">OPEN STUDIO</button><button id="theatre_reveal" class="play_action" data-action="theatre:reveal">SHOW FILE</button><button id="theatre_delete" class="play_action danger" data-action="theatre:delete">DELETE</button></div>
<div class="play_form_label">REPLAY NAME</div><input id="theatre_name" class="play_input" type="text" maxlength="180"/><button id="theatre_rename" class="play_action" data-action="theatre:rename">SAVE NAME</button>
<div class="play_form_label">TAGS // COMMA SEPARATED</div><input id="theatre_tags" class="play_input" type="text" maxlength="2048"/>
<div class="play_form_label">COLLECTIONS // COMMA SEPARATED</div><input id="theatre_collections" class="play_input" type="text" maxlength="2048"/><button id="theatre_organize" class="play_action" data-action="theatre:organize">SAVE ORGANIZATION</button>
</div></div>
<div id="theatre_status" class="theatre_notice"/><div id="theatre_error" class="theatre_notice theatre_error"/><div id="theatre_launch_problem" class="theatre_notice theatre_error"/><button id="theatre_cancel_job" class="play_action" data-action="theatre:cancel-job">CANCEL OPERATION</button>
<div class="theatre_import_row"><label class="play_form_label">LOCAL REPLAY PATH</label><input id="theatre_import_path" class="play_input" type="text" maxlength="2048"/><button id="theatre_import_submit" class="play_action" data-action="theatre:import-path">OPEN PATH</button></div>
<div class="theatre_navigation"><button class="play_action" data-action="route:home">HOME</button></div>
</div></body></rml>