" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_49" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_50" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_51" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_52" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_53" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_54" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_55" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_56" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_57" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_58" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_59" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_60" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_61" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_62" class="curve_point curve_y_0"/><span id="replay_camera_curve_speed_63" class="curve_point curve_y_0"/></div><h3>PREVIEW MOTION</h3><p>Speed, collision and Director change the current preview and export camera. Wait for a new picture and refresh before saving another track edit.</p><div class="theatre_actions"><button id="replay_camera_tools_speed" class="play_action" data-action="replay:camera-tools-constant-speed">CONSTANT SPEED</button><button id="replay_camera_tools_collision" class="play_action" data-action="replay:camera-tools-collision">PATH COLLISION</button><button id="replay_camera_tools_director" class="play_action" data-action="replay:camera-tools-director">DIRECTOR</button></div><p id="replay_camera_tools_status"/><p id="replay_camera_tools_error" class="bookmark_error"/><button id="replay_camera_tools_close" class="play_action" data-action="replay:camera-tools-close">RETURN TO CAMERA</button></div></div><div id="studio_inspector_markers" class="studio_inspector_section"><h3>EVENT SEARCH</h3><input id="studio_event_search" type="text" maxlength="128" placeholder="Search recorded event types" data-submit="replay:workspace-event-search"/><button id="studio_event_search_apply" class="play_action" data-action="replay:workspace-event-search">FIND EVENTS</button><h3>REPLAY TAGS</h3><input id="studio_replay_tags" type="text" maxlength="1024" placeholder="Comma-separated tags"/><button id="studio_replay_tags_save" class="play_action" data-action="replay:workspace-replay-tags-save">SAVE TAGS</button><p id="studio_marker_metadata_status"/><h3>TIMELINE TRACKS</h3><div class="studio_transport_row"><button id="studio_track_camera" class="play_action" data-action="replay:workspace-track-camera">CAMERA</button><button id="studio_track_events" class="play_action" data-action="replay:workspace-track-events">EVENTS</button><button id="studio_track_bookmarks" class="play_action" data-action="replay:workspace-track-bookmarks">BOOKMARKS</button><button id="studio_track_ranges" class="play_action" data-action="replay:workspace-track-ranges">ANNOTATIONS</button><button id="studio_track_reel" class="play_action" data-action="replay:workspace-track-reel">REEL</button><button id="studio_track_kills" class="play_action" data-action="replay:workspace-track-kills">KILLS</button><button id="studio_track_damage" class="play_action" data-action="replay:workspace-track-damage">DAMAGE</button><button id="studio_track_shots" class="play_action" data-action="replay:workspace-track-shots">SHOTS</button><button id="studio_track_spawns" class="play_action" data-action="replay:workspace-track-spawns">SPAWNS</button><button id="studio_track_objectives" class="play_action" data-action="replay:workspace-track-objectives">OBJECTIVES</button><button id="studio_track_audio" class="play_action" data-action="replay:workspace-track-audio">AUDIO</button><button id="studio_track_cuts" class="play_action" data-action="replay:workspace-track-cuts">CUTS</button><button id="studio_track_exportrange" class="play_action" data-action="replay:workspace-track-exportrange">EXPORT RANGE</button></div><div id="replay_bookmark_panel" class="prime_dialog">
<h2>REPLAY BOOKMARKS</h2><p>Save a moment at the playhead, then jump back to it later.</p>
<label for="replay_bookmark_name">Bookmark name</label><input id="replay_bookmark_name" class="play_input" type="text" maxlength="80" value=""/>
<div class="theatre_actions"><button id="replay_bookmark_add" class="play_action primary" data-action="replay:bookmark-add">ADD AT PLAYHEAD</button><button id="replay_bookmark_refresh" class="play_action" data-action="replay:bookmark-refresh">REFRESH</button></div>
<p id="replay_bookmark_count"/><p id="replay_bookmark_selected"/>
<div class="theatre_actions"><button id="replay_bookmark_previous" class="play_action" data-action="replay:bookmark-previous">PREVIOUS</button><button id="replay_bookmark_next" class="play_action" data-action="replay:bookmark-next">NEXT</button><button id="replay_bookmark_jump" class="play_action" data-action="replay:bookmark-jump">JUMP TO BOOKMARK</button><button id="replay_bookmark_remove" class="play_action danger" data-action="replay:bookmark-remove">REMOVE...</button></div>
<p id="replay_bookmark_status"/><p id="replay_bookmark_error" class="bookmark_error"/>
<button id="replay_bookmark_close" class="play_action" data-action="replay:bookmark-cancel">RETURN TO PLAYBACK</button>
</div><div id="replay_range_panel" class="prime_dialog">
<h2>REPLAY RANGE</h2><p id="replay_range_replay"/><p id="replay_range_selection"/>
<div class="theatre_actions"><button id="replay_range_mark_in" class="play_action" data-action="replay:mark-in">MARK IN AT PLAYHEAD</button><button id="replay_range_mark_out" class="play_action" data-action="replay:mark-out">MARK OUT AT PLAYHEAD</button></div>
<label for="replay_range_name">Highlight or clip name</label><input id="replay_range_name" class="play_input" type="text" maxlength="80" value=""/>
<div class="theatre_actions"><button id="replay_range_highlight" class="play_action primary" data-action="replay:range-save-highlight">SAVE NAMED HIGHLIGHT</button><button id="replay_range_virtual" class="play_action primary" data-action="replay:range-create-virtual">CREATE VIRTUAL CLIP</button></div>
<div class="theatre_actions"><button id="replay_range_materialized" class="play_action primary" data-action="replay:range-save-materialized">SAVE REPLAY CLIP</button><button id="replay_range_cancel_save" class="play_action" data-action="replay:range-cancel-materialized">CANCEL CLIP SAVE</button></div>
<p>A replay clip is a standalone recording. A virtual clip refers to the original replay, which must be kept to watch it later.</p>
<p id="replay_range_status"/><p id="replay_range_error" class="bookmark_error"/>
<div class="theatre_actions"><button id="replay_range_refresh" class="play_action" data-action="replay:range-refresh">REFRESH SELECTION</button><button id="replay_range_close" class="play_action" data-action="replay:range-cancel">RETURN TO PLAYBACK</button></div>
</div><div id="replay_editor_panel" class="prime_dialog"><h2>MARKERS &amp; REEL</h2><div class="studio_transport_row"><button id="studio_editor_tab_Events" class="play_action" data-action="replay:workspace-editor-tab-Events">EVENTS</button><button id="studio_editor_tab_AutomaticHighlights" class="play_action" data-action="replay:workspace-editor-tab-AutomaticHighlights">AUTOMATICHIGHLIGHTS</button><button id="studio_editor_tab_NamedHighlights" class="play_action" data-action="replay:workspace-editor-tab-NamedHighlights">NAMEDHIGHLIGHTS</button><button id="studio_editor_tab_Reel" class="play_action" data-action="replay:workspace-editor-tab-Reel">REEL</button><button id="studio_editor_tab_Analytics" class="play_action" data-action="replay:workspace-editor-tab-Analytics">ANALYTICS</button></div><p id="replay_editor_replay"/><p>Inspect recorded events, automatic highlights and analytics. Assemble a saved reel for the Video Export panel. Playback uses the current replay.</p>
<div class="theatre_actions"><button id="replay_editor_refresh" class="play_action" data-action="replay:editor-refresh">REFRESH REVIEW</button><button id="replay_editor_tab" class="play_action" data-action="replay:editor-tab">VIEW</button><button id="replay_editor_player" class="play_action" data-action="replay:editor-player">PLAYER</button><button id="replay_editor_filter" class="play_action" data-action="replay:editor-event-filter">EVENTS</button></div>
<p id="replay_editor_review"/><p id="replay_editor_count"/><p id="replay_editor_entries"/><h3>SELECTED ENTRY</h3><p id="replay_editor_selected"/>
<div class="theatre_actions"><button id="replay_editor_previous" class="play_action" data-action="replay:editor-previous">PREVIOUS ENTRY</button><button id="replay_editor_next" class="play_action" data-action="replay:editor-next">NEXT ENTRY</button><button id="replay_editor_seek" class="play_action" data-action="replay:editor-seek">SEEK TO ENTRY</button><button id="replay_editor_select_range" class="play_action" data-action="replay:editor-select-range">USE ENTRY RANGE</button></div>
<h3>REEL ASSEMBLY</h3><p class="theatre_hint">Pause playback and refresh the review before saving edits. Mark In and Out define the range used by Add and Trim.</p><label for="replay_editor_name">NEW SEGMENT NAME</label><input id="replay_editor_name" type="text" maxlength="80"/>
<div class="theatre_actions"><button id="replay_editor_add_selection" class="play_action" data-action="replay:editor-add-selection-to-reel">ADD REVIEWED MARKS...</button><button id="replay_editor_add_highlight" class="play_action" data-action="replay:editor-add-highlight-to-reel">ADD THIS HIGHLIGHT...</button><button id="replay_editor_add_top" class="play_action" data-action="replay:editor-add-top-highlights">ADD TOP 8 HIGHLIGHTS...</button></div>
<div class="theatre_actions"><button id="replay_editor_move_up" class="play_action" data-action="replay:editor-move-up">MOVE EARLIER...</button><button id="replay_editor_move_down" class="play_action" data-action="replay:editor-move-down">MOVE LATER...</button><button id="replay_editor_trim" class="play_action" data-action="replay:editor-trim">TRIM TO REVIEWED MARKS...</button><button id="replay_editor_camera" class="play_action" data-action="replay:editor-cycle-camera">CYCLE SEGMENT CAMERA...</button><button id="replay_editor_remove" class="play_action danger" data-action="replay:editor-remove">REMOVE SEGMENT...</button><button id="replay_editor_clear" class="play_action danger" data-action="replay:editor-clear-reel">CLEAR REEL...</button><button id="replay_editor_remove_named" class="play_action danger" data-action="replay:editor-remove-named-highlight">REMOVE NAMED HIGHLIGHT...</button></div>
