<rml><head><title>Review camera track edit</title><link type="text/template" href="../../components/dialog.rml"/><link type="text/rcss" href="theatre.rcss"/><link type="text/rcss" href="camera-tools.rcss"/></head><body template="prime-dialog"><div id="replay_camera_tools_confirm_panel" class="prime_dialog"><h2 id="replay_camera_tools_confirm_title"/><p>Review the complete saved track change. Recorded gameplay is preserved.</p><h3>BEFORE</h3><p id="replay_camera_tools_confirm_before"/><h3>AFTER</h3><p id="replay_camera_tools_confirm_after"/><p id="replay_camera_tools_confirm_error" class="bookmark_error"/><button id="replay_camera_tools_confirm_apply" class="play_action" data-action="replay:camera-tools-confirm">SAVE REVIEWED TRACK</button><button id="replay_camera_tools_confirm_cancel" class="play_action" data-action="replay:camera-tools-cancel">KEEP CURRENT TRACK</button></div></body></rml>