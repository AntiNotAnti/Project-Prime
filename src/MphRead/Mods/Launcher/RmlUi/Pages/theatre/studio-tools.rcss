#replay_studio_panel { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:760dp; max-width:92%; max-height:92%; overflow-y:auto; box-sizing:border-box; padding:12dp; background-color:#081523; border:1dp #41667f; }
#replay_studio_panel p, #replay_studio_panel label { display:block; white-space:pre-wrap; margin:8dp 0; }
#replay_studio_panel input { display:block; width:96%; min-height:32dp; margin-bottom:8dp; color:#edf7ff; background-color:#14283a; border:1dp #29485e; }
