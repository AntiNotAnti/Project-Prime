n id="replay_camera_curve_key_0_29" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_30" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_31" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_32" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_33" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_34" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_35" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_36" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_37" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_38" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_39" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_40" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_41" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_42" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_43" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_44" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_45" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_46" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id="replay_camera_curve_key_0_47" class="curve_key" data-action="replay:camera-tools-curve-key"/><button id=