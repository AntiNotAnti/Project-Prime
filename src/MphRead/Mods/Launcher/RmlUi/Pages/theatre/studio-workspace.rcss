#studio_workspace { position:absolute; left:0; top:0; width:100%; height:100%; display:flex; flex-direction:column; padding:6dp; box-sizing:border-box; background-color:transparent; color:#e5f1fb; }
#studio_transport { flex-shrink:0; background-color:#06111c; }
.studio_title { flex:1; min-width:0; padding:4dp; font-size:15dp; line-height:19dp; font-weight:bold; letter-spacing:1dp; }
.studio_title span { margin-left:6dp; font-size:12dp; letter-spacing:0; }
.studio_transport_row { display:flex; flex-wrap:wrap; align-items:center; gap:3dp; }
#studio_workspace .play_action, #studio_workspace #replay_timeline_panel button { min-height:30dp; padding:5dp 8dp; margin:2dp 0; font-size:12dp; }
#studio_workspace p { font-size:12dp; line-height:16dp; white-space:pre-wrap; margin:4dp 0; }
#studio_workspace h2 { font-size:16dp; line-height:20dp; margin:4dp 0; }
#studio_workspace h3 { font-size:13dp; line-height:17dp; margin:8dp 0 4dp; color:#9dd9fd; }
#studio_frame { width:65dp; }
#studio_workspace input { min-height:30dp; box-sizing:border-box; border:1dp #3b657f; background-color:#102b3e; color:#e5f1fb; padding:3dp 5dp; }
#studio_workspace #replay_position { flex:1; min-width:120dp; margin:2dp 6dp; }
#studio_notice { color:#9db8cc; }
#studio_main { display:flex; flex:1; min-height:64dp; overflow:hidden; }
#studio_workspace #replay_viewport { position:relative; left:auto; top:auto; right:auto; bottom:auto; transform:none; flex:1 1 0; width:auto; height:auto; min-width:0; min-height:64dp; margin:4dp 6dp 4dp 0; background-color:transparent; border:1dp #24465c; }
#studio_inspector { display:flex; flex-direction:column; width:360dp; max-width:46%; min-width:220dp; background-color:#0a1a29; border:1dp #284a62; }
#studio_workspace #studio_tabs { display:flex; flex-wrap:nowrap; flex-shrink:0; overflow-x:auto; overflow-y:hidden; padding:4dp; border-bottom:1dp #284a62; }
#studio_workspace #studio_tabs button { flex-shrink:0; width:auto; min-width:76dp; margin-right:4dp; }
#studio_tabs button.selected { background-color:#1b5267; border-color:#64d9cb; }
#studio_inspector_scroll { flex:1; min-height:0; overflow-y:auto; padding:8dp; }
.studio_numeric_grid { display:flex; flex-wrap:wrap; gap:4dp; }
.studio_numeric_grid label { display:block; width:30%; color:#b9d3e6; font-size:12dp; }
.studio_numeric_grid input { display:block; width:100%; }
#studio_timeline { flex-shrink:0; height:180dp; max-height:32%; min-height:100dp; border-top:1dp #36617a; background-color:#081725; }
#studio_workspace #replay_timeline_panel { position:relative; left:auto; top:auto; transform:none; width:100%; max-width:none; height:100%; max-height:none; padding:4dp; overflow:hidden; box-sizing:border-box; }
#studio_workspace #replay_timeline_panel h2 { display:none; }
#studio_workspace #replay_timeline_panel p { font-size:12dp; line-height:15dp; margin:1dp 0; }
#studio_workspace #replay_timeline_surface p { display:none; }
#studio_workspace .timeline_actions { gap:2dp; margin:1dp 0; }
#studio_workspace #replay_camera_panel, #studio_workspace #replay_camera_tools_panel, #studio_workspace #replay_editor_panel, #studio_workspace #replay_bookmark_panel, #studio_workspace #replay_range_panel, #studio_workspace #replay_export_panel, #studio_workspace #replay_spatial_panel, #studio_workspace #replay_studio_panel { position:relative; left:auto; top:auto; right:auto; bottom:auto; transform:none; width:100%; max-width:none; height:auto; max-height:none; min-height:0; overflow:visible; display:block; margin:0 0 8dp; padding:0; border:0; background-color:transparent; box-sizing:border-box; }
#studio_workspace #replay_spatial_plot { overflow:visible; }
#studio_workspace #replay_heatmap { margin:6dp auto; }
#studio_workspace #replay_camera_close, #studio_workspace #replay_camera_tools_close, #studio_workspace #replay_editor_close, #studio_workspace #replay_bookmark_close, #studio_workspace #replay_range_close, #studio_workspace #replay_export_close, #studio_workspace #replay_spatial_close, #studio_workspace #replay_studio_close, #studio_workspace #replay_timeline_close { display:none; }
#studio_workspace #replay_error { color:#ffb79c; }
#studio_workspace #replay_inactive { position:absolute; top:45%; width:60%; text-align:center; background-color:#081725; }

#studio_workspace #replay_timeline_focus, #studio_workspace #replay_timeline_selection, #studio_workspace #replay_timeline_status { display:none; }
#studio_workspace #replay_timeline_panel > label, #studio_workspace #replay_timeline_frame, #studio_workspace #replay_timeline_seek { display:none; }
#studio_workspace #replay_timeline_panel > .timeline_actions { display:none; }
#studio_workspace #replay_timeline_panel #replay_timeline_toolbar { display:flex; }
#studio_workspace .timeline_lane { height:16dp; margin-bottom:1dp; }
#studio_workspace .studio_track_label { position:absolute; left:2dp; top:0; font-size:11dp; line-height:14dp; color:#c9e3ef; background-color:#102235; z-index:3; pointer-events:none; }

/* Keep lower tracks reachable in short windows while transport stays fixed. */
#studio_workspace #replay_timeline_panel { display:flex; flex-direction:column; min-height:0; }
#studio_workspace #replay_timeline_toolbar { flex-shrink:0; }
#studio_workspace #replay_timeline_surface { flex:1; min-height:0; overflow-y:auto; overflow-x:hidden; }
#studio_workspace #replay_timeline_panel .timeline_marker { min-height:0; padding:0; margin:0; border:0; }
.studio_choices { display:flex; flex-wrap:wrap; gap:3dp; margin-bottom:5dp; }
.studio_choices button { flex:0 0 auto; min-width:28dp; }
.studio_choices button.selected { border-color:#64d9cb; background-color:#1b5267; }
#studio_workspace #replay_camera_tools_interpolation, #studio_workspace #replay_camera_tools_ease, #studio_workspace #replay_camera_tools_lookat { display:none; }
#studio_workspace #studio_event_search, #studio_workspace #studio_replay_tags, #studio_workspace #replay_studio_music_file, #studio_workspace #replay_export_executable { display:block; width:100%; margin:4dp 0; }

/* Navigation, transport and seeking stay separate from the scrolling inspector. */
.studio_heading { display:flex; align-items:center; justify-content:space-between; border-bottom:1dp #24465c; }
.studio_navigation { display:flex; flex-shrink:0; gap:4dp; }
.studio_navigation .play_action { flex-shrink:0; }
#studio_workspace .studio_playback_controls,#studio_workspace .studio_seek_controls { flex-wrap:nowrap; overflow-x:auto; overflow-y:hidden; flex-shrink:0; }
#studio_workspace .studio_transport_row > button,#studio_workspace .studio_transport_row > label,#studio_workspace .studio_transport_row > span,#studio_frame { flex-shrink:0; }
.studio_feedback { max-height:36dp; overflow-y:auto; font-size:12dp; line-height:16dp; padding:0 4dp; }
#studio_workspace .studio_feedback p { margin:0; }

#studio_workspace #replay_timeline_toolbar { flex-wrap:nowrap; overflow-x:auto; overflow-y:hidden; }
#studio_workspace #replay_timeline_toolbar button { flex-shrink:0; }
@media (max-width:800dp) {
 #studio_workspace { padding:4dp; }
 #studio_workspace .studio_title { font-size:13dp; line-height:16dp; }
 #studio_workspace .studio_title span { font-size:12dp; }
 #studio_workspace .studio_navigation .play_action { padding:5dp 6dp; }
 #studio_workspace #studio_inspector { width:46%; min-width:180dp; max-width:48%; }
 #studio_workspace #studio_inspector_scroll { padding:6dp; }
 #studio_workspace #replay_viewport { margin-right:4dp; }
 #studio_workspace .studio_numeric_grid label { width:46%; }
}
@media (max-height:520dp) {
 #studio_workspace #studio_timeline { height:88dp; min-height:72dp; max-height:30%; }
 #studio_workspace .studio_title { max-height:48dp; overflow-y:auto; }
 #studio_workspace .studio_feedback { max-height:20dp; }
 #studio_workspace #studio_inspector_scroll { padding:4dp; }
}
.touch-targets #studio_workspace .play_action,.touch-targets #studio_workspace input { min-height:48dp; }
.touch-targets #studio_workspace .studio_choices button { min-width:48dp; }
.touch-targets #studio_workspace #replay_timeline_toolbar button { min-height:48dp; }
.large-text #studio_workspace button, .large-text #studio_workspace input,
.large-text #studio_workspace label { font-size:16dp; line-height:20dp; }
.large-text #studio_workspace p { font-size:16dp; line-height:21dp; }
.large-text #studio_workspace .studio_track_label { font-size:14dp; line-height:18dp; }
.large-text #studio_workspace .timeline_lane { height:20dp; }

@media (max-height:400dp) {
 .touch-targets #studio_workspace #studio_timeline { height:72dp; min-height:64dp; }
 /* On the shortest touch viewport the timeline scrolls as a whole, so its
    toolbar cannot consume the entire track area. Every lane remains reachable. */
 .touch-targets #studio_workspace #replay_timeline_panel,
 .large-text #studio_workspace #replay_timeline_panel { overflow-y:auto; }
 .touch-targets #studio_workspace #replay_timeline_surface,
 .large-text #studio_workspace #replay_timeline_surface { flex:0 0 auto; overflow-y:visible; }
}

#studio_transport_controls { display:flex; flex-direction:column; }
@media (max-width:800dp) and (max-height:520dp) {
 #studio_workspace #studio_transport_controls { flex-direction:row; overflow-x:auto; overflow-y:hidden; }
 #studio_workspace .studio_playback_controls { flex:0 0 auto; min-width:440dp; overflow:visible; }
 #studio_workspace .studio_seek_controls { flex:0 0 auto; min-width:330dp; overflow:visible; }
 #studio_workspace #replay_position { flex:0 0 160dp; width:160dp; }
 #studio_workspace .studio_navigation .play_action { min-width:0; }
 #studio_workspace .studio_title { word-break:break-word; }
 #studio_workspace .studio_feedback { max-height:16dp; }
 #studio_workspace #studio_main { min-height:96dp; }
 .touch-targets #studio_workspace #studio_main { min-height:112dp; }
 .touch-targets #studio_workspace #studio_timeline { height:64dp; min-height:64dp; }
}
