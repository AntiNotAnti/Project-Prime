<rml><head><title>Confirm export operation</title><link type="text/template" href="../../components/dialog.rml"/><link type="text/rcss" href="theatre.rcss"/></head>
<body template="prime-dialog"><div id="replay_export_confirm_panel" class="prime_dialog"><h2 id="replay_export_confirm_title"/><p id="replay_export_confirm_exact"/><p id="replay_export_confirm_note"/><p id="replay_export_confirm_error" class="bookmark_error"/><div class="theatre_actions"><button id="replay_export_confirm_cancel" class="play_action" data-action="replay:export-cancel-confirm">CANCEL</button><button id="replay_export_confirm_apply" class="play_action danger" data-action="replay:export-confirm">CONFIRM REVIEWED JOBS</button></div></div></body></rml>