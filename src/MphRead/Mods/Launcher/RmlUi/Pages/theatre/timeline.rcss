#replay_timeline_panel { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:920dp; max-width:96%; max-height:94%; overflow-y:auto; padding:10dp; box-sizing:border-box; background-color:#081523; border:1dp #41667f; }
#replay_timeline_panel p { white-space:pre-wrap; margin:4dp 0; }
#replay_timeline_panel h2 { margin:4dp 0; }
.timeline_actions { display:flex; flex-wrap:wrap; gap:4dp; margin:4dp 0; }
#replay_timeline_panel button { padding:5dp; min-height:26dp; color:#edf7ff; background-color:#14283a; border:1dp #41667f; }
#replay_timeline_panel button:focus { border-color:#ffffff; }
#replay_timeline_panel button:disabled { opacity:0.45; }
#replay_timeline_surface { display:block; padding:2dp; }
.timeline_lane { position:relative; width:100%; height:24dp; overflow:hidden; background-color:#14283a; box-sizing:border-box; }
#replay_timeline_panel .timeline_marker { display:block; position:absolute; padding:0; min-height:0; margin:0; border:0; box-sizing:border-box; font-size:8dp; white-space:nowrap; overflow:hidden; color:#ffffff; background-color:#7c91bd; }
#replay_timeline_panel .camera_marker { background-color:#6fb7c8; }
#replay_timeline_panel .bookmarks_lane .timeline_marker { background-color:#9772d4; }
#replay_timeline_panel .ranges_lane .timeline_marker { background-color:#b9974b; }
#replay_timeline_panel .reel_lane .timeline_marker { background-color:#65a478; }
.timeline_ghost { display:block; position:absolute; opacity:0.5; pointer-events:none; }
.timeline_playhead { position:absolute; background-color:#ffffff; pointer-events:none; }
#replay_timeline_frame { width:80dp; min-height:28dp; color:#edf7ff; background-color:#14283a; }
