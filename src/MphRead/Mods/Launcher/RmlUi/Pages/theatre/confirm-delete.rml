<rml><head><title>Delete replay</title><link type="text/template" href="../../components/dialog.rml"/><link type="text/rcss" href="theatre.rcss"/></head>
<body template="prime-dialog"><div id="theatre_confirmation" class="prime_dialog"><h2 id="theatre_delete_title"/><p>This removes the selected archive and its replay artifacts.</p><div id="theatre_delete_path" class="theatre_hint"/><div class="theatre_actions"><button id="theatre_cancel_delete" class="play_action" data-action="theatre:cancel-delete">CANCEL</button><button id="theatre_confirm_delete" class="play_action danger" data-action="theatre:confirm-delete">DELETE</button></div></div></body></rml>