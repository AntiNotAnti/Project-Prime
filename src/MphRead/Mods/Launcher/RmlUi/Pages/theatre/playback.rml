<rml><head><title>Replay playback</title><link type="text/template" href="../../components/app-shell.rml"/><link type="text/rcss" href="theatre.rcss"/></head>
<body template="prime-shell"><div id="replay_page"><div class="replay_heading"><div class="eyebrow">THEATRE // PLAYBACK</div><span id="replay_state"/><span id="replay_time"/></div>
<div id="replay_viewport" tabindex="0"><div id="replay_inactive">OPEN A REPLAY TO BEGIN</div></div>
<div id="replay_controls"><input id="replay_position" type="range" min="0" max="1000" step="1" value="0" data-action="replay:seek"/>
<div class="theatre_actions"><button id="replay_pause" class="play_action primary" data-action="replay:toggle-pause">PAUSE</button><button id="replay_jump_back" class="play_action" data-action="replay:jump-back">−10S</button><button id="replay_jump_forward" class="play_action" data-action="replay:jump-forward">+10S</button><button id="replay_restart" class="play_action" data-action="replay:restart">RESTART</button><button id="replay_step" class="play_action" data-action="replay:step">STEP</button><button id="replay_rate" class="play_action" data-action="replay:next-rate">SPEED</button></div>
<div class="theatre_actions"><button id="replay_camera" class="play_action" data-action="replay:next-camera">CAMERA</button><button id="replay_previous_player" class="play_action" data-action="replay:previous-player">PREVIOUS PLAYER</button><button id="replay_next_player" class="play_action" data-action="replay:next-player">NEXT PLAYER</button><button id="replay_studio" class="play_action" data-action="replay:studio">OPEN STUDIO</button><button id="replay_fullscreen" class="play_action" data-action="replay:fullscreen">FULLSCREEN</button><button id="replay_back" class="play_action" data-action="replay:back">LIBRARY</button></div>
<p class="theatre_hint">Click the preview to focus the camera. Drag to look; WASD moves, E/V moves vertically, Shift moves faster. Escape releases camera focus. Configured replay shortcuts remain available.</p><div id="replay_error" class="theatre_notice theatre_error"/>
</div></div></body></rml>