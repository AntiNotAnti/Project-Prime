<rml><head><title>Replay Studio tools</title><link type="text/template" href="../../components/dialog.rml"/><link type="text/rcss" href="theatre.rcss"/><link type="text/rcss" href="studio-tools.rcss"/></head>
<body template="prime-dialog"><div id="replay_studio_panel" class="prime_dialog"><h2>STUDIO TOOLS</h2><p id="replay_studio_source"/>
<button id="replay_studio_operation" class="play_action" data-action="replay:studio-tools-operation">OPERATION</button><p id="replay_studio_help"/>
<label for="replay_studio_input">INPUT FILE (WAV, REPLAY OR BUILD EVIDENCE AS DESCRIBED ABOVE)</label><input id="replay_studio_input" type="text" maxlength="2048"/>
<label for="replay_studio_overlay">OPTIONAL REPLAY OVERLAY WAV (STARTS AT REVIEWED IN FRAME)</label><input id="replay_studio_overlay" type="text" maxlength="2048"/>
<h3>AUDIO SETTINGS</h3><button id="replay_studio_audio_enabled" class="play_action" data-action="replay:studio-audio-enabled">AUDIO ENABLED</button><label for="replay_studio_music_file">MUSIC WAV</label><input id="replay_studio_music_file" type="text" maxlength="4096"/><button id="studio_music_choose" class="play_action" data-action="replay:workspace-music-choose">CHOOSE MUSIC WAV</button><button id="replay_studio_audio_save" class="play_action" data-action="replay:studio-audio-save">SAVE AUDIO SETTINGS</button><h3>AUDIO BUS GAINS (0–4)</h3><label for="replay_studio_game">GAME</label><input id="replay_studio_game" type="text" maxlength="8"/><label for="replay_studio_combat">COMBAT</label><input id="replay_studio_combat" type="text" maxlength="8"/><label for="replay_studio_replay">REPLAY</label><input id="replay_studio_replay" type="text" maxlength="8"/><label for="replay_studio_music">MUSIC</label><input id="replay_studio_music" type="text" maxlength="8"/>
<div class="theatre_actions"><button id="replay_studio_game_events" class="play_action" data-action="replay:studio-tools-game-events">GAME EVENT CUES</button><button id="replay_studio_combat_feedback" class="play_action" data-action="replay:studio-tools-combat-feedback">HEADSHOT FEEDBACK</button></div>
<p class="theatre_hint">Game cues render weapon, damage, spawn and death events. Combat feedback uses recorded headshots. Music loops your optional WAV. Replay plays your optional overlay WAV once at the reviewed In frame.</p>
<h3>CUSTOM RECORDED EVENT WAV CUES</h3>
<p class="theatre_hint">Bind a recorded event to a local PCM16/float32 WAV. Optional integer value matches only that event value. Cues and their bus/gain are saved for this recording; WAV files stay local.</p>
<button id="replay_studio_cue_event" class="play_action" data-action="replay:studio-cue-event">EVENT</button><p id="replay_studio_cue_values"/>
<label for="replay_studio_cue_wave">ABSOLUTE CUE WAV PATH</label><input id="replay_studio_cue_wave" type="text" maxlength="2048"/><button id="studio_cue_choose" class="play_action" data-action="replay:workspace-cue-choose">CHOOSE CUE WAV</button>
<button id="replay_studio_cue_bus" class="play_action" data-action="replay:studio-cue-bus">CUE BUS</button>
<label for="replay_studio_cue_gain">CUE GAIN (0–4)</label><input id="replay_studio_cue_gain" type="text" maxlength="8"/>
<label for="replay_studio_cue_value">OPTIONAL RECORDED VALUE (BLANK MATCHES ALL)</label><input id="replay_studio_cue_value" type="text" maxlength="16"/>
<div class="theatre_actions"><button id="replay_studio_cue_add" class="play_action" data-action="replay:studio-cue-add">ADD CUE</button><button id="replay_studio_cue_update" class="play_action" data-action="replay:studio-cue-update">UPDATE SELECTED</button><button id="replay_studio_cue_remove" class="play_action" data-action="replay:studio-cue-remove">REMOVE SELECTED</button></div>
<p id="replay_studio_cue_list"/>
<div class="theatre_actions"><button id="replay_studio_cue_previous" class="play_action" data-action="replay:studio-cue-previous">PREVIOUS CUE</button><button id="replay_studio_cue_next" class="play_action" data-action="replay:studio-cue-next">NEXT CUE</button></div>
<div class="theatre_actions"><button id="replay_studio_run" class="play_action primary" data-action="replay:studio-tools-run">RUN REVIEWED OPERATION</button><button id="replay_studio_cancel" class="play_action" data-action="replay:studio-tools-cancel">CANCEL JOB</button><button id="replay_studio_close" class="play_action" data-action="replay:studio-tools-close">RETURN TO EDITOR</button></div>
<div class="theatre_actions"><button id="replay_studio_preview" class="play_action" data-action="replay:studio-tools-preview">PREVIEW REVIEWED MIX</button><button id="replay_studio_stop_preview" class="play_action" data-action="replay:studio-tools-stop-preview">STOP PREVIEW</button></div><p id="replay_studio_status"/><p id="replay_studio_output"/><p id="replay_studio_error" class="bookmark_error"/></div></body></rml>
