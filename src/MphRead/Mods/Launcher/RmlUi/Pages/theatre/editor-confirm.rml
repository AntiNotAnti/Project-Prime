<rml><head><title>Review replay metadata change</title><link type="text/template" href="../../components/dialog.rml"/><link type="text/rcss" href="theatre.rcss"/><link type="text/rcss" href="editor.rcss"/></head>
<body template="prime-dialog"><div id="replay_editor_confirm_panel" class="prime_dialog"><h2 id="replay_editor_confirm_title"/><p>This changes the saved replay metadata. Recorded gameplay stays preserved.</p><h3>BEFORE</h3><p id="replay_editor_confirm_before"/><h3>AFTER</h3><p id="replay_editor_confirm_after"/><p id="replay_editor_confirm_error" class="bookmark_error"/><div class="theatre_actions"><button id="replay_editor_confirm_apply" class="play_action danger" data-action="replay:editor-confirm">SAVE REVIEWED CHANGE</button><button id="replay_editor_confirm_cancel" class="play_action" data-action="replay:editor-cancel">KEEP CURRENT METADATA</button></div></div></body></rml>
