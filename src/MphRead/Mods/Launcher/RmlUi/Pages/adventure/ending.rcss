#campaign_ending_page {
    position: absolute; left: 5%; right: 5%; top: 5%; bottom: 4%;
    display: flex; flex-direction: column; padding: 16dp 20dp;
    background-color: rgba(2, 9, 16, 94%);
}
#campaign_ending_page h1, #campaign_ending_page h2, #campaign_ending_page p {
    display: block; width: 82vw;
}
#campaign_ending_heading { flex-shrink: 0; margin: 6dp 0 10dp; color: #ffffff; font-size: 30dp; line-height: 34dp; }
#campaign_ending_continue { flex-shrink: 0; margin: 0 0 12dp; min-height: 40dp; }
#campaign_ending_scroll { flex: 1; min-height: 0dp; overflow-y: auto; padding: 4dp 10dp 12dp 0; }
#campaign_ending_page h2 { margin: 8dp 0; color: #72c7ff; font-size: 22dp; line-height: 26dp; }
#campaign_ending_page p { margin: 6dp 0 12dp; color: #d5eaff; line-height: 22dp; }
.campaign_ending_summary { margin-bottom: 20dp; border-bottom: 1dp rgba(114, 199, 255, 25%); }
#campaign_ending_totals, #campaign_ending_credits { white-space: pre-wrap; word-break: break-word; }
#campaign_ending_credits { font-size: 15dp; line-height: 22dp; }
@media (max-width: 780dp) {
    #campaign_ending_page { left: 2%; right: 2%; top: 2%; bottom: 2%; padding: 10dp 12dp; }
    #campaign_ending_page h1, #campaign_ending_page h2, #campaign_ending_page p { width: 85vw; }
    #campaign_ending_heading { font-size: 23dp; line-height: 26dp; }
    #campaign_ending_continue { font-size: 14dp; }
}
@media (max-height: 620dp) {
    #campaign_ending_page { top: 2%; bottom: 2%; padding-top: 8dp; padding-bottom: 8dp; }
    #campaign_ending_heading { font-size: 23dp; line-height: 26dp; margin: 3dp 0 6dp; }
    #campaign_ending_continue { min-height: 34dp; margin-bottom: 6dp; }
}
