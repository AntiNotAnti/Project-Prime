<rml><head><title>PREPARE SELECTED RELEASE?</title><link type="text/template" href="../../components/dialog.rml"/><link type="text/rcss" href="setup.rcss"/></head><body template="prime-dialog"><div class="setup_dialog"><h1>PREPARE SELECTED RELEASE?</h1><p id="setup_confirm_message"/><div class="dialog_actions"><button id="setup_confirm_cancel" class="play_action quiet" data-action="setup:action:11">CANCEL</button><button id="setup_confirm_yes" class="play_action" data-action="setup:action:9">PREPARE</button></div></div></body></rml>