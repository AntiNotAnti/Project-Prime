.setup_workspace { position: absolute; left: 5%; top: 5%; width: 90%; height: 90%; padding: 22dp; background-color: rgba(2, 9, 17, 95%); border: 1dp #29465b; }
.setup_heading { display: flex; justify-content: space-between; align-items: center; width: 100%; height: 70dp; }
.setup_heading h1 { font-size: 27dp; }
.setup_heading button { width: 150dp; height: 40dp; }
.setup_columns { display: flex; flex-direction: row; width: 100%; height: 65%; }
.setup_panel { width: 49%; height: 100%; overflow: auto; padding: 12dp 20dp 12dp 12dp; }
.setup_panel + .setup_panel { margin-left: 2%; border-left: 1dp #254157; }
.setup_panel h2 { font-size: 22dp; margin-bottom: 12dp; }
.setup_panel h3 { margin-top: 16dp; margin-bottom: 8dp; font-size: 16dp; }
.setup_panel p { margin: 9dp 0dp; font-size: 14dp; color: #afc6d8; }
.setup_hint { color: #7994ab; }
.setup_panel button { display: block; width: 100%; height: 37dp; margin: 7dp 0dp; font-size: 13dp; }
.setup_panel label { display: block; margin: 10dp 0dp 5dp; font-size: 13dp; }
.setup_panel input { display: block; width: 100%; height: 33dp; }
.setup_path { white-space: pre-wrap; }
.setup_versions { width: 100%; max-height: 135dp; overflow: auto; }
.setup_release { text-align: left; padding-left: 12dp; background-color: #0c1c2c; color: #b8d4e7; border: 1dp #203d53; }
.setup_release.selected, .setup_release:hover, .setup_release:focus { background-color: #123a52; border-color: #61bdd3; }
.setup_notes { white-space: pre-wrap; font-size: 13dp; line-height: 1.4; color: #93adc0; width: 100%; max-height: 130dp; overflow: auto; }
.setup_status, .setup_error, .setup_progress { width: 100%; min-height: 20dp; padding-top: 5dp; font-size: 13dp; }
.setup_status { color: #a8d7cf; }.setup_error { color: #ff9189; }.setup_progress { color: #a9c6db; }
.setup_log { width: 100%; height: 11%; overflow: auto; white-space: pre-wrap; font-size: 11dp; color: #7895aa; }
.setup_dialog { position: absolute; left: 22%; top: 26%; width: 56%; padding: 28dp; background-color: #07121f; border: 1dp #284d68; }
.setup_dialog h1 { font-size: 25dp; margin-bottom: 15dp; }.setup_dialog p { white-space: pre-wrap; color: #b3c8da; line-height: 1.4; margin-bottom: 18dp; }
.setup_dialog .dialog_actions { display: flex; justify-content: flex-end; width: 100%; }.setup_dialog button { width: 42%; height: 42dp; margin-left: 10dp; }

/* In-app progress/status, driven only by the verified installer controller. */
#setup_update_overlay { position: absolute; right: 5%; bottom: 9%; width: 42%; min-width: 290dp; padding: 20dp; background-color: #091e2c; border: 1dp #69bce4; border-top: 3dp #74caff; border-radius: 4dp; box-shadow: 0 10dp 28dp rgba(0,0,0,65%); z-index: 20; }
.setup_update_heading { display: flex; justify-content: space-between; color: #91c9e9; font-size: 11dp; letter-spacing: 1dp; font-weight: bold; }
#setup_update_stage { color: #ffffff; margin: 12dp 0; font-size: 19dp; }
#setup_update_message { color: #bfd4e2; font-size: 13dp; line-height: 19dp; margin: 11dp 0; white-space: pre-wrap; }
.setup_progress_segments { display: flex; gap: 4dp; height: 10dp; width: 100%; }
.setup_progress_segment { display: inline-block; flex: 1; height: 8dp; border-radius: 2dp; background-color: #213b4c; border: 1dp #355064; }
.setup_progress_segment.filled { background-color: #66c5f2; border-color: #99e0ff; }
.setup_update_actions { display: flex; gap: 10dp; }
.setup_update_actions button { flex: 1; min-width: 0; padding: 9dp; font-size: 11dp; border-radius: 3dp; }
@media (max-width: 800dp) { #setup_update_overlay { width: 86%; left: 7%; right: 7%; bottom: 8%; min-width: 0; } }
@media (max-height: 710dp) { #setup_update_overlay { bottom: 5%; padding: 12dp; } }
