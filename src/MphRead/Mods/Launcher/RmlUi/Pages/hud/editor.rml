<rml><head><title>HUD Studio</title><link type="text/template" href="../../components/app-shell.rml"/><link type="text/rcss" href="editor.rcss"/></head><body template="prime-shell"><div id="hud_page"><div class="hud_header"><div><h1 id="hud_title">HUD STUDIO</h1><p id="hud_intro" class="hud_intro">All HUD settings in one place. Use in settings, then Apply to activate.</p><p id="hud_live_preview_help" class="hud_help">Available while editing settings during a match.</p></div><div class="hud_toolbar"><button id="hud_undo" class="play_action" data-action="hud:undo">UNDO</button><button id="hud_redo" class="play_action" data-action="hud:redo">REDO</button><button id="hud_use" class="play_action" data-action="hud:use">USE IN SETTINGS</button><button id="hud_live_preview" class="play_action" data-action="settings:action:246">PREVIEW IN GAME (60s)</button><button id="hud_cancel" class="play_action" data-action="hud:cancel">CANCEL</button></div></div><div class="hud_workspace_tabs"><button id="hud_workspace_elements" class="play_action" data-action="hud:workspace-elements">HUD ELEMENTS</button><button id="hud_workspace_profiles" class="play_action" data-action="hud:workspace-profiles">PRESETS &amp; SHARING</button></div><div id="hud_elements_workspace"><div class="hud_element_rail"><h2>ELEMENTS</h2><p class="hud_help">Select an element or click the preview.</p><div class="hud_element_choices"><button id="hud_pick0" class="hud_pick" data-action="hud:element:0"/>

