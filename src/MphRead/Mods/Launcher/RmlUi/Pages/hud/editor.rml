<rml><head><title>HUD editor</title><link type="text/template" href="../../components/app-shell.rml"/><link type="text/rcss" href="editor.rcss"/></head><body template="prime-shell"><div id="hud_page"><h1 id="hud_title">HUD STUDIO</h1><p id="hud_intro" class="hud_intro">Build a profile, then use it in Settings. Apply your settings to activate it.</p><div class="hud_toolbar"><button id="hud_preset" class="play_action" data-action="hud:next-preset">PRESET</button><button id="hud_undo" class="play_action" data-action="hud:undo">UNDO</button><button id="hud_redo" class="play_action" data-action="hud:redo">REDO</button><button id="hud_lock_all" class="play_action" data-action="hud:lock-all">LOCK ALL</button><button id="hud_unlock_all" class="play_action" data-action="hud:unlock-all">UNLOCK ALL</button><button id="hud_align_left" class="play_action" data-action="hud:align-left">ALIGN LEFT</button><button id="hud_align_top" class="play_action" data-action="hud:align-top">ALIGN TOP</button><button id="hud_native_elements" class="play_action" data-action="hud:native-elements">USE NATIVE ELEMENTS</button><button id="hud_reset_hud" class="play_action" data-action="hud:reset-hud">RESET HUD</button><button id="hud_use" class="play_action" data-action="hud:use">USE IN SETTINGS</button><button id="hud_cancel" class="play_action" data-action="hud:cancel">CANCEL</button></div>
<div id="hud_main"><div class="hud_preview_column"><div class="hud_toolbar"><button id="hud_aspect" class="play_action" data-action="hud:next-aspect">ASPECT</button><button id="hud_hunter" class="play_action" data-action="hud:next-hunter">HUNTER</button><button id="hud_scenario" class="play_action" data-action="hud:next-scenario">SCENARIO</button><button id="hud_grid" class="play_action" data-action="hud:next-grid">GRID</button><button id="hud_guides" class="play_action" data-action="hud:toggle-guides">SNAP GUIDES</button><button id="hud_palette" class="play_action" data-action="hud:next-palette">PALETTE</button></div><div id="hud_canvas" tabindex="0" data-focus-scroll="none"><img id="hud_preview"/><div id="hud_surface"/><div id="hud_element0" class="hud_element" tabindex="0" data-action="hud:element:0"><span id="hud_element0_label"></span></div>
<div id="hud_element1" class="hud_element" tabindex="0" data-action="hud:element:1"><span id="hud_element1_label">99</span></div>
<div id="hud_element2" class="hud_element" tabindex="0" data-action="hud:element:2"><span id="hud_element2_label">80</span></div>
<div id="hud_element3" class="hud_element" tabindex="0" data-action="hud:element:3"><span id="hud_element3_label">POWER BEAM / VOLT DRIVER / MISSILE / IMPERIALIST</span></div>
<div id="hud_element4" class="hud_element" tabindex="0" data-action="hud:element:4"><span id="hud_element4_label"></span></div>
<div id="hud_element5" class="hud_element" tabindex="0" data-action="hud:element:5"><span id="hud_element5_label">SCORE 5 / 7</span></div>
<div id="hud_element6" class="hud_element" tabindex="0" data-action="hud:element:6"><span id="hud_element6_label">03:42</span></div>
<div id="hud_element7" class="hud_element" tabindex="0" data-action="hud:element:7"><span id="hud_element7_label">Hunter > Rival / Rival > Player</span></div>
<div id="hud_element8" class="hud_element" tabindex="0" data-action="hud:element:8"><span id="hud_element8_label">DOUBLE KILL</span></div>
<div id="hud_element9" class="hud_element" tabindex="0" data-action="hud:element:9"><span id="hud_element9_label">RIVAL / HEALTH</span></div>
<div id="hud_element10" class="hud_element" tabindex="0" data-action="hud:element:10"><span id="hud_element10_label">OBJECTIVE</span></div>
<div id="hud_element11" class="hud_element" tabindex="0" data-action="hud:element:11"><span id="hud_element11_label">144 FPS</span></div>
<div id="hud_element12" class="hud_element" tabindex="0" data-action="hud:element:12"><span id="hud_element12_label"></span></div>
<div id="hud_element13" class="hud_element" tabindex="0" data-action="hud:element:13"><span id="hud_element13_label"></span></div><div id="hud_guide_x"/><div id="hud_guide_y"/></div><p class="hud_preview_note">Crosshair, meter and radar geometry is shared with the game. Other preview elements are schematic.</p><div id="hud_preview_warning" class="hud_error"/><div class="hud_toolbar"><button id="hud_nudge_left" class="play_action" data-action="hud:nudge-left">LEFT</button><button id="hud_nudge_right" class="play_action" data-action="hud:nudge-right">RIGHT</button><button id="hud_nudge_up" class="play_action" data-action="hud:nudge-up">UP</button><button id="hud_nudge_down" class="play_action" data-action="hud:nudge-down">DOWN</button><button id="hud_scale_down" class="play_action" data-action="hud:scale-down">SMALLER</button><button id="hud_scale_up" class="play_action" data-action="hud:scale-up">LARGER</button></div><div class="hud_element_choices"><button id="hud_pick0" class="hud_pick" data-action="hud:element:0"/>
<button id="hud_pick1" class="hud_pick" data-action="hud:element:1"/>
<button id="hud_pick2" class="hud_pick" data-action="hud:element:2"/>
<button id="hud_pick3" class="hud_pick" data-action="hud:element:3"/>
<button id="hud_pick4" class="hud_pick" data-action="hud:element:4"/>
<button id="hud_pick5" class="hud_pick" data-action="hud:element:5"/>
<button id="hud_pick6" class="hud_pick" data-action="hud:element:6"/>
<button id="hud_pick7" class="hud_pick" data-action="hud:element:7"/>
<button id="hud_pick8" class="hud_pick" data-action="hud:element:8"/>
<button id="hud_pick9" class="hud_pick" data-action="hud:element:9"/>
<button id="hud_pick10" class="hud_pick" data-action="hud:element:10"/>
<button id="hud_pick11" class="hud_pick" data-action="hud:element:11"/>
<button id="hud_pick12" class="hud_pick" data-action="hud:element:12"/>
<button id="hud_pick13" class="hud_pick" data-action="hud:element:13"/></div><div id="hud_status"/><div id="hud_error" class="hud_error"/>
<div class="play_form_label">PROFILE NAME</div><input id="hud_name" class="play_input" type="text" maxlength="64"/><div class="hud_toolbar"><button id="hud_save_named" class="play_action" data-action="hud:save-named">SAVE NAMED PROFILE</button><button id="hud_load_named" class="play_action" data-action="hud:load-named">LOAD NAMED PROFILE</button></div>
<div class="play_form_label">PROFILE JSON / CROSSHAIR SHARE CODE</div><textarea id="hud_json" class="play_input" maxlength="131072"/><div class="hud_toolbar"><button id="hud_export_json" class="play_action" data-action="hud:export-json">EXPORT JSON</button><button id="hud_import_json" class="play_action" data-action="hud:import-json">IMPORT JSON</button><button id="hud_share_crosshair" class="play_action" data-action="hud:share-crosshair">SHARE CROSSHAIR</button><button id="hud_import_crosshair" class="play_action" data-action="hud:import-crosshair">IMPORT CROSSHAIR</button></div></div>
<div class="hud_inspector"><h2 id="hud_selected"/><div class="hud_toolbar"><button id="hud_visible" class="play_action" data-action="hud:toggle-visible">VISIBLE</button><button id="hud_locked" class="play_action" data-action="hud:toggle-lock">LOCK</button><button id="hud_anchor" class="play_action" data-action="hud:next-anchor">ANCHOR</button><button id="hud_visibility" class="play_action" data-action="hud:next-visibility">VISIBILITY</button><button id="hud_reset_element" class="play_action" data-action="hud:reset-element">RESET ELEMENT</button><button id="hud_reset_section" class="play_action" data-action="hud:reset-section">RESET SECTION</button></div><div class="hud_layout_fields"><label class="play_form_label">X</label><input id="hud_x" class="play_input" type="text" maxlength="32"/><label class="play_form_label">Y</label><input id="hud_y" class="play_input" type="text" maxlength="32"/><label class="play_form_label">SCALE</label><input id="hud_scale" class="play_input" type="text" maxlength="32"/><label class="play_form_label">OPACITY</label><input id="hud_opacity" class="play_input" type="text" maxlength="32"/><label class="play_form_label">COLOR // #RRGGBB</label><input id="hud_color" class="play_input" type="text" maxlength="32"/><span id="hud_color_swatch"/></div><button id="hud_apply_layout" class="play_action" data-action="hud:apply-layout">APPLY LAYOUT</button>
<div id="hud_crosshair_controls"><div class="hud_toolbar"><button id="hud_crosshair_target" class="play_action" data-action="hud:next-crosshair-target">DEFAULT</button><button id="hud_crosshair_override" class="play_action" data-action="hud:toggle-crosshair-override">OVERRIDE</button><button id="hud_crosshair_preset" class="play_action" data-action="hud:next-crosshair-preset">CROSSHAIR PRESET</button></div></div><button id="hud_radar_preset" class="play_action" data-action="hud:next-radar-preset">RADAR PRESET</button>
<h3>PROFILE PROPERTIES</h3><p class="hud_help">Select a property to edit. All values use the HUD profile validator; contexts accept comma-separated names.</p><button id="hud_property0" class="hud_property" data-action="hud:property:0"><span id="hud_property0_label"/><b id="hud_property0_value"/></button>
<button id="hud_property1" class="hud_property" data-action="hud:property:1"><span id="hud_property1_label"/><b id="hud_property1_value"/></button>
<button id="hud_property2" class="hud_property" data-action="hud:property:2"><span id="hud_property2_label"/><b id="hud_property2_value"/></button>
<button id="hud_property3" class="hud_property" data-action="hud:property:3"><span id="hud_property3_label"/><b id="hud_property3_value"/></button>
<button id="hud_property4" class="hud_property" data-action="hud:property:4"><span id="hud_property4_label"/><b id="hud_property4_value"/></button>
<button id="hud_property5" class="hud_property" data-action="hud:property:5"><span id="hud_property5_label"/><b id="hud_property5_value"/></button>
<button id="hud_property6" class="hud_property" data-action="hud:property:6"><span id="hud_property6_label"/><b id="hud_property6_value"/></button>
<button id="hud_property7" class="hud_property" data-action="hud:property:7"><span id="hud_property7_label"/><b id="hud_property7_value"/></button><div class="hud_toolbar"><button id="hud_property_previous" class="play_action" data-action="hud:property-previous">PREVIOUS</button><span id="hud_property_page"/><button id="hud_property_next" class="play_action" data-action="hud:property-next">NEXT</button></div><div id="hud_property_label"/><div id="hud_property_help"/><input id="hud_property_value" class="play_input" type="text" maxlength="256"/><div class="hud_toolbar"><button id="hud_property_apply" class="play_action" data-action="hud:property-apply">APPLY VALUE</button><button id="hud_property_reset" class="play_action" data-action="hud:property-reset">RESET VALUE</button></div></div></div></div></body></rml>