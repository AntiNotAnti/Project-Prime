<div id="hud_element25" class="hud_element" tabindex="0" data-action="hud:element:25"><span id="hud_element25_label"></span></div><div id="hud_guide_x"/><div id="hud_guide_y"/></div><p id="hud_safe_area_label" class="hud_preview_note"/><p class="hud_preview_note">Drag to move. Shift-click groups; arrows nudge; Ctrl+Z/Y undo/redo. Some preview artwork is schematic.</p><div id="hud_preview_warning" class="hud_error"/><div class="hud_toolbar"><button id="hud_nudge_left" class="play_action" data-action="hud:nudge-left">NUDGE LEFT</button><button id="hud_nudge_right" class="play_action" data-action="hud:nudge-right">NUDGE RIGHT</button><button id="hud_nudge_up" class="play_action" data-action="hud:nudge-up">NUDGE UP</button><button id="hud_nudge_down" class="play_action" data-action="hud:nudge-down">NUDGE DOWN</button><button id="hud_scale_down" class="play_action" data-action="hud:scale-down">SCALE DOWN</button><button id="hud_scale_up" class="play_action" data-action="hud:scale-up">SCALE UP</button></div><div class="hud_toolbar"><button id="hud_lock_all" class="play_action" data-action="hud:lock-all">LOCK ALL</button><button id="hud_unlock_all" class="play_action" data-action="hud:unlock-all">UNLOCK ALL</button><button id="hud_align_left" class="play_action" data-action="hud:align-left">ALIGN LEFT</button><button id="hud_align_top" class="play_action" data-action="hud:align-top">ALIGN TOP</button></div></div><div class="hud_inspector"><h2 id="hud_selected"/><div class="hud_section_tabs"><button id="hud_section_appearance" class="play_action" data-action="hud:section-appearance">APPEARANCE</button><button id="hud_section_layout" class="play_action" data-action="hud:section-layout">POSITION &amp; VISIBILITY</button><button id="hud_section_global" class="play_action" data-action="hud:section-global">HUD-WIDE</button><button id="hud_section_typography" class="play_action" data-action="hud:section-typography">LETTERING</button><button id="hud_section_decorations" class="play_action" data-action="hud:section-decorations">DECORATIONS</button></div><div class="hud_search"><input id="hud_property_search" class="play_input" type="text" maxlength="128" placeholder="Find a setting in this section"/><button id="hud_search" class="play_action" data-action="hud:search-properties">FIND</button><button id="hud_clear_search" class="play_action" data-action="hud:clear-search">CLEAR</button></div><div id="hud_section_title"/><div class="hud_inspector_scroll"><div id="hud_appearance_controls"><div id="hud_crosshair_controls"><div class="hud_toolbar"><div class="hud_choice"><button id="hud_crosshair_target_previous" class="play_action" data-action="hud:previous-crosshair-target">‹</button><button id="hud_crosshair_target" class="play_action" data-action="hud:next-crosshair-target">DEFAULT</button></div><button id="hud_crosshair_override" class="play_action" data-action="hud:toggle-crosshair-override">OVERRIDE</button><div class="hud_choice"><button id="hud_crosshair_preset_previous" class="play_action" data-action="hud:previous-crosshair-preset">‹</button><button id="hud_crosshair_preset" class="play_action" data-action="hud:next-crosshair-preset">CROSSHAIR PRESET</button></div></div></div><div id="hud_radar_controls"><div class="hud_choice"><button id="hud_radar_preset_previous" class="play_action" data-action="hud:previous-radar-preset">‹</button><button id="hud_radar_preset" class="play_action" data-action="hud:next-radar-preset">RADAR PRESET</button></div></div></div><div id="hud_global_controls"><div class="hud_toolbar"><div class="hud_choice"><button id="hud_palette_previous" class="play_action" data-action="hud:previous-palette">‹</button><button id="hud_palette" class="play_action" data-action="hud:next-palette">PALETTE</button></div><button id="hud_native_elements" class="play_action" data-action="hud:native-elements">USE NATIVE ELEMENTS</button></div></div><p id="hud_property_empty" class="hud_help">No settings in this section match your search.</p><div id="hud_property0" class="hud_property"><div class="hud_property_heading"><label id="hud_property0_label" for="hud_property0_input"/><button id="hud_property0_info" class="play_action hud_info" data-action="hud:property:72" aria-label="Explain this setting">i</button></div><div class="hud_property_editor"><button id="hud_property0_previous" class="play_action hud_inline_arrow" data-action="hud:property:8" title="Previous value">&#8249;</button><button id="hud_property0_choice" class="play_action hud_choice_value" data-action="hud:property:16"/><input id="hud_property0_slider" class="hud_slider" type="range" min="0" max="1000" step="1" value="0" data-action="hud:property:0"/><span id="hud_property0_number" class="hud_number"/><button id="hud_property0_exact" class="play_action hud_exact" data-action="hud:property:80" title="Enter an exact value">#</button><button id="hud_property0_color" class="play_action hud_color" data-action="hud:property:32">PALETTE</button><input id="hud_property0_input" class="play_input" type="text" maxlength="256"/><button id="hud_property0_next" class="play_action hud_inline_arrow" data-action="hud:property:16" title="Next value">&#8250;</button><button id="hud_property0_reset" class="play_action hud_inline_reset" data-action="hud:property:24" title="Reset this setting">RESET</button></div><p id="hud_property0_help" class="hud_property_hint"/></div><div id="hud_property1" class="hud_property"><div class="hud_property_heading"><label id="hud_property1_label" for="hud_property1_input"/><button id="hud_property1_info" class="play_action hud_info" data-action="hud:property:73" aria-label="Explain this setting">i</button></div><div class="hud_property_editor"><button id="hud_property1_previous" class="play_action hud_inline_arrow" data-action="hud:property:9" title="Previous value">&#8249;</button><button id="hud_property1_choice" class="play_action hud_choice_value" data-action="hud:property:17"/><input id="hud_property1_slider" cl