/* Full-screen editors retain the underlying workspace without letting its
   headings, fields or footer bleed through their own document surface. */
body { background-color:#030c14; }
#hud_page { position:absolute; top:1%; bottom:1%; left:1%; right:1%; display:flex; flex-direction:column; padding:12dp; background-color:rgba(2,9,16,98%); color:#d5eaff; }
#hud_page h1, #hud_page h2, #hud_page p { display:block; }
#hud_page h1 { margin:0 0 3dp; color:#ffffff; font-size:24dp; line-height:28dp; }
#hud_page h2 { margin:0 0 8dp; color:#ffffff; font-size:17dp; line-height:21dp; }
.hud_header { display:flex; flex-shrink:0; align-items:center; justify-content:space-between; }
.hud_intro { margin:0; color:#b2cadc; font-size:12dp; line-height:17dp; }
.hud_toolbar, .hud_workspace_tabs, .hud_section_tabs { display:flex; flex-wrap:wrap; align-items:center; margin:4dp 0; flex-shrink:0; }
#hud_page .play_action { min-height:30dp; padding:6dp 8dp; font-size:11dp; margin:0 4dp 4dp 0; background-color:#123047; border:1dp #31566c; color:#d5eaff; }
#hud_page .play_action:hover, #hud_page .play_action:focus { background-color:#24556c; border-color:#8cd4e3; color:#ffffff; }
#hud_page .play_action.selected { background-color:#1a4559; border-color:#55e18c; color:#ffffff; }
#hud_use { background-color:#176377; }
.hud_workspace_tabs { padding-bottom:6dp; border-bottom:1dp #31566c; }
#hud_elements_workspace { display:flex; flex:1; min-height:0; margin-top:8dp; }
.hud_element_rail { width:14%; flex-shrink:0; margin-right:12dp; overflow-y:auto; }
.hud_preview_column { width:43%; flex-shrink:0; margin-right:12dp; overflow-y:auto; }
.hud_inspector { display:flex; flex-direction:column; flex:1; min-width:0; padding:10dp; border:1dp #21445e; background-color:#041321; }
.hud_inspector > h2 { flex-shrink:0; }
.hud_inspector_scroll { flex:1; min-height:0; overflow-y:auto; padding-right:7dp; }
.hud_help, .hud_preview_note { margin:4dp 0 8dp; color:#a7c3d6; font-size:12dp; line-height:17dp; }
.hud_choice { display:flex; align-items:center; margin:2dp 5dp 2dp 0; min-width:0; }
.hud_choice .play_action { margin:0 2dp 0 0; }
.hud_choice > .play_action:first-child { width:26dp; min-width:26dp; max-width:26dp; flex:0 0 26dp; flex-shrink:0; }
.hud_choice > .play_action:last-child { flex:1; }
.hud_search { display:flex; align-items:center; flex-shrink:0; margin:3dp 0; }
.hud_search input { flex:1; min-width:0; margin-right:5dp; }
#hud_section_title { flex-shrink:0; padding:7dp 0; color:#8cd4e3; font-size:13dp; }
#hud_canvas { position:relative; width:100%; height:40vh; min-height:180dp; overflow:hidden; border:1dp #21445e; background-color:#101820; }
#hud_canvas:focus { border-color: #55e18c; }
#hud_preview { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#hud_surface { position: absolute; background-color: transparent; pointer-events: none; }
.hud_element { position: absolute; background-color: transparent; color: #ffffff; font-size: 11dp; line-height: 14dp; overflow: hidden; }
.hud_element span { display: block; padding: 2dp; }
.hud_element.selected { border: 1dp #55e18c; }
.hud_element:hover, .hud_element:focus { border: 1dp #72c7ff; }
#hud_guide_x, #hud_guide_y { position: absolute; background-color: #55e18c; pointer-events: none; }

.hud_element_choices { display:block; }
.hud_pick { display:block; width:96%; padding:8dp; margin:0 0 5dp; border:1dp #21445e; background-color:#0b2338; color:#b2cadc; font-size:12dp; text-align:left; }
.hud_pick.selected { border-color:#55e18c; color:#ffffff; }
.hud_pick:focus, .hud_pick:hover { border-color:#8cd4e3; color:#ffffff; }
.hud_layout_fields { display:flex; flex-wrap:wrap; align-items:center; }
.hud_layout_fields .play_form_label { width:42%; margin:5dp 0; }
.hud_layout_fields .play_input { width:55%; margin:5dp 0; }
#hud_color_swatch { display:block; width:97%; height:10dp; margin-bottom:6dp; }
.hud_property { display:flex; flex-wrap:wrap; width:98%; align-items:center; padding:8dp; margin:0 0 6dp; background-color:#0b2338; border:1dp #21445e; color:#b2cadc; }
.hud_property label { width:45%; padding-right:7dp; font-size:12dp; line-height:17dp; white-space:pre-wrap; }
.hud_property_editor { display:flex; flex:1; min-width:140dp; align-items:center; }
.hud_property_editor .play_input { flex:1; min-width:35dp; width:auto; margin:0 3dp; padding:5dp; font-size:12dp; }
#hud_page .hud_property_editor .play_action { flex:0 0 23dp; min-width:23dp; width:23dp; padding:5dp 2dp; margin:0; }
#hud_page .hud_property_editor .hud_inline_reset { flex:0 0 44dp; min-width:44dp; width:44dp; font-size:9dp; }
.hud_property_hint { width:100%; font-size:10dp; line-height:14dp; margin:4dp 0 0; color:#8baec3; white-space:pre-wrap; }
#hud_profiles_workspace { flex:1; min-height:0; overflow-y:auto; padding:15dp; }
#hud_profiles_workspace .hud_help { max-width:720dp; }
#hud_profiles_workspace .hud_choice { width:360dp; }
#hud_name, #hud_json { display:block; width:85%; max-width:880dp; margin:8dp 0; }
#hud_json { height:140dp; overflow-y:auto; font-size:12dp; }
.hud_footer { flex-shrink:0; margin-top:6dp; max-height:68dp; overflow-y:auto; }
#hud_status { font-size:11dp; line-height:16dp; color:#b2cadc; white-space:pre-wrap; }
.hud_error { padding:7dp; margin:4dp 0; border:1dp #ff788a; color:#ffb7bf; white-space:pre-wrap; }
#hud_safe_area { position:absolute; border:1dp #c8a660; background-color:transparent; pointer-events:none; }
@media (max-width:1000dp) { .hud_element_rail { width:17%; margin-right:8dp; } .hud_preview_column { width:37%; margin-right:8dp; } .hud_inspector { padding:7dp; } .hud_pick { padding:6dp; font-size:11dp; } }
@media (max-width:780dp) { #hud_page { overflow-y:auto; display:block; } .hud_header { display:block; } #hud_elements_workspace { display:block; } .hud_element_rail { width:100%; max-height:150dp; margin-bottom:9dp; } .hud_element_choices { display:flex; flex-wrap:wrap; } .hud_pick { width:auto; margin-right:5dp; } .hud_preview_column { width:100%; margin:0 0 9dp; overflow-y:visible; } #hud_canvas { height:36vh; } .hud_inspector { width:100%; min-height:500dp; padding:9dp; } .hud_inspector_scroll { overflow-y:visible; } .hud_footer { max-height:none; } }
@media (max-height:600dp) and (min-width:781dp) { #hud_page { padding:7dp; } #hud_page h1 { font-size:20dp; line-height:23dp; } #hud_canvas { min-height:150dp; } .hud_preview_column .hud_preview_note { font-size:10dp; line-height:14dp; } }
#native_hud_unsaved { position: absolute; left: 20%; top: 24%; width: 56%; padding: 22dp; background-color: #041321; border: 1dp #55e18c; }
#native_hud_unsaved h1 { display: block; margin-bottom: 12dp; color: #ffffff; font-size: 24dp; }
#native_hud_unsaved p { display: block; margin-bottom: 16dp; color: #b2cadc; line-height: 22dp; }
#native_hud_unsaved button { display: block; width: 100%; margin-top: 8dp; }
@media (max-width: 780dp) { #native_hud_unsaved { left: 5%; width: 84%; top: 15%; } }
