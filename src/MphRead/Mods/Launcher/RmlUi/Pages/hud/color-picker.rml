<rml><head><title>Choose a color</title><link type="text/template" href="../../components/dialog.rml"/><link type="text/rcss" href="editor.rcss"/></head><body template="prime-dialog"><div id="hud_color_dialog" role="dialog" aria-modal="true"><h1>Choose a color</h1><p id="hud_color_title"/><div id="hud_color_preview"/><h2>Palette</h2><div class="hud_swatches"><button id="hud_color_palette0" class="hud_swatch" data-action="hud:property:40" aria-label="Palette color 1"/><button id="hud_color_palette1" class="hud_swatch" data-action="hud:property:41" aria-label="Palette color 2"/><button id="hud_color_palette2" class="hud_swatch" data-action="hud:property:42" aria-label="Palette color 3"/><button id="hud_color_palette3" class="hud_swatch" data-action="hud:property:43" aria-label="Palette color 4"/><button id="hud_color_palette4" class="hud_swatch" data-action="hud:property:44" aria-label="Palette color 5"/><button id="hud_color_palette5" class="hud_swatch" data-action="hud:property:45" aria-label="Palette color 6"/><button id="hud_color_palette6" class="hud_swatch" data-action="hud:property:46" aria-label="Palette color 7"/><button id="hud_color_palette7" class="hud_swatch" data-action="hud:property:47" aria-label="Palette color 8"/><button id="hud_color_palette8" class="hud_swatch" data-action="hud:property:48" aria-label="Palette color 9"/><button id="hud_color_palette9" class="hud_swatch" data-action="hud:property:49" aria-label="Palette color 10"/><button id="hud_color_palette10" class="hud_swatch" data-action="hud:property:50" aria-label="Palette color 11"/><button id="hud_color_palette11" class="hud_swatch" data-action="hud:property:51" aria-label="Palette color 12"/><button id="hud_color_palette12" class="hud_swatch" data-action="hud:property:52" aria-label="Palette color 13"/><button id="hud_color_palette13" class="hud_swatch" data-action="hud:property:53" aria-label="Palette color 14"/><button id="hud_color_palette14" class="hud_swatch" data-action="hud:property:54" aria-label="Palette color 15"/><button id="hud_color_palette15" class="hud_swatch" data-action="hud:property:55" aria-label="Palette color 16"/></div><h2>Recently used</h2><p id="hud_color_recent_empty">Colors you choose appear here for this session.</p><div class="hud_swatches"><button id="hud_color_recent0" class="hud_swatch" data-action="hud:property:56" aria-label="Recent color 1"/><button id="hud_color_recent1" class="hud_swatch" data-action="hud:property:57" aria-label="Recent color 2"/><button id="hud_color_recent2" class="hud_swatch" data-action="hud:property:58" aria-label="Recent color 3"/><button id="hud_color_recent3" class="hud_swatch" data-action="hud:property:59" aria-label="Recent color 4"/><button id="hud_color_recent4" class="hud_swatch" data-action="hud:property:60" aria-label="Recent color 5"/><button id="hud_color_recent5" class="hud_swatch" data-action="hud:property:61" aria-label="Recent color 6"/><button id="hud_color_recent6" class="hud_swatch" data-action="hud:property:62" aria-label="Recent color 7"/><button id="hud_color_recent7" class="hud_swatch" data-action="hud:property:63" aria-label="Recent color 8"/></div><h2>Custom color</h2><div class="hud_color_channels"><label>Red</label><input id="hud_color_channel0" class="hud_slider" type="range" min="0" max="255" step="1" value="0" data-action="hud:property:88"/><label>Green</label><input id="hud_color_channel1" class="hud_slider" type="range" min="0" max="255" step="1" value="0" data-action="hud:property:89"/><label>Blue</label><input id="hud_color_channel2" class="hud_slider" type="range" min="0" max="255" step="1" value="0" data-action="hud:property:90"/></div><label for="hud_color_hex">Hex color</label><input id="hud_color_hex" class="play_input" type="text" maxlength="7" data-submit="hud:property:91"/><button class="play_action" data-action="hud:property:91">USE HEX</button><p id="hud_color_error" role="status"/><button id="hud_color_done" class="play_action" data-action="hud:property:64">DONE</button></div></body></rml>