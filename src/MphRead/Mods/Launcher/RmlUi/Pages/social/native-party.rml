<rml><head><title>Party</title><link type="text/template" href="../../components/app-shell.rml"/><link type="text/rcss" href="social.rcss"/></head>
<body template="prime-shell"><div id="social_page" class="party-page">
<div class="social_body">
<div class="social_header"><h1>YOUR PARTY</h1><p id="party_self"/></div>
<div class="social_panel party_operations"><div class="party_fact_copy"><p id="party_summary"/><p id="party_travel"/><p id="party_reservation"/></div><div class="social_commands"><button id="party_follow" data-action="social:follow-party-travel">FOLLOW PARTY</button><button id="party_join_leader" data-action="social:join-party-leader">JOIN LEADER</button></div></div>
<div class="party_tools"><div class="social_tabs"><button id="party_members" data-action="social:friends">MEMBERS</button><button id="party_incoming" data-action="social:invites">INCOMING INVITATIONS</button><button id="party_outgoing" data-action="social:party">SENT INVITATIONS</button></div>
<div class="social_searches"><input id="party_invite_id" type="text" maxlength="27" placeholder="FRIEND'S PRIME ID"/><button id="party_invite" data-action="social:invite-party">INVITE FRIEND</button></div></div>
<div class="social_columns"><div class="social_panel social_list"><div class="social_list_scroll"><p id="party_empty"/><button id="party_row_0" class="social_row" data-action="social:select-0"><b id="party_name_0"/><span id="party_detail_0"/></button>
<button id="party_row_1" class="social_row" data-action="social:select-1"><b id="party_name_1"/><span id="party_detail_1"/></button>
<button id="party_row_2" class="social_row" data-action="social:select-2"><b id="party_name_2"/><span id="party_detail_2"/></button>
<button id="party_row_3" class="social_row" data-action="social:select-3"><b id="party_name_3"/><span id="party_detail_3"/></button>
<button id="party_row_4" class="social_row" data-action="social:select-4"><b id="party_name_4"/><span id="party_detail_4"/></button>
<button id="party_row_5" class="social_row" data-action="social:select-5"><b id="party_name_5"/><span id="party_detail_5"/></button>
<button id="party_row_6" class="social_row" data-action="social:select-6"><b id="party_name_6"/><span id="party_detail_6"/></button>
<button id="party_row_7" class="social_row" data-action="social:select-7"><b id="party_name_7"/><span id="party_detail_7"/></button>
</div><div class="social_paging"><button id="party_previous" data-action="social:previous-page">PREVIOUS</button><span id="party_page"/><button id="party_next" data-action="social:next-page">NEXT</button></div></div>
<div class="social_panel social_details"><h2 id="party_selected"/><p id="party_selected_id"/><div class="social_commands">
<button id="party_command_34" data-action="social:accept-party-invite">ACCEPT INVITATION</button>
<button id="party_command_35" data-action="social:decline-party-invite">DECLINE INVITATION</button>
<button id="party_command_36" data-action="social:cancel-party-invite">CANCEL INVITATION</button>
<button id="party_command_39" class="social_danger" data-action="social:kick-party-member">REMOVE MEMBER</button>
<button id="party_command_40" data-action="social:promote-party-member">MAKE LEADER</button>
<button id="party_command_37" class="social_danger" data-action="social:leave-party">LEAVE PARTY</button>
<button id="party_command_38" class="social_danger" data-action="social:disband-party">DISBAND PARTY</button>
</div><div class="party_secondary_ops"><p>DESTINATION CONTROLS</p><div class="social_commands"><button id="party_publish" data-action="social:invite-party-lobby">PUBLISH CURRENT LOBBY</button><button id="party_reserve" data-action="social:reserve-party-seats">RESERVE PARTY SEATS</button><button id="party_cancel_reservation" data-action="social:cancel-reservation">CANCEL SEAT INTENT</button><button id="party_decline_travel" data-action="social:decline-party-travel">DECLINE DESTINATION</button></div></div><p>Membership and leadership changes require confirmation.</p></div></div>
<p id="party_status" class="social_status"/></div>
<div class="social_commands social_footer"><button id="party_refresh" data-action="social:refresh">REFRESH PARTY</button><button id="party_cancel" data-action="social:cancel">CANCEL REQUEST</button><button id="party_back" data-action="social:back">BACK TO SOCIAL</button></div>
</div></body></rml>
