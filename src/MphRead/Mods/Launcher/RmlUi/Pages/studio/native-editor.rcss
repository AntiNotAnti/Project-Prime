#native_editor_frame { position:absolute; left:8dp; right:8dp; top:6dp; bottom:6dp; overflow:hidden; }
#native_editor_heading { position:absolute; left:0; right:0; top:0; height:36dp; padding:3dp 8dp; background-color:#071927; }
#native_editor_title { font-size:17dp; color:#dff4ff; }
#native_editor_frame .eyebrow { font-size:10dp; color:#75d8ff; }
#native_editor_tools { position:absolute; left:0; right:0; top:39dp; height:38dp; overflow-y:auto; background-color:#10273a; }
#native_editor_left { position:absolute; left:0; top:81dp; bottom:40dp; width:32%; overflow-y:auto; padding:8dp; background-color:#0a2031; }
/* The transparent rectangle is drawn by the retained MapViewport before RmlUi chrome. */
#native_editor_viewport { position:absolute; left:33%; right:0; top:81dp; bottom:59dp; background-color:rgba(0,0,0,0); border:1dp #456a82; tab-index:auto; }
#native_editor_viewport:focus { border-color:#9edfff; }
#native_editor_viewport_hint { position:absolute; left:33%; right:0; bottom:40dp; height:18dp; font-size:10dp; color:#a6d6e8; background-color:#071927; padding:2dp; }
#native_editor_status { position:absolute; left:0; right:0; bottom:0; height:37dp; overflow-y:auto; padding:5dp; color:#86dbff; background-color:#0b2942; font-size:12dp; }
#native_editor_frame button { min-height:28dp; margin:2dp 3dp 2dp 0; padding:4dp 7dp; font-size:11dp; color:#e1f6ff; border:1dp #5889a9; background-color:#15334c; tab-index:auto; }
#native_editor_frame button:focus,#native_editor_frame button:hover,#native_editor_frame button.selected { background-color:#235d84; border-color:#b0e6ff; }
#native_editor_frame button:disabled { color:#62798d; border-color:#30465a; background-color:#102235; }
#native_editor_frame .editor-row { display:block; width:98%; text-align:left; white-space:normal; }
#native_editor_frame h2 { color:#8ddcff; font-size:15dp; margin:8dp 0 4dp; }
#native_editor_frame label,#native_editor_frame p,#native_editor_selection,#native_editor_page_label { display:block; font-size:11dp; color:#b8d7e8; white-space:pre-wrap; margin:5dp 0; }
#native_editor_frame input { width:98%; height:28dp; padding:4dp; margin:3dp 0; color:#e1f6ff; background-color:#061724; border:1dp #5889a9; tab-index:auto; }
.editor-values,.editor-actions { display:flex; flex-wrap:wrap; }
#native_editor_delete_panel { padding:6dp; background-color:#302619; border:1dp #dcb567; }
#native_editor_frame .editor-values input { width:30%; margin-right:2%; }
@media (max-height:500dp) { #native_editor_heading { height:27dp; } #native_editor_frame .eyebrow { display:none; } #native_editor_tools { top:30dp; height:29dp; } #native_editor_left,#native_editor_viewport { top:63dp; } #native_editor_frame button { min-height:23dp; padding:3dp 4dp; font-size:10dp; } #native_editor_status { height:29dp; font-size:10dp; } #native_editor_left { bottom:32dp; padding:5dp; width:39%; } #native_editor_viewport { left:40%; bottom:51dp; } #native_editor_viewport_hint { left:40%; bottom:32dp; font-size:8dp; } }
