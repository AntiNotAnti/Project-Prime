<rml><head><title>Project Prime native object editor</title>
<link type="text/rcss" href="../../themes/prime.rcss"/>
<link type="text/rcss" href="../../components/controls.rcss"/>
<link type="text/rcss" href="native-build.rcss"/><link type="text/rcss" href="native-asset-io.rcss"/><link type="text/rcss" href="native-modeling.rcss"/><link type="text/rcss" href="native-editor.rcss"/><link type="text/rcss" href="native-resources.rcss"/></head>
<body><div id="native_editor_frame">
  <div id="native_editor_heading"><div class="eyebrow">STUDIO // NATIVE OBJECT EDITOR</div><div id="native_editor_title" role="heading" aria-level="1"/></div>
  <div id="native_editor_tools">
    <button id="native_build_toggle" data-action="studio:build-panel">BUILD &amp; TEST</button>
    <button id="native_editor_back" data-action="studio:editor-back">PROJECT LIBRARY</button>
    <button id="native_editor_undo" data-action="studio:editor-undo">UNDO</button>
    <button id="native_editor_redo" data-action="studio:editor-redo">REDO</button>
    <button id="native_editor_frame_all" data-action="studio:editor-frame-all">FRAME ALL</button>
    <button id="native_editor_frame_selection" data-action="studio:editor-frame-selection">FRAME SELECTED</button>
    <button id="native_editor_perspective" data-action="studio:editor-perspective">3D</button>
    <button id="native_editor_top" data-action="studio:editor-top">TOP</button>
    <button id="native_editor_front" data-action="studio:editor-front">FRONT</button>
    <button id="native_editor_side" data-action="studio:editor-side">SIDE</button>
  </div>
  <div id="native_editor_left">
<div id="native_build_panel"><h2>BUILD &amp; TEST</h2>
<p id="native_build_status" role="status" tabindex="0"/><p id="native_build_notice" role="status"/>
<p id="native_build_current" role="status"/>
<div class="editor-actions"><button id="native_build_validate" data-action="studio:build-validate">VALIDATE MAP</button><button id="native_build_runtime" data-action="studio:build-runtime">BUILD RUNTIME</button></div>
<label for="native_build_destination">PACKAGE EXPORT PATH (.PPMAP)</label><input id="native_build_destination" type="text" maxlength="32767" value=""/>
<p id="native_build_review" role="status" tabindex="0"/><button id="native_build_package" data-action="studio:build-package">REVIEW PACKAGE EXPORT</button>
<h3>PLAYTEST START</h3><div class="editor-actions"><button id="native_build_play_camera" data-action="studio:build-play-camera">FROM CAMERA</button><button id="native_build_play_selection" data-action="studio:build-play-selection">SELECTED SPAWN</button><button id="native_build_play_team_a" data-action="studio:build-play-team-a">TEAM A SPAWN</button><button id="native_build_play_team_b" data-action="studio:build-play-team-b">TEAM B SPAWN</button></div>
<div class="editor-actions"><button id="native_build_navigation" data-action="studio:build-navigation">GENERATE NAVIGATION</button><button id="native_build_audit" data-action="studio:build-audit">RUN MAP AUDIT</button></div>
<div class="editor-actions"><button id="native_build_cancel" data-action="studio:build-cancel">CANCEL BUILD WORK</button><button id="native_build_clear" data-action="studio:build-clear">CLEAR RESULT / PACKAGE REVIEW</button></div>
<p id="native_build_fingerprint" tabindex="0"/>
<h3>PROBLEMS</h3><p>Choose an object problem to select and frame its object. Results from an older project state remain available for reference.</p>
<p id="native_build_problems_page" role="status"/>
<button id="native_build_problem0" class="editor-row" data-action="studio:build-problem-0">—</button>
<button id="native_build_problem1" class="editor-row" data-action="studio:build-problem-1">—</button>
<button id="native_build_problem2" class="editor-row" data-action="studio:build-problem-2">—</button>
<button id="native_build_problem3" class="editor-row" data-action="studio:build-problem-3">—</button>
<button id="native_build_problem4" class="editor-row" data-action="studio:build-problem-4">—</button>
<button id="native_build_problem5" class="editor-row" data-action="studio:build-problem-5">—</button>
<button id="native_build_problem6" class="editor-row" data-action="studio:build-problem-6">—</button>
<button id="native_build_problem7" class="editor-row" data-action="studio:build-problem-7">—</button>
<div class="editor-actions"><button id="native_build_problems_previous" data-action="studio:build-problems-previous">PREVIOUS PROBLEMS</button><button id="native_build_problems_next" data-action="studio:build-problems-next">NEXT PROBLEMS</button></div>
<h3>BUDGETS</h3><p id="native_build_budgets_page" role="status"/>
<p id="native_build_budget0" class="native-build-budget" tabindex="0"/>
<p id="native_build_budget1" class="native-build-budget" tabindex="0"/>
<p id="native_build_budget2" class="native-build-budget" tabindex="0"/>
<p id="native_build_budget3" class="native-build-budget" tabindex="0"/>
<p id="native_build_budget4" class="native-build-budget" tabindex="0"/>
<p id="native_build_budget5" class="native-build-budget" tabindex="0"/>
<p id="native_build_budget6" class="native-build-budget" tabindex="0"/>
<p id="native_build_budget7" class="native-build-budget" tabindex="0"/>
<div class="editor-actions"><button id="native_build_budgets_previous" data-action="studio:build-budgets-previous">PREVIOUS BUDGETS</button><button id="native_build_budgets_next" data-action="studio:build-budgets-next">NEXT BUDGETS</button></div>
</div>

<div id="native_resource_tabs"><button id="native_resource_objects" data-action="studio:resource-objects">OBJECTS</button><button id="native_resource_materials" data-action="studio:resource-materials">MATERIALS</button><button id="native_resource_assets" data-action="studio:resource-assets">ASSETS</button></div><div id="native_object_panel">
    <h2>CREATE OBJECT</h2><div class="editor-actions">
    <button id="native_create_box" data-action="studio:editor-create-box">BOX</button><button id="native_create_wedge" data-action="studio:editor-create-wedge">WEDGE</button><button id="native_create_prism" data-action="studio:editor-create-prism">PRISM</button><button id="native_create_convex" data-action="studio:editor-create-convex">CONVEX</button><button id="native_create_mesh" data-action="studio:editor-create-mesh">MESH</button><button id="native_create_spawn" data-action="studio:editor-create-spawn">SPAWN</button><button id="native_create_pickup" data-action="studio:editor-create-pickup">PICKUP</button><button id="native_create_pad" data-action="studio:editor-create-jump-pad">JUMP PAD</button><button id="native_create_link" data-action="studio:editor-create-link">NAV LINK</button></div>
    <h2>OBJECTS</h2>
    <button id="native_editor_row0" class="editor-row" data-action="studio:editor-select-0">—</button>
    <button id="native_editor_row1" class="editor-row" data-action="studio:editor-select-1">—</button>
    <button id="native_editor_row2" class="editor-row" data-action="studio:editor-select-2">—</button>
    <button id="native_editor_row3" class="editor-row" data-action="studio:editor-select-3">—</button>
    <button id="native_editor_row4" class="editor-row" data-action="studio:editor-select-4">—</button>
    <button id="native_editor_row5" class="editor-row" data-action="studio:editor-select-5">—</button>
    <button id="native_editor_row6" class="editor-row" data-action="studio:editor-select-6">—</button>
    <button id="native_editor_row7" class="editor-row" data-action="studio:editor-select-7">—</button>
    <div class="editor-actions"><button id="native_editor_previous" data-action="studio:editor-previous">PREVIOUS</button><button id="native_editor_next" data-action="studio:editor-next">NEXT</button></div>
    <div id="native_editor_page_label"/>
<div id="native_model_panel"><h2>MODELING</h2><p id="native_model_state"/><p>Drag a colored axis handle or the center of the selection. A gesture creates one undo step when released inside the viewport. Escape, focus changes and leaving the viewport cancel the preview.</p><div class="editor-actions"><button id="native_model_object_mode" data-action="studio:object-mode">OBJECT</button><button id="native_model_face_mode" data-action="studio:face-mode">FACE</button><button id="native_model_edge_mode" data-action="studio:edge-mode">EDGE</button><button id="native_model_vertex_mode" data-action="studio:vertex-mode">VERTEX</button></div><div class="editor-actions"><button id="native_model_tool_move" data-action="studio:tool-move">MOVE</button><button id="native_model_tool_rotate" data-action="studio:tool-rotate">ROTATE</button><button id="native_model_tool_scale" data-action="studio:tool-scale">SCALE</button></div><div class="editor-actions"><button id="native_model_axis_free" data-action="studio:axis-free">FREE</button><button id="native_model_axis_x" data-action="studio:axis-x">X</button><button id="native_model_axis_y" data-action="studio:axis-y">Y</button><button id="native_model_axis_z" data-action="studio:axis-z">Z</button><button id="native_model_axis_xy" data-action="studio:axis-xy">XY</button><button id="native_model_axis_xz" data-action="studio:axis-xz">XZ</button><button id="native_model_axis_yz" data-action="studio:axis-yz">YZ</button></div><button id="native_model_local" data-action="studio:toggle-local">TOGGLE LOCAL</button><button id="native_model_pivot" data-action="studio:pivot-cycle">PIVOT CYCLE</button><button id="native_model_selection_mode" data-action="studio:selection-mode-cycle">SELECTION MODE CYCLE</button><h3>SNAP AND CURSOR</h3><label for="native_model_grid">GRID SNAP (0..100000)</label><input id="native_model_grid" type="text" maxlength="64" value=".25"/><label for="native_model_angle_snap">ANGLE SNAP (0..180)</label><input id="native_model_angle_snap" type="text" maxlength="64" value="15"/><label for="native_model_scale_snap">SCALE SNAP (0..1000)</label><input id="native_model_scale_snap" type="text" maxlength="64" value=".25"/><button id="native_model_snap_apply" data-action="studio:snap-apply">APPLY SNAP AND CURSOR</button><label for="native_model_cursor_x">CURSOR X (-1000000..1000000)</label><input id="native_model_cursor_x" type="text" maxlength="64" value="0"/><label for="native_model_cursor_y">CURSOR Y (-1000000..1000000)</label><input id="native_model_cursor_y" type="text" maxlength="64" value="0"/><label for="native_model_cursor_z">CURSOR Z (-1000000..1000000)</label><input id="native_model_cursor_z" type="text" maxlength="64" value="0"/><button id="native_model_cursor_apply" data-action="studio:cursor-apply">APPLY SNAP AND CURSOR</button><h3>COMPONENTS</h3><div class="editor-actions"><button id="native_model_component_select_all" data-action="studio:component-select-all">SELECT-ALL</button><button id="native_model_component_clear" data-action="studio:component-clear">CLEAR</button><button id="native_model_component_linked" data-action="studio:component-linked">LINKED</button><button id="native_model_component_grow" data-action="studio:component-grow">GROW</button><button id="native_model_component_shrink" data-action="studio:component-shrink">SHRINK</button><button id="native_model_component_boundary" data-action="studio:component-boundary">BOUNDARY</button></div><button id="native_model_row0" data-action="studio:component-select-0">—</button><button id="native_model_row1" data-action="studio:component-select-1">—</button><button id="native_model_row2" data-action="studio:component-select-2">—</button><button id="native_model_row3" data-action="studio:component-select-3">—</button><button id="native_model_row4" data-action="studio:component-select-4">—</button><button id="native_model_row5" data-action="studio:component-select-5">—</button><button id="native_model_row6" data-action="studio:component-select-6">—</button><button id="native_model_row7" data-action="studio:component-select-7">—</button><button id="native_model_previous" data-action="studio:component-previous">PREVIOUS</button><button id="native_model_next" data-action="studio:component-next">NEXT</button><p id="native_model_page"/><button id="native_model_convert_to_mesh" data-action="studio:convert-to-mesh">CONVERT SELECTED PRIMITIVES TO MESH</button><h3>TRANSFORM DRAFT</h3><label for="native_model_move_x">MOVE X (-1000000..1000000)</label><input id="native_model_move_x" type="text" maxlength="64" value="0"/><label for="native_model_move_y">MOVE Y (-1000000..1000000)</label><input id="native_model_move_y" type="text" maxlength="64" value="0"/><label for="native_model_move_z">MOVE Z (-1000000..1000000)</label><input id="native_model_move_z" type="text" maxlength="64" value="0"/><label for="native_model_angle">ROTATION DEGREES (-3600..3600)</label><input id="native_model_angle" type="text" maxlength="64" value="0"/><label for="native_model_scale">SCALE FACTOR (.001..1000)</label><input id="native_model_scale" type="text" maxlength="64" value="1"/><button id="native_model_apply_component_transform" data-action="studio:apply-component-transform">APPLY CURRENT TOOL TO SELECTION</button><button id="native_model_gesture_cancel" data-action="studio:gesture-cancel">CANCEL ACTIVE GESTURE</button><h3>SELECTED FACE UVS</h3><label for="native_model_uv_u">U SCALE (SIGNED .001..1000)</label><input id="native_model_uv_u" type="text" maxlength="64" value="1"/><label for="native_model_uv_v">V SCALE (SIGNED .001..1000)</label><input id="native_model_uv_v" type="text" maxlength="64" value="1"/><label for="native_model_uv_offset_u">U OFFSET (-1000000..1000000)</label><input id="native_model_uv_offset_u" type="text" maxlength="64" value="0"/><label for="native_model_uv_offset_v">V OFFSET (-1000000..1000000)</label><input id="native_model_uv_offset_v" type="text" maxlength="64" value="0"/><label for="native_model_uv_angle">UV ROTATION (-3600..3600)</label><input id="native_model_uv_angle" type="text" maxlength="64" value="0"/><label for="native_model_uv_density">TEXEL DENSITY (.001..65536)</label><input id="native_model_uv_density" type="text" maxlength="64" value="16"/><div id="native_model_uv_actions"><button id="native_model_uv_apply" data-action="studio:uv-apply">UV APPLY</button><button id="native_model_uv_fit64" data-action="studio:uv-fit64">FIT TO 64 TEXELS</button><button id="native_model_uv_match_density" data-action="studio:uv-density">APPLY TEXEL DENSITY</button><button id="native_model_uv_copy" data-action="studio:uv-copy">UV COPY</button><button id="native_model_uv_paste" data-action="studio:uv-paste">UV PASTE</button><button id="native_model_uv_rotate_positive" data-action="studio:uv-rotate-positive">UV ROTATE POSITIVE</button><button id="native_model_uv_rotate_negative" data-action="studio:uv-rotate-negative">UV ROTATE NEGATIVE</button><button id="native_model_uv_flip_u" data-action="studio:uv-flip-u">UV FLIP U</button><button id="native_model_uv_flip_v" data-action="studio:uv-flip-v">UV FLIP V</button><button id="native_model_uv_explicit" data-action="studio:uv-explicit">STORE EXPLICIT UVS</button><button id="native_model_uv_projected" data-action="studio:uv-projected">USE PROJECTED UVS</button><button id="native_model_checker" data-action="studio:uv-checker-toggle">UV CHECKER</button><button id="native_model_reset_uv_draft" data-action="studio:reset-uv-draft">RESET UV DRAFT</button></div></div>
    <h2>SELECTED OBJECT</h2><div id="native_editor_selection"/>
    <button id="native_editor_duplicate" data-action="studio:editor-duplicate">DUPLICATE SELECTION</button><button id="native_editor_delete" data-action="studio:editor-delete">DELETE SELECTION</button>
    <div id="native_editor_delete_panel"><p id="native_editor_delete_label"/><button id="native_editor_confirm_delete" data-action="studio:editor-confirm-delete">CONFIRM DELETE</button><button id="native_editor_cancel_delete" data-action="studio:editor-cancel-delete">KEEP OBJECTS</button></div>
    <h2>TYPED PROPERTIES</h2>
    <div id="native_property_row0"><label id="native_property_label0" for="native_property_value0"/><input id="native_property_value0" type="text" maxlength="4096" value=""/><button id="native_property_cycle0" data-action="studio:property-cycle-0"/></div>
    <div id="native_property_row1"><label id="native_property_label1" for="native_property_value1"/><input id="native_property_value1" type="text" maxlength="4096" value=""/><button id="native_property_cycle1" data-action="studio:property-cycle-1"/></div>
    <div id="native_property_row2"><label id="native_property_label2" for="native_property_value2"/><input id="native_property_value2" type="text" maxlength="4096" value=""/><button id="native_property_cycle2" data-action="studio:property-cycle-2"/></div>
    <div id="native_property_row3"><label id="native_property_label3" for="native_property_value3"/><input id="native_property_value3" type="text" maxlength="4096" value=""/><button id="native_property_cycle3" data-action="studio:property-cycle-3"/></div>
    <div id="native_property_row4"><label id="native_property_label4" for="native_property_value4"/><input id="native_property_value4" type="text" maxlength="4096" value=""/><button id="native_property_cycle4" data-action="studio:property-cycle-4"/></div>
    <div id="native_property_row5"><label id="native_property_label5" for="native_property_value5"/><input id="native_property_value5" type="text" maxlength="4096" value=""/><button id="native_property_cycle5" data-action="studio:property-cycle-5"/></div>
    <div id="native_property_row6"><label id="native_property_label6" for="native_property_value6"/><input id="native_property_value6" type="text" maxlength="4096" value=""/><button id="native_property_cycle6" data-action="studio:property-cycle-6"/></div>
    <div id="native_property_row7"><label id="native_property_label7" for="native_property_value7"/><input id="native_property_value7" type="text" maxlength="4096" value=""/><button id="native_property_cycle7" data-action="studio:property-cycle-7"/></div>
    <div class="editor-actions"><button id="native_property_previous" data-action="studio:property-previous">PREVIOUS FIELDS</button><button id="native_property_next" data-action="studio:property-next">NEXT FIELDS</button></div><div id="native_property_page"/>
    <button id="native_property_apply" data-action="studio:property-apply">APPLY PROPERTY DRAFT</button><button id="native_property_reset" data-action="studio:property-reset">RESET / RELOAD PROPERTIES</button>
    <label for="native_editor_move_x">MOVE BY X / Y / Z</label>
    <div class="editor-values"><input id="native_editor_move_x" type="text" maxlength="64" value="0"/><input id="native_editor_move_y" type="text" maxlength="64" value="0"/><input id="native_editor_move_z" type="text" maxlength="64" value="0"/></div>
    <button id="native_editor_move" data-action="studio:editor-move">APPLY MOVE</button>
    <label for="native_editor_angle">ROTATE ABOUT Y (DEGREES)</label><input id="native_editor_angle" type="text" maxlength="64" value="0"/>
    <button id="native_editor_rotate" data-action="studio:editor-rotate">APPLY ROTATION</button>
    <label for="native_editor_factor">UNIFORM SCALE FACTOR</label><input id="native_editor_factor" type="text" maxlength="64" value="1"/>
    <button id="native_editor_scale" data-action="studio:editor-scale">APPLY SCALE</button>
</div><div id="native_material_panel"><h2>MATERIALS</h2><button id="native_material_row0" class="editor-row" data-action="studio:material-select-0">—</button><button id="native_material_row1" class="editor-row" data-action="studio:material-select-1">—</button><button id="native_material_row2" class="editor-row" data-action="studio:material-select-2">—</button><button id="native_material_row3" class="editor-row" data-action="studio:material-select-3">—</button><button id="native_material_row4" class="editor-row" data-action="studio:material-select-4">—</button><button id="native_material_row5" class="editor-row" data-action="studio:material-select-5">—</button><button id="native_material_row6" class="editor-row" data-action="studio:material-select-6">—</button><button id="native_material_row7" class="editor-row" data-action="studio:material-select-7">—</button><div class="editor-actions"><button id="native_material_previous" data-action="studio:material-previous">PREVIOUS</button><button id="native_material_next" data-action="studio:material-next">NEXT</button></div><p id="native_material_page"/><button id="native_material_add" data-action="studio:material-add">ADD MATERIAL</button><button id="native_material_duplicate" data-action="studio:material-duplicate">DUPLICATE MATERIAL</button><button id="native_material_assign" data-action="studio:material-assign-selection">ASSIGN TO SELECTION</button><button id="native_material_usages" data-action="studio:material-select-usages">SELECT USAGES</button><h2>SURFACE AND ANIMATION</h2><div id="native_material_property_row0"><label id="native_material_label0" for="native_material_value0"/><input id="native_material_value0" type="text" maxlength="4096" value=""/><button id="native_material_cycle0" data-action="studio:material-property-cycle-0"/></div><div id="native_material_property_row1"><label id="native_material_label1" for="native_material_value1"/><input id="native_material_value1" type="text" maxlength="4096" value=""/><button id="native_material_cycle1" data-action="studio:material-property-cycle-1"/></div><div id="native_material_property_row2"><label id="native_material_label2" for="native_material_value2"/><input id="native_material_value2" type="text" maxlength="4096" value=""/><button id="native_material_cycle2" data-action="studio:material-property-cycle-2"/></div><div id="native_material_property_row3"><label id="native_material_label3" for="native_material_value3"/><input id="native_material_value3" type="text" maxlength="4096" value=""/><button id="native_material_cycle3" data-action="studio:material-property-cycle-3"/></div><div id="native_material_property_row4"><label id="native_material_label4" for="native_material_value4"/><input id="native_material_value4" type="text" maxlength="4096" value=""/><button id="native_material_cycle4" data-action="studio:material-property-cycle-4"/></div><div id="native_material_property_row5"><label id="native_material_label5" for="native_material_value5"/><input id="native_material_value5" type="text" maxlength="4096" value=""/><button id="native_material_cycle5" data-action="studio:material-property-cycle-5"/></div><div id="native_material_property_row6"><label id="native_material_label6" for="native_material_value6"/><input id="native_material_value6" type="text" maxlength="4096" value=""/><button id="native_material_cycle6" data-action="studio:material-property-cycle-6"/></div><div id="native_material_property_row7"><label id="native_material_label7" for="native_material_value7"/><input id="native_material_value7" type="text" maxlength="4096" value=""/><button id="native_material_cycle7" data-action="studio:material-property-cycle-7"/></div><div class="editor-actions"><button id="native_material_property_previous" data-action="studio:material-property-previous">PREVIOUS FIELDS</button><button id="native_material_property_next" data-action="studio:material-property-next">NEXT FIELDS</button></div><p id="native_material_property_page"/><button id="native_material_apply" data-action="studio:material-property-apply">APPLY MATERIAL DRAFT</button><button id="native_material_reset" data-action="studio:material-property-reset">RESET / RELOAD DRAFT</button><h2>REPLACE MATERIAL USAGES</h2><button id="native_material_replacement" data-action="studio:material-use-as-replacement">USE SELECTED AS REPLACEMENT</button><button id="native_material_replace" data-action="studio:material-replace-usages">REPLACE SELECTED MATERIAL USAGES</button><p>Choose a replacement first, then select the source material whose usages should change.</p><button id="native_material_delete" data-action="studio:material-delete-unused">REMOVE UNUSED MATERIAL</button><div id="native_material_delete_panel"><p id="native_material_delete_label"/><button id="native_material_confirm_delete" data-action="studio:material-confirm-delete">CONFIRM REMOVE MATERIAL</button><button id="native_material_cancel_delete" data-action="studio:material-cancel-delete">KEEP MATERIAL</button></div></div><div id="native_asset_panel"><div id="native_asset_io_panel"><h2>TEXTURE FILES</h2><p>Save an editable JSON project before import or replacement. PNG, JPEG, TGA and KTX2 paths are supported. The system picker filters PNG; other formats can be entered below.</p>
<label for="native_asset_io_source">TEXTURE SOURCE PATH</label><input id="native_asset_io_source" type="text" maxlength="32767" value=""/>
<button id="native_asset_io_choose" data-action="studio:asset-choose-source">CHOOSE PNG SOURCE</button>
<label for="native_asset_io_name">NEW MATERIAL NAME (1..256 CHARACTERS)</label><input id="native_asset_io_name" type="text" maxlength="256" value="Imported texture"/>
<button id="native_asset_io_review_import" data-action="studio:asset-review-import">REVIEW TEXTURE IMPORT</button>
<button id="native_asset_io_review_replace" data-action="studio:asset-review-replace">REVIEW REPLACEMENT OF SELECTED TEXTURE</button><button id="native_asset_io_reload_source" data-action="studio:asset-reload-source">REVIEW RELOAD FROM RECORDED SOURCE</button>
<label for="native_asset_io_destination">EXPORT ORIGINAL BYTES TO A PATH OUTSIDE THIS PROJECT</label><input id="native_asset_io_destination" type="text" maxlength="32767" value=""/>
<button id="native_asset_io_review_export" data-action="studio:asset-review-export">REVIEW ORIGINAL ASSET EXPORT</button>
<h3>REVIEWED SOURCE</h3><p id="native_asset_io_source_name" role="heading" aria-level="3"/><p id="native_asset_io_source_path" role="status" tabindex="0"/><h3>REVIEWED DESTINATION</h3><p id="native_asset_io_destination_name" role="heading" aria-level="3"/><p id="native_asset_io_destination_path" role="status" tabindex="0"/><p id="native_asset_io_summary" role="status" tabindex="0"/>
<button id="native_asset_io_apply_import" data-action="studio:asset-apply-import">APPLY REVIEWED IMPORT</button><button id="native_asset_io_apply_replace" data-action="studio:asset-apply-replace">APPLY REVIEWED REPLACEMENT</button><button id="native_asset_io_export" data-action="studio:asset-confirm-export">EXPORT TO REVIEWED NEW DESTINATION</button><button id="native_asset_io_overwrite" data-action="studio:asset-confirm-overwrite">OVERWRITE EXACT REVIEWED DESTINATION</button><button id="native_asset_io_cancel" data-action="studio:asset-cancel-io">CANCEL ASSET OPERATION</button><p id="native_asset_io_status" role="status"/></div><h2>DECLARED ASSETS</h2><button id="native_asset_row0" class="editor-row" data-action="studio:asset-select-0">—</button><button id="native_asset_row1" class="editor-row" data-action="studio:asset-select-1">—</button><button id="native_asset_row2" class="editor-row" data-action="studio:asset-select-2">—</button><button id="native_asset_row3" class="editor-row" data-action="studio:asset-select-3">—</button><button id="native_asset_row4" class="editor-row" data-action="studio:asset-select-4">—</button><button id="native_asset_row5" class="editor-row" data-action="studio:asset-select-5">—</button><button id="native_asset_row6" class="editor-row" data-action="studio:asset-select-6">—</button><button id="native_asset_row7" class="editor-row" data-action="studio:asset-select-7">—</button><div class="editor-actions"><button id="native_asset_previous" data-action="studio:asset-previous">PREVIOUS</button><button id="native_asset_next" data-action="studio:asset-next">NEXT</button></div><p id="native_asset_page"/><p id="native_asset_detail"/><label for="native_asset_name">ASSET DISPLAY NAME</label><input id="native_asset_name" type="text" maxlength="257" value=""/><button id="native_asset_rename" data-action="studio:asset-rename">RENAME ASSET</button><button id="native_asset_usages" data-action="studio:asset-find-usages">SELECT ASSET USAGES</button><h2>BIND TO SELECTED MATERIAL</h2><p>Select a material on the Materials tab, then choose a declared texture here. This changes a project reference; existing asset files stay intact.</p><button id="native_asset_channel" data-action="studio:asset-cycle-channel">CHANNEL: NATIVE FALLBACK (.TEX)</button><button id="native_asset_bind" data-action="studio:asset-bind-channel">BIND ASSET TO MATERIAL CHANNEL</button><button id="native_asset_clear" data-action="studio:asset-clear-channel">CLEAR SELECTED MATERIAL CHANNEL</button><button id="native_asset_delete" data-action="studio:asset-remove-unused">REMOVE UNUSED ASSET REFERENCE</button><div id="native_asset_delete_panel"><p id="native_asset_delete_label"/><button id="native_asset_confirm_delete" data-action="studio:asset-confirm-remove">CONFIRM REMOVE REFERENCE</button><button id="native_asset_cancel_delete" data-action="studio:asset-cancel-remove">KEEP ASSET REFERENCE</button></div></div><p id="native_material_selection"/><p id="native_resource_notices"/><button id="native_resource_refresh" data-action="studio:resource-refresh-cache">REFRESH MATERIAL CACHE</button><button id="native_resource_reset" data-action="studio:resource-reset-selection">CLEAR RESOURCE SELECTION</button>
    <h2>SAVE PROJECT</h2><label for="native_editor_path">LOCAL .JSON SAVE PATH</label><input id="native_editor_path" type="text" maxlength="32767" value=""/>
    <button id="native_editor_save" data-action="studio:editor-save">SAVE PROJECT</button>
    <button id="native_editor_publish" data-action="community:detail:5">PUBLISH CURRENT EDITOR PROJECT</button>
    <p>Advanced mesh topology operations and model and Q3 source imports continue in the same retained editor.</p>
    <button id="native_editor_legacy" data-action="studio:launch">ADVANCED EDITOR TOOLS</button>
  </div>
  <div id="native_editor_viewport" tabindex="0"/>
  <div id="native_editor_viewport_hint">CLICK SELECT // RIGHT DRAG ORBIT // MIDDLE DRAG PAN // WHEEL ZOOM</div>
  <div id="native_editor_status" role="status"/>
</div></body></rml>
