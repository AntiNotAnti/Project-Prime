<rml><head><title>Change Studio project</title><link type="text/rcss" href="../../themes/prime.rcss"/><link type="text/rcss" href="../../components/controls.rcss"/><link type="text/rcss" href="project-change.rcss"/></head>
<body><div id="native_change_scrim"><div id="native_change_panel" role="dialog"><h1>CHANGE PROJECT</h1><p id="native_change_current"/><p id="native_change_target"/>
<div id="native_change_decision"><p>Save this project or keep a recovery copy before opening the next project.</p><label for="native_change_path">CURRENT PROJECT .JSON SAVE PATH</label><input id="native_change_path" type="text" maxlength="32767" value=""/><button id="native_change_save" data-action="studio:project-change-save">SAVE AND CONTINUE</button><button id="native_change_preserve" data-action="studio:project-change-preserve">KEEP RECOVERY AND CONTINUE</button></div>
<div id="native_change_overwrite_panel"><p>Replace this reviewed existing JSON file?</p><p id="native_change_review_name"/><p id="native_change_review_path"/><button id="native_change_overwrite" data-action="studio:project-change-overwrite">CONFIRM REPLACE FILE</button><button id="native_change_keep_file" data-action="studio:project-change-keep-file">KEEP EXISTING FILE</button></div>
<p id="native_change_status" role="status"/><button id="native_change_cancel" data-action="studio:project-change-cancel">CANCEL PROJECT CHANGE</button></div></div></body></rml>
