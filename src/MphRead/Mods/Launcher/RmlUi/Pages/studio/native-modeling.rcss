#native_model_panel { width:100%; margin-top:12dp; }
#native_model_panel input { width:100%; margin-bottom:5dp; }
#native_model_panel button { margin-bottom:4dp; }
#native_model_panel h3 { margin-top:12dp; font-size:14dp; }
#native_model_state, #native_model_page { white-space:normal; word-break:break-all; }

/* Each UV action is one complete box in the existing left-pane scroller. */
#native_editor_frame #native_model_uv_actions { display:block; width:100%; }
#native_editor_frame #native_model_uv_actions button { display:block; width:98%; max-width:98%; white-space:normal; text-align:left; margin:3dp 0; }
