#weapon_editor { position:absolute; left:2%; right:2%; top:10dp; bottom:10dp; padding:14dp; display:flex; flex-direction:column; background-color:#071927; box-sizing:border-box; }
#weapon_editor h1 { font-size:25dp; margin:0 12dp 0 0; color:#d4fbef; }
#weapon_editor h2 { font-size:18dp; color:#87d6c1; margin:18dp 0 6dp; }
#weapon_editor p { color:#bdd2df; font-size:13dp; line-height:18dp; margin:6dp 0; white-space:pre-wrap; }
.weapon_heading { display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }
.weapon_scroll { flex:1; min-height:0; overflow-y:auto; padding:6dp 8dp 6dp 0; }
#weapon_editor label { display:block; font-size:12dp; color:#a7c7d8; margin:10dp 0 4dp; }
#weapon_editor input,#weapon_editor textarea { display:block; width:100%; box-sizing:border-box; padding:8dp; color:#e9f6ff; background-color:#102b3d; border:1dp #497283; tab-index:auto; }
#weapon_editor input { min-height:36dp; }
#weapon_editor textarea { height:260dp; font-family:monospace; font-size:12dp; white-space:pre; }
#weapon_editor input:focus,#weapon_editor textarea:focus { border-color:#a6f0d8; }
#weapon_editor button { min-height:38dp; margin:4dp 6dp 4dp 0; padding:8dp 12dp; color:#e2fff4; background-color:#143d3a; border:1dp #4f9c8e; tab-index:auto; }
#weapon_editor button:hover,#weapon_editor button:focus { background-color:#21675b; border-color:#b8ffe4; }
#weapon_editor button:disabled { color:#819993; background-color:#182b2b; border-color:#395451; }
.weapon_buttons { display:flex; flex-wrap:wrap; margin:6dp 0; }
.weapon_columns { display:flex; }
.weapon_column { width:49%; margin-right:1%; }
#weapon_preview_info { border:1dp #325d6c; padding:10dp; background-color:#102734; }
#weapon_status { flex-shrink:0; min-height:36dp; max-height:74dp; overflow-y:auto; border-top:1dp #386575; padding-top:8dp; color:#d4f5e6; }
#weapon_model_preview { display:block; width:640dp; max-width:100%; height:280dp; margin:8dp 0; }
