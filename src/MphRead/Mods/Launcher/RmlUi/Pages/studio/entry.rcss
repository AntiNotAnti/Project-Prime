#studio_page { position: absolute; left: 5%; right: 5%; top: 5%; bottom: 4%; overflow-y: auto; padding: 20dp; background-color: rgba(2, 9, 16, 91%); }
#studio_page h1 { margin: 8dp 0 10dp; font-size: 32dp; line-height: 36dp; color: #ffffff; }
#studio_page h2 { margin: 0 0 14dp; font-size: 20dp; line-height: 25dp; color: #e0f2ff; }
#studio_page p { line-height: 23dp; color: #b2cadc; }
.studio_intro { margin-bottom: 20dp; }
.studio_panels { display: flex; align-items: stretch; }
.studio_panel { flex: 1; padding: 20dp; border: 1dp rgba(114, 199, 255, 27%); background-color: rgba(4, 19, 33, 94%); }
.studio_path_panel { margin-left: 18dp; }
.studio_panel .wide { display: block; width: 100%; margin: 10dp 0; min-height: 45dp; }
.studio_panel label { display: block; margin: 5dp 0 8dp; color: #91b9d5; }
#studio_path { display: block; width: 100%; height: 42dp; padding: 8dp 10dp; background-color: rgba(1, 8, 16, 95%); border: 1dp #537f9d; color: #e0f2ff; font-family: JetBrains Mono; font-size: 14dp; }
#studio_path:focus { border-color: #72c7ff; }
.studio_hint { font-size: 13dp; line-height: 20dp; }
.studio_notice { white-space: pre-wrap; word-break: break-word; }
.studio_status { margin: 18dp 0 10dp; padding: 12dp; border-left: 3dp #72c7ff; background-color: rgba(15, 41, 63, 85%); }
.studio_error { padding: 12dp; margin-bottom: 12dp; color: #ffb7bf; border: 1dp rgba(255, 120, 138, 60%); background-color: rgba(64, 17, 31, 80%); }
#studio_cancel { min-height: 44dp; margin-top: 10dp; }
@media (max-width: 850dp) {
    #studio_page { left: 2%; right: 2%; top: 3%; bottom: 2%; padding: 14dp; }
    .studio_panels { display: block; }
    .studio_panel { width: 100%; margin-bottom: 14dp; padding: 15dp; }
    .studio_path_panel { margin-left: 0; }
    #studio_page h1 { font-size: 26dp; line-height: 30dp; }
}
@media (max-height: 620dp) { #studio_page { top: 2%; bottom: 2%; } .studio_intro { margin-bottom: 12dp; } }
