body { background-color: #000000b8; }
.journal-panel { position: absolute; left: 5%; top: 5%; width: 90%; height: 90%; background-color: #081523; border: 1px #41667f; padding: 12dp; box-sizing: border-box; }
.journal-header { height: 112dp; }
.journal-header h1 { margin: 3dp 0; font-size: 21dp; }
.journal-header .eyebrow, #journal_summary { font-size: 11dp; color: #9eb6c9; }
.journal-actions { display: flex; margin-top: 6dp; }
.journal-actions button { margin-right: 5dp; font-size: 11dp; padding: 5dp; }
.journal-entries { position: absolute; top: 126dp; bottom: 56dp; left: 12dp; right: 12dp; overflow-y: auto; }
.journal-entry { border-bottom: 1px #254056; padding: 5dp 0; }
.journal-entry h2 { font-size: 14dp; color: #a9dcfa; margin: 4dp 0; }
.journal-entry p, #journal_empty { white-space: pre-wrap; font-size: 12dp; margin: 4dp 0; }
.journal-footer { position: absolute; bottom: 10dp; left: 12dp; right: 12dp; display: flex; align-items: center; }
.journal-footer button { font-size: 11dp; margin-right: 6dp; padding: 6dp; }
#journal_page { margin-right: 10dp; font-size: 11dp; }
