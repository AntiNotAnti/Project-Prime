<rml><head><link type="text/rcss" href="../../components/controls.rcss"/><title>Targeting simulation report</title><link type="text/rcss" href="../../themes/prime.rcss"/><link type="text/rcss" href="results.rcss"/></head><body class="aim-results">
<div class="aim-panel"><div class="eyebrow">TRAINING REPORT</div><h1>TARGETING SIMULATION COMPLETE</h1><div id="aim_results_summary"/>
<div class="aim-metrics"><div id="aim_result0"/><div id="aim_result1"/><div id="aim_result2"/><div id="aim_result3"/><div id="aim_result4"/><div id="aim_result5"/><div id="aim_result6"/><div id="aim_result7"/><div id="aim_result8"/><div id="aim_result9"/><div id="aim_result10"/><div id="aim_result11"/><div id="aim_result12"/><div id="aim_result13"/><div id="aim_result14"/><div id="aim_result15"/><div id="aim_result16"/><div id="aim_result17"/><div id="aim_result18"/><div id="aim_result19"/></div>
<div id="aim_results_status" class="result-next"/><div class="aim-actions"><button id="aim_results_retry" class="primary" data-action="aim-results:retry">RETRY</button><button id="aim_results_change" data-action="aim-results:change-drill">CHANGE DRILL</button><button id="aim_results_exit" data-action="aim-results:exit">EXIT TRAINING</button></div></div></body></rml>
