<rml><head><link type="text/rcss" href="../../components/controls.rcss"/><title>Post-match report</title><link type="text/rcss" href="../../themes/prime.rcss"/><link type="text/rcss" href="results.rcss"/></head><body class="match-results">
<div class="results-panel"><div class="eyebrow">POST-MATCH REPORT</div><div id="results_phase"/><h1 id="results_title">NEXT DEPLOYMENT</h1>
<div id="results_message"/><div id="results_ballot"><input id="results_search" type="text" maxlength="120" value=""/><button id="results_search_apply" data-action="results:search">SEARCH</button><button id="results_clear" data-action="results:clear-search">CLEAR</button>
<div class="result-maps"><button id="results_map0" data-action="results:map:0"/><button id="results_map1" data-action="results:map:1"/><button id="results_map2" data-action="results:map:2"/><button id="results_map3" data-action="results:map:3"/><button id="results_map4" data-action="results:map:4"/><button id="results_map5" data-action="results:map:5"/><button id="results_map6" data-action="results:map:6"/><button id="results_map7" data-action="results:map:7"/></div>
<div class="result-pages"><button id="results_previous" data-action="results:previous-page">PREVIOUS</button><span id="results_paging"/><button id="results_next_page" data-action="results:next-page">NEXT</button></div></div>
<div id="results_tally"/><div id="results_next" class="result-next"/><div id="results_countdown"/><div id="results_error" class="error"/>
<button id="results_rematch" class="primary" data-action="results:rematch">START NEXT MATCH</button><button id="results_close" data-action="results:close">PAUSE / LEAVE MATCH</button></div></body></rml>
