<rml><head><title>PLAYER NAME GLYPHS</title><link type="text/template" href="../../components/dialog.rml" /><link type="text/rcss" href="settings.rcss" /></head><body template="prime-dialog"><div class="settings_dialog settings_glyph_dialog"><h1>PLAYER NAME GLYPHS</h1><input id="settings_glyph_name" type="text" class="input"/><p id="settings_glyph_status"/><div class="settings_glyph_tabs"><button class="choice" data-action="settings:category:0">ASCII</button><button class="choice" data-action="settings:category:1">LATIN &amp; SYMBOLS</button><button class="choice" data-action="settings:category:2">HIRAGANA</button><button class="choice" data-action="settings:category:3">KATAKANA</button><button class="choice" data-action="settings:category:4">JP / MISC</button></div><div class="settings_glyph_grid"><button id="settings_glyph_0" class="settings_glyph" data-action="settings:action:16" /><button id="settings_glyph_1" class="settings_glyph" data-action="settings:action:17" /><button id="settings_glyph_2" class="settings_glyph" data-action="settings:action:18" /><button id="settings_glyph_3" class="settings_glyph" data-action="settings:action:19" /><button id="settings_glyph_4" class="settings_glyph" data-action="settings:action:20" /><button id="settings_glyph_5" class="settings_glyph" data-action="settings:action:21" /><button id="settings_glyph_6" class="settings_glyph" data-action="settings:action:22" /><button id="settings_glyph_7" class="settings_glyph" data-action="settings:action:23" /><button id="settings_glyph_8" class="settings_glyph" data-action="settings:action:24" /><button id="settings_glyph_9" class="settings_glyph" data-action="settings:action:25" /><button id="settings_glyph_10" class="settings_glyph" data-action="settings:action:26" /><button id="settings_glyph_11" class="settings_glyph" data-action="settings:action:27" /><button id="settings_glyph_12" class="settings_glyph" data-action="settings:action:28" /><button id="settings_glyph_13" class="settings_glyph" data-action="settings:action:29" /><button id="settings_glyph_14" class="settings_glyph" data-action="settings:action:30" /><button id="settings_glyph_15" class="settings_glyph" data-action="settings:action:31" /><button id="settings_glyph_16" class="settings_glyph" data-action="settings:action:32" /><button id="settings_glyph_17" class="settings_glyph" data-action="settings:action:33" /><button id="settings_glyph_18" class="settings_glyph" data-action="settings:action:34" /><button id="settings_glyph_19" class="settings_glyph" data-action="settings:action:35" /><button id="settings_glyph_20" class="settings_glyph" data-action="settings:action:36" /><button id="settings_glyph_21" class="settings_glyph" data-action="settings:action:37" /><button id="settings_glyph_22" class="settings_glyph" data-action="settings:action:0" /><button id="settings_glyph_23" class="settings_glyph" data-action="settings:action:1" /></div><div class="settings_glyph_paging"><button id="settings_glyph_previous" class="choice" data-action="settings:action:57">PREVIOUS</button><span id="settings_glyph_page"/><button id="settings_glyph_next" class="choice" data-action="settings:action:58">NEXT</button></div><div class="dialog_actions"><button class="play_action quiet" data-action="settings:close">CANCEL</button><button id="settings_glyph_use" class="play_action" data-action="settings:apply">USE NAME</button></div></div></body></rml>