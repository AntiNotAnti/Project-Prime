<rml><head><title>UNSAVED SETTINGS</title><link type="text/template" href="../../components/dialog.rml" /><link type="text/rcss" href="settings.rcss" /></head><body template="prime-dialog"><div class="settings_dialog"><h1>UNSAVED SETTINGS</h1><p>Apply your draft, discard it, or return to editing.</p><div id="settings_video_status"/><div id="settings_video_error"/><div class="dialog_actions"><button id="settings_close_cancel" class="play_action" data-action="settings:action:9">CANCEL</button><button id="settings_close_discard" class="play_action" data-action="settings:discard">DISCARD</button><button id="settings_close_apply" class="play_action" data-action="settings:apply">APPLY</button></div></div></body></rml>
