                <button id="settings_cycle_6" class="choice settings_cycle" data-action="settings:action:22">STAGE</button>
            </div>
            <div class="settings_row" id="settings_row_7">
                <div class="settings_description"><label for="settings_value_7" id="settings_label_7">Setting</label><div class="settings_help" id="settings_help_7" /></div>
                <input type="text" id="settings_value_7" class="input settings_value" />
                <button id="settings_cycle_7" class="choice settings_cycle" data-action="settings:action:23">STAGE</button>
            </div>
            <div class="settings_row" id="settings_row_8">
                <div class="settings_description"><label for="settings_value_8" id="settings_label_8">Setting</label><div class="settings_help" id="settings_help_8" /></div>
                <input type="text" id="settings_value_8" class="input settings_value" />
                <button id="settings_cycle_8" class="choice settings_cycle" data-action="settings:action:24">STAGE</button>
            </div>
            <div class="settings_row" id="settings_row_9">
                <div class="settings_description"><label for="settings_value_9" id="settings_label_9">Setting</label><div class="settings_help" id="settings_help_9" /></div>
                <input type="text" id="settings_value_9" class="input settings_value" />
                <button id="settings_cycle_9" class="choice settings_cycle" data-action="settings:action:25">STAGE</button>
            </div>
            <div class="settings_row" id="settings_row_10">
                <div class="settings_description"><label for="settings_value_10" id="settings_label_10">Setting</label><div class="settings_help" id="settings_help_10" /></div>
                <input type="text" id="settings_value_10" class="input settings_value" />
                <button id="settings_cycle_10" class="choice settings_cycle" data-action="settings:action:26">STAGE</button>
            </div>
            <div class="settings_row" id="settings_row_11">
                <div class="settings_description"><label for="settings_value_11" id="settings_label_11">Setting</label><div class="settings_help" id="settings_help_11" /></div>
                <input type="text" id="settings_value_11" class="input settings_value" />
                <button id="settings_cycle_11" class="choice settings_cycle" data-action="settings:action:27">STAGE</button>
            </div>
            <div id="settings_profile_tools" class="settings_tools"><button id="settings_open_glyphs" class="play_action" data-action="settings:action:56">PLAYER NAME GLYPHS</button>
                <button id="settings_share_logs" class="play_action" data-action="settings:action:53">SHARE DEBUGGING LOGS</button><div id="settings_files" /><button class="play_action" data-action="settings:action:10">GAME FILES</button>
            </div>
            <div id="settings_system" class="settings_tools">
                <h3>SETTINGS BACKUP</h3><p>Preferences, controls, controller mappings and HUD profiles. Accounts, game files, saves and replays stay separate.</p>
                <label for="settings_archive_path">Archive file</label><input id="settings_archive_path" type="text" class="input" />
                <button class="play_action" data-action="settings:action:3">EXPORT SETTINGS</button>
                <button id="settings_import" class="play_action" data-action="settings:action:4">IMPORT SETTINGS</button>
                <button id="settings_reset" class="play_action danger" data-action="settings:action:5">RESET SETTINGS</button>
                <button id="settings_open_folder" class="play_action quiet" data-action="settings:action:7">OPEN SETTINGS FOLDER</button>
            </div>
            <div id="settings_maintenance" class="settings_tools">
                <h3>INSTALLATION AND PERFORMANCE</h3><p id="settings_installation" /><p id="settings_storage" />
                <button class="play_action" data-action="settings:action:11">VERIFY INSTALLATION</button>
                <button class="play_action" data-action="settings:action:12">CLEAN TEMPORARY CACHE</button>
                <button class="play_action" data-action="settings:action:50">CLEAR MAP BUILD CACHE</button>
                <button class="play_action" data-action="settings:action:51">CLEAR THUMBNAILS</button>
                <button id="settings_render_thumbnails" class="play_action" data-action="settings:action:52">REBUILD THUMBNAILS</button>
                <button class="play_action" data-action="settings:action:13">RESET PERFORMANCE DRAFT</button>
                <button id="settings_diagnostic" class="play_action" data-action="settings:action:14">RUN PERFORMANCE DIAGNOSTIC</button>
            </div>
            <div id="settings_credits" class="settings_tools"><h3>CREDITS</h3><div id="settings_credits_text" class="settings_credits_text" /></div>
            <div id="settings_restart" class="settings_tools"><p>Restart to activate imported or reset preferences. Current settings cannot overwrite those saved stores.</p><button class="play_action" data-action="settings:action:8">RESTART NOW</button></div>
        </div>
        <div id="settings_pager" class="settings_paging"><button id="settings_previous" class="choice" data-action="settings:action:0">PREVIOUS</button><span id="settings_paging">Page 1 of 1</span><button id="settings_next" class="choice" data-action="settings:action:1">NEXT</button></div>
        <div id="settings_error" class="settings_error" /><div id="settings_status" class="settings_status" />
        <div id="settings_actions" class="settings_actions"><button id="settings_revert_category" class="play_action quiet" data-action="settings:reset-category">REVERT CATEGORY</button><button id="settings_discard" class="play_action quiet" data-action="settings:discard">DISCARD</button><button id="settings_apply" class="play_action" data-action="settings:apply">APPLY</button></div>
    </div>
</div>
</body></rml>
