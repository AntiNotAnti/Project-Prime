<rml>
<head><title>Project Prime Settings</title><link type="text/template" href="../../components/app-shell.rml" /><link type="text/rcss" href="settings.rcss" /></head>
<body template="prime-shell">
<div id="settings_workspace" class="settings_workspace">
        <button id="settings_back" class="play_action quiet" data-action="settings:close">BACK</button>
    <div id="settings_navigation" class="settings_navigation">
        <div class="eyebrow">PROJECT PRIME</div><h1>SETTINGS</h1>
            <button id="settings_display_tab" class="settings_tab" data-action="settings:category:0">DISPLAY</button>
            <button id="settings_graphics_tab" class="settings_tab" data-action="settings:category:1">GRAPHICS</button>
            <button id="settings_audio_tab" class="settings_tab" data-action="settings:category:2">AUDIO</button>
            <button id="settings_controls_tab" class="settings_tab" data-action="settings:category:3">KEYBOARD / MOUSE</button>
            <button id="settings_controller_tab" class="settings_tab" data-action="settings:category:10">CONTROLLER</button>
            <button id="settings_touch_tab" class="settings_tab" data-action="settings:category:11">TOUCH / STYLUS</button>
            <button id="settings_hud_tab" class="settings_tab" data-action="settings:category:9">HUD STUDIO</button>
            <button id="settings_online_tab" class="settings_tab" data-action="settings:category:12">ONLINE SERVICES</button>
            <button id="settings_replays_tab" class="settings_tab" data-action="settings:category:4">REPLAYS</button>
            <button id="settings_profile_tab" class="settings_tab" data-action="settings:category:5">PROFILE</button>
            <button id="settings_system_tab" class="settings_tab" data-action="settings:category:6">SYSTEM</button>
            <button id="settings_maintenance_tab" class="settings_tab" data-action="settings:category:7">MAINTENANCE</button>
            <button id="settings_credits_tab" class="settings_tab" data-action="settings:category:8">CREDITS</button>

    </div>
    <div id="settings_content" class="settings_content">
        <div class="settings_heading"><h2 id="settings_title">Display</h2><span id="settings_dirty">Saved settings</span></div>
        <div class="settings_search"><input id="settings_search" type="text" class="input" placeholder="Search all settings" /><button id="settings_search_button" class="choice" data-action="settings:action:54">SEARCH</button><button id="settings_clear_search" class="choice" data-action="settings:action:55">CLEAR</button></div>
