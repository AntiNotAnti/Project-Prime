        <div id="settings_fields" class="settings_fields">
            <div id="settings_hud_tools" class="settings_tools"><p>Move and resize HUD elements, customize crosshairs, and manage profiles in HUD Studio. Apply your settings to activate the finished layout.</p><button id="settings_hud_edit" class="play_action" data-action="settings:action:28">OPEN HUD STUDIO</button></div>
            <div id="settings_controller_tools" class="settings_tools">
                <p id="settings_controls_help" /><p id="settings_controller_device" />
                <button class="play_action" data-action="settings:action:38">SELECT NEXT CONTROLLER</button>
                <p id="settings_controller_library" />
                <label for="settings_controller_selected">Saved controller profile</label><input id="settings_controller_selected" type="text" class="input" />
                <label for="settings_controller_name">Profile name</label><input id="settings_controller_name" type="text" class="input" />
                <div id="settings_controller_file_tools"><label for="settings_controller_file">Controller profile file</label><input id="settings_controller_file" type="text" class="input" /></div>
                <button class="play_action" data-action="settings:action:39">SAVE CURRENT PROFILE</button>
                <button class="play_action" data-action="settings:action:40">LOAD PROFILE INTO DRAFT</button>
                <button class="play_action" data-action="settings:action:41">ASSIGN PROFILE TO CONTROLLER</button>
                <button class="play_action" data-action="settings:action:42">REMOVE AUTOMATIC ASSIGNMENT</button>
                <button class="play_action" data-action="settings:action:43">EXPORT CONTROLLER PROFILE</button>
                <button class="play_action" data-action="settings:action:44">IMPORT CONTROLLER PROFILE</button>
                <button class="play_action" data-action="settings:action:45">CALIBRATE STICKS AND TRIGGERS</button>
                <div id="settings_manual_mapping"><button class="play_action" data-action="settings:action:46">MAP BUTTONS AND AXES</button><button class="play_action" data-action="settings:action:49">RESET CUSTOM MAPPINGS</button></div>
                <label for="settings_capture_id">Binding action name</label><input id="settings_capture_id" type="text" class="input" />
                <button id="settings_capture_button" class="play_action" data-action="settings:action:59">CAPTURE BINDING</button>
            </div>
