<rml><head><title>Animated source preview</title><link type="text/template" href="../../components/app-shell.rml"/><link type="text/rcss" href="../../themes/prime.rcss"/><link type="text/rcss" href="native-character-source.rcss"/></head><body template="prime-shell"><div id="source_stage"><div class="eyebrow">PRIVATE SOURCE VIEWER</div><h1>ANIMATED SOURCE PREVIEW</h1><p id="source_hint">View imported body materials and source animations with preview lighting. The camera follows the source root. Normal Dark Samus also offers a fixed diagnostic cannon cut. Imported Trooper match actors and weapons remain unavailable.</p><div id="source_panel"><div id="source_preview"/><div class="source_controls"><button id="source_body" data-action="hunter:preview-mode:0">BODY</button><button id="source_cannon" data-action="hunter:preview-mode:1">CANNON</button><h2 id="source_clip"/><p id="source_phase"/><button id="source_prev" data-action="settings:action:246">PREVIOUS CLIP</button><button id="source_next" data-action="settings:action:247">NEXT CLIP</button><button id="source_pause" data-action="settings:action:248">PAUSE</button><button id="source_restart" data-action="settings:action:249">RESTART CLIP</button><button id="source_rotate_left" data-action="hunter:rotate:0">ROTATE LEFT</button><button id="source_rotate_right" data-action="hunter:rotate:1">ROTATE RIGHT</button><button id="source_zoom_out" data-action="hunter:zoom:0">ZOOM OUT</button><button id="source_zoom_in" data-action="hunter:zoom:1">ZOOM IN</button><button id="source_reset" data-action="hunter:preview-reset">RESET VIEW</button></div></div><p id="source_render_status">Loading source preview…</p><p id="source_status" role="status"/><button id="source_back" data-action="hunter:cancel">BACK TO SETTINGS</button></div></body></rml>
