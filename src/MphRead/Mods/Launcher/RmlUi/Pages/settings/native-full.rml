3 id="native_settings_group_178" class="native_settings_group"/><div class="native_settings_caption"><label for="native_settings_value_178" id="native_settings_label_178"/></div><div class="native_settings_editors"><input id="native_settings_slider_178" type="range" min="0" max="1000" step="1" value="0" data-action="settings:action:210" aria-labelledby="native_settings_label_178 native_settings_readout_178"/><input id="native_settings_value_178" type="text" class="input"/><button id="native_settings_cycle_178" aria-labelledby="native_settings_label_178 native_settings_cycle_178" data-action="settings:action:210"/><span id="native_settings_readout_178" class="native_settings_readout"/></div><div id="native_settings_hint_178" class="native_settings_hint"/></div><div id="native_settings_row_179" class="native_settings_row"><h3 id="native_settings_group_179" class="native_settings_group"/><div class="native_settings_caption"><label for="native_settings_value_179" id="native_settings_label_179"/></div><div class="native_settings_editors"><input id="native_settings_slider_179" type="range" min="0" max="1000" step="1" value="0" data-action="settings:action:211" aria-labelledby="native_settings_label_179 native_settings_readout_179"/><input id="native_settings_value_179" type="text" class="input"/><button id="native_settings_cycle_179" aria-labelledby="native_settings_label_179 native_settings_cycle_179" data-action="settings:action:211"/><span id="native_settings_readout_179" class="native_settings_readout"/></div><div id="native_settings_hint_179" class="native_settings_hint"/></div><p id="native_settings_empty"/><div id="native_settings_system"><h3>Settings backup</h3><p>Exports preferences, controls, controller profiles and HUD layouts. Accounts, saves, game files and replays are excluded.</p><label for="native_settings_archive">Archive or controller profile file</label><input id="native_settings_archive" type="text" class="input"/><button data-action="settings:action:6">EXPORT SETTINGS</button><button data-action="settings:action:31">EXPORT DEBUG LOGS</button><button data-action="settings:action:7">IMPORT SETTINGS</button><button data-action="settings:action:8">RESET SETTINGS</button><button data-action="settings:action:9">OPEN SETTINGS FOLDER</button><button data-action="settings:action:22">RESTART NOW</button></div><div id="native_settings_profiles"><h3>Controller</h3><h3>Controller profiles</h3><p>Choose a binding to capture keyboard, mouse or controller input. Duplicate bindings offer a swap before changing either draft.</p><button data-action="settings:action:26">SAMPLE REST</button><button data-action="settings:action:27">SAMPLE RANGE</button><button data-action="settings:action:28">STAGE CALIBRATION</button><label for="native_settings_profile_name">Profile name</label><input id="native_settings_profile_name" type="text" class="input"/><button data-action="settings:action:16">SAVE CURRENT PROFILE</button><button data-action="settings:action:17">LOAD PROFILE</button><button data-action="settings:action:18">EXPORT PROFILE</button><button data-action="settings:action:19">IMPORT PROFILE</button><button data-action="settings:action:20">ASSIGN TO DEVICE</button><button data-action="settings:action:21">REMOVE ASSIGNMENT</button></div><div id="native_settings_maintenance"><h3>Installation</h3><p id="native_settings_summary"/><button data-action="settings:action:5">VERIFY INSTALLATION</button><button data-action="settings:action:10">CLEAN TEMPORARY CACHE</button><button data-action="settings:action:11">CLEAR MAP BUILD CACHE</button><button data-action="settings:action:12">REBUILD MAP THUMBNAILS</button><button data-action="settings:action:13">RESET PERFORMANCE SETTINGS</button><button data-action="settings:action:14">RUN PERFORMANCE DIAGNOSTIC</button></div><button id="native_settings_import_arenas" data-action="settings:action:218">IMPORT ECHOES ARENAS (PREVIEW)</button><button id="native_settings_files" data-action="settings:action:4">GAME FILES</button></div></div></div><div id="native_settings_video" class="native_settings_video"><p id="native_settings_video_countdown" role="status" aria-live="polite"/><button id="native_settings_keep_video" data-action="settings:keep-video">KEEP DISPLAY MODE</button><button data-action="settings:revert-video">REVERT</button></div><div id="native_settings_capture" class="native_settings_video"><p id="native_settings_capture_text"/><button id="native_settings_capture_modifier" data-action="settings:action:215">MODIFIER: NONE</button><button data-action="settings:action:24">CANCEL CAPTURE</button></div><div id="native_settings_confirmation" class="native_settings_video"><p id="native_settings_confirmation_text"/><button id="native_settings_confirm" data-action="settings:action:23">CONFIRM</button><button id="native_settings_conflict_replace" data-action="settings:action:213">REPLACE</button><button id="native_settings_conflict_keep" data-action="settings:action:214">KEEP BOTH</button><button data-action="settings:action:24">CANCEL</button></div><p id="native_settings_help" class="native_settings_help"/><p id="native_settings_status" role="status"/><div class="native_settings_footer"><button id="native_settings_apply" data-action="settings:apply">APPLY CHANGES</button><button data-action="settings:discard">DISCARD</button><button data-action="settings:reset-category">REVERT CATEGORY</button><button data-action="settings:close">BACK</button></div></div></body></rml>