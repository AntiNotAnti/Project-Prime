.settings_workspace { position: absolute; left: 4%; top: 5%; width: 92%; height: 89%; display: flex; flex-direction: row; background-color: rgba(2, 9, 17, 90%); border: 1dp #1b334b; }
.settings_navigation { width: 19%; height: 100%; min-height: 0dp; overflow: auto; padding: 16dp; border-right: 1dp #1b334b; }
.settings_navigation h1 { font-size: 28dp; margin-bottom: 20dp; }
.settings_tab { display: block; width: 100%; height: 35dp; text-align: left; padding-left: 12dp; margin-bottom: 5dp; background-color: #0c1725; border: 1dp #1c354f; color: #c8d8e9; }
.settings_tab:hover, .settings_tab:focus { background-color: #183951; border-color: #459ac4; color: #ffffff; }
.settings_content { width: 81%; height: 100%; min-height: 0dp; overflow: auto; padding: 16dp 20dp; }
.settings_heading { display: flex; justify-content: space-between; height: 42dp; }
.settings_heading h2 { font-size: 25dp; }
#settings_dirty { color: #7194ad; padding-top: 8dp; }
.settings_fields { display: block; width: 100%; height: auto; overflow: visible; padding-right: 10dp; }
.settings_row { display: flex; flex-direction: row; align-items: center; width: 100%; min-height: 58dp; padding: 7dp 8dp; border-bottom: 1dp #162b40; }
.settings_row.dirty { background-color: #102840; }
.settings_description { width: 49%; padding-right: 12dp; }
.settings_description label { font-size: 16dp; color: #dceafa; }
.settings_help { font-size: 12dp; color: #7897ad; padding-top: 3dp; }
.settings_value { width: 35%; height: 32dp; }
.settings_cycle { width: 12%; height: 32dp; margin-left: 10dp; font-size: 12dp; }
.settings_paging { display: flex; justify-content: center; align-items: center; height: 42dp; margin-top: 4dp; }
#settings_paging { margin: 0dp 18dp; color: #92b2ce; }
.settings_error { min-height: 20dp; color: #ff918a; font-size: 13dp; }
.settings_status { min-height: 20dp; color: #a0bacf; font-size: 13dp; }
.settings_actions { display: flex; justify-content: flex-end; height: 44dp; margin-top: 5dp; }
.settings_actions button { width: 165dp; margin-left: 10dp; }
.settings_tools { padding: 15dp; }
.settings_tools p { margin: 10dp 0dp; color: #a9bdce; }
.settings_tools button { display: block; margin: 8dp 0dp; width: 85%; height: 40dp; }
#settings_archive_path { display: block; width: 96%; margin: 8dp 0dp; height: 36dp; }
.settings_credits_text { white-space: pre-wrap; font-size: 15dp; color: #c5d5e5; }
.settings_dialog { position: absolute; left: 25%; top: 27%; width: 50%; padding: 28dp; background-color: #07121f; border: 1dp #284d68; }
.settings_dialog h1 { font-size: 25dp; margin-bottom: 15dp; }
.settings_dialog p { color: #b3c8da; line-height: 1.4; margin-bottom: 18dp; }
.settings_dialog .dialog_actions { display: flex; justify-content: flex-end; margin-top: 20dp; }
.settings_dialog button { width: 145dp; height: 40dp; margin-left: 8dp; }

.settings_search { display: flex; align-items: center; height: 38dp; margin-bottom: 8dp; }
.settings_search input { width: 70%; height: 32dp; margin-right: 10dp; }
.settings_search button { width: 12%; height: 32dp; margin-left: 6dp; }
.settings_tools input { display: block; width: 96%; height: 32dp; margin: 8dp 0dp; }

.settings_dialog .settings_conflict_actions { width: 100%; }
.settings_dialog .settings_conflict_actions button { width: 22%; margin-left: 2%; }

.settings_glyph_dialog { top: 16%; width: 65%; left: 17%; }
#settings_glyph_name { width: 100%; height: 38dp; margin-bottom: 8dp; }
.settings_glyph_tabs { display: flex; width: 100%; margin: 8dp 0dp; }
.settings_glyph_tabs button { width: 19%; height: 32dp; margin-left: 1%; font-size: 11dp; }
.settings_glyph_grid { display: flex; flex-wrap: wrap; width: 100%; min-height: 195dp; }
.settings_glyph_grid .settings_glyph { width: 11%; height: 50dp; margin-left: 1%; margin-bottom: 8dp; font-size: 22dp; }
.settings_glyph_paging { display: flex; justify-content: center; align-items: center; width: 100%; margin: 10dp 0dp; }
.settings_glyph_paging span { margin: 0dp 20dp; }

/* Each side owns its scroll viewport, so every category, field, page action and
   commit action stays reachable between the fixed application chrome. The
   content flows as one scroll region instead of mixing percentage field height
   with fixed rows whose combined height exceeds short windows. */
@media (max-width: 800dp) {
    .settings_workspace { left: 2%; top: 3%; width: 96%; height: 94%; }
    .settings_navigation { width: 30%; padding: 10dp; }
    .settings_navigation h1 { font-size: 20dp; margin-bottom: 12dp; }
    .settings_tab { min-height: 44dp; padding-left: 6dp; font-size: 13dp; }
    .settings_content { width: 70%; padding: 10dp 12dp; }
    .settings_heading { display: block; height: auto; margin-bottom: 10dp; }
    .settings_heading h2 { font-size: 22dp; }
    #settings_dirty { display: block; padding-top: 4dp; font-size: 13dp; }
    .settings_search { flex-wrap: wrap; height: auto; margin-bottom: 12dp; }
    .settings_search input { width: 100%; height: 38dp; margin: 0dp 0dp 6dp 0dp; }
    .settings_search button { width: 45%; height: 38dp; margin: 0dp 5% 0dp 0dp; padding-left: 3dp; padding-right: 3dp; font-size: 12dp; }
    .settings_row { display: block; min-height: 105dp; padding: 8dp 0dp; }
    .settings_description { width: 100%; padding: 0dp; margin-bottom: 6dp; }
    .settings_value { display: inline-block; width: 70%; min-height: 38dp; }
    .settings_cycle { display: inline-block; width: 25%; min-height: 38dp; margin-left: 2%; padding-left: 3dp; padding-right: 3dp; }
    .settings_paging { width: 100%; height: auto; min-height: 44dp; margin: 12dp 0dp; }
    .settings_paging button { width: 30%; min-height: 44dp; padding-left: 2dp; padding-right: 2dp; font-size: 11dp; }
    #settings_paging { width: 40%; margin: 0dp; text-align: center; font-size: 12dp; }
    .settings_actions { display: block; width: 100%; height: auto; margin-top: 10dp; }
    .settings_actions button { display: block; width: 100%; min-height: 44dp; margin: 6dp 0dp 0dp 0dp; }
    .settings_tools { padding: 8dp 0dp; }
    .settings_tools button { width: 100%; min-height: 44dp; height: auto; padding-top: 8dp; padding-bottom: 8dp; }
}

.settings_navigation { width: 17%; padding: 12dp; }
.settings_groups { width: 23%; height: 100%; overflow-y: auto; padding: 14dp 10dp; background-color: #06121e; border-right: 1dp #1b334b; }
.settings_group { display: block; width: 100%; min-height: 34dp; padding: 8dp; margin-bottom: 5dp; text-align: left; font-size: 13dp; color: #a7c1d5; background-color: #0c1e2e; border: 1dp #1c354f; }
.settings_group:hover, .settings_group:focus, .settings_group.selected, .settings_tab.selected { background-color: #183951; border-color: #72c7ff; color: #fff; }
.settings_content { width: 60%; padding: 14dp; }
.settings_heading h2 { font-size: 20dp; }
.settings_row { min-height: 46dp; padding: 5dp; }
.settings_description label { font-size: 14dp; }
.settings_help { font-size: 11dp; }
.settings_tools button { display: inline-block; width: 47%; margin-right: 2%; font-size: 12dp; }
.settings_actions button { width: 30%; font-size: 12dp; }
@media (max-width: 900dp) { .settings_navigation { width: 20%; } .settings_groups { width: 25%; } .settings_content { width: 55%; } .settings_heading { height: auto; } .settings_heading h2 { font-size: 17dp; } }

.settings_content { display: flex; flex-direction: column; overflow: hidden; }
.settings_heading, .settings_search, .settings_paging, .settings_error, .settings_status, .settings_actions { flex-shrink: 0; }
.settings_fields { flex: 1; min-height: 0dp; overflow-y: auto; }
.settings_navigation h1 { margin-bottom: 12dp; }
.settings_tab { height: 30dp; margin-bottom: 3dp; font-size: 12dp; }
.settings_status, .settings_error { font-size: 11dp; }
.settings_tools #settings_hud_edit { width: 100%; }

/* Keep exit outside the category scroll area. */
.settings_navigation { padding-bottom: 60dp; }
#settings_back { position: absolute; left: 12dp; bottom: 12dp; width: 13%; height: 36dp; text-align: center; line-height: 34dp; padding: 0dp; z-index: 2; }
.settings_value, .settings_search input { background-color: #102638; border: 1dp #365b77; padding: 5dp 8dp; color: #edf7ff; }
.settings_cycle, .settings_search button { background-color: #163951; border: 1dp #477b9b; color: #e3f3ff; text-align: center; line-height: 30dp; }
.settings_value:focus, .settings_search input:focus { border-color: #72c7ff; }

.settings_navigation { height: 85%; padding-bottom: 12dp; }

@media (max-width: 800dp) {
 .settings_navigation { padding: 8dp; } .settings_navigation h1 { font-size: 18dp; }
 .settings_tab { min-height: 28dp; padding-left: 4dp; font-size: 10dp; }
 .settings_groups { padding: 8dp 5dp; } .settings_group { font-size: 11dp; padding: 6dp; }
 .settings_content { padding: 8dp; } .settings_heading { height: 26dp; margin: 0dp; }
 .settings_heading h2 { font-size: 15dp; } #settings_dirty { display: none; }
 .settings_search { height: 32dp; margin-bottom: 5dp; flex-wrap: nowrap; }
 .settings_search input { width: 64%; height: 30dp; margin: 0dp; font-size: 11dp; }
 .settings_search button { width: 17%; height: 30dp; margin: 0dp 0dp 0dp 1%; font-size: 9dp; min-height: 0dp; }
 .settings_row { display: flex; min-height: 54dp; padding: 4dp 0dp; }
 .settings_description { width: 48%; margin: 0dp; padding-right: 4dp; } .settings_description label { font-size: 12dp; }
 .settings_value { width: 34%; min-height: 30dp; padding: 4dp; font-size: 12dp; }
 .settings_cycle { width: 16%; min-height: 30dp; margin-left: 1%; font-size: 9dp; }
 .settings_paging { height: 28dp; min-height: 28dp; margin: 2dp 0dp; } .settings_paging button { min-height: 26dp; font-size: 9dp; }
 .settings_status, .settings_error { min-height: 12dp; font-size: 9dp; }
 .settings_actions { display: flex; height: 30dp; margin-top: 4dp; } .settings_actions button { width: 32%; min-height: 30dp; margin: 0dp 0dp 0dp 1%; padding: 3dp; font-size: 9dp; }
 #settings_back { left: 8dp; width: 16%; height: 30dp; line-height: 28dp; bottom: 8dp; }
}
@media (max-height: 500dp) {
 #topbar { height: 42dp; } #primary_nav .nav { line-height: 38dp; } .brand_subtitle { display: none; }
 #footerbar { height: 36dp; } .footer_button { padding-top: 5dp; padding-bottom: 5dp; }
 #stage { top: 42dp; bottom: 36dp; }
 .settings_workspace { top: 2%; height: 96%; }
 .settings_navigation h1 { margin-bottom: 4dp; font-size: 16dp; }
 .settings_navigation { height: 83%; }
}

/* Familiar category sidebar, full-width form and persistent commit bar. */
.settings_workspace { left: 3%; top: 3%; width: 94%; height: 94%; background-color: #081522; }
.settings_navigation { width: 210dp; flex-shrink: 0; height: 100%; padding: 18dp 12dp 66dp; }
.settings_tab { min-height: 36dp; height: auto; font-size: 14dp; padding: 8dp 10dp; margin-bottom: 4dp; }
.settings_content { flex: 1; width: auto; min-width: 0dp; padding: 20dp; }
.settings_groups { display: flex; flex-wrap: wrap; width: 100%; height: auto; max-height: 110dp; flex-shrink: 0; overflow-y: auto; padding: 6dp 0dp; margin-bottom: 10dp; background-color: transparent; border-right: 0dp; border-bottom: 1dp #284258; }
.settings_group { width: auto; min-height: 32dp; margin: 0dp 6dp 6dp 0dp; padding: 7dp 12dp; }
.settings_heading { height: 38dp; }
.settings_heading h2 { font-size: 24dp; }
.settings_row { min-height: 62dp; padding: 10dp 8dp; }
.settings_description label { font-size: 16dp; }
.settings_help { font-size: 12dp; }
.settings_value { height: 36dp; }
.settings_cycle { height: 36dp; line-height: 34dp; }
.settings_status, .settings_error { min-height: 18dp; font-size: 13dp; }
.settings_actions { height: 44dp; margin-top: 10dp; }
.settings_actions button { min-height: 40dp; width: 30%; font-size: 14dp; }
#settings_back { width: 182dp; left: 12dp; bottom: 14dp; }
@media (max-width: 800dp) { .settings_navigation { width: 154dp; padding: 10dp 8dp 58dp; } .settings_tab { font-size: 12dp; padding: 7dp 5dp; } .settings_content { padding: 12dp; } #settings_back { width: 130dp; } .settings_row { min-height: 60dp; } .settings_description label { font-size: 13dp; } .settings_group { font-size: 12dp; padding: 6dp; } .settings_heading h2 { font-size: 18dp; } }

.settings_navigation { position: absolute; left: 0dp; top: 0dp; bottom: 64dp; height: auto; padding-bottom: 12dp; }
.settings_content { margin-left: 210dp; }
@media (max-width: 800dp) { .settings_navigation { bottom: 54dp; } .settings_content { margin-left: 154dp; } }
