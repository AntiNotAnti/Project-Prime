<rml><head><title>Controller setup</title><link type="text/template" href="../../components/dialog.rml" /><link type="text/rcss" href="settings.rcss" /></head><body template="prime-dialog"><div class="settings_dialog"><h1>CONTROLLER SETUP</h1><p id="settings_setup_status">Release controls and keep both sticks centered.</p><div class="dialog_actions"><button id="settings_setup_cancel" class="play_action quiet" data-action="settings:action:48">CANCEL</button><button id="settings_setup_apply" class="play_action" data-action="settings:action:47">STAGE SETUP</button></div></div></body></rml>
