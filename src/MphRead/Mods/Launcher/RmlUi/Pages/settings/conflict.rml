<rml><head><title>Controller binding conflict</title><link type="text/template" href="../../components/dialog.rml" /><link type="text/rcss" href="settings.rcss" /></head><body template="prime-dialog"><div class="settings_dialog"><h1>BINDING CONFLICT</h1><p id="settings_capture_status">This button is already assigned to another action.</p><div class="dialog_actions settings_conflict_actions"><button id="settings_capture_cancel" class="play_action quiet" data-action="settings:action:60">CANCEL</button><button class="play_action" data-action="settings:action:61">SWAP</button><button class="play_action" data-action="settings:action:62">REPLACE</button><button class="play_action" data-action="settings:action:63">KEEP BOTH</button></div></div></body></rml>
