<rml><head><title>Capture binding</title><link type="text/template" href="../../components/dialog.rml" /><link type="text/rcss" href="settings.rcss" /></head><body template="prime-dialog"><div class="settings_dialog"><h1>CAPTURE BINDING</h1><p id="settings_capture_status">Press a key, mouse button, wheel, or controller button. Escape cancels.</p><div class="dialog_actions"><button id="settings_capture_cancel" class="play_action quiet" data-action="settings:action:60">CANCEL</button></div></div></body></rml>
