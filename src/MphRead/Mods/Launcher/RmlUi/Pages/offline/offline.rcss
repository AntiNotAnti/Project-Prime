.offline_page { width: 100vw; height: 100%; padding: 18dp; overflow-y: auto; }
.offline_page h1, .offline_dialog h1 { font-size: 26dp; margin: 0 0 8dp; color: #edf7ff; }
.offline_page h2 { font-size: 20dp; margin: 8dp 0 10dp; color: #72c7ff; }
.offline_page p, .offline_dialog p { color: #9caec0; margin: 0 0 12dp; }
.offline_columns, .offline_rule_columns, .offline_actions { display: flex; gap: 12dp; }
.offline_panel { flex: 1; min-width: 0; padding: 16dp; background-color: #0b1723; border: 1dp #28465e; }
.offline_choice, .offline_action { display: block; width: 100%; padding: 10dp 12dp; margin-bottom: 6dp; text-align: left; color: #c9dceb; border: 1dp #29485e; background-color: #101f2d; }
.offline_choice { display: flex; justify-content: space-between; }
.offline_choice span { color: #72c7ff; font-size: 12dp; }
.offline_choice b { font-size: 16dp; font-weight: bold; }
.offline_choice:hover, .offline_action:hover { background-color: #19384f; }
.offline_choice:focus, .offline_action:focus, .offline_field input:focus { border-color: #72c7ff; }
.offline_action.primary { color: #d8f3ff; background-color: #15465e; border-color: #72c7ff; text-align: center; }
.offline_summary { margin: 14dp 0; color: #9caec0; font-size: 12dp; }
.offline_error { color: #ff9090; margin: 6dp 0; }
.offline_notice { color: #e9c376; margin: 6dp 0; }
.offline_dialog { position: absolute; top: 10%; left: 8%; width: 84%; max-height: 80%; overflow-y: auto; padding: 22dp; border: 1dp #4b7799; background-color: #09131e; }
.offline_field { margin-bottom: 12dp; }
.offline_field label { display: block; margin-bottom: 6dp; color: #72c7ff; }
.offline_field input { display: block; width: 100%; padding: 10dp; color: #edf7ff; background-color: #14283a; border: 1dp #29485e; }
.offline_actions { margin-top: 12dp; }
.offline_actions button { flex: 1; }
.offline_arena_list { display: flex; flex-wrap: wrap; align-content: flex-start; overflow-y: auto; }
.offline_arena_row { display: flex; flex-direction: column; width: 31%; height: 154dp; margin: 0 1% 8dp; padding: 6dp; box-sizing: border-box; border: 1dp #29485e; }
.offline_arena_row button { display: flex; flex: 1; flex-direction: column; min-height: 0; width: 100%; padding: 6dp; text-align: left; color: #d8f3ff; background-color: #14283a; }
.offline_arena_row button:focus { border: 1dp #72c7ff; }
.offline_arena_art { position: relative; flex-shrink: 0; width: 100%; height: 86dp; background-color: #091d2b; }
.offline_arena_art img { width: 100%; height: 100%; }
.offline_arena_art_label { position: absolute; left: 0; top: 43%; width: 100%; text-align: center; color: #83c5eb; font-size: 10dp; letter-spacing: 1dp; }
.offline_arena_row button > span { display: block; width: 100%; margin-top: 5dp; font-size: 14dp; line-height: 17dp; font-weight: bold; overflow: hidden; word-break: break-word; }
.offline_arena_reason { flex-shrink: 0; width: 100%; margin-top: 4dp; color: #e9c376; font-size: 10dp; line-height: 12dp; }
@media (max-width: 800dp) { .offline_columns, .offline_rule_columns { flex-direction: column; } .offline_dialog { left: 3%; width: 94%; top: 5%; max-height: 90%; } }

.offline_page h1, .offline_page h2, .offline_page p, .offline_dialog h1, .offline_dialog h2, .offline_dialog p { display: block; }

/* Viewport widths avoid zero-width automatic text boxes inside the positioned shell stage. */
.offline_page h1, #offline_description { width: 94vw; }
.offline_panel h2, .offline_panel p { width: 42vw; }
.offline_dialog h1, .offline_dialog p { width: 76vw; }
@media (max-width: 800dp) { .offline_panel h2, .offline_panel p, .offline_dialog h1, .offline_dialog p { width: 86vw; } }

/* Give every nested flow/flex container a concrete viewport basis. */
.offline_columns { width: 94vw; }
.offline_columns > .offline_panel { flex: none; width: 46vw; }
.offline_columns .offline_choice, .offline_columns .offline_action, .offline_columns .offline_summary,
.offline_columns .offline_error { width: 42vw; }
.offline_choice span { width: 17vw; flex: none; }
.offline_choice b { width: 21vw; flex: none; text-align: right; }
.offline_page > .eyebrow, .offline_page > .offline_notice, .offline_page > .offline_error { width: 94vw; }
.offline_dialog { width: 84vw; }
.offline_rule_columns, .offline_dialog > .offline_actions, .offline_arena_list { width: 76vw; }
.offline_rule_columns > .offline_panel { flex: none; width: 24vw; }
.offline_rule_columns .offline_action, .offline_rule_columns .offline_field,
.offline_rule_columns .offline_field input, .offline_rule_columns .offline_field label { width: 20vw; }
.offline_actions button { flex: none; width: 37vw; }
.offline_arena_row { width: 31%; }
.offline_arena_row button, .offline_arena_reason { width: 100%; }
@media (max-width: 800dp) {
 .offline_columns, .offline_columns > .offline_panel, .offline_rule_columns,
 .offline_rule_columns > .offline_panel, .offline_dialog > .offline_actions, .offline_arena_list { width: 86vw; }
 .offline_columns .offline_choice, .offline_columns .offline_action, .offline_columns .offline_summary,
 .offline_columns .offline_error, .offline_panel h2, .offline_panel p,
 .offline_rule_columns .offline_action, .offline_rule_columns .offline_field,
 .offline_rule_columns .offline_field input, .offline_rule_columns .offline_field label { width: 78vw; }
 .offline_choice span { width: 30vw; } .offline_choice b { width: 42vw; }
 .offline_actions button { width: 41vw; }
 .offline_arena_row { width: 48%; } .offline_arena_row button, .offline_arena_reason { width: 100%; }
}

/* Activities each own their setup section and retain the shared launch controller. */
.offline_page { padding: 20dp 4%; }
.offline_columns { width: 100%; }
.offline_columns > .offline_panel { width: 100%; padding: 12dp; }
.offline_columns .offline_choice { display: inline-flex; width: 47%; margin-right: 2%; padding: 8dp; }
.offline_choice span { width: 40%; } .offline_choice b { width: 60%; }
.offline_columns .offline_action, .offline_columns .offline_summary, .offline_columns .offline_error { width: 97%; }
.offline_panel h2, .offline_panel p { width: 97%; }
.offline_back { position: absolute; right: 4%; top: 18dp; padding: 10dp 16dp; background-color: #10283a; color: #bcd8ed; border: 1dp #365c79; }
@media (max-height: 650dp) { .offline_page { padding-top: 10dp; } .offline_choice b { font-size: 14dp; } .offline_columns .offline_choice { padding: 5dp 8dp; } .offline_action { padding: 7dp 10dp; } }

.offline_panel h2 { margin: 4dp 0dp 8dp; }
.offline_summary { margin: 8dp 0dp; }

/* At the minimum supported width the modal's old 22dp padding left less
   space than its explicit 86vw form/list budget. Preserve that native width
   basis while leaving room for the vertical scrollbar and border. */
@media (max-width:560dp) {
    .offline_dialog { left:2vw; width:96vw; padding:12dp; }
    .offline_rule_columns, .offline_dialog > .offline_actions, .offline_arena_list { width:86vw; }
    .offline_dialog h1, .offline_dialog p { word-break:break-word; }
}

/* Rules and training keep their commit/return row outside the reading area.
   Long rules remain scrollable without scrolling away their draft actions. */
.offline_dialog_config { display:flex; flex-direction:column; height:auto; max-height:80vh; overflow:hidden; }
.offline_dialog_config > h1, .offline_dialog_config > .offline_actions,
.offline_dialog_config > #offline_training_done { flex-shrink:0; }
.offline_dialog_body { flex:0 1 auto; min-height:0; width:76vw; overflow-y:auto; overflow-x:hidden; }
.offline_training_grid { width:76vw; }
#offline_training_done { width:76vw; margin:12dp 0 0; }
.offline_dialog_body > .offline_error { width:100%; }
@media (min-width:900dp) {
    .offline_training_grid { display:flex; flex-wrap:wrap; align-content:flex-start; }
    .offline_training_grid > button { width:48%; min-width:0; margin-right:2%; }
}
@media (max-width:800dp) {
    .offline_dialog_config { max-height:90vh; }
    .offline_dialog_body, .offline_training_grid, #offline_training_done { width:86vw; }
}

.offline_choice_navigation { display:flex; align-items:stretch; width:42vw; margin-bottom:6dp; }
.offline_choice_navigation .offline_previous { flex:0 0 30dp; width:30dp; margin-right:4dp; color:#d8f3ff; background-color:#14283a; border:1dp #29485e; font-size:18dp; }
.offline_choice_navigation .offline_choice { flex:1; width:auto; min-width:0; margin-bottom:0; }
.offline_choice_navigation .offline_previous:hover, .offline_choice_navigation .offline_previous:focus { border-color:#72c7ff; background-color:#19384f; }
.offline_dialog .offline_choice_navigation { width:100%; }
@media (max-width:800dp) { .offline_choice_navigation { width:78vw; } }

@media (max-height:520dp) {
    .offline_arena_row { height: 128dp; padding: 4dp; }
    .offline_arena_row button { padding: 4dp; }
    .offline_arena_art { height: 68dp; }
    .offline_arena_row button > span { font-size: 12dp; line-height: 14dp; margin-top: 3dp; }
}

/* Battle setup follows the online lobby's left setup rail and right roster.
   The Aim Lab remains a single scrollable setup panel on this same route. */
#offline_page { padding:16dp 24dp 20dp; overflow-y:auto; overflow-x:hidden; }
#offline_page > .eyebrow, #offline_page > #offline_description { width:72vw; }
#offline_page > h1 { width:72vw; margin:2dp 0 6dp; font-size:26dp; line-height:30dp; }
#offline_page > #offline_description { margin:0 0 8dp; font-size:12dp; line-height:16dp; }
#offline_page > #offline_availability, #offline_page > #offline_error { width:72vw; margin:2dp 0; }
#offline_back { position:absolute; right:24dp; top:14dp; padding:8dp 12dp; color:#cceaff; background-color:#10283a; border:1dp #365c79; }
#offline_columns { display:flex; align-items:flex-start; gap:14dp; width:100%; margin-top:8dp; }
#offline_columns > #offline_match_panel { flex:0 0 35%; width:35%; max-width:440dp; max-height:calc(100vh - 178dp); overflow-y:auto; }
#offline_columns > #offline_roster_panel { flex:1 1 0; width:auto; min-width:0; max-height:calc(100vh - 178dp); overflow-y:auto; }
#offline_columns > #offline_training_panel { flex:1 1 auto; width:100%; max-width:900dp; max-height:calc(100vh - 178dp); overflow-y:auto; }
#offline_match_panel > .eyebrow { width:100%; margin-bottom:4dp; }
#offline_match_panel h2, #offline_roster_panel h2 { width:100%; margin:4dp 0 8dp; color:#edf7ff; font-size:18dp; line-height:22dp; }
#offline_match_panel .offline_choice_navigation, #offline_match_panel > .offline_choice,
#offline_roster_panel .offline_choice_navigation { width:100%; }
#offline_match_panel .offline_choice, #offline_roster_panel .offline_choice {
    display:flex; width:100%; margin:0 0 6dp; padding:7dp 8dp; box-sizing:border-box;
}
#offline_match_panel .offline_choice span, #offline_roster_panel .offline_choice span { width:40%; flex:none; }
#offline_match_panel .offline_choice b, #offline_roster_panel .offline_choice b { width:60%; flex:none; font-size:14dp; }
#offline_match_panel .offline_choice_navigation .offline_choice,
#offline_roster_panel .offline_choice_navigation .offline_choice { flex:1; width:auto; min-width:0; }
#offline_match_panel .offline_choice_navigation .offline_previous,
#offline_roster_panel .offline_choice_navigation .offline_previous { flex:0 0 28dp; width:28dp; }
#offline_match_panel > .offline_action, #offline_match_panel > .offline_summary { width:100%; }
#offline_match_panel > .offline_action { margin-top:4dp; padding:8dp 10dp; }
#offline_match_panel > .offline_summary { margin:8dp 0 4dp; }
#offline_arena_error { width:100%; }
.offline_roster_panel { padding:12dp; }
.offline_roster_header { display:flex; align-items:center; justify-content:space-between; width:100%; margin-bottom:8dp; }
.offline_roster_header .eyebrow { width:100%; margin:0 0 2dp; font-size:11dp; letter-spacing:1dp; }
.offline_roster_header h2 { margin:0; }
.offline_roster_count { flex-shrink:0; margin-left:8dp; padding:4dp 8dp; color:#78caff; font-size:13dp; font-weight:bold; border:1dp rgba(114,199,255,25%); }
.offline_roster_list { display:flex; flex-direction:column; width:100%; }
.offline_roster_row { flex:0 0 auto; display:flex; align-items:center; width:100%; min-width:0; min-height:42dp; margin:0 0 4dp; padding:3dp 6dp; text-align:left; color:#d9efff; background-color:rgba(11,35,53,80%); border:1dp rgba(114,199,255,18%); border-left:3dp #426983; }
.offline_roster_row.local { border-left-color:#d3efff; background-color:rgba(19,49,69,92%); }
.offline_roster_row.occupied { border-left-color:#49caff; }
.offline_roster_row.selected { background-color:#173e58; border-color:#78caff; border-left-color:#ffffff; }
.offline_roster_row.empty { color:#8298aa; background-color:rgba(5,17,27,75%); border-style:dashed; border-left-color:#526779; }
.offline_roster_row:disabled { opacity:1; }
.offline_roster_row:hover:not(:disabled), .offline_roster_row:focus:not(:disabled) { background-color:#1c4b68; border-color:#78caff; }
.offline_roster_index { flex:0 0 24dp; color:#8eafc7; text-align:center; font-family:"JetBrains Mono"; font-size:12dp; }
.offline_roster_copy { display:block; flex:1 1 auto; min-width:0; padding:1dp 8dp; }
.offline_roster_copy b { display:block; width:100%; color:#eaf6ff; font-size:14dp; line-height:16dp; overflow:hidden; white-space:nowrap; }
.offline_roster_detail { display:block; width:100%; color:#a0b9cb; font-size:12dp; line-height:14dp; }
.offline_roster_state { flex:0 0 auto; min-width:56dp; color:#8eafc7; text-align:right; font-size:11dp; line-height:14dp; letter-spacing:0.5dp; }
.offline_roster_row.local .offline_roster_state { color:#d3efff; }
.offline_roster_row.occupied .offline_roster_state { color:#8ecff0; }
.offline_roster_row.empty .offline_roster_state { color:#71869a; }
.offline_bot_controls { display:flex; flex-wrap:wrap; gap:0 2%; width:100%; margin-top:10dp; padding-top:8dp; border-top:1dp rgba(114,199,255,18%); }
.offline_bot_controls > h2, .offline_bot_controls > p { width:100%; }
.offline_bot_controls > p { margin:0 0 8dp; color:#91a9bb; font-size:11dp; line-height:14dp; }
.offline_bot_controls .offline_choice_navigation { flex:0 0 49%; width:49%; min-width:0; margin-bottom:6dp; }
.offline_bot_controls .offline_choice { padding:6dp; }
#offline_training_panel > h2, #offline_training_panel > p { width:100%; }
#offline_training_panel .offline_choice_navigation { width:100%; }

@media (max-width:800dp) {
    #offline_page { padding:12dp 12dp 18dp; }
    #offline_page > .eyebrow, #offline_page > h1, #offline_page > #offline_description,
    #offline_page > #offline_availability, #offline_page > #offline_error { width:100%; }
    #offline_back { right:12dp; top:8dp; padding:6dp 8dp; font-size:11dp; }
    #offline_columns { flex-direction:column; gap:10dp; }
    #offline_columns > #offline_match_panel, #offline_columns > #offline_roster_panel,
    #offline_columns > #offline_training_panel { flex:none; width:100%; max-width:none; max-height:none; overflow:visible; }
    #offline_match_panel .offline_choice, #offline_roster_panel .offline_choice { padding:8dp; }
    .offline_roster_row { min-height:40dp; }
    .offline_bot_controls .offline_choice_navigation { flex-basis:100%; width:100%; margin-right:0; }
}
@media (max-width:480dp) {
    #offline_page > h1 { font-size:22dp; line-height:25dp; }
    #offline_back { top:4dp; right:8dp; }
    #offline_page > .eyebrow { font-size:10dp; }
    #offline_match_panel, #offline_roster_panel, #offline_training_panel { padding:10dp; }
    .offline_roster_state { min-width:48dp; font-size:10dp; }
}
@media (max-height:440dp) and (min-width:801dp) {
    #offline_columns > #offline_match_panel, #offline_columns > #offline_roster_panel,
    #offline_columns > #offline_training_panel { max-height:calc(100vh - 154dp); }
    .offline_roster_row { min-height:34dp; }
    .offline_bot_controls > p { display:none; }
}
