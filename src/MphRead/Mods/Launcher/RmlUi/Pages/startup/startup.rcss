body { width:100%; height:100%; margin:0; background-color:#030b14; font-family:Rajdhani; }
#native_startup { position:absolute; left:0; right:0; top:0; bottom:0; overflow:hidden; background-color:#030b14; }
#native_startup_art { position:absolute; left:50%; top:50%; width:100%; height:auto; transform:translate(-50%,-50%); }
#native_startup.wide #native_startup_art { width:auto; height:100%; }
#native_startup_continue { position:absolute; left:0; top:0; width:100%; height:100%; margin:0; padding:0; border:0; background-color:rgba(0,0,0,0); color:#d9f6ff; text-align:center; tab-index:auto; }
#native_startup_continue:hover,#native_startup_continue:focus,#native_startup_continue:disabled { background-color:rgba(0,0,0,0); transform:none; }
#native_startup_identity { position:absolute; left:5%; top:18dp; width:90%; margin:0; font-size:14dp; line-height:18dp; letter-spacing:2dp; text-align:center; color:#a4c4d7; }
#native_startup_prompt { position:absolute; left:10%; right:10%; bottom:6%; display:block; padding:10dp; font-size:28dp; line-height:34dp; font-weight:bold; letter-spacing:4dp; color:#d9f6ff; background-color:rgba(3,11,20,80%); }
@media (max-height:500dp) { #native_startup_identity { top:9dp; font-size:11dp; line-height:14dp; } #native_startup_prompt { padding:6dp; font-size:20dp; line-height:26dp; bottom:5%; } }
