/* RmlUi 6.3 computes intrinsic modal text widths before percentage children.
   Use the same bounded viewport budget for the card and its flow children.
   88vw card - 80vw content leaves 4vw per side (>= 16dp at 400dp).
   The 640/600dp caps retain that padding budget on large displays. */
#update_card { width:88vw; max-width:640dp; padding:16dp; }
#versions_rows { position:relative; width:80vw; max-width:600dp; box-sizing:border-box; display:flex; flex-direction:column; align-items:stretch; max-height:280dp; overflow-y:auto; overflow-x:hidden; margin-top:12dp; }
#versions_rows button { position:relative; display:block; flex-shrink:0; width:80vw; max-width:600dp; box-sizing:border-box; min-height:38dp; margin:3dp 0; padding:8dp; color:#dff5ff; border:1dp #3e88aa; background-color:#0b344c; tab-index:auto; text-align:left; white-space:normal; word-break:break-word; }
#versions_rows button:hover,#versions_rows button:focus { background-color:#11648b; }
#versions_rows button:disabled,#update_actions button:disabled { color:#8295a3; border-color:#244354; background-color:#11232e; }
#versions_confirmation { color:#ffd18b; }
#update_card .eyebrow,#update_card h1,#update_card p,#update_card .update_version,#update_actions { width:80vw; max-width:600dp; box-sizing:border-box; }
#update_card .update_version span { width:22vw; max-width:160dp; }
#update_card .update_version b { width:56vw; max-width:420dp; word-break:break-word; }
#update_actions, #update_actions button { position:relative; }
#versions_close { min-width:80dp; }
@media (max-height:500dp) {
    #update_card { padding:12dp; }
    #versions_rows { max-height:130dp; }
    #versions_rows button { min-height:32dp; padding:6dp; }
}
