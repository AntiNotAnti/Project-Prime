body { width:100%; height:100%; margin:0; font-family:Rajdhani; color:#d8ecf7; }
#update_scrim { position:absolute; left:0; top:0; width:100%; height:100%; background-color:rgba(1,8,15,87%); }
#update_card { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:76%; max-width:620dp; max-height:88%; overflow-y:auto; box-sizing:border-box; padding:24dp; border:1dp #397895; background-color:#071b29; }
#update_card .eyebrow { color:#6ecfff; font-size:11dp; letter-spacing:2dp; }
#update_card h1 { font-size:30dp; line-height:34dp; margin:12dp 0; }
#update_card p { font-size:15dp; line-height:20dp; margin:12dp 0; color:#a9c7d9; }
.update_version { display:flex; justify-content:space-between; padding:12dp 0; border-bottom:1dp #244354; font-size:16dp; }
.update_version span { display:block; width:28%; flex-shrink:0; color:#8bb3cc; }
.update_version b { display:block; width:70%; flex-shrink:0; text-align:right; white-space:normal; }
#update_actions { display:flex; justify-content:flex-end; flex-wrap:wrap; margin-top:18dp; }
#update_actions button { margin:4dp 0 0 10dp; padding:10dp 16dp; min-height:40dp; font-size:15dp; color:#dff5ff; border:1dp #3e88aa; background-color:#0b344c; tab-index:auto; }
#update_actions button:hover,#update_actions button:focus { background-color:#11648b; border-color:#83dcff; }
@media (max-height:500dp) { #update_card { padding:14dp; width:88%; } #update_card h1 { font-size:22dp; line-height:26dp; margin:6dp 0; } #update_card p { font-size:12dp; line-height:15dp; margin:8dp 0; } .update_version { padding:7dp 0; font-size:14dp; } #update_actions { margin-top:10dp; } #update_actions button { min-height:30dp; padding:6dp 12dp; font-size:12dp; } }
