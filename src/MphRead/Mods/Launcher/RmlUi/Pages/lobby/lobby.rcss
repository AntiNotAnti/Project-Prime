/* Shared authored lobby rules, extracted from prime_home.rcss. */
#lobby_stage {
position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#lobby_heading {
position: absolute;
    left: 32dp;
    top: 24dp;
    width: 246dp;
}

.lobby_title {
color: #ffffff;
    font-size: 22dp;
    line-height: 24dp;
    font-weight: bold;
    letter-spacing: 0.7dp;
}

.lobby_status_line {
margin-top: 3dp;
    color: #69879d;
    font-family: "JetBrains Mono";
    font-size: 8dp;
    line-height: 11dp;
    letter-spacing: 0.5dp;
}

.lobby_side_panel {
position: absolute;
    width: 238dp;
    padding: 12dp;
    color: #b8cadd;
    background-color: rgba(3,13,23,62%);
    border: 1dp rgba(97,182,246,12%);
    border-left: 2dp rgba(114,199,255,36%);
}

#lobby_match_panel {
left: 32dp;
    top: 94dp;
}

#lobby_roster_panel {
right: 32dp;
    top: 38dp;
    width: 226dp;
    padding: 10dp;
}

.lobby_panel_title {
margin-bottom: 8dp;
    color: #ffffff;
    font-size: 19dp;
    line-height: 21dp;
    font-weight: bold;
}

.lobby_data_row {
display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 27dp;
    padding-top: 4dp;
    padding-bottom: 4dp;
    color: #668198;
    font-family: "JetBrains Mono";
    font-size: 8dp;
    line-height: 10dp;
    border-bottom: 1dp rgba(114,199,255,8%);
}

.lobby_data_row b {
max-width: 145dp;
    color: #c9dceb;
    text-align: right;
    font-weight: normal;
}

.lobby_small_button {
width: 100%;
    margin-top: 9dp;
    padding: 7dp 9dp;
    color: #8eb2cc;
    font-size: 9dp;
    font-weight: bold;
    letter-spacing: 0.8dp;
    background-color: rgba(7,24,40,72%);
    border: 1dp rgba(114,199,255,18%);
}

.lobby_small_button:hover,
.lobby_small_button:focus {
color: #ffffff;
    border-color: #61b6f6;
    background-color: rgba(28,114,225,25%);
}

.lobby_roster_header {
display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 7dp;
}

.lobby_roster_header .eyebrow {
margin-bottom: 0;
}

.lobby_roster_count {
color: #61b6f6;
    font-family: "JetBrains Mono";
    font-size: 8dp;
}

.lobby_roster_row {
min-height: 34dp;
    display: flex;
    align-items: center;
    margin-bottom: 3dp;
    padding: 4dp 6dp;
    color: #8298aa;
    background-color: rgba(8,25,41,48%);
    border-left: 2dp rgba(97,182,246,14%);
}

.lobby_roster_row.ready {
border-left-color: #55e18c;
    background-color: rgba(22,73,65,30%);
}

.lobby_roster_row.local {
color: #d9efff;
    border-left-color: #72c7ff;
    background-color: rgba(28,114,225,18%);
}

.lobby_roster_index {
width: 20dp;
    color: #54758e;
    font-family: "JetBrains Mono";
    font-size: 8dp;
}

.lobby_roster_copy {
display: block;
    flex: 1;
    min-width: 0;
}

.lobby_roster_copy b {
display: block;
    color: #d9e7f3;
    font-size: 12dp;
    line-height: 12dp;
    font-weight: bold;
}

.lobby_roster_hunter {
display: block;
    margin-top: 1dp;
    color: #7796ad;
    font-size: 8dp;
    line-height: 8dp;
}

.lobby_roster_state {
margin-left: 5dp;
    color: #668198;
    font-family: "JetBrains Mono";
    font-size: 7dp;
}

.lobby_roster_row.ready .lobby_roster_state {
color: #55e18c;
}

.lobby_nameplate {
position: absolute;
    width: 116dp;
    padding: 4dp 6dp;
    text-align: center;
    color: #a9bfd1;
    background-color: rgba(2,11,19,62%);
    border-top: 1dp rgba(114,199,255,20%);
}

.lobby_nameplate b {
display: block;
    color: #dcebf7;
    font-size: 10dp;
    line-height: 11dp;
    font-weight: bold;
}

.lobby_nameplate span {
display: block;
    margin-top: 1dp;
    color: #607d94;
    font-family: "JetBrains Mono";
    font-size: 6dp;
    line-height: 8dp;
}

.lobby_nameplate.local {
width: 158dp;
    border-top-color: #72c7ff;
}

.lobby_nameplate.local b {
color: #ffffff;
    font-size: 14dp;
    line-height: 15dp;
}

#lobby_actions {
position: absolute;
    
    left: 50%;
    width: 620dp;
    margin-left: -310dp;
    bottom: 10dp;
    height: 42dp;
    display: flex;
    align-items: stretch;
    justify-content: center;
}

.lobby_action {
min-width: 92dp;
    margin-left: 3dp;
    margin-right: 3dp;
    padding-left: 10dp;
    padding-right: 10dp;
    color: #8da8bc;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 0.5dp;
    background-color: rgba(5,18,31,86%);
    border: 1dp rgba(97,182,246,20%);
}

.lobby_action:hover,
.lobby_action:focus {
color: #ffffff;
    border-color: #61b6f6;
    background-color: rgba(28,114,225,28%);
}

.lobby_action.primary {
color: #dff6ff;
    border-bottom: 3dp #2b9ef7;
}

.lobby_action.start {
color: #ffffff;
    background-color: rgba(28,114,225,50%);
    border-color: #72c7ff;
}

.lobby_action.danger:hover,
.lobby_action.danger:focus {
border-color: #ef6870;
    background-color: rgba(178,47,58,28%);
}

#lobby_ready {
nav-up: #nav_play; nav-right: #lobby_hunter;
}

#lobby_hunter {
nav-left: #lobby_ready; nav-right: #lobby_suit;
}

#lobby_suit {
nav-left: #lobby_hunter; nav-right: #lobby_leave;
}

#lobby_rules {
nav-left: #lobby_suit; nav-right: #lobby_leave;
}

#lobby_leave {
nav-left: #lobby_suit; nav-right: #lobby_start;
}

#lobby_start {
nav-left: #lobby_leave;
}



@media (max-width: 1500dp) {
#lobby_heading,
#lobby_match_panel {
left: 24dp;
}
#lobby_match_panel {
width: 216dp;
}
#lobby_roster_panel {
right: 24dp; width: 204dp;
}
#lobby_actions {
left: 50%; width: 590dp; margin-left: -295dp;
}
.lobby_action {
min-width: 82dp; font-size: 9dp;
}
}

@media (max-width: 1180dp) {
#lobby_heading {
width: 190dp;
}
#lobby_match_panel {
width: 190dp;
}
#lobby_roster_panel {
width: 184dp;
}
#lobby_actions {
left: 50%; width: 540dp; margin-left: -270dp;
}
.lobby_action {
min-width: 72dp; padding-left: 6dp; padding-right: 6dp; font-size: 8dp;
}
.lobby_nameplate {
display: none;
}
}

@media (max-width: 900dp) {
#lobby_heading {
display: none;
}
#lobby_match_panel {
left: 14dp; top: 18dp; width: 170dp;
}
#lobby_roster_panel {
right: 14dp; top: 18dp; width: 170dp;
}
#lobby_actions {
left: 50%; width: 94%; margin-left: -47%; height: 38dp;
}
.lobby_action {
min-width: 62dp; font-size: 7dp;
}
}

#lobby_map_preview { left: 32dp; top: 306dp; width: 238dp; padding: 10dp; }
#lobby_map_image { display: block; width: 100%; height: 114dp; }
#lobby_map_preview_status { color: #839db1; font-size: 10dp; margin-top: 5dp; }
#lobby_chat_panel { right: 32dp; bottom: 64dp; width: 270dp; height: 172dp; padding: 10dp; background-color: rgba(3,13,23,94%); }
#lobby_chat_history { height: 92dp; overflow-y: auto; white-space: pre-wrap; font-size: 12dp; color: #c1d6e7; }
#lobby_chat_status { font-size: 10dp; color: #ffbf80; min-height: 13dp; }
.lobby_chat_compose { display: flex; width: 100%; height: 28dp; }
#lobby_chat_input { width: 77%; height: 28dp; padding: 4dp; font-size: 12dp; background-color: #10283a; color: #e5f4ff; border: 1dp #285274; }
#lobby_chat_send { width: 23%; height: 28dp; font-size: 11dp; background-color: #153e5b; color: #e5f4ff; border: 1dp #548aaa; }
.lobby_action { display: block; text-align: center; line-height: 38dp; }
@media (max-width: 1500dp) { #lobby_map_preview { left: 24dp; width: 216dp; } #lobby_chat_panel { right: 24dp; width: 230dp; } }
@media (max-width: 1180dp) { #lobby_map_preview { width: 190dp; } #lobby_chat_panel { width: 204dp; } }
@media (max-width: 900dp) { #lobby_map_preview { left: 14dp; top: 230dp; width: 170dp; } #lobby_map_image { height: 80dp; } #lobby_chat_panel { right: 14dp; width: 180dp; height: 135dp; } #lobby_chat_history { height: 56dp; } }

#lobby_roster_panel { max-height: 46%; overflow-y: auto; }
#lobby_map_preview { min-height: 145dp; }
@media (max-height: 700dp) { #lobby_roster_panel { max-height: 40%; } }

@media (max-height: 650dp) { #lobby_map_image { height: 90dp; } }

#lobby_roster_panel { right: 24dp; top: 24dp; width: 286dp; bottom: 250dp; max-height: none; overflow-y: auto; background-color: rgba(3,13,23,94%); }
.lobby_roster_row { min-height: 38dp; margin-bottom: 2dp; border-left: 3dp #35506a; padding: 3dp; }
.lobby_roster_copy { flex: 1; min-width: 0dp; width: auto; padding: 4dp; text-align: left; background-color: transparent; }
.lobby_roster_copy:hover, .lobby_roster_copy:focus { background-color: #17364c; }
.lobby_roster_copy b { overflow: hidden; max-height: 16dp; }
.lobby_roster_meta { display: block; text-align: right; }
.lobby_roster_state { display: block; }
.lobby_team { display: block; font-size: 9dp; padding: 3dp 5dp; margin-top: 2dp; border: 1dp #42627b; background-color: #102638; }
.lobby_team:hover, .lobby_team:focus { background-color: #235475; }
.lobby_nameplate { min-height: 30dp; }
.lobby_nameplate.empty { background-color: rgba(5,24,38,85%); border-top-color: #416780; }
.lobby_nameplate.empty span, .lobby_roster_row.empty .lobby_roster_hunter { color: #90cbed; }
.lobby_nameplate:hover, .lobby_nameplate:focus { background-color: #16425e; border-top-color: #a7e4ff; }
.lobby_roster_row.team0, .lobby_nameplate.team0 { border-color: #ff9c00; } .lobby_roster_row.team1, .lobby_nameplate.team1 { border-color: #49df67; } .lobby_roster_row.team2, .lobby_nameplate.team2 { border-color: #299cff; } .lobby_roster_row.team3, .lobby_nameplate.team3 { border-color: #de59ff; }
.team0 .lobby_team { color: #ffb647; } .team1 .lobby_team { color: #74ec8c; } .team2 .lobby_team { color: #71c0ff; } .team3 .lobby_team { color: #e69aff; }
#lobby_chat_panel { width: 286dp; right: 24dp; bottom: 64dp; height: 172dp; }
@media (max-width: 1100dp) { #lobby_roster_panel, #lobby_chat_panel { right: 12dp; width: 216dp; } .lobby_roster_index { width: 12dp; } }
@media (max-height: 720dp) { #lobby_roster_panel { top: 12dp; bottom: 178dp; } .lobby_roster_row { min-height: 34dp; } #lobby_chat_panel { height: 104dp; } #lobby_chat_history { height: 34dp; } }

#lobby_map_preview { top: 354dp; }
@media (max-height: 720dp) { #lobby_map_preview { top: 316dp; } #lobby_map_image { height: 76dp; } }

.lobby_team:disabled, .lobby_team.unavailable { opacity: 1; background-color: transparent; border-color: transparent; }

#lobby_map_preview { top: 390dp; cursor: pointer; }
#lobby_map_preview:hover, #lobby_map_preview:focus { border-color: #91daff; background-color: #143248; }
#lobby_countdown { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; z-index: 100; background-color: rgba(3,12,22,92%); display: flex; flex-direction: column; align-items: center; justify-content: center; }
#lobby_countdown_number { font-size: 90dp; color: #b7eaff; }
#lobby_countdown_detail { font-size: 22dp; color: #d8efff; letter-spacing: 3dp; }
@media (max-height: 720dp) { #lobby_map_preview { top: 354dp; min-height: 0dp; } #lobby_map_image { height: 64dp; } .lobby_data_row { padding-top: 5dp; padding-bottom: 5dp; } }

@media (max-height: 650dp) { #lobby_heading { display: none; } #lobby_match_panel { top: 12dp; } #lobby_map_preview { top: 278dp; } }

#lobby_map_preview { text-align: left; color: #b8d7ed; background-color: rgba(3,13,23,94%); }

/* Keep the preview below the rules as text and display density change. */
#lobby_left_panels { position: absolute; left: 32dp; top: 94dp; width: 238dp; }
#lobby_left_panels #lobby_match_panel, #lobby_left_panels #lobby_map_preview { position: relative; left: 0dp; top: 0dp; width: 100%; display: block; }
#lobby_left_panels #lobby_map_preview { margin-top: 12dp; min-height: 0dp; }
.lobby_small_button { display: block; text-align: center; }
@media (max-width: 1500dp) { #lobby_left_panels { left: 24dp; width: 216dp; } }
@media (max-width: 1180dp) { #lobby_left_panels { width: 190dp; } }
@media (max-height: 720dp) { .lobby_data_row { min-height: 23dp; padding-top: 3dp; padding-bottom: 3dp; } .lobby_small_button { margin-top: 5dp; padding: 5dp; } }
@media (max-height: 650dp) { #lobby_left_panels { top: 12dp; } }
@media (max-width: 900dp) { #lobby_left_panels { left: 14dp; top: 18dp; width: 170dp; } }
