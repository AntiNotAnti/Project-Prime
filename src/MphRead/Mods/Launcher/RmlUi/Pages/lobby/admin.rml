<rml><head><link type="text/rcss" href="../../components/controls.rcss"/><title>Lobby administration</title><link type="text/rcss" href="../../themes/prime.rcss" /><link type="text/rcss" href="admin.rcss" /></head>
<body id="admin_page"><div class="admin-panel"><div class="admin-header"><div><div class="eyebrow">MULTIPLAYER // SESSION CONTROLS</div><h1 id="admin_title">LOBBY</h1></div><button id="admin_close" data-action="lobby:admin-close">BACK</button></div>
<div id="admin_status" class="admin-status">WAITING FOR SERVER STATE</div><div class="admin-grid"><div class="admin-roster"><div class="section-title">CONNECTED HUNTERS // SELECT A PLAYER</div><button id="admin_slot0" class="admin-roster-row" data-action="lobby:player:0"><span id="admin_player0_name" class="admin-player-name">OPEN SLOT</span><span id="admin_player0_details" class="admin-player-details">WAITING</span></button>
<button id="admin_slot1" class="admin-roster-row" data-action="lobby:player:1"><span id="admin_player1_name" class="admin-player-name">OPEN SLOT</span><span id="admin_player1_details" class="admin-player-details">WAITING</span></button>
<button id="admin_slot2" class="admin-roster-row" data-action="lobby:player:2"><span id="admin_player2_name" class="admin-player-name">OPEN SLOT</span><span id="admin_player2_details" class="admin-player-details">WAITING</span></button>
<button id="admin_slot3" class="admin-roster-row" data-action="lobby:player:3"><span id="admin_player3_name" class="admin-player-name">OPEN SLOT</span><span id="admin_player3_details" class="admin-player-details">WAITING</span></button>
<button id="admin_slot4" class="admin-roster-row" data-action="lobby:player:4"><span id="admin_player4_name" class="admin-player-name">OPEN SLOT</span><span id="admin_player4_details" class="admin-player-details">WAITING</span></button>
<button id="admin_slot5" class="admin-roster-row" data-action="lobby:player:5"><span id="admin_player5_name" class="admin-player-name">OPEN SLOT</span><span id="admin_player5_details" class="admin-player-details">WAITING</span></button>
<button id="admin_slot6" class="admin-roster-row" data-action="lobby:player:6"><span id="admin_player6_name" class="admin-player-name">OPEN SLOT</span><span id="admin_player6_details" class="admin-player-details">WAITING</span></button>
<button id="admin_slot7" class="admin-roster-row" data-action="lobby:player:7"><span id="admin_player7_name" class="admin-player-name">OPEN SLOT</span><span id="admin_player7_details" class="admin-player-details">WAITING</span></button>
<div class="section-title">LOBBY CHAT</div><div id="admin_chat_history" class="admin-chat-history">NO MESSAGES</div><div class="admin-chat-compose"><input id="admin_chat_input" type="text" maxlength="96" value="" /><button id="admin_chat_send" data-action="lobby:chat-send">SEND</button></div><div id="admin_chat_hint" class="hint">CHAT USES THE EXISTING SERVER LIMIT</div></div>
<div class="admin-controls"><div class="section-title">SELECTED PLAYER</div><div id="admin_selected_name" class="admin-selected">SELECT A CONNECTED PLAYER</div><div id="admin_selected_details" class="hint"></div>
<div class="admin-actions"><button id="admin_team" data-action="lobby:team-next">NEXT TEAM</button><button id="admin_handicap" data-action="lobby:handicap-next">DAMAGE REDUCTION</button><button id="admin_kick" data-action="lobby:kick">KICK PLAYER</button><button id="admin_transfer" data-action="lobby:transfer-owner">TRANSFER OWNERSHIP</button></div>
<div class="section-title">BOT DRAFT // APPLIED ON SUBMIT</div><button id="admin_bot_hunter" data-action="lobby:bot-hunter-next">HUNTER</button><button id="admin_bot_suit" data-action="lobby:bot-suit-next">SUIT</button><button id="admin_bot_level" data-action="lobby:bot-level-next">DIFFICULTY</button><div class="admin-actions"><button id="admin_bot_add" data-action="lobby:bot-add">ADD BOT</button><button id="admin_bot_apply" data-action="lobby:bot-configure">UPDATE SELECTED BOT</button><button id="admin_bot_remove" data-action="lobby:bot-remove">REMOVE SELECTED BOT</button></div>
<div class="section-title">TEAMS // SERVER CAPACITY</div><div id="admin_teams" class="hint">FREE FOR ALL</div><div class="admin-actions"><button id="admin_team0" data-action="lobby:team:0">TEAM A</button><button id="admin_team1" data-action="lobby:team:1">TEAM B</button><button id="admin_team2" data-action="lobby:team:2">TEAM C</button><button id="admin_team3" data-action="lobby:team:3">TEAM D</button><button id="admin_team_auto" data-action="lobby:teams-auto">AUTO ASSIGN SELECTED</button><button id="admin_team_lock" data-action="lobby:team-lock-toggle">LOCK TEAMS</button></div>
<div class="section-title">ARENA PREPARATION</div><div id="admin_map_status" class="hint"></div><button id="admin_map_retry" data-action="lobby:map-retry">RETRY ARENA PREPARATION</button><div id="admin_rotation_state" class="hint"></div>
<div class="admin-actions"><button id="admin_start" class="primary" data-action="lobby:start">START MATCH</button><button id="admin_close_lobby" class="danger" data-action="lobby:close">CLOSE LOBBY</button></div><div id="admin_permission_reason" class="hint"></div></div></div>
<div id="admin_confirmation" class="admin-confirmation"><div id="admin_confirmation_text">CONFIRM ACTION</div><div class="admin-actions"><button id="admin_confirm" class="danger" data-action="lobby:admin-confirm">CONFIRM</button><button id="admin_cancel" data-action="lobby:admin-cancel">CANCEL</button></div></div></div></body></rml>