<rml><head><link type="text/rcss" href="../../themes/prime.rcss"/><link type="text/rcss" href="../../components/controls.rcss"/><link type="text/rcss" href="strip.rcss"/></head><body><div id="hunter_strip"><h1>CHOOSE HUNTER</h1><button id="hunter_close" data-action="hunter:cancel">CLOSE</button><div id="hunter_status"/><div id="hunter_rail"><button id="hunter_choice0" data-action="hunter:select:0"><div id="hunter_model0" class="hunter_model"/><b>SAMUS</b></button><button id="hunter_choice1" data-action="hunter:select:1"><div id="hunter_model1" class="hunter_model"/><b>KANDEN</b></button><button id="hunter_choice2" data-action="hunter:select:2"><div id="hunter_model2" class="hunter_model"/><b>TRACE</b></button><button id="hunter_choice3" data-action="hunter:select:3"><div id="hunter_model3" class="hunter_model"/><b>SYLUX</b></button><button id="hunter_choice4" data-action="hunter:select:4"><div id="hunter_model4" class="hunter_model"/><b>NOXUS</b></button><button id="hunter_choice5" data-action="hunter:select:5"><div id="hunter_model5" class="hunter_model"/><b>SPIRE</b></button><button id="hunter_choice6" data-action="hunter:select:6"><div id="hunter_model6" class="hunter_model"/><b>WEAVEL</b></button></div><div id="hunter_restriction"/></div></body></rml>