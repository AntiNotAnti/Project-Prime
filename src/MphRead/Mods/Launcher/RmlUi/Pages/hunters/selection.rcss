body { font-family: Rajdhani; font-size: 17dp; color: #d8edff; background-color: rgba(2,9,18,70%); }
.hunter-panel { display: block; width: 92%; max-width: 1180dp; max-height: 94%; margin: 2% auto; padding: 18dp; overflow: auto; background-color: rgba(7,23,39,89%); border: 1dp #285274; }
.hunter-panel > .eyebrow, .hunter-status { width: 86vw; max-width: 1100dp; display: block; }
h1 { display: block; width: 86vw; max-width: 1100dp; font-size: 32dp; margin: 4dp 0 8dp; } .eyebrow, .section-title { color: #78caff; font-size: 13dp; letter-spacing: 1dp; } .section-title { margin: 14dp 0 7dp; }
.hunter-status { padding: 9dp; color: #ffe0a0; background-color: #0b2942; } .hunter-grid { width: 86vw; max-width: 1100dp; display: block; } .hunter-picker { width: 47%; display: block; float: left; } .hunter-preview { width: 50%; display: block; float: right; }
.hunter-choices, .hunter-suits, .hunter-actions { display: flex; flex-wrap: wrap; } button { tab-index: auto; min-height: 42dp; padding: 8dp 12dp; margin: 0 5dp 6dp 0; font-size: 15dp; color: #d8edff; background-color: #123554; border: 1dp #356689; }
button:hover, button:focus { border-color: #8ed6ff; background-color: #225b81; } button.selected { border-color: #b9e7ff; border-bottom: 3dp #3eafff; background-color: #225b81; } button.unavailable { color: #627d91; background-color: #0c2236; border-color: #253e52; }
.hunter-picker > button { display: block; width: 100%; text-align: left; } .hint { display: block; color: #a6bdd0; font-size: 13dp; line-height: 18dp; white-space: pre-wrap; } .hunter-preview-space { display: block; width: 100%; height: 285dp; background-color: transparent; }
.hunter-preview { background-color: transparent; } .hunter-footer { clear: both; width: 86vw; max-width: 1100dp; margin-top: 14dp; } .hunter-footer button { min-width: 220dp; flex-shrink: 0; } button.primary { border-color: #72d0ff; }
@media (max-width: 960dp) { .hunter-grid { display: block; } .hunter-picker, .hunter-preview { width: 100%; float: none; } .hunter-preview-space { height: 190dp; } }

.hunter-panel { position: absolute; left: 3%; top: 3%; width: 94%; max-width: none; height: 94%; max-height: none; margin: 0dp; padding: 16dp; overflow: hidden; }
.hunter-panel > .eyebrow, .hunter-panel h1, .hunter-status { width: 90%; max-width: none; }
.hunter-panel h1 { font-size: 27dp; margin: 4dp 0dp; }
.hunter-status { padding: 5dp 8dp; font-size: 14dp; }
.hunter-close { position: absolute; right: 16dp; top: 12dp; min-width: 86dp; }
.hunter-grid { position: absolute; left: 16dp; right: 16dp; top: 104dp; bottom: 66dp; width: auto; max-width: none; height: auto; display: flex; }
.hunter-picker { width: 49%; float: none; }
.hunter-preview { width: 48%; margin-left: 3%; height: 100%; float: none; display: flex; flex-direction: column; }
.hunter-preview-space { width: 100%; height: auto; min-height: 80dp; flex: 1; }
.hunter-grid button { min-height: 32dp; padding: 5dp 8dp; margin: 0dp 4dp 4dp 0dp; font-size: 13dp; }
.section-title { margin: 8dp 0dp 5dp; font-size: 12dp; }
.hint { font-size: 11dp; line-height: 13dp; }
.hunter-preview .hunter-actions { flex-shrink: 0; }
.hunter-preview .hunter-actions button { width: 23%; font-size: 11dp; }
.hunter-footer { position: absolute; left: 16dp; right: 16dp; bottom: 10dp; width: auto; max-width: none; height: 40dp; margin: 0dp; border-top: 1dp #285274; padding-top: 6dp; }
.hunter-footer button { min-width: 150dp; min-height: 34dp; padding: 5dp 12dp; font-size: 14dp; }
@media (max-height: 680dp) { .hunter-panel { padding: 10dp; } .hunter-grid { top: 86dp; bottom: 54dp; } .hunter-panel h1 { font-size: 22dp; } .hunter-status { font-size: 12dp; } .hunter-grid button { min-height: 27dp; padding: 3dp 6dp; font-size: 12dp; } .section-title { margin: 5dp 0dp; } .hint { font-size: 10dp; line-height: 11dp; } .hunter-preview .hunter-actions button { font-size: 10dp; } }
