<rml>
  <head>
    <title>Project Prime // Hunter Identity</title>
    <link type="text/rcss" href="../../themes/prime.rcss" />
    <link type="text/rcss" href="../../components/controls.rcss" />
    <link type="text/rcss" href="selection.rcss" />
    <link type="text/rcss" href="identity.rcss" />
  </head>
  <body id="hunter_page">
    <div id="identity_modal">
      <div id="identity_header">
        <div class="eyebrow">MULTIPLAYER // HUNTER IDENTITY</div>
        <h1 id="hunter_name">CHOOSE YOUR HUNTER</h1>
        <button id="hunter_close" data-action="hunter:cancel">CLOSE</button>
      </div>
      <div id="hunter_status">Select your Hunter, then apply.</div>
      <div class="section-title">AVAILABLE HUNTERS</div>
      <div class="hunter-choices">
        <button id="hunter_choice0" data-action="hunter:select:0">SAMUS</button>
        <button id="hunter_choice1" data-action="hunter:select:1">KANDEN</button>
        <button id="hunter_choice2" data-action="hunter:select:2">TRACE</button>
        <button id="hunter_choice3" data-action="hunter:select:3">SYLUX</button>
        <button id="hunter_choice4" data-action="hunter:select:4">NOXUS</button>
        <button id="hunter_choice5" data-action="hunter:select:5">SPIRE</button>
        <button id="hunter_choice6" data-action="hunter:select:6">WEAVEL</button>
      </div>
      <div id="hunter_restriction">Only the Hunter pool allowed by the server can be equipped.</div>
      <div class="section-title">SUIT COLOR</div>
      <div class="hunter-suits">
        <button id="hunter_suit0" data-action="hunter:suit:0">SUIT 1</button>
        <button id="hunter_suit1" data-action="hunter:suit:1">SUIT 2</button>
        <button id="hunter_suit2" data-action="hunter:suit:2">SUIT 3</button>
        <button id="hunter_suit3" data-action="hunter:suit:3">SUIT 4</button>
      </div>
      <div id="identity_hint">Cosmetics, previews, and team administration remain available in the existing Hunter and lobby screens.</div>
      <div id="identity_footer">
        <button id="hunter_cancel" data-action="hunter:cancel">CANCEL</button>
        <button id="hunter_apply" data-action="hunter:apply">SEND HUNTER / SUIT</button>
      </div>
    </div>
  </body>
</rml>