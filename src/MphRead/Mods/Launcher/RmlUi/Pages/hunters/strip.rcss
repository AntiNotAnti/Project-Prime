body { font-family: Rajdhani; color: #d8edff; background-color: rgba(2,9,18,72%); }
#hunter_strip { position: absolute; left: 3%; top: 25%; width: 94%; height: 50%; padding: 14dp; background-color: #071a29; border: 1dp #387391; }
h1 { margin: 0dp; font-size: 24dp; } #hunter_close { position: absolute; right: 12dp; top: 12dp; padding: 8dp 16dp; }
button { tab-index: auto; color: #d8edff; background-color: #102c40; border: 1dp #387391; }
button:hover, button:focus, button.selected { background-color: #1c425b; border-color: #9cdeff; } button:disabled { opacity: 0.4; }
#hunter_status { height: 30dp; font-size: 13dp; color: #a9d8f3; } #hunter_rail { display: flex; height: 73%; width: 100%; }
#hunter_rail button { width: 13.5%; height: 100%; margin-right: 0.7%; padding: 0dp; }
.hunter_model { width: 100%; height: 86%; } #hunter_rail b { display: block; text-align: center; font-size: 14dp; }
#hunter_restriction { font-size: 11dp; margin-top: 6dp; color: #9abbcf; }
