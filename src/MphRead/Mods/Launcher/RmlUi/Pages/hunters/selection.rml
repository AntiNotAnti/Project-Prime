<rml><head><link type="text/rcss" href="../../components/controls.rcss"/><title>Hunter selection</title><link type="text/rcss" href="../../themes/prime.rcss" /><link type="text/rcss" href="selection.rcss" /></head><body id="hunter_page">
<div class="hunter-panel"><button id="hunter_close" class="hunter-close" data-action="hunter:cancel">CLOSE</button><div class="eyebrow">HUNTER SELECTION // LOCAL DRAFT</div><h1 id="hunter_name">SELECT YOUR HUNTER</h1><div id="hunter_status" class="hunter-status">SELECTION IS APPLIED ONLY WHEN YOU CONFIRM</div><div class="hunter-grid"><div class="hunter-picker"><div class="section-title">PLAYABLE HUNTERS</div><div class="hunter-choices"><button id="hunter_choice0" data-action="hunter:select:0">SAMUS</button><button id="hunter_choice1" data-action="hunter:select:1">KANDEN</button><button id="hunter_choice2" data-action="hunter:select:2">TRACE</button><button id="hunter_choice3" data-action="hunter:select:3">SYLUX</button><button id="hunter_choice4" data-action="hunter:select:4">NOXUS</button><button id="hunter_choice5" data-action="hunter:select:5">SPIRE</button><button id="hunter_choice6" data-action="hunter:select:6">WEAVEL</button></div><div class="section-title">SUIT COLOR</div><div class="hunter-suits"><button id="hunter_suit0" data-action="hunter:suit:0">SUIT 1</button><button id="hunter_suit1" data-action="hunter:suit:1">SUIT 2</button><button id="hunter_suit2" data-action="hunter:suit:2">SUIT 3</button><button id="hunter_suit3" data-action="hunter:suit:3">SUIT 4</button></div><button id="hunter_spectator" data-action="hunter:spectator">SPECTATOR ROLE</button><div id="hunter_team_state" class="hint"></div><button id="hunter_team0" data-action="lobby:team:0">TEAM A</button><button id="hunter_team1" data-action="lobby:team:1">TEAM B</button><button id="hunter_team2" data-action="lobby:team:2">TEAM C</button><button id="hunter_team3" data-action="lobby:team:3">TEAM D</button><button id="hunter_team_next" data-action="lobby:team-next">NEXT TEAM</button><div id="hunter_restriction" class="hint"></div>
<div class="section-title">EQUIPPED LOADOUT // COSMETICS</div><button id="hunter_skin" data-action="hunter:skin-next">SKIN</button><button id="hunter_armor" data-action="hunter:armor-next">ARMOR EFFECT</button><button id="hunter_death" data-action="hunter:death-next">DEATH PRESENTATION</button><div class="hunter-actions"><button id="hunter_cosmetics_save" data-action="hunter:cosmetics-save">EQUIP COSMETICS</button><button id="hunter_cosmetics_reset" data-action="hunter:cosmetics-reset">RESET DRAFT</button></div><div id="hunter_cosmetics_state" class="hint"></div><div id="hunter_custom_assets" class="hint"></div></div>
<div class="hunter-preview"><div class="section-title">HUNTER PREVIEW</div><div id="hunter_preview_status" class="hint">PREPARING HUNTER PREVIEW.</div><div id="hunter_preview_space" class="hunter-preview-space"></div><div class="hunter-actions"><button id="hunter_preview_biped" data-action="hunter:preview-mode:0">HUNTER</button><button id="hunter_preview_weapon" data-action="hunter:preview-mode:1">WEAPON</button><button id="hunter_preview_alt" data-action="hunter:preview-mode:2">ALT FORM</button><button id="hunter_preview_turret" data-action="hunter:preview-mode:3">HALFTURRET</button><button id="hunter_rotate_left" data-action="hunter:rotate:0">ROTATE LEFT</button><button id="hunter_rotate_right" data-action="hunter:rotate:1">ROTATE RIGHT</button><button id="hunter_zoom_out" data-action="hunter:zoom:0">ZOOM OUT</button><button id="hunter_zoom_in" data-action="hunter:zoom:1">ZOOM IN</button><button id="hunter_loop_death" data-action="hunter:loop-death">LOOP DEATH</button><button id="hunter_compare_native" data-action="hunter:compare-native">COMPARE NATIVE</button><button id="hunter_reset_preview" data-action="hunter:reset-preview">RESET PREVIEW</button><button id="hunter_preview_death" data-action="hunter:preview-death">DEATH</button></div><div id="hunter_acknowledged" class="hint">LOCAL PROFILE</div></div></div>
<div class="hunter-actions hunter-footer"><button id="hunter_apply" class="primary" data-action="hunter:apply">APPLY HUNTER / SUIT</button><button id="hunter_cancel" data-action="hunter:cancel">CANCEL</button></div></div></body></rml>