<rml>
<head>
  <title>Project Prime Community Discover</title>
  <link type="text/template" href="../../components/app-shell.rml"/>
  <link type="text/rcss" href="../../themes/prime.rcss"/>
  <link type="text/rcss" href="../../components/controls.rcss"/>
  <link type="text/rcss" href="native-discover.rcss"/>
</head>
<body template="prime-shell">
<div id="native_community" class="native_community">
  <div class="eyebrow">COMMUNITY // MAP DISCOVERY</div>
  <h1>COMMUNITY MAPS</h1>
  <div class="native_community_tools">
    <button id="native_community_public" data-action="community:tab:0">DISCOVER</button>
    <button id="native_community_installed" data-action="community:tab:4">INSTALLED</button>
    <button id="native_community_favorites" data-action="community:tab:3">FAVORITES</button>
    <button id="native_community_owned" data-action="community:tab:1">MY UPLOADS</button>
    <button id="native_community_transfers" data-action="community:tab:2">DOWNLOADS &amp; HISTORY</button>
    <button id="native_community_import" data-action="community:import">IMPORT PACKAGE</button>
  </div>
  <p>Discover arenas, browse your installed packages and Favorites, or manage uploads and download history.</p>
  <div class="native_community_tools">
    <input id="native_community_search" placeholder="Search maps or creators" maxlength="128" type="text"/>
    <button id="native_community_find" data-action="community:search">SEARCH</button>
    <button id="native_community_refresh" data-action="community:refresh">REFRESH</button>
    <button id="native_community_name_sort" data-action="community:sort:0">NAME</button>
    <button id="native_community_new_sort" data-action="community:sort:1">UPDATED</button>
    <button id="native_community_popular_sort" data-action="community:sort:2">POPULAR</button>
  </div>
  <p id="native_community_status" class="native_community_status" role="status" aria-live="polite"></p>
  <p id="native_community_notice" role="status" aria-live="polite"/>
  <div class="native_community_paging">
    <button id="native_community_previous" data-action="community:page:previous">PREVIOUS</button>
    <button id="native_community_next" data-action="community:page:next">NEXT</button>
  </div>
  <div class="native_community_columns collection_columns">
    <div class="native_community_list collection_list">
      <button id="native_community_row0" data-action="community:select:0"><b id="native_community_name0"/><span id="native_community_meta0"/></button>
      <button id="native_community_row1" data-action="community:select:1"><b id="native_community_name1"/><span id="native_community_meta1"/></button>
      <button id="native_community_row2" data-action="community:select:2"><b id="native_community_name2"/><span id="native_community_meta2"/></button>
      <button id="native_community_row3" data-action="community:select:3"><b id="native_community_name3"/><span id="native_community_meta3"/></button>
      <button id="native_community_row4" data-action="community:select:4"><b id="native_community_name4"/><span id="native_community_meta4"/></button>
      <button id="native_community_row5" data-action="community:select:5"><b id="native_community_name5"/><span id="native_community_meta5"/></button>
      <button id="native_community_row6" data-action="community:select:6"><b id="native_community_name6"/><span id="native_community_meta6"/></button>
      <button id="native_community_row7" data-action="community:select:7"><b id="native_community_name7"/><span id="native_community_meta7"/></button>
    </div>
    <div class="native_community_detail">
      <h2 id="native_community_title">SELECT A MAP</h2>
      <div class="native_community_primary action_bar">
        <button id="native_community_install" data-action="community:detail:0">INSTALL VERIFIED MAP</button>
        <button id="native_community_install_host" data-action="community:detail:1">INSTALL &amp; HOST</button>
        <button id="native_community_cancel_install" data-action="community:cancel-work">CANCEL HANDOFF</button>
      </div>
      <img id="native_community_preview"/>
      <p id="native_community_preview_status" class="hint" role="status"/>
      <p id="native_community_description" role="group">Published revisions are immutable. Select a map to install its exact package.</p>
      <p id="native_community_hash" role="group"></p>
      <p id="native_community_notes" role="group"/>
      <button id="native_community_favorite" data-action="community:detail:2">ADD TO FAVORITES</button>
      <button id="native_community_copy_link" data-action="community:detail:6">COPY EXACT PACKAGE LINK</button>
      <button id="native_community_report" data-action="community:report">REPORT MAP</button>
      <button id="native_community_history" data-action="community:detail:3">VIEW IMMUTABLE REVISION HISTORY</button>
      <button id="native_community_archive" data-action="community:creator:0">ARCHIVE OWNED MAP</button>
      <button id="native_community_restore" data-action="community:creator:1">RESTORE OWNED MAP</button>
      <button id="native_community_creator_confirm" data-action="community:confirm">CONFIRM CHANGE</button>
      <button id="native_community_creator_cancel" data-action="community:cancel">CANCEL CHANGE</button>
      <button id="native_community_full" data-action="studio:open">OPEN MAP STUDIO</button>
      <button id="native_community_back" data-action="route:home">BACK TO HOME</button>
    </div>
  </div>
</div>
</body>
</rml>
