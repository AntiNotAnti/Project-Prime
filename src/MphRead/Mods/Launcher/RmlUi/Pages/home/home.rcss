/* Shared authored home rules, extracted from prime_home.rcss. */
#deploy {
display: block;
}

#activity_panel {
position: absolute;
    left: 52dp;
    bottom: 44dp;
    width: 500dp;
}

#activity_compact {
display: block; width: 400dp;
}

#activity_compact.hidden {
display: none;
}

#activity_selector {
width: 100%;
    min-height: 112dp;
    display: flex;
    align-items: stretch;
    padding: 0;
    text-align: left;
    color: #dceaf5;
    background-color: rgba(4,15,27,82%);
    border-left: 4dp #72c7ff;
    border-top: 1dp rgba(114,199,255,18%);
    border-right: 1dp rgba(114,199,255,12%);
    border-bottom: 1dp rgba(114,199,255,12%);
    transition: background-color border-left-color transform 0.14s quadratic-out;
}

#activity_selector:hover,
#activity_selector:focus {
color: #ffffff;
    background-color: rgba(8,31,52,91%);
    border-left-color: #a3dcff;
    transform: translateX(3dp);
}

.selector_art {
width: 92dp;
    min-height: 110dp;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 12dp;
    background-color: rgba(28,114,225,70%);
    border-right: 1dp rgba(154,220,255,20%);
}

.selector_art_label {
color: rgba(224,246,255,84%);
    font-size: 9dp;
    font-weight: bold;
    letter-spacing: 1.5dp;
}

.selector_copy {
display: block;
    flex: 1;
    padding: 17dp 12dp 13dp 16dp;
}

.selector_title {
display: block;
    color: #ffffff;
    font-size: 27dp;
    line-height: 29dp;
    font-weight: bold;
    letter-spacing: 0.8dp;
}

.selector_meta {
display: block;
    margin-top: 4dp;
    color: #93a8b9;
    font-size: 11dp;
    line-height: 14dp;
}

.selector_hint {
display: block;
    margin-top: 9dp;
    color: #5f88a7;
    font-family: "JetBrains Mono";
    font-size: 9dp;
    line-height: 11dp;
    letter-spacing: 0.8dp;
}

.selector_change {
width: 58dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-left: 1dp rgba(114,199,255,10%);
}

.selector_change_label {
color: #5f7d94;
    font-size: 7dp;
    letter-spacing: 0.8dp;
    transform: rotate(-90deg);
    margin-bottom: 12dp;
}

.selector_change_arrow {
color: #72c7ff;
    font-size: 14dp;
    font-weight: bold;
}

#activity_status {
width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 8dp 13dp;
    color: #7a8fa2;
    font-size: 10dp;
    letter-spacing: 1dp;
    background-color: rgba(3,10,18,86%);
    border-left: 1dp rgba(97,182,246,16%);
    border-right: 1dp rgba(97,182,246,16%);
    border-top: 1dp rgba(97,182,246,10%);
}

.ready {
color: #55e18c;
}

#deploy {
position: relative;
    width: 100%;
    min-height: 84dp;
    padding: 12dp 62dp 10dp 18dp;
    text-align: left;
    color: #ffffff;
    background-color: rgba(5,17,30,90%);
    border-left: 4dp #2b9ef7;
    border-top: 1dp rgba(72,154,234,45%);
    border-right: 1dp rgba(16,73,131,65%);
    border-bottom: 6dp #1c72e1;
    transition: background-color transform border-bottom-color 0.13s quadratic-out;
}

#deploy:hover,
#deploy:focus {
background-color: rgba(17,61,100,95%);
    border-bottom-color: #72c7ff;
    transform: translateY(-2dp);
}

.deploy_kicker {
display: block;
    color: #7f9fb7;
    font-size: 9dp;
    line-height: 11dp;
    letter-spacing: 1.5dp;
}

.deploy_label {
display: block;
    margin-top: 2dp;
    font-size: 31dp;
    line-height: 34dp;
    font-weight: bold;
    letter-spacing: 1.1dp;
}

.deploy_arrow {
position: absolute;
    right: 20dp;
    top: 16dp;
    color: #8fd5ff;
    font-family: "JetBrains Mono";
    font-size: 31dp;
    line-height: 34dp;
    font-weight: bold;
}

#activity_drawer {
display: none;
    width: 500dp;
    padding: 18dp;
    color: #d9e7f3;
    background-color: rgba(2,10,18,94%);
    border-left: 3dp #2b9ef7;
    border-top: 1dp rgba(114,199,255,20%);
    border-right: 1dp rgba(114,199,255,14%);
    border-bottom: 1dp rgba(114,199,255,14%);
}

#activity_drawer.open {
display: block;
    animation: 0.16s quadratic-out 1 drawer-in;
}

.drawer_header {
display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12dp;
    padding-bottom: 11dp;
    border-bottom: 1dp rgba(114,199,255,13%);
}

.drawer_title {
color: #ffffff;
    font-size: 27dp;
    line-height: 29dp;
    font-weight: bold;
    letter-spacing: 0.7dp;
}

#drawer_close {
padding: 8dp 11dp;
    color: #71899d;
    font-size: 9dp;
    font-weight: bold;
    letter-spacing: 1dp;
    background-color: rgba(8,22,36,72%);
    border: 1dp rgba(114,199,255,16%);
}

#drawer_close:hover,
#drawer_close:focus {
color: #ffffff;
    border-color: #72c7ff;
    background-color: rgba(28,114,225,26%);
}

.drawer_section {
margin-top: 10dp;
    margin-bottom: 5dp;
    color: #55758f;
    font-size: 9dp;
    font-family: "JetBrains Mono";
    font-weight: bold;
    letter-spacing: 1.4dp;
}

.drawer_item {
width: 100%;
    min-height: 67dp;
    display: flex;
    align-items: center;
    text-align: left;
    margin-bottom: 5dp;
    padding: 9dp 12dp;
    color: #8ea4b7;
    background-color: rgba(5,17,30,78%);
    border-left: 3dp rgba(114,199,255,14%);
    border-top: 1dp rgba(114,199,255,9%);
    border-right: 1dp rgba(114,199,255,7%);
    border-bottom: 1dp rgba(114,199,255,7%);
    transition: color background-color border-left-color transform padding-left 0.12s quadratic-out;
}

.drawer_item:hover,
.drawer_item:focus {
color: #ffffff;
    background-color: rgba(13,49,82,94%);
    border-left-color: #72c7ff;
    padding-left: 16dp;
    transform: translateX(2dp);
}

.drawer_item.selected {
color: #ffffff;
    background-color: rgba(18,72,120,84%);
    border-left-color: #a3dcff;
}

.drawer_code {
width: 36dp;
    color: #557189;
    font-family: "JetBrains Mono";
    font-size: 9dp;
}

.drawer_copy {
display: block; flex: 1;
}

.drawer_name {
display: block;
    font-size: 18dp;
    line-height: 20dp;
    font-weight: bold;
    letter-spacing: 0.7dp;
}

.drawer_meta {
display: block;
    margin-top: 2dp;
    color: #71879a;
    font-size: 10dp;
    line-height: 13dp;
}

.drawer_state {
margin-right: 10dp;
    color: #55e18c;
    font-size: 9dp;
    font-family: "JetBrains Mono";
    letter-spacing: 0.8dp;
}

.drawer_arrow {
width: 20dp;
    color: #72c7ff;
    text-align: right;
    font-size: 23dp;
}

.drawer_footer {
margin-top: 9dp;
    padding-top: 10dp;
    color: #49677d;
    font-family: "JetBrains Mono";
    font-size: 8dp;
    line-height: 11dp;
    letter-spacing: 0.7dp;
    border-top: 1dp rgba(114,199,255,9%);
}

#activity_selector {
nav-up: #nav_play; nav-down: #deploy; nav-right: #nav_play;
}

#deploy {
nav-up: #activity_selector;
}

#drawer_quick {
nav-up: #drawer_close; nav-down: #drawer_browser;
}

#drawer_browser {
nav-up: #drawer_quick; nav-down: #drawer_offline;
}

#drawer_offline {
nav-up: #drawer_browser; nav-down: #drawer_adventure;
}

#drawer_adventure {
nav-up: #drawer_offline; nav-down: #drawer_close;
}

#drawer_close {
nav-down: #drawer_quick;
}

#hunter_caption {
position: absolute;
    left: 55%;
    bottom: 46dp;
    width: 330dp;
    display: flex;
    align-items: center;
}

.hunter_rule {
width: 58dp;
    height: 1dp;
    margin-right: 12dp;
    background-color: rgba(114,199,255,72%);
}

#hunter_name {
color: #ffffff;
    font-size: 27dp;
    line-height: 29dp;
    font-weight: bold;
    letter-spacing: 0.6dp;
}

#hunter_meta {
margin-top: 1dp;
    color: #6b8295;
    font-size: 9dp;
    line-height: 11dp;
    letter-spacing: 1.1dp;
}

#session_panel {
position: absolute;
    right: 46dp;
    top: 38dp;
    width: 304dp;
    padding: 15dp;
    background-color: rgba(4,14,25,60%);
    border: 1dp rgba(97,182,246,12%);
    border-left: 2dp rgba(114,199,255,45%);
}

.session_header {
display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12dp;
}

.session_header .eyebrow {
margin-bottom: 0;
}

.session_state {
color: #55e18c;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1dp;
}

.session_player {
display: flex;
    align-items: center;
    padding: 12dp;
    background-color: rgba(12,40,65,60%);
    border: 1dp rgba(97,182,246,11%);
}

.session_badge {
width: 40dp;
    height: 40dp;
    line-height: 40dp;
    text-align: center;
    margin-right: 11dp;
    color: #ffffff;
    font-size: 20dp;
    font-weight: bold;
    background-color: rgba(28,114,225,78%);
}

.session_copy {
flex: 1;
}

.session_name {
color: #ffffff;
    font-size: 16dp;
    line-height: 18dp;
    font-weight: bold;
}

.session_meta {
margin-top: 2dp;
    color: #8197aa;
    font-size: 10dp;
    line-height: 12dp;
}

.session_slot {
display: flex;
    align-items: center;
    margin-top: 7dp;
    padding: 11dp 12dp;
    color: #72899c;
    font-size: 10dp;
    letter-spacing: 0.8dp;
    background-color: rgba(5,16,29,58%);
    border: 1dp rgba(97,182,246,9%);
}

.plus {
width: 28dp;
    color: #61b6f6;
    font-size: 21dp;
}

.session_hint {
margin-top: 10dp;
    color: #536b80;
    font-size: 9dp;
    line-height: 13dp;
}

@media (max-width: 1500dp) {
#activity_panel {
left: 32dp; width: 460dp;
}
#activity_compact {
width: 380dp;
}
#activity_drawer {
width: 460dp;
}
#session_panel {
right: 28dp; width: 270dp;
}
}

@media (max-width: 1180dp) {
#session_panel {
display: none;
}
#activity_panel {
width: 430dp;
}
#activity_compact {
width: 370dp;
}
#activity_drawer {
width: 430dp;
}
#hunter_caption {
left: 62%;
}
}

@media (max-width: 900dp) {
#activity_panel {
left: 20dp; bottom: 24dp; width: 365dp;
}
#activity_compact {
width: 345dp;
}
#activity_drawer {
width: 365dp; padding: 13dp;
}
#activity_selector {
min-height: 96dp;
}
.selector_art {
width: 76dp; min-height: 94dp;
}
.selector_title {
font-size: 23dp; line-height: 25dp;
}
.selector_meta {
font-size: 10dp; line-height: 13dp;
}
.drawer_item {
min-height: 58dp;
}
.drawer_name {
font-size: 16dp; line-height: 18dp;
}
#deploy {
min-height: 72dp;
}
.deploy_label {
font-size: 27dp; line-height: 29dp;
}
#hunter_caption {
display: none;
}
}

@media (max-height: 760dp) {
#activity_panel {
bottom: 18dp;
}
#activity_selector {
min-height: 88dp;
}
.selector_art {
min-height: 86dp; width: 72dp;
}
.selector_copy {
padding-top: 12dp; padding-bottom: 10dp;
}
.selector_title {
font-size: 22dp; line-height: 24dp;
}
.selector_meta {
margin-top: 2dp; font-size: 9dp; line-height: 12dp;
}
.selector_hint {
margin-top: 6dp;
}
#activity_status {
padding-top: 5dp; padding-bottom: 5dp;
}
#deploy {
min-height: 66dp; padding-top: 8dp; padding-bottom: 7dp;
}
.deploy_label {
font-size: 25dp; line-height: 27dp;
}
.deploy_arrow {
top: 9dp; font-size: 33dp;
}
#activity_drawer {
padding: 12dp;
}
.drawer_header {
margin-bottom: 7dp; padding-bottom: 7dp;
}
.drawer_title {
font-size: 22dp; line-height: 24dp;
}
.drawer_section {
margin-top: 6dp; margin-bottom: 3dp;
}
.drawer_item {
min-height: 50dp; margin-bottom: 3dp; padding-top: 5dp; padding-bottom: 5dp;
}
.drawer_name {
font-size: 15dp; line-height: 17dp;
}
.drawer_meta {
font-size: 8dp; line-height: 10dp;
}
.drawer_footer {
margin-top: 5dp; padding-top: 6dp;
}
#session_panel {
top: 20dp;
}
#hunter_caption {
bottom: 22dp;
}
}

@media (min-resolution: 2x) {
#session_panel,
#activity_selector,
.drawer_item,
#activity_status,
#deploy {
border-color: rgba(114,199,255,22%);
}
}


/* A short landscape stage scrolls the activity flow rather than extending it
   above the persistent header. Drawer choices share this same reachable pane. */
@media (max-height: 480dp) {
    #activity_panel { top: 8dp; bottom: 8dp; left: 14dp; width: 92vw; overflow-y: auto; overflow-x: hidden; }
    #activity_compact, #activity_drawer { width: 87vw; }
    #activity_selector { min-height: 74dp; }
    .selector_art { min-height: 72dp; width: 58dp; }
    .selector_copy { padding: 7dp 10dp; }
    .selector_title { font-size: 20dp; line-height: 22dp; }
    .selector_meta { font-size: 11dp; line-height: 14dp; }
    .selector_hint { margin-top: 3dp; font-size: 10dp; }
    #deploy { min-height: 58dp; padding-top: 6dp; padding-bottom: 6dp; }
    .deploy_label { font-size: 23dp; line-height: 26dp; }
    #activity_drawer { padding: 10dp; }
    .drawer_item { min-height: 48dp; }
}
