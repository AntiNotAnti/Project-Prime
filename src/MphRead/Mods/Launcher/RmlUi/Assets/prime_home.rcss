* { box-sizing: border-box; }

@keyframes enter-top {
    from { opacity: 0; transform: translateY(-10dp); }
    to   { opacity: 1; transform: translateY(0dp); }
}
@keyframes enter-left {
    from { opacity: 0; transform: translateX(-18dp); }
    to   { opacity: 1; transform: translateX(0dp); }
}
@keyframes enter-right {
    from { opacity: 0; transform: translateX(14dp); }
    to   { opacity: 1; transform: translateX(0dp); }
}
@keyframes enter-bottom {
    from { opacity: 0; transform: translateY(8dp); }
    to   { opacity: 1; transform: translateY(0dp); }
}
@keyframes enter-hunter {
    from { opacity: 0; transform: translateY(8dp); }
    to   { opacity: 1; transform: translateY(0dp); }
}
@keyframes enter-social {
    from { opacity: 0; transform: translateX(28dp); }
    to   { opacity: 1; transform: translateX(0dp); }
}

body {
    margin: 0;
    width: 100%;
    height: 100%;
    color: #edf7ff;
    font-family: Rajdhani;
    font-size: 16dp;
    background-color: rgba(0, 0, 0, 0);
}

#screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

#top_rule {
    position: absolute;
    left: 0;
    top: 92dp;
    width: 100%;
    height: 1dp;
    background-color: rgba(97,182,246,0.25);
}

#topbar {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 92dp;
    display: flex;
    align-items: center;
    padding-left: 46dp;
    padding-right: 46dp;
    background-color: rgba(2,8,15,0.82);
    border-bottom: 1dp rgba(97,182,246,0.10);
}

.enter_top { animation: 0.16s quadratic-out 1 enter-top; }
.enter_left { animation: 0.18s quadratic-out 1 enter-left; }
.enter_right { animation: 0.18s quadratic-out 1 enter-right; }
.enter_bottom { animation: 0.16s quadratic-out 1 enter-bottom; }
.enter_hunter { animation: 0.18s quadratic-out 1 enter-hunter; }
.enter_social { animation: 0.16s quadratic-out 1 enter-social; }

.reduce-motion .enter_top,
.reduce-motion .enter_left,
.reduce-motion .enter_right,
.reduce-motion .enter_bottom,
.reduce-motion .enter_hunter,
.reduce-motion .enter_social {
    animation: none;
}

#brand {
    width: 286dp;
    display: flex;
    align-items: center;
}
#brand_mark {
    width: 54dp;
    height: 54dp;
    line-height: 54dp;
    text-align: center;
    margin-right: 14dp;
    color: #ffffff;
    font-size: 31dp;
    font-weight: bold;
    background-color: #1c72e1;
    border: 1dp #72c7ff;
    transform: rotate(-3deg);
}
.brand_title {
    display: block;
    color: #ffffff;
    font-size: 22dp;
    line-height: 23dp;
    font-weight: bold;
    letter-spacing: 1.4dp;
}
.brand_subtitle {
    display: block;
    margin-top: 3dp;
    color: #6d8396;
    font-size: 9dp;
    line-height: 11dp;
    letter-spacing: 1.6dp;
}

#primary_nav {
    display: flex;
    align-items: stretch;
    height: 100%;
    flex: 1;
}

button {
    tab-index: auto;
    cursor: pointer;
    color: #9caec0;
    background-color: rgba(0,0,0,0);
    border: 0;
    font-family: Rajdhani;
}

.nav {
    min-width: 116dp;
    padding-left: 20dp;
    padding-right: 20dp;
    font-size: 18dp;
    font-weight: bold;
    letter-spacing: 1dp;
    border-bottom: 4dp rgba(0,0,0,0);
    transition: color background-color border-bottom-color transform 0.14s quadratic-out;
}
.nav:hover, .nav:focus {
    color: #ffffff;
    background-color: rgba(43,158,247,0.10);
    border-bottom-color: #2b9ef7;
    transform: translateY(-1dp);
}
.nav.active {
    color: #ffffff;
    background-color: rgba(28,114,225,0.12);
    border-bottom-color: #72c7ff;
}

#account_cluster {
    width: 430dp;
    display: flex;
    justify-content: flex-end;
    align-items: center;
}
.online_dot {
    width: 9dp;
    height: 9dp;
    border-radius: 5dp;
    margin-right: 10dp;
    background-color: #55e18c;
}
.account_copy {
    width: 162dp;
    margin-right: 13dp;
    text-align: right;
}
.account_name {
    display: block;
    color: #ffffff;
    font-size: 17dp;
    line-height: 19dp;
    font-weight: bold;
}
.account_meta {
    display: block;
    margin-top: 2dp;
    color: #667e92;
    font-size: 8dp;
    line-height: 10dp;
    letter-spacing: 0.7dp;
}

.social_button {
    margin-right: 7dp;
}
.social_badge {
    display: inline-block;
    min-width: 19dp;
    height: 19dp;
    line-height: 19dp;
    margin-left: 5dp;
    padding-left: 5dp;
    padding-right: 5dp;
    text-align: center;
    color: #ffffff;
    background-color: #d34752;
    border-radius: 10dp;
    font-family: "JetBrains Mono";
    font-size: 8dp;
}

.utility, .footer_button {
    padding: 10dp 15dp;
    border: 1dp rgba(97,182,246,0.28);
    background-color: rgba(7,18,31,0.72);
    font-size: 12dp;
    font-weight: bold;
    letter-spacing: 0.8dp;
    transition: color background-color border-color transform 0.13s quadratic-out;
}
.utility:hover, .utility:focus,
.footer_button:hover, .footer_button:focus {
    color: #ffffff;
    border-color: #61b6f6;
    background-color: rgba(28,114,225,0.31);
    transform: translateY(-1dp);
}

#stage {
    position: absolute;
    left: 0;
    top: 93dp;
    right: 0;
    bottom: 68dp;
}

#activity_panel {
    position: absolute;
    left: 52dp;
    bottom: 44dp;
    width: 470dp;
}

.eyebrow {
    color: #72c7ff;
    font-size: 10dp;
    line-height: 12dp;
    font-weight: bold;
    letter-spacing: 1.9dp;
    margin-bottom: 6dp;
}

#activity_title {
    color: #ffffff;
    font-size: 49dp;
    line-height: 50dp;
    font-weight: bold;
    letter-spacing: 0.7dp;
}

#activity_description {
    width: 430dp;
    margin-top: 5dp;
    margin-bottom: 18dp;
    color: #9cb0c1;
    font-size: 14dp;
    line-height: 19dp;
}

#activity_list {
    width: 100%;
    margin-bottom: 11dp;
}

.activity {
    width: 100%;
    min-height: 68dp;
    display: flex;
    align-items: center;
    text-align: left;
    margin-bottom: 5dp;
    padding: 9dp 14dp;
    color: #91a6b8;
    background-color: rgba(5,16,29,0.80);
    border-left: 3dp rgba(97,182,246,0.18);
    border-top: 1dp rgba(97,182,246,0.12);
    border-right: 1dp rgba(97,182,246,0.09);
    border-bottom: 1dp rgba(97,182,246,0.09);
    transition: color background-color border-left-color padding-left transform 0.13s quadratic-out;
}
.activity:hover, .activity:focus, .activity.selected {
    color: #ffffff;
    background-color: rgba(15,55,92,0.92);
    border-left-color: #72c7ff;
    padding-left: 19dp;
    transform: translateX(3dp);
}
.activity.selected {
    background-color: rgba(18,72,120,0.94);
}

.activity_code {
    width: 38dp;
    color: #557189;
    font-size: 10dp;
    font-family: "JetBrains Mono";
}
.activity:hover .activity_code,
.activity:focus .activity_code,
.activity.selected .activity_code {
    color: #72c7ff;
}

.activity_copy {
    display: block;
    flex: 1;
}
.activity_name {
    display: block;
    font-size: 20dp;
    line-height: 22dp;
    font-weight: bold;
    letter-spacing: 0.7dp;
}
.activity_meta {
    display: block;
    margin-top: 2dp;
    color: #758b9e;
    font-size: 10dp;
    line-height: 13dp;
}
.activity_arrow {
    width: 24dp;
    text-align: right;
    color: #72c7ff;
    font-size: 27dp;
}

#mode_quick { nav-down: #mode_browser; nav-right: #nav_play; }
#mode_browser { nav-up: #mode_quick; nav-down: #mode_offline; }
#mode_offline { nav-up: #mode_browser; nav-down: #mode_adventure; }
#mode_adventure { nav-up: #mode_offline; nav-down: #deploy; }
#deploy { nav-up: #mode_adventure; }
#nav_play { nav-left: #mode_quick; nav-right: #nav_hunters; }
#nav_hunters { nav-left: #nav_play; nav-right: #nav_community; }
#nav_community { nav-left: #nav_hunters; nav-right: #nav_studio; }
#nav_studio { nav-left: #nav_community; nav-right: #social; }
#social { nav-left: #nav_studio; nav-right: #profile; }
#profile { nav-left: #social; }

#activity_status {
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 8dp 13dp;
    color: #7a8fa2;
    font-size: 9dp;
    letter-spacing: 1dp;
    background-color: rgba(3,10,18,0.86);
    border-left: 1dp rgba(97,182,246,0.16);
    border-right: 1dp rgba(97,182,246,0.16);
    border-top: 1dp rgba(97,182,246,0.10);
}
.ready { color: #55e18c; }

#deploy {
    position: relative;
    width: 100%;
    min-height: 94dp;
    padding: 13dp 66dp 11dp 19dp;
    text-align: left;
    color: #ffffff;
    background-color: #175fb8;
    border-left: 4dp #8bd3ff;
    border-top: 1dp #489aea;
    border-right: 1dp #104983;
    border-bottom: 1dp #104983;
    transition: background-color transform 0.13s quadratic-out;
}
#deploy:hover, #deploy:focus {
    background-color: #1c72e1;
    transform: translateY(-2dp);
}
.deploy_kicker {
    display: block;
    color: #b9ddf7;
    font-size: 8dp;
    line-height: 10dp;
    letter-spacing: 1.5dp;
}
.deploy_label {
    display: block;
    margin-top: 2dp;
    font-size: 34dp;
    line-height: 37dp;
    font-weight: bold;
    letter-spacing: 1.1dp;
}
.deploy_arrow {
    position: absolute;
    right: 20dp;
    top: 18dp;
    color: #e9f8ff;
    font-size: 42dp;
}

#hunter_caption {
    position: absolute;
    left: 55%;
    bottom: 46dp;
    width: 330dp;
    display: flex;
    align-items: center;
}
.hunter_rule {
    width: 58dp;
    height: 1dp;
    margin-right: 12dp;
    background-color: rgba(114,199,255,0.72);
}
#hunter_name {
    color: #ffffff;
    font-size: 27dp;
    line-height: 29dp;
    font-weight: bold;
    letter-spacing: 0.6dp;
}
#hunter_meta {
    margin-top: 1dp;
    color: #6b8295;
    font-size: 8dp;
    line-height: 10dp;
    letter-spacing: 1.1dp;
}

#session_panel {
    position: absolute;
    right: 46dp;
    top: 38dp;
    width: 304dp;
    padding: 15dp;
    background-color: rgba(4,14,25,0.68);
    border: 1dp rgba(97,182,246,0.14);
    border-left: 2dp rgba(114,199,255,0.45);
}
.session_header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12dp;
}
.session_header .eyebrow { margin-bottom: 0; }
.session_state {
    color: #55e18c;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1dp;
}
.session_player {
    display: flex;
    align-items: center;
    padding: 12dp;
    background-color: rgba(12,40,65,0.80);
    border: 1dp rgba(97,182,246,0.14);
}
.session_badge {
    width: 40dp;
    height: 40dp;
    line-height: 40dp;
    text-align: center;
    margin-right: 11dp;
    color: #ffffff;
    font-size: 20dp;
    font-weight: bold;
    background-color: #1c72e1;
}
.session_copy { flex: 1; }
.session_name {
    color: #ffffff;
    font-size: 16dp;
    line-height: 18dp;
    font-weight: bold;
}
.session_meta {
    margin-top: 2dp;
    color: #8197aa;
    font-size: 9dp;
    line-height: 11dp;
}
.session_slot {
    display: flex;
    align-items: center;
    margin-top: 7dp;
    padding: 11dp 12dp;
    color: #72899c;
    font-size: 10dp;
    letter-spacing: 0.8dp;
    background-color: rgba(5,16,29,0.58);
    border: 1dp rgba(97,182,246,0.09);
}
.plus {
    width: 28dp;
    color: #61b6f6;
    font-size: 21dp;
}
.session_hint {
    margin-top: 10dp;
    color: #536b80;
    font-size: 8dp;
    line-height: 12dp;
}
.session_friends_header {
    display: flex;
    justify-content: space-between;
    margin-top: 10dp;
    margin-bottom: 5dp;
    color: #688197;
    font-size: 8dp;
    font-weight: bold;
    letter-spacing: 1dp;
}
.session_online_count { color: #55e18c; }
.home_friend {
    display: flex;
    align-items: center;
    min-height: 39dp;
    margin-bottom: 4dp;
    padding: 7dp 8dp;
    background-color: rgba(4,17,30,0.70);
    border: 1dp rgba(97,182,246,0.08);
}
.friend_dot {
    width: 7dp;
    height: 7dp;
    margin-right: 8dp;
    border-radius: 4dp;
    background-color: #55e18c;
}
.home_friend_copy { display: block; flex: 1; }
.home_friend_name {
    display: block;
    color: #eaf6ff;
    font-size: 11dp;
    line-height: 12dp;
    font-weight: bold;
}
.home_friend_state {
    display: block;
    margin-top: 1dp;
    color: #6f899f;
    font-size: 7dp;
    line-height: 9dp;
    letter-spacing: 0.4dp;
}
.session_empty {
    padding: 12dp 8dp;
    color: #50687c;
    text-align: center;
    font-size: 8dp;
    letter-spacing: 0.8dp;
    background-color: rgba(4,17,30,0.46);
    border: 1dp rgba(97,182,246,0.06);
}
.session_social {
    width: 100%;
    margin-top: 7dp;
    padding: 9dp 10dp;
    color: #b9ddf7;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1dp;
    background-color: rgba(20,77,126,0.62);
    border: 1dp rgba(114,199,255,0.22);
}
.session_social:hover, .session_social:focus {
    color: #ffffff;
    background-color: rgba(28,114,225,0.54);
    border-color: #72c7ff;
}

.social-open #topbar button,
.social-open #activity_panel button,
.social-open #session_panel button,
.social-open #footerbar button {
    tab-index: none;
}

#social_backdrop {
    display: none;
    position: absolute;
    left: 0;
    top: 93dp;
    right: 0;
    bottom: 68dp;
}
#social_backdrop.open { display: block; }
#social_scrim {
    tab-index: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,5,10,0.58);
    border: 0;
}
#social_drawer {
    position: absolute;
    right: 0;
    top: 0;
    width: 510dp;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 20dp 20dp 14dp 20dp;
    background-color: rgba(3,12,22,0.97);
    border-left: 1dp rgba(114,199,255,0.32);
}
.social_header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12dp;
}
.social_header .eyebrow { margin-bottom: 1dp; }
.social_title {
    color: #ffffff;
    font-size: 31dp;
    line-height: 32dp;
    font-weight: bold;
    letter-spacing: 1.1dp;
}
.social_icon_button {
    width: 38dp;
    height: 38dp;
    line-height: 34dp;
    padding: 0;
    color: #8fa7ba;
    font-size: 25dp;
    text-align: center;
    background-color: rgba(8,24,39,0.86);
    border: 1dp rgba(114,199,255,0.16);
}
.social_icon_button:hover, .social_icon_button:focus {
    color: #ffffff;
    border-color: #72c7ff;
    background-color: rgba(28,114,225,0.34);
}
.social_tabs {
    display: flex;
    margin-bottom: 10dp;
    border-bottom: 1dp rgba(114,199,255,0.13);
}
.social_tab {
    flex: 1;
    min-height: 42dp;
    padding: 8dp 7dp;
    color: #71899e;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 0.8dp;
    border-bottom: 3dp rgba(0,0,0,0);
}
.social_tab:hover, .social_tab:focus {
    color: #dceeff;
    background-color: rgba(35,106,166,0.14);
}
.social_tab.selected {
    color: #ffffff;
    border-bottom-color: #72c7ff;
    background-color: rgba(28,114,225,0.18);
}
.social_tab_count {
    display: block;
    margin-top: 2dp;
    color: #58758d;
    font-size: 7dp;
    font-family: "JetBrains Mono";
    letter-spacing: 0.3dp;
}
.social_tab.selected .social_tab_count { color: #8bd3ff; }

.social_search_row {
    display: flex;
    margin-bottom: 8dp;
}
#social_search {
    flex: 1;
    height: 40dp;
    padding: 8dp 10dp;
    color: #eaf6ff;
    background-color: rgba(5,20,34,0.94);
    border: 1dp rgba(114,199,255,0.16);
    font-family: "JetBrains Mono";
    font-size: 9dp;
}
#social_search:focus {
    border-color: #72c7ff;
    background-color: rgba(9,33,55,0.98);
}
.social_filter_button {
    width: 78dp;
    margin-left: 6dp;
    color: #c8e9ff;
    background-color: rgba(25,86,137,0.62);
    border: 1dp rgba(114,199,255,0.20);
    font-size: 9dp;
    font-weight: bold;
    letter-spacing: 0.8dp;
}
.social_filter_button:hover, .social_filter_button:focus {
    color: #ffffff;
    background-color: rgba(28,114,225,0.55);
    border-color: #72c7ff;
}
.social_statebar {
    display: flex;
    align-items: center;
    min-height: 30dp;
    padding: 6dp 8dp;
    margin-bottom: 8dp;
    color: #69849a;
    background-color: rgba(2,10,18,0.66);
    border: 1dp rgba(114,199,255,0.07);
    font-size: 8dp;
    letter-spacing: 0.7dp;
}
.social_state_dot {
    width: 7dp;
    height: 7dp;
    margin-right: 7dp;
    border-radius: 4dp;
    background-color: #55e18c;
}
.social_state_dot.loading { background-color: #e1b55a; }
.social_ttl {
    margin-left: auto;
    color: #435c71;
    font-family: "JetBrains Mono";
}

#social_list {
    position: relative;
    flex: 1;
    min-height: 140dp;
    overflow-y: auto;
    padding-right: 3dp;
}
.social_empty {
    margin-top: 38dp;
    padding: 24dp 18dp;
    text-align: center;
    background-color: rgba(5,17,29,0.60);
    border: 1dp rgba(114,199,255,0.08);
}
.social_empty_title {
    color: #b9d4e7;
    font-size: 13dp;
    font-weight: bold;
    letter-spacing: 1dp;
}
.social_empty_copy {
    margin-top: 5dp;
    color: #526c81;
    font-size: 9dp;
    line-height: 13dp;
}
.social_row {
    width: 100%;
    min-height: 72dp;
    display: flex;
    align-items: center;
    margin-bottom: 5dp;
    padding: 9dp 10dp;
    text-align: left;
    color: #91a9bc;
    background-color: rgba(5,18,31,0.82);
    border-left: 2dp rgba(114,199,255,0.15);
    border-top: 1dp rgba(114,199,255,0.08);
    border-right: 1dp rgba(114,199,255,0.06);
    border-bottom: 1dp rgba(114,199,255,0.06);
}
.social_row:hover, .social_row:focus {
    color: #ffffff;
    background-color: rgba(14,50,82,0.96);
    border-left-color: #72c7ff;
}
.social_presence_dot {
    width: 9dp;
    height: 9dp;
    margin-left: 2dp;
    margin-right: 11dp;
    border-radius: 5dp;
    background-color: #45596c;
}
.social_presence_dot.online { background-color: #55e18c; }
.social_row_copy { display: block; flex: 1; }
.social_row_top { display: flex; align-items: center; }
.social_row_name {
    color: #edf8ff;
    font-size: 14dp;
    line-height: 16dp;
    font-weight: bold;
}
.social_relation {
    margin-left: auto;
    color: #72c7ff;
    font-size: 7dp;
    letter-spacing: 0.8dp;
}
.social_row_meta {
    display: block;
    margin-top: 2dp;
    color: #728ba0;
    font-size: 8dp;
    line-height: 10dp;
}
.social_row_id {
    display: block;
    margin-top: 3dp;
    color: #425d74;
    font-family: "JetBrains Mono";
    font-size: 7dp;
}
.social_row_more {
    width: 24dp;
    margin-left: 8dp;
    color: #5f7c94;
    font-size: 14dp;
    text-align: right;
}

.social_footer {
    display: flex;
    justify-content: space-between;
    padding-top: 9dp;
}
.social_footer_button {
    padding: 8dp 11dp;
    color: #718ba1;
    background-color: rgba(4,16,28,0.82);
    border: 1dp rgba(114,199,255,0.10);
    font-size: 8dp;
    font-weight: bold;
    letter-spacing: 0.8dp;
}
.social_footer_button:hover, .social_footer_button:focus,
.social_footer_button.selected {
    color: #dff3ff;
    border-color: rgba(114,199,255,0.44);
    background-color: rgba(22,78,126,0.48);
}

#social_context {
    display: none;
    position: absolute;
    left: 14dp;
    right: 14dp;
    bottom: 58dp;
    padding: 15dp;
    background-color: rgba(3,12,22,0.99);
    border: 1dp rgba(114,199,255,0.28);
    border-left: 3dp #72c7ff;
}
#social_context.open { display: block; }
.social_context_header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}
.social_context_name {
    color: #ffffff;
    font-size: 21dp;
    line-height: 23dp;
    font-weight: bold;
}
.social_context_id {
    margin-top: 2dp;
    color: #527088;
    font-family: "JetBrains Mono";
    font-size: 8dp;
}
.social_context_state {
    margin-top: 9dp;
    padding: 8dp 9dp;
    color: #8aa1b4;
    background-color: rgba(7,25,42,0.82);
    border: 1dp rgba(114,199,255,0.08);
    font-size: 9dp;
    letter-spacing: 0.5dp;
}
.social_context_actions {
    display: flex;
    flex-wrap: wrap;
    margin-top: 9dp;
}
.social_action {
    min-width: 120dp;
    margin-right: 6dp;
    margin-bottom: 6dp;
    padding: 10dp 12dp;
    color: #b8d3e5;
    background-color: rgba(12,39,63,0.88);
    border: 1dp rgba(114,199,255,0.13);
    font-size: 9dp;
    font-weight: bold;
    letter-spacing: 0.7dp;
}
.social_action:hover, .social_action:focus {
    color: #ffffff;
    border-color: #72c7ff;
    background-color: rgba(28,114,225,0.44);
}
.social_action.primary {
    color: #ffffff;
    background-color: #175fb8;
    border-color: #61b6f6;
}
.social_action.danger {
    color: #f0a8ad;
    border-color: rgba(239,104,112,0.30);
}
.social_action.danger:hover, .social_action.danger:focus {
    color: #ffffff;
    background-color: rgba(178,47,58,0.48);
    border-color: #ef6870;
}
.social_context_note {
    margin-top: 4dp;
    color: #455f75;
    font-size: 7dp;
    line-height: 10dp;
    letter-spacing: 0.3dp;
}

#diagnostics_panel {
    display: none;
    position: absolute;
    right: 46dp;
    bottom: 82dp;
    width: 330dp;
    padding: 13dp;
    color: #91a6b8;
    background-color: rgba(2,10,18,0.93);
    border: 1dp rgba(114,199,255,0.28);
    border-left: 3dp #2b9ef7;
}
#diagnostics_panel.open { display: block; }
.diag_header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8dp;
    color: #ffffff;
    font-size: 12dp;
    font-weight: bold;
    letter-spacing: 1dp;
}
.diag_key { color: #72c7ff; }
.diag_row {
    display: flex;
    justify-content: space-between;
    padding-top: 5dp;
    padding-bottom: 5dp;
    border-bottom: 1dp rgba(114,199,255,0.09);
    font-size: 9dp;
    letter-spacing: 0.6dp;
}
.diag_row b {
    max-width: 220dp;
    color: #dcebf7;
    text-align: right;
    font-weight: bold;
}

#footerbar {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 68dp;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 46dp;
    padding-right: 46dp;
    background-color: rgba(2,8,15,0.88);
    border-top: 1dp rgba(97,182,246,0.13);
}
#build_info {
    color: #60788d;
    font-size: 9dp;
    letter-spacing: 0.8dp;
}
.blue { color: #72c7ff; }
.divider {
    margin-left: 10dp;
    margin-right: 10dp;
    color: #344d62;
}
#footer_actions { display: flex; }
.footer_button {
    min-width: 90dp;
    margin-left: 7dp;
}
.footer_button.danger:hover,
.footer_button.danger:focus {
    border-color: #ef6870;
    background-color: rgba(178,47,58,0.28);
}

@media (max-width: 1500px) {
    #topbar { padding-left: 28dp; padding-right: 28dp; }
    #brand { width: 246dp; }
    #brand_mark { width: 48dp; height: 48dp; line-height: 48dp; font-size: 28dp; }
    .brand_title { font-size: 19dp; line-height: 21dp; }
    .nav { min-width: 96dp; padding-left: 13dp; padding-right: 13dp; font-size: 16dp; }
    #account_cluster { width: 330dp; }
    .account_copy { width: 118dp; }
    #activity_panel { left: 32dp; width: 410dp; }
    #activity_title { font-size: 43dp; line-height: 44dp; }
    #activity_description { width: 385dp; }
    #session_panel { right: 28dp; width: 270dp; }
    #footerbar { padding-left: 28dp; padding-right: 28dp; }
}

@media (max-width: 1180px) {
    #session_panel { display: none; }
    #account_cluster { width: 218dp; }
    .account_copy { display: none; }
    #activity_panel { width: 390dp; }
    #activity_description { width: 365dp; }
    #hunter_caption { left: 62%; }
}

@media (max-width: 900px) {
    #topbar { height: 82dp; }
    #top_rule { top: 82dp; }
    #stage { top: 83dp; }
    #brand { width: 190dp; }
    .brand_subtitle { display: none; }
    .nav { min-width: 78dp; padding-left: 8dp; padding-right: 8dp; font-size: 14dp; }
    #account_cluster { width: 172dp; }
    #activity_panel { left: 20dp; bottom: 24dp; width: 350dp; }
    #activity_title { font-size: 38dp; line-height: 40dp; }
    #activity_description { width: 330dp; font-size: 12dp; line-height: 16dp; }
    .activity { min-height: 58dp; }
    .activity_name { font-size: 17dp; line-height: 19dp; }
    #deploy { min-height: 78dp; }
    .deploy_label { font-size: 28dp; line-height: 31dp; }
    #hunter_caption { display: none; }
    #footerbar { height: 58dp; }
    #stage { bottom: 58dp; }
    #social_backdrop { top: 83dp; bottom: 58dp; }
    #social_drawer { width: 430dp; }
}

@media (max-height: 760px) {
    #topbar { height: 78dp; }
    #top_rule { top: 78dp; }
    #stage { top: 79dp; bottom: 54dp; }
    #footerbar { height: 54dp; }

    #brand_mark {
        width: 44dp;
        height: 44dp;
        line-height: 44dp;
        font-size: 25dp;
    }
    .brand_title { font-size: 18dp; line-height: 20dp; }
    .nav { font-size: 15dp; }

    #activity_panel { bottom: 20dp; }
    .eyebrow { margin-bottom: 4dp; }
    #activity_title { font-size: 39dp; line-height: 40dp; }
    #activity_description {
        margin-top: 3dp;
        margin-bottom: 10dp;
        font-size: 12dp;
        line-height: 15dp;
    }
    #activity_list { margin-bottom: 7dp; }
    .activity {
        min-height: 54dp;
        margin-bottom: 3dp;
        padding-top: 6dp;
        padding-bottom: 6dp;
    }
    .activity_name { font-size: 17dp; line-height: 18dp; }
    .activity_meta { font-size: 9dp; line-height: 11dp; }
    #activity_status { padding-top: 5dp; padding-bottom: 5dp; }
    #deploy {
        min-height: 72dp;
        padding-top: 9dp;
        padding-bottom: 8dp;
    }
    .deploy_label { font-size: 28dp; line-height: 30dp; }
    .deploy_arrow { top: 11dp; font-size: 36dp; }

    #session_panel { top: 20dp; }
    #hunter_caption { bottom: 22dp; }
    #social_drawer { padding-top: 12dp; padding-bottom: 9dp; }
    .social_header { margin-bottom: 7dp; }
    .social_title { font-size: 25dp; line-height: 26dp; }
    .social_tabs { margin-bottom: 6dp; }
    .social_tab { min-height: 35dp; padding-top: 5dp; padding-bottom: 5dp; }
    .social_search_row { margin-bottom: 5dp; }
    #social_search { height: 34dp; }
    .social_statebar { min-height: 25dp; margin-bottom: 5dp; padding-top: 4dp; padding-bottom: 4dp; }
    .social_row { min-height: 60dp; padding-top: 6dp; padding-bottom: 6dp; }
}

@media (min-resolution: 2x) {
    #top_rule,
    #footerbar,
    #session_panel,
    .activity,
    #activity_status,
    #deploy,
    .utility,
    .footer_button {
        border-color: rgba(114,199,255,0.22);
    }
}
