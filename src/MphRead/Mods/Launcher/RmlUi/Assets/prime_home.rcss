* { box-sizing: border-box; }

body {
    margin: 0;
    width: 100%;
    height: 100%;
    color: #edf7ff;
    font-family: Rajdhani;
    background-color: rgba(0, 0, 0, 0);
}

#screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: rgba(4, 12, 23, 0.34);
    decorator: radial-gradient(62% 82% at 54% 43%, rgba(24,92,154,0.12), rgba(2,7,14,0.08) 54%, rgba(1,5,10,0.46));
}

#scene_tint {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    decorator: linear-gradient(90deg, rgba(2,8,16,0.97) 0%, rgba(4,13,25,0.79) 27%, rgba(4,13,25,0.08) 52%, rgba(4,13,25,0.18) 72%, rgba(2,8,16,0.92) 100%);
}

#top_rule {
    position: absolute;
    left: 0;
    top: 78px;
    width: 100%;
    height: 1px;
    background-color: rgba(97, 182, 246, 0.28);
}

#topbar {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 78px;
    display: flex;
    align-items: center;
    padding-left: 34px;
    padding-right: 34px;
    background-color: rgba(3, 9, 17, 0.86);
    border-bottom: 1px rgba(97, 182, 246, 0.12);
}

#brand { width: 315px; display: flex; align-items: center; }
#brand_mark {
    width: 50px;
    height: 50px;
    line-height: 50px;
    text-align: center;
    margin-right: 12px;
    color: #ffffff;
    font-size: 30px;
    font-weight: bold;
    background-color: #1c72e1;
    border: 1px #61b6f6;
    transform: rotate(-3deg);
}
.brand_title { display: block; color: #ffffff; font-size: 20px; line-height: 22px; font-weight: bold; letter-spacing: 1.5px; }
.brand_subtitle { display: block; margin-top: 2px; color: #6e8498; font-size: 8px; line-height: 10px; letter-spacing: 1.2px; }

#primary_nav { display: flex; align-items: stretch; height: 100%; flex: 1; }
button {
    tab-index: auto;
    cursor: pointer;
    color: #9caec0;
    background-color: rgba(0,0,0,0);
    border: 0;
    font-family: Rajdhani;
}
.nav {
    min-width: 124px;
    padding-left: 22px;
    padding-right: 22px;
    font-size: 17px;
    font-weight: bold;
    letter-spacing: 1px;
    border-bottom: 3px rgba(0,0,0,0);
    transition: color background-color border-bottom-color 0.13s quadratic-out;
}
.nav:hover, .nav:focus {
    color: #ffffff;
    background-color: rgba(43,158,247,0.09);
    border-bottom-color: #2b9ef7;
}
.nav.active { color: #ffffff; background-color: rgba(28,114,225,0.12); border-bottom-color: #61b6f6; }

#account_cluster { width: 340px; display: flex; justify-content: flex-end; align-items: center; }
.online_dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 10px; background-color: #55e18c; }
.account_copy { width: 205px; margin-right: 12px; text-align: right; }
.account_name { display: block; color: #ffffff; font-size: 16px; line-height: 18px; font-weight: bold; }
.account_meta { display: block; color: #657c90; font-size: 7px; line-height: 9px; letter-spacing: 0.6px; }
.utility, .footer_button {
    padding: 9px 13px;
    border: 1px rgba(97,182,246,0.25);
    background-color: rgba(7,18,31,0.72);
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    transition: color background-color border-color transform 0.12s quadratic-out;
}
.utility:hover, .utility:focus, .footer_button:hover, .footer_button:focus {
    color: #ffffff;
    border-color: #61b6f6;
    background-color: rgba(28,114,225,0.30);
    transform: translateY(-1px);
}

#stage { position: absolute; left: 0; top: 79px; right: 0; bottom: 58px; }

#activity_panel { position: absolute; left: 38px; bottom: 34px; width: 420px; }
.eyebrow { color: #61b6f6; font-size: 9px; font-weight: bold; letter-spacing: 1.8px; margin-bottom: 5px; }
#activity_title { color: #ffffff; font-size: 38px; line-height: 40px; font-weight: bold; letter-spacing: 0.7px; }
#activity_description { width: 360px; margin-top: 3px; margin-bottom: 15px; color: #91a5b8; font-size: 12px; line-height: 18px; }
#activity_list { width: 100%; margin-bottom: 10px; }
.activity {
    width: 420px;
    min-height: 58px;
    display: flex;
    align-items: center;
    text-align: left;
    margin-bottom: 4px;
    padding: 8px 12px;
    color: #8da2b5;
    background-color: rgba(7,22,38,0.91);
    border-left: 3px rgba(97,182,246,0.18);
    border-top: 1px rgba(97,182,246,0.12);
    border-right: 1px rgba(97,182,246,0.08);
    border-bottom: 1px rgba(97,182,246,0.08);
    transition: color background-color border-left-color padding-left transform 0.12s quadratic-out;
}
.activity:hover, .activity:focus, .activity.selected {
    color: #ffffff;
    background-color: rgba(14,63,104,0.94);
    border-left-color: #61b6f6;
    padding-left: 17px;
    transform: translateX(2px);
}
.activity_code { width: 34px; color: #4e6b84; font-size: 10px; }
.activity:hover .activity_code, .activity:focus .activity_code, .activity.selected .activity_code { color: #61b6f6; }
.activity_copy { display: block; flex: 1; }
.activity_name { display: block; font-size: 17px; font-weight: bold; letter-spacing: 0.7px; }
.activity_meta { display: block; margin-top: 1px; color: #71869a; font-size: 9px; }
.activity_arrow { width: 20px; text-align: right; color: #61b6f6; font-size: 24px; }

#mode_quick { nav-down: #mode_browser; nav-right: #nav_play; }
#mode_browser { nav-up: #mode_quick; nav-down: #mode_offline; }
#mode_offline { nav-up: #mode_browser; nav-down: #mode_adventure; }
#mode_adventure { nav-up: #mode_offline; nav-down: #deploy; }
#deploy { nav-up: #mode_adventure; }
#nav_play { nav-left: #mode_quick; nav-right: #nav_hunters; }
#nav_hunters { nav-left: #nav_play; nav-right: #nav_community; }
#nav_community { nav-left: #nav_hunters; nav-right: #nav_studio; }
#nav_studio { nav-left: #nav_community; nav-right: #profile; }
#profile { nav-left: #nav_studio; }

#activity_status {
    display: flex;
    width: 420px;
    justify-content: space-between;
    padding: 7px 11px;
    color: #758a9e;
    font-size: 9px;
    letter-spacing: 1px;
    background-color: rgba(3,10,18,0.82);
    border-left: 1px rgba(97,182,246,0.16);
    border-right: 1px rgba(97,182,246,0.16);
    border-top: 1px rgba(97,182,246,0.10);
}
.ready { color: #55e18c; }
#deploy {
    position: relative;
    display: block;
    width: 420px;
    height: 80px;
    min-height: 80px;
    padding: 12px 60px 10px 18px;
    text-align: left;
    color: #ffffff;
    background-color: #175ab1;
    border-left: 4px #72c7ff;
    border-top: 1px #3a8ce4;
    border-right: 1px #104983;
    border-bottom: 1px #104983;
    transition: background-color transform 0.11s quadratic-out;
}
#deploy:hover, #deploy:focus { background-color: #1c72e1; transform: translateY(-2px); }
.deploy_kicker { display: block; color: #b6dbf6; font-size: 8px; letter-spacing: 1.3px; }
.deploy_label { display: block; font-size: 29px; line-height: 32px; font-weight: bold; letter-spacing: 1.2px; }
.deploy_arrow { position: absolute; right: 18px; top: 17px; color: #e6f7ff; font-size: 38px; }

#hunter_caption {
    position: absolute;
    left: 47%;
    bottom: 32px;
    width: 330px;
    display: flex;
    align-items: center;
}
.hunter_rule { width: 52px; height: 1px; margin-right: 11px; background-color: rgba(97,182,246,0.62); }
#hunter_name { color: #ffffff; font-size: 23px; font-weight: bold; }
#hunter_meta { color: #637b90; font-size: 8px; letter-spacing: 1px; }

#right_panel { position: absolute; right: 34px; top: 30px; width: 300px; }
.side_title { margin-bottom: 8px; color: #dcebf7; font-size: 15px; font-weight: bold; letter-spacing: 1.2px; }
.status_card {
    margin-bottom: 8px;
    padding: 13px;
    background-color: rgba(6,17,29,0.76);
    border: 1px rgba(97,182,246,0.14);
}
.status_card.accent { border-left: 3px #2b9ef7; background-color: rgba(9,31,51,0.80); }
.status_card.note { border-left: 2px #526d84; }
.status_value { color: #ffffff; font-size: 19px; font-weight: bold; letter-spacing: 0.8px; }
.status_meta { margin-top: 4px; color: #7d93a7; font-size: 9px; line-height: 14px; }
.row { display: flex; justify-content: space-between; padding-top: 6px; padding-bottom: 6px; border-bottom: 1px rgba(97,182,246,0.08); color: #71879a; font-size: 8px; letter-spacing: 0.7px; }
.row b { color: #d8e9f6; font-size: 7px; font-weight: bold; text-align: right; max-width: 176px; }

#footerbar {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 34px;
    padding-right: 34px;
    background-color: rgba(2,8,15,0.91);
    border-top: 1px rgba(97,182,246,0.13);
}
#build_info { color: #60788d; font-size: 9px; letter-spacing: 0.8px; }
.blue { color: #61b6f6; }
.divider { margin-left: 9px; margin-right: 9px; color: #344d62; }
#footer_actions { display: flex; }
.footer_button { min-width: 86px; margin-left: 6px; }
.footer_button.danger:hover, .footer_button.danger:focus { border-color: #ef6870; background-color: rgba(178,47,58,0.28); }

@media (max-width: 1180px) {
    #right_panel { display: none; }
    #account_cluster { width: 260px; }
    .account_copy { width: 150px; }
    #hunter_caption { left: 55%; }
}

@media (max-width: 900px) {
    #brand { width: 235px; }
    .brand_subtitle { display: none; }
    .nav { min-width: 92px; padding-left: 12px; padding-right: 12px; font-size: 15px; }
    #account_cluster { width: 170px; }
    .account_copy { display: none; }
    #activity_panel { left: 22px; width: 360px; }
    .activity, #activity_status, #deploy { width: 360px; }
    #hunter_caption { display: none; }
}
