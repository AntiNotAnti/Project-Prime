<rml>
<head>
    <title>Project Prime</title>
    <link type="text/rcss" href="prime_home.rcss" />
</head>
<body data-model="prime_menu">
    <div id="screen" data-class-reduce-motion="reduce_motion" data-class-social-open="social_open">
        <!-- Background grading, vignette, halo and floor contact now live
             below the Hunter in the native GL stage pass. Keeping them out of
             RmlUi prevents a translucent wash from flattening the character. -->
        <div id="top_rule"></div>

        <div id="topbar" class="enter_top">
            <div id="brand">
                <div id="brand_mark">P</div>
                <div id="brand_copy">
                    <div class="brand_title">PROJECT PRIME</div>
                    <div class="brand_subtitle">HUNTERS ONLINE</div>
                </div>
            </div>

            <div id="primary_nav">
                <button id="nav_play" class="nav active" data-event-click="noop">PLAY</button>
                <button id="nav_hunters" class="nav" data-event-click="nav_hunters">HUNTERS</button>
                <button id="nav_community" class="nav" data-event-click="nav_community">COMMUNITY</button>
                <button id="nav_studio" class="nav" data-event-click="nav_studio">STUDIO</button>
            </div>

            <div id="account_cluster">
                <div class="online_dot"></div>
                <div class="account_copy">
                    <div class="account_name">{{player_name}}</div>
                    <div class="account_meta">{{profile_state}}</div>
                </div>
                <button id="social" class="utility social_button" data-event-click="open_social">
                    SOCIAL <span class="social_badge" data-if="social_badge != ''">{{social_badge}}</span>
                </button>
                <button id="profile" class="utility" data-event-click="open_profile">PROFILE</button>
            </div>
        </div>

        <div id="stage">
            <div id="activity_panel" class="enter_left">
                <div class="eyebrow">SELECT ACTIVITY</div>
                <div id="activity_title">{{activity_title}}</div>
                <div id="activity_description">{{activity_description}}</div>

                <div id="activity_list">
                    <button id="mode_quick" class="activity" data-class-selected="activity_index == 0"
                            data-event-click="select_quick">
                        <span class="activity_code">01</span>
                        <span class="activity_copy">
                            <span class="activity_name">QUICK PLAY</span>
                            <span class="activity_meta">Find the best compatible public hunt</span>
                        </span>
                        <span class="activity_arrow">›</span>
                    </button>
                    <button id="mode_browser" class="activity" data-class-selected="activity_index == 1"
                            data-event-click="select_browser">
                        <span class="activity_code">02</span>
                        <span class="activity_copy">
                            <span class="activity_name">SERVER BROWSER</span>
                            <span class="activity_meta">Browse live lobbies and arenas</span>
                        </span>
                        <span class="activity_arrow">›</span>
                    </button>
                    <button id="mode_offline" class="activity" data-class-selected="activity_index == 2"
                            data-event-click="select_offline">
                        <span class="activity_code">03</span>
                        <span class="activity_copy">
                            <span class="activity_name">OFFLINE BATTLE</span>
                            <span class="activity_meta">Bots, training and local rules</span>
                        </span>
                        <span class="activity_arrow">›</span>
                    </button>
                    <button id="mode_adventure" class="activity" data-class-selected="activity_index == 3"
                            data-event-click="select_adventure">
                        <span class="activity_code">04</span>
                        <span class="activity_copy">
                            <span class="activity_name">ADVENTURE</span>
                            <span class="activity_meta">Continue a solo save</span>
                        </span>
                        <span class="activity_arrow">›</span>
                    </button>
                </div>

                <div id="activity_status">
                    <span>{{activity_hint}}</span>
                    <span class="ready">READY</span>
                </div>
                <button id="deploy" data-event-click="deploy">
                    <span class="deploy_kicker">PROJECT PRIME ACTIVITY</span>
                    <span class="deploy_label">{{activity_action}}</span>
                    <span class="deploy_arrow">→</span>
                </button>
            </div>

            <div id="hunter_caption" class="enter_hunter">
                <div class="hunter_rule"></div>
                <div>
                    <div class="eyebrow">ACTIVE HUNTER</div>
                    <div id="hunter_name">{{hunter_name}}</div>
                    <div id="hunter_meta">SELECTED LOADOUT</div>
                </div>
            </div>

            <div id="session_panel" class="enter_right">
                <div class="session_header">
                    <div class="eyebrow">CURRENT SESSION</div>
                    <div class="session_state">SOLO</div>
                </div>
                <div class="session_player">
                    <div class="session_badge">P</div>
                    <div class="session_copy">
                        <div class="session_name">{{player_name}}</div>
                        <div class="session_meta">{{hunter_name}} // READY</div>
                    </div>
                </div>
                <div class="session_friends_header">
                    <span>FRIENDS ONLINE</span>
                    <span class="session_online_count">{{social_friend_count}}</span>
                </div>
                <div class="home_friend" data-for="friend : home_friends">
                    <span class="friend_dot"></span>
                    <span class="home_friend_copy">
                        <span class="home_friend_name">{{friend.name}}</span>
                        <span class="home_friend_state">{{friend.activity}}<span data-if="friend.detail != ''"> // {{friend.detail}}</span></span>
                    </span>
                </div>
                <div class="session_empty" data-if="home_friends.size == 0">NO FRIENDS ONLINE</div>
                <button id="home_social" class="session_social" data-event-click="open_social">OPEN SOCIAL</button>
                <div class="session_hint">SOCIAL JOINS VERIFY THE LIVE SERVER BEFORE DEPLOYMENT.</div>
            </div>
        </div>

        <div id="social_backdrop" data-class-open="social_open">
            <button id="social_scrim" data-event-click="close_social"></button>
            <div id="social_drawer" class="enter_social">
                <div class="social_header">
                    <div>
                        <div class="eyebrow">PROJECT PRIME NETWORK</div>
                        <div class="social_title">SOCIAL</div>
                    </div>
                    <button id="social_close" class="social_icon_button" data-event-click="close_social">×</button>
                </div>

                <div class="social_tabs">
                    <button id="social_tab_friends" class="social_tab"
                            data-class-selected="social_tab == 0"
                            data-event-click="social_friends">
                        FRIENDS <span class="social_tab_count">{{social_friend_count}}</span>
                    </button>
                    <button id="social_tab_players" class="social_tab"
                            data-class-selected="social_tab == 1"
                            data-event-click="social_players">
                        PLAYERS <span class="social_tab_count">{{social_online_count}}</span>
                    </button>
                    <button id="social_tab_requests" class="social_tab"
                            data-class-selected="social_tab == 2"
                            data-event-click="social_requests">
                        REQUESTS <span class="social_tab_count">{{social_request_count}}</span>
                    </button>
                    <button id="social_tab_invites" class="social_tab"
                            data-class-selected="social_tab == 3"
                            data-event-click="social_invites">
                        INVITES <span class="social_tab_count">{{social_invite_count}}</span>
                    </button>
                </div>

                <div class="social_notice" data-if="social_notice != ''">{{social_notice}}</div>

                <div class="social_search_row">
                    <input id="social_search" type="text" maxlength="48"
                           data-value="social_search"
                           placeholder="Filter visible players or paste a Prime ID" />
                    <button id="social_filter" class="social_filter_button"
                            data-event-click="social_filter">FILTER</button>
                </div>

                <div class="social_statebar">
                    <span class="social_state_dot" data-class-loading="social_loading"></span>
                    <span>{{social_status}}</span>
                    <span class="social_ttl">45S TTL</span>
                </div>

                <div id="social_list">
                    <div class="social_empty" data-if="social_rows.size == 0 && !social_loading">
                        <div class="social_empty_title">NO HUNTERS HERE</div>
                        <div class="social_empty_copy">Try another tab, clear the filter, or refresh the social service.</div>
                    </div>

                    <button class="social_row" data-for="row : social_rows"
                            data-event-click="social_select(row.prime_id, row.invite_id)">
                        <span class="social_presence_dot" data-class-online="row.online"></span>
                        <span class="social_row_copy">
                            <span class="social_row_top">
                                <span class="social_row_name">{{row.name}}</span>
                                <span class="social_relation">{{row.relation}}</span>
                            </span>
                            <span class="social_row_meta">{{row.activity}}<span data-if="row.detail != ''"> // {{row.detail}}</span></span>
                            <span class="social_row_id">{{row.prime_id}}</span>
                        </span>
                        <span class="social_row_more">•••</span>
                    </button>
                </div>

                <div class="social_footer">
                    <button id="social_blocks" class="social_footer_button"
                            data-class-selected="social_tab == 4"
                            data-event-click="social_blocks">MANAGE BLOCKS</button>
                    <button id="social_refresh" class="social_footer_button"
                            data-event-click="social_refresh">REFRESH</button>
                </div>

                <div id="social_context" data-class-open="social_context_open">
                    <div class="social_context_header">
                        <div>
                            <div class="eyebrow">HUNTER ACTIONS</div>
                            <div class="social_context_name">{{selected_name}}</div>
                            <div class="social_context_id">{{selected_prime_id}}</div>
                        </div>
                        <button id="social_context_close" class="social_icon_button" data-event-click="social_context_close">×</button>
                    </div>
                    <div class="social_context_state">{{selected_activity}}<span data-if="selected_detail != ''"> // {{selected_detail}}</span></div>
                    <div class="social_context_actions">
                        <button class="social_action primary" data-if="selected_can_join" data-event-click="social_join_friend">JOIN FRIEND</button>
                        <button class="social_action primary" data-if="selected_can_invite" data-event-click="social_invite_friend">INVITE TO LOBBY</button>
                        <button class="social_action primary" data-if="selected_can_accept_invite" data-event-click="social_accept_invite">ACCEPT GAME INVITE</button>
                        <button class="social_action" data-if="selected_can_decline_invite" data-event-click="social_decline_invite">DECLINE GAME INVITE</button>
                        <button class="social_action" data-if="selected_can_cancel_invite" data-event-click="social_cancel_invite">CANCEL GAME INVITE</button>
                        <button class="social_action primary" data-if="selected_can_add" data-event-click="social_add">ADD FRIEND</button>
                        <button class="social_action primary" data-if="selected_can_accept" data-event-click="social_accept">ACCEPT REQUEST</button>
                        <button class="social_action" data-if="selected_can_decline" data-event-click="social_decline">DECLINE</button>
                        <button class="social_action" data-if="selected_can_cancel" data-event-click="social_cancel">CANCEL REQUEST</button>
                        <button class="social_action" data-if="selected_can_remove" data-event-click="social_remove">REMOVE FRIEND</button>
                        <button class="social_action danger" data-if="selected_can_block" data-event-click="social_block">BLOCK PLAYER</button>
                        <button class="social_action primary" data-if="selected_can_unblock" data-event-click="social_unblock">UNBLOCK PLAYER</button>
                    </div>
                    <div class="social_context_note">JOIN TARGETS ARE RE-VERIFIED AGAINST THE PUBLIC DIRECTORY AND LIVE SERVER AUTHORITY BEFORE CONNECTION.</div>
                </div>
            </div>
        </div>

        <div id="diagnostics_panel" data-class-open="diagnostics_visible">
            <div class="diag_header">
                <span>UI DIAGNOSTICS</span>
                <span class="diag_key">F10</span>
            </div>
            <div class="diag_row"><span>LIBRARY</span><b>RMLUI 6.3</b></div>
            <div class="diag_row"><span>RENDERER</span><b>{{renderer_name}}</b></div>
            <div class="diag_row"><span>GAME DATA</span><b>{{game_data_state}}</b></div>
            <div class="diag_row"><span>SUBMIT</span><b>{{ui_cost}}</b></div>
        </div>

        <div id="footerbar" class="enter_bottom">
            <div id="build_info">
                <span class="blue">BUILD {{build_version}}</span>
                <span class="divider">//</span>
                <span>PROJECT PRIME CLIENT</span>
            </div>
            <div id="footer_actions">
                <button class="footer_button" data-event-click="open_classic">NEWS</button>
                <button class="footer_button" data-event-click="open_settings">SETTINGS</button>
                <button class="footer_button danger" data-event-click="quit_game">QUIT</button>
            </div>
        </div>
    </div>
</body>
</rml>
