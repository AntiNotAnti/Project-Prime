<rml>
<head>
    <title>Project Prime</title>
    <link type="text/rcss" href="prime_home.rcss" />
</head>
<body data-model="prime_menu">
    <div id="screen" data-class-reduce-motion="reduce_motion">
        <div id="top_rule"></div>

        <div id="topbar" class="enter_top">
            <div id="brand">
                <div id="brand_mark">P</div>
                <div id="brand_copy">
                    <div class="brand_title">PROJECT PRIME</div>
                    <div class="brand_subtitle">HUNTERS ONLINE</div>
                </div>
            </div>

            <div id="primary_nav">
                <button id="nav_play" class="nav active" data-event-click="noop">PLAY</button>
                <button id="nav_hunters" class="nav" data-event-click="nav_hunters">HUNTERS</button>
                <button id="nav_community" class="nav" data-event-click="nav_community">COMMUNITY</button>
                <button id="nav_studio" class="nav" data-event-click="nav_studio">STUDIO</button>
            </div>

            <div id="account_cluster">
                <div class="online_dot"></div>
                <div class="account_copy">
                    <div class="account_name">{{player_name}}</div>
                    <div class="account_meta">{{profile_state}}</div>
                </div>
                <button id="profile" class="utility" data-event-click="open_profile">PROFILE</button>
            </div>
        </div>

        <div id="stage">
            <div id="activity_panel" class="enter_left">
                <div id="activity_compact" data-class-hidden="activity_selector_open">
                    <div class="eyebrow">{{activity_group}}</div>

                    <button id="activity_selector" data-event-click="toggle_activity_selector">
                        <span class="selector_art">
                            <span class="selector_art_label">MODE</span>
                        </span>
                        <span class="selector_copy">
                            <span class="selector_title">{{activity_title}}</span>
                            <span class="selector_meta">{{activity_description}}</span>
                            <span class="selector_hint">{{activity_hint}}</span>
                        </span>
                        <span class="selector_change">
                            <span class="selector_change_label">CHANGE</span>
                            <span class="selector_change_arrow">V</span>
                        </span>
                    </button>

                    <div id="activity_status">
                        <span>{{activity_hint}}</span>
                        <span class="ready">READY</span>
                    </div>

                    <button id="deploy" data-event-click="deploy">
                        <span class="deploy_kicker">{{activity_group}} ACTIVITY</span>
                        <span class="deploy_label">{{activity_action}}</span>
                        <span class="deploy_arrow">→</span>
                    </button>
                </div>

                <div id="activity_drawer" data-class-open="activity_selector_open">
                    <div class="drawer_header">
                        <div>
                            <div class="eyebrow">PLAY</div>
                            <div class="drawer_title">CHOOSE ACTIVITY</div>
                        </div>
                        <button id="drawer_close" data-event-click="close_activity_selector">CLOSE</button>
                    </div>

                    <div class="drawer_section">MULTIPLAYER</div>
                    <button id="drawer_quick" class="drawer_item"
                            data-class-selected="activity_index == 0"
                            data-event-mouseover="preview_quick"
                            data-event-focus="preview_quick"
                            data-event-click="select_quick">
                        <span class="drawer_code">01</span>
                        <span class="drawer_copy">
                            <span class="drawer_name">QUICK PLAY</span>
                            <span class="drawer_meta">Automatic public matchmaking</span>
                        </span>
                        <span class="drawer_state" data-if="activity_index == 0">ACTIVE</span>
                        <span class="drawer_arrow">›</span>
                    </button>

                    <button id="drawer_browser" class="drawer_item"
                            data-class-selected="activity_index == 1"
                            data-event-mouseover="preview_browser"
                            data-event-focus="preview_browser"
                            data-event-click="select_browser">
                        <span class="drawer_code">02</span>
                        <span class="drawer_copy">
                            <span class="drawer_name">SERVER BROWSER</span>
                            <span class="drawer_meta">Browse public and private sessions</span>
                        </span>
                        <span class="drawer_state" data-if="activity_index == 1">ACTIVE</span>
                        <span class="drawer_arrow">›</span>
                    </button>

                    <div class="drawer_section">LOCAL</div>
                    <button id="drawer_offline" class="drawer_item"
                            data-class-selected="activity_index == 2"
                            data-event-mouseover="preview_offline"
                            data-event-focus="preview_offline"
                            data-event-click="select_offline">
                        <span class="drawer_code">03</span>
                        <span class="drawer_copy">
                            <span class="drawer_name">OFFLINE BATTLE</span>
                            <span class="drawer_meta">Bots, training and custom rules</span>
                        </span>
                        <span class="drawer_state" data-if="activity_index == 2">ACTIVE</span>
                        <span class="drawer_arrow">›</span>
                    </button>

                    <div class="drawer_section">SOLO</div>
                    <button id="drawer_adventure" class="drawer_item"
                            data-class-selected="activity_index == 3"
                            data-event-mouseover="preview_adventure"
                            data-event-focus="preview_adventure"
                            data-event-click="select_adventure">
                        <span class="drawer_code">04</span>
                        <span class="drawer_copy">
                            <span class="drawer_name">ADVENTURE</span>
                            <span class="drawer_meta">Continue or load a solo save</span>
                        </span>
                        <span class="drawer_state" data-if="activity_index == 3">ACTIVE</span>
                        <span class="drawer_arrow">›</span>
                    </button>

                    <div class="drawer_footer">
                        HOVER OR FOCUS TO PREVIEW THE MENU STAGE // SELECT TO CONFIRM
                    </div>
                </div>
            </div>

            <div id="hunter_caption" class="enter_hunter">
                <div class="hunter_rule"></div>
                <div>
                    <div class="eyebrow">ACTIVE HUNTER</div>
                    <div id="hunter_name">{{hunter_name}}</div>
                    <div id="hunter_meta">SELECTED LOADOUT</div>
                </div>
            </div>

            <div id="session_panel" class="enter_right">
                <div class="session_header">
                    <div class="eyebrow">CURRENT SESSION</div>
                    <div class="session_state">SOLO</div>
                </div>
                <div class="session_player">
                    <div class="session_badge">P</div>
                    <div class="session_copy">
                        <div class="session_name">{{player_name}}</div>
                        <div class="session_meta">{{hunter_name}} // READY</div>
                    </div>
                </div>
                <div class="session_slot">
                    <span class="plus">+</span>
                    <span>OPEN PARTY SLOT</span>
                </div>
                <div class="session_hint">PARTY CONTROLS APPEAR AFTER JOINING OR CREATING A LOBBY.</div>
            </div>
        </div>

        <div id="diagnostics_panel" data-class-open="diagnostics_visible">
            <div class="diag_header">
                <span>UI DIAGNOSTICS</span>
                <span class="diag_key">F10</span>
            </div>
            <div class="diag_row"><span>LIBRARY</span><b>RMLUI 6.3</b></div>
            <div class="diag_row"><span>RENDERER</span><b>{{renderer_name}}</b></div>
            <div class="diag_row"><span>GAME DATA</span><b>{{game_data_state}}</b></div>
            <div class="diag_row"><span>SUBMIT</span><b>{{ui_cost}}</b></div>
        </div>

        <div id="footerbar" class="enter_bottom">
            <div id="build_info">
                <span class="blue">BUILD {{build_version}}</span>
                <span class="divider">//</span>
                <span>PROJECT PRIME CLIENT</span>
            </div>
            <div id="footer_actions">
                <button class="footer_button" data-event-click="open_classic">NEWS</button>
                <button class="footer_button" data-event-click="open_settings">SETTINGS</button>
                <button class="footer_button danger" data-event-click="quit_game">QUIT</button>
            </div>
        </div>
    </div>
</body>
</rml>
