<template name="prime-shell" content="stage">
    <head>
        <link type="text/rcss" href="../themes/prime.rcss" />
        <link type="text/rcss" href="controls.rcss" />
        <link type="text/rcss" href="app-shell.rcss" />
    </head>
    <body>
        <div id="screen" data-prime-class-reduce-motion="reduce_motion" data-prime-class-lobby="lobby_mode">
            <div id="top_rule" />
            <div id="topbar" class="enter_top">
                <div id="brand">
                    <div id="brand_copy">
                        <div class="brand_title">PROJECT PRIME</div>
                        <div class="brand_subtitle">HUNTERS ONLINE</div>
                    </div>
                </div>
                <div id="primary_nav">
                    <button id="nav_play" class="nav" data-action="route:home">PLAY</button>
                    <button id="nav_hunters" class="nav" data-action="hunter:open">HUNTERS</button>
                    <button id="nav_community" class="nav" data-action="route:forge">COMMUNITY</button>
                    <button id="nav_studio" class="nav" data-action="studio:open">STUDIO</button>
                </div>
                <div id="account_cluster">
                    <button id="profile" class="utility" data-action="route:hunter" data-prime-text="{{player_name}}">PROFILE</button>
                    <button id="header_settings" class="utility" data-action="route:settings">SETTINGS</button>
                    <button id="notice_button" class="utility" data-action="notice:toggle" aria-label="Open notifications" title="Notifications">
                        <span id="notice_bell_icon"><span id="notice_bell_clapper" /></span><span class="notice_button_text">ALERTS</span><span id="notice_badge" data-prime-visible="notice_unread_visible" data-prime-text="{{notice_unread_count}}" />
                    </button>
                </div>
            </div>
            <div id="stage">
            </div>
            <div id="notice_panel" data-prime-visible="notice_open">
                <div class="notice_heading"><span>NOTIFICATION CENTER</span><button id="notice_close" data-action="notice:close" aria-label="Close notifications">CLOSE ×</button></div>
                <p class="notice_caption">Release updates, social activity, and system alerts.</p>
                <div id="notice_empty" data-prime-visible="notice_empty">YOU'RE ALL CAUGHT UP</div>
                <div id="notice_0" class="notice_entry" data-prime-visible="notice_0_visible">
                    <div class="notice_entry_top"><span id="notice_0_type" data-prime-text="{{notice_0_type}}" /><span id="notice_0_dot" data-prime-visible="notice_0_unread">NEW</span></div>
                    <div class="notice_entry_title" id="notice_0_title" data-prime-text="{{notice_0_title}}" />
                    <p id="notice_0_message" data-prime-text="{{notice_0_message}}" />
                    <div class="notice_entry_actions"><button id="notice_0_open" data-prime-visible="notice_0_action_visible" data-action="notice:open:0"><span id="notice_0_action" data-prime-text="{{notice_0_action}}" /></button><button id="notice_0_dismiss" data-action="notice:dismiss:0">DISMISS</button></div>
                </div>
                <div id="notice_1" class="notice_entry" data-prime-visible="notice_1_visible">
                    <div class="notice_entry_top"><span id="notice_1_type" data-prime-text="{{notice_1_type}}" /><span id="notice_1_dot" data-prime-visible="notice_1_unread">NEW</span></div>
                    <div class="notice_entry_title" id="notice_1_title" data-prime-text="{{notice_1_title}}" />
                    <p id="notice_1_message" data-prime-text="{{notice_1_message}}" />
                    <div class="notice_entry_actions"><button id="notice_1_open" data-prime-visible="notice_1_action_visible" data-action="notice:open:1"><span id="notice_1_action" data-prime-text="{{notice_1_action}}" /></button><button id="notice_1_dismiss" data-action="notice:dismiss:1">DISMISS</button></div>
                </div>
                <div id="notice_2" class="notice_entry" data-prime-visible="notice_2_visible">
                    <div class="notice_entry_top"><span id="notice_2_type" data-prime-text="{{notice_2_type}}" /><span id="notice_2_dot" data-prime-visible="notice_2_unread">NEW</span></div>
                    <div class="notice_entry_title" id="notice_2_title" data-prime-text="{{notice_2_title}}" />
                    <p id="notice_2_message" data-prime-text="{{notice_2_message}}" />
                    <div class="notice_entry_actions"><button id="notice_2_open" data-prime-visible="notice_2_action_visible" data-action="notice:open:2"><span id="notice_2_action" data-prime-text="{{notice_2_action}}" /></button><button id="notice_2_dismiss" data-action="notice:dismiss:2">DISMISS</button></div>
                </div>
                <div id="notice_3" class="notice_entry" data-prime-visible="notice_3_visible">
                    <div class="notice_entry_top"><span id="notice_3_type" data-prime-text="{{notice_3_type}}" /><span id="notice_3_dot" data-prime-visible="notice_3_unread">NEW</span></div>
                    <div class="notice_entry_title" id="notice_3_title" data-prime-text="{{notice_3_title}}" />
                    <p id="notice_3_message" data-prime-text="{{notice_3_message}}" />
                    <div class="notice_entry_actions"><button id="notice_3_open" data-prime-visible="notice_3_action_visible" data-action="notice:open:3"><span id="notice_3_action" data-prime-text="{{notice_3_action}}" /></button><button id="notice_3_dismiss" data-action="notice:dismiss:3">DISMISS</button></div>
                </div>
            </div>
            <div id="system_status_toast" role="status" aria-live="polite" data-prime-text="{{system_status}}" />
            <div id="diagnostics_panel" data-prime-class-open="diagnostics_visible">
                <div class="diag_header">
                    <span>UI DIAGNOSTICS</span>
                    <span class="diag_key">F10</span>
                </div>
                <div class="diag_row">
                    <span>LIBRARY</span>
                    <b>RMLUI 6.3</b>
                </div>
                <div class="diag_row">
                    <span>RENDERER</span>
                    <b data-prime-text="{{renderer_name}}" id="text_renderer_name_1" />
                </div>
                <div class="diag_row">
                    <span>GAME DATA</span>
                    <b data-prime-text="{{game_data_state}}" id="text_game_data_state_1" />
                </div>
                <div class="diag_row">
                    <span>SUBMIT</span>
                    <b data-prime-text="{{ui_cost}}" id="text_ui_cost_1" />
                </div>
                <div class="diag_row"><span>INPUT</span><b id="input_debug" data-prime-text="{{input_debug}}" /></div>
            </div>
            <div id="footerbar" class="enter_bottom">
                <div id="build_info">
                    <button id="build_button" data-action="notice:versions" data-prime-class-available="notice_update_available" title="Open published versions">
                        <span class="blue" data-prime-text="BUILD {{build_version}}" id="build_version" />
                        <span id="build_alert" data-prime-visible="notice_update_available">UPDATE AVAILABLE &#8250;</span>
                    </button>
                    <span class="divider">//</span>
                    <span id="client_label">PROJECT PRIME CLIENT</span>
                </div>
                <div id="footer_actions" data-prime-visible="home_mode">
                    <button id="footer_quit" class="footer_button danger" data-action="quit">QUIT</button>
                </div>
                <div id="lobby_footer_state" data-prime-visible="lobby_mode" data-prime-text="{{lobby_status}}" />
            </div>
        </div>
    </body>
</template>
