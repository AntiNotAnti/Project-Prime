<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MphReadServer=true builds the dedicated-server package: no launcher of
         either kind and no UI toolkit. A bare invocation prints server usage;
         actually running a game server requires the user's extracted game data
         and paths.txt because the server simulates the authoritative world. It
         is what the Pi and the Windows server downloads are published with.

         One framework for every target. Native game clients and the separate
         Studio engine projection both use the portable desktop TFM. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- A console binary everywhere except a Windows game build, which is a GUI
         one: double-clicking it has to open the launcher and nothing else, and
         a console subsystem process gets a terminal before Main can hide it.
         Mods/ConsoleWindow attaches or allocates one for command-line runs. -->
    <MphReadWindowsUi Condition="$(RuntimeIdentifier.StartsWith('win')) and '$(MphReadServer)' != 'true'">true</MphReadWindowsUi>
    <OutputType Condition="'$(MphReadWindowsUi)' != 'true'">Exe</OutputType>
    <OutputType Condition="'$(MphReadWindowsUi)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(MphReadStudioEngine)' == 'true'">Library</OutputType>
    <!-- On Windows the server needs a second, differently named executable.

         Windows bakes the subsystem into the PE header at link time, so a GUI
         binary cannot be talked into behaving like a console one: cmd and
         PowerShell do not wait for it, its exit code never reaches
         %ERRORLEVEL%, and a service supervisor cannot tell whether it is
         still up. Those are the three things a dedicated server is made of, so
         it gets a binary whose header says console, and a name of its own so
         that it can sit next to the game's in one folder.

           dotnet publish -r win-x64 -p:MphReadServer=true
             produces ProjectPrimeServer.exe

         Only on Windows. Elsewhere the subsystem does not exist, the server
         package holds exactly one binary, and renaming it would mean a Pi that
         has been running MphRead under systemd since before this change gets a
         second binary beside the one its unit still points at. -->
    <!-- The public product is Project Prime. The C# namespace remains MphRead
         for upstream compatibility; the assembly, binary and package identities
         intentionally use the Project Prime name after the product migration. -->
    <AssemblyName>ProjectPrime</AssemblyName>
    <AssemblyName Condition="'$(MphReadServer)' == 'true' and $(RuntimeIdentifier.StartsWith('win'))">ProjectPrimeServer</AssemblyName>
    <Product>Project Prime</Product>
    <!-- A local build must not masquerade as the SDK's default 1.0.0 release. -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">local</InformationalVersion>
    <RootNamespace>MphRead</RootNamespace>
    <!-- Not the same question as "has no launcher": server packages never
         contain Nintendo game data, but an operator supplies extracted files
         through paths.txt. A bare invocation therefore prints server-specific
         setup/usage instead of opening the client setup flow. -->
    <DefineConstants Condition="'$(MphReadServer)' == 'true'">$(DefineConstants);MPHREAD_SERVER</DefineConstants>
    <!-- Accepted game clients use the engine-native documents. The separate
         Studio product and an explicit MphReadAvalonia=true compatibility build
         retain their toolkit dependencies. Server builds contain neither UI. -->
    <MphReadClientRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MphReadClientRid>
    <MphReadClientRid Condition="'$(MphReadClientRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</MphReadClientRid>
    <MphReadNativeDefault Condition="'$(MphReadServer)' != 'true' and '$(MphReadStudioEngine)' != 'true'">true</MphReadNativeDefault>
    <MphReadRmlUi Condition="'$(MphReadRmlUi)' == '' and '$(MphReadNativeDefault)' == 'true'">true</MphReadRmlUi>
    <MphReadRmlUi Condition="'$(MphReadRmlUi)' == ''">false</MphReadRmlUi>
    <MphReadAvalonia Condition="'$(MphReadAvalonia)' == '' and '$(MphReadNativeDefault)' == 'true'">false</MphReadAvalonia>
    <MphReadAvalonia Condition="'$(MphReadAvalonia)' == '' and '$(MphReadServer)' != 'true'">true</MphReadAvalonia>
    <DefineConstants Condition="'$(MphReadAvalonia)' == 'true'">$(DefineConstants);MPHREAD_AVALONIA;MPHREAD_SHELL</DefineConstants>
    <MphReadRmlUiPoc Condition="'$(MphReadRmlUiPoc)' == ''">false</MphReadRmlUiPoc>
    <MphReadRmlUiEnabled Condition="('$(MphReadRmlUi)' == 'true' or '$(MphReadRmlUiPoc)' == 'true') and '$(MphReadServer)' != 'true'">true</MphReadRmlUiEnabled>
    <DefineConstants Condition="'$(MphReadRmlUi)' == 'true' and '$(MphReadServer)' != 'true'">$(DefineConstants);MPHREAD_RMLUI</DefineConstants>
    <DefineConstants Condition="'$(MphReadRmlUiEnabled)' == 'true'">$(DefineConstants);MPHREAD_RMLUI_POC</DefineConstants>
    <!-- The ordinary game client has no toolkit dependency. An explicit
         compatibility build remains available for previous-version recovery. -->
    <MphReadNativeClient Condition="'$(MphReadAvalonia)' == 'false' and '$(MphReadRmlUi)' == 'true' and '$(MphReadServer)' != 'true'">true</MphReadNativeClient>
    <DefineConstants Condition="'$(MphReadNativeClient)' == 'true'">$(DefineConstants);MPHREAD_SHELL</DefineConstants>
    <!-- Project Prime shell identity for Explorer, the taskbar and pinned
         shortcuts. The dedicated server keeps a small badge so it is visually
         distinct from the game client. Runtime GL windows still use the
         embedded PNG mark below. -->
    <ApplicationIcon Condition="$(RuntimeIdentifier.StartsWith('win')) and '$(MphReadServer)' != 'true'">Assets\project-prime.ico</ApplicationIcon>
    <ApplicationIcon Condition="$(RuntimeIdentifier.StartsWith('win')) and '$(MphReadServer)' == 'true'">Assets\project-prime-server.ico</ApplicationIcon>
    <PublishSingleFile Condition="'$(MphReadStudioEngine)' != 'true'">true</PublishSingleFile>
    <PublishSingleFile Condition="'$(MphReadStudioEngine)' == 'true'">false</PublishSingleFile>
    <!-- Dedicated servers spend their first seconds loading/JITing the exact
         combat paths every isolated match process will use. Crossgen those
         packages ahead of time; game/client builds stay unchanged. -->
    <PublishReadyToRun Condition="'$(MphReadServer)' == 'true'">true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <!-- The launcher's screens are drawn into the game window through an
         ITopLevelImpl of our own (Mods/Launcher/Gui/UiTopLevel.cs), which is
         the supported way to put Avalonia inside somebody else's frame and is
         the difference between a menu that scrolls and one that does not: the
         toolkit's headless backend allocates and frees a full-window bitmap
         per redraw and forces two extra rasterisations per input event.

         Avalonia ships reference assemblies that hide the platform interfaces,
         so implementing one needs this switch, which is Avalonia's own. It
         also pins us to an exact version: these interfaces are allowed to
         change between releases, so the Avalonia PackageReferences above are
         exact versions and not ranges, and bumping them means rebuilding
         against the new shape rather than hoping. AVA3001 is the warning that
         says so and is expected. -->
    <AvaloniaAccessUnstablePrivateApis Condition="'$(MphReadAvalonia)' == 'true'">true</AvaloniaAccessUnstablePrivateApis>
    <!-- AVA3001 is the notice the switch above prints on every build: "you are
         using unstable internal APIs". It is saying something true and it has
         been acted on rather than waved away, which is what the exact version
         pins are for: bumping Avalonia means rebuilding against the new shape
         of ITopLevelImpl and IRenderTimer, deliberately. Silenced because the
         build has no other warnings and one that fires unconditionally is one
         that teaches people to stop reading them. -->
    <NoWarn Condition="'$(MphReadAvalonia)' == 'true'">$(NoWarn);AVA3001</NoWarn>
  </PropertyGroup>

  <!-- Mods\Launcher\Gui\ is the front screen and every window behind it, in
       Avalonia. Mods\Launcher\Portable\ is the half of the launcher that is
       just logic: preferences, game-file setup, what a launch consists of, and
       the text front screen that stands in for the window where there is no
       display. Only builds that declared the toolkit get the packages, so a
       server build never restores Avalonia and never carries it. -->
  <PropertyGroup Condition="'$(MphReadAvalonia)' != 'true'">
    <!-- A previously restored compatibility graph may still import the
         toolkit's default item targets before the next native restore. -->
    <AvaloniaIncludeApplicationIconAsWindowIcon>false</AvaloniaIncludeApplicationIconAsWindowIcon>
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
  </PropertyGroup>
  <ItemGroup Condition="'$(MphReadAvalonia)' != 'true'">
    <AvaloniaResource Remove="@(AvaloniaResource)" />
    <AvaloniaXaml Remove="@(AvaloniaXaml)" />
    <Compile Remove="Mods\Launcher\Gui\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(MphReadNativeClient)' == 'true'">
    <!-- Native engine adapters contain no toolkit types. Both compile paths
         reuse the same page presenters and Core/session authorities. -->
    <Compile Include="Mods/Launcher/Gui/RmlUiPrototype.cs;Mods/Launcher/Gui/RmlMultiplayerController*.cs;Mods/Launcher/Gui/RmlLobbyRulesEditor.cs;Mods/Launcher/Gui/Shell.Navigation.cs;Mods/Launcher/Gui/Shell.Presentation.cs;Mods/Launcher/Gui/Shell.RmlUi*.cs" />
    <EmbeddedResource Include="Assets/project-prime-mark.png;Assets/Fonts/Roboto-Bold.ttf" />
  </ItemGroup>
  <ItemGroup Condition="'$(MphReadRmlUiEnabled)' != 'true'">
    <Compile Remove="Mods\Launcher\RmlUi\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MphReadAvalonia)' == 'true'">
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <!-- Desktop is still here for the platform's fonts, its Skia backend and
         the packages the render path pulls in; what it is no longer used for
         is a window. The launcher's screens are rendered by the *headless*
         backend into a buffer and drawn inside the game window
         (Mods/Render/UiOverlay.cs), so the program opens exactly one window on
         every platform and the launcher is a screen in the game rather than a
         second application beside it. -->
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- Loaded at runtime through avares://, Avalonia's own asset scheme: a
         plain EmbeddedResource is not visible to AssetLoader. The launcher wordmark is rendered in code; the mark is the window icon. -->
    <AvaloniaResource Include="Assets\project-prime-mark.png" />
    <!-- The same file again, as a plain embedded resource: the *window's*
         icon is set on the GL window, which knows nothing about avares:// and
         is created before the toolkit is. Mods/Render/WindowIcon.cs reads it.
         A few kilobytes, and the alternative is the launcher's icon existing
         only on a screen the program no longer opens. -->
    <EmbeddedResource Include="Assets\project-prime-mark.png" />
    <!-- The launcher's two faces and its backdrop: fonts from
         OpenQuake3/defrag's ui/font, whose UI this one is built to. -->
    <AvaloniaResource Include="Assets\Fonts\heyNovember.ttf" />
    <!-- JetBrains Mono, SIL OFL 1.1 (licence beside it). The deck theme's
         body face, and it is not interchangeable with the display one: the
         reference sets its labels, its headings and its wordmark in the pixel
         face and everything that is read (a mode name, a ping, a note under
         the foot) in a mono, because a pixel face at eleven points
         loses the difference between an "e" and an "o". Two weights, since
         400 and 700 are both used and a synthesised bold on a mono is a
         smear. -->
    <AvaloniaResource Include="Assets\Fonts\JetBrainsMono-Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\JetBrainsMono-Bold.ttf" />
    <!-- Squared tactical headings/controls; unmodified static faces, SIL OFL 1.1. -->
    <AvaloniaResource Include="Assets\Fonts\Rajdhani-SemiBold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Rajdhani-Bold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Rajdhani-OFL.txt" />
    <!-- IP-to-country ranges, so the browser can put a flag beside a server
         without asking a third party where every server you are looking at
         is. Built from DB-IP Lite (CC BY 4.0) by tools/build-ipcountry.py;
         the attribution the licence requires is on the Credits page. About a
         megabyte, which is the price of the question being answered offline. -->
    <AvaloniaResource Include="Assets\Geo\ipcountry.bin.gz" />
    <AvaloniaResource Include="Assets\Fonts\Roboto-Bold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Roboto-Bold.ttf" />
    <AvaloniaResource Include="Assets\Backgrounds\launcher-bg.png" />
  </ItemGroup>

  <PropertyGroup Condition="'$(MphReadRmlUiEnabled)' == 'true'">
    <MphReadRmlUiRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MphReadRmlUiRid>
    <MphReadRmlUiRid Condition="'$(MphReadRmlUiRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</MphReadRmlUiRid>
    <MphReadRmlUiNativeName Condition="$(MphReadRmlUiRid.StartsWith('win'))">ProjectPrime.RmlUi.Native.dll</MphReadRmlUiNativeName>
    <MphReadRmlUiNativeName Condition="$(MphReadRmlUiRid.StartsWith('osx'))">libProjectPrime.RmlUi.Native.dylib</MphReadRmlUiNativeName>
    <MphReadRmlUiNativeName Condition="$(MphReadRmlUiRid.StartsWith('linux'))">libProjectPrime.RmlUi.Native.so</MphReadRmlUiNativeName>
    <MphReadRmlUiNativeDirectory>$(MSBuildProjectDirectory)/../../artifacts/rmlui-native/$(MphReadRmlUiRid)</MphReadRmlUiNativeDirectory>
    <MphReadRmlUiNativePath>$(MphReadRmlUiNativeDirectory)/$(MphReadRmlUiNativeName)</MphReadRmlUiNativePath>
    <MphReadRmlUiPython Condition="$([MSBuild]::IsOSPlatform('Windows'))">python</MphReadRmlUiPython>
    <MphReadRmlUiPython Condition="'$(MphReadRmlUiPython)' == ''">python3</MphReadRmlUiPython>
  </PropertyGroup>

  <ItemGroup Condition="'$(MphReadRmlUiEnabled)' == 'true'">
    <!-- Keep the native library and its matched document/font payload beside
         single-file hosts, where the native bootstrap can resolve them. -->
    <None Remove="Mods/Launcher/RmlUi/Assets/**/*" />
    <None Include="Mods/Launcher/RmlUi/Assets/**/*"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          TargetPath="rmlui/%(RecursiveDir)%(Filename)%(Extension)" ExcludeFromSingleFile="true" />
    <None Remove="Mods/Launcher/RmlUi/Pages/**/*;Mods/Launcher/RmlUi/Components/**/*;Mods/Launcher/RmlUi/Themes/**/*" />
    <None Include="Mods/Launcher/RmlUi/Pages/**/*.rml;Mods/Launcher/RmlUi/Pages/**/*.rcss"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          TargetPath="rmlui/pages/%(RecursiveDir)%(Filename)%(Extension)" ExcludeFromSingleFile="true" />
    <None Include="Mods/Launcher/RmlUi/Components/**/*.rml;Mods/Launcher/RmlUi/Components/**/*.rcss"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          TargetPath="rmlui/components/%(RecursiveDir)%(Filename)%(Extension)" ExcludeFromSingleFile="true" />
    <None Include="Mods/Launcher/RmlUi/Themes/**/*.rcss"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          TargetPath="rmlui/themes/%(RecursiveDir)%(Filename)%(Extension)" ExcludeFromSingleFile="true" />
    <None Update="Assets/Fonts/Rajdhani-SemiBold.ttf;Assets/Fonts/Rajdhani-Bold.ttf;Assets/Fonts/JetBrainsMono-Regular.ttf;Assets/Fonts/NotoSansJP-Regular.ttf;Assets/Fonts/Rajdhani-OFL.txt;Assets/Fonts/JetBrainsMono-OFL.txt;Assets/Fonts/NotoSansJP-OFL.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          TargetPath="rmlui/fonts/%(Filename)%(Extension)" ExcludeFromSingleFile="true" />
    <None Include="$(MphReadRmlUiNativePath)"
          Condition="'$(MphReadRmlUiNativeName)' != '' and Exists('$(MphReadRmlUiNativePath)')"
          Link="$(MphReadRmlUiNativeName)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="$(MphReadRmlUiNativeDirectory)/PRIME-RMLUI.json"
          Condition="Exists('$(MphReadRmlUiNativeDirectory)/PRIME-RMLUI.json')"
          Link="PRIME-RMLUI.json" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="$(MphReadRmlUiNativeDirectory)/licenses/*"
          Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="VerifyPrimeRmlUiRuntime" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(MphReadRmlUiEnabled)' == 'true'">
    <Error Condition="'$(MphReadRmlUiNativeName)' == '' or !Exists('$(MphReadRmlUiNativePath)') or !Exists('$(MphReadRmlUiNativeDirectory)/PRIME-RMLUI.json')"
           Text="RmlUi native runtime missing for $(MphReadRmlUiRid). Run tools/rmlui/build-native.sh $(MphReadRmlUiRid) before publishing (or tools/rmlui/build-native.ps1 on Windows)." />
    <Exec Command="$(MphReadRmlUiPython) &quot;$(MSBuildProjectDirectory)/../../tools/rmlui/verify-runtime.py&quot; &quot;$(MphReadRmlUiNativePath)&quot; &quot;$(MphReadRmlUiRid)&quot;" />
  </Target>

  <ItemGroup Condition="'$(MphReadServer)' != 'true'">
    <ProjectReference Include="../ProjectPrime.Studio.Protocol/ProjectPrime.Studio.Protocol.csproj" />
    <!-- Shared gameplay/replay bitmap rendering is independent of the UI
         toolkit. Keep its direct dependency in native-only client packages. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" Condition="'$(MphReadNativeClient)' == 'true'" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" Condition="'$(MphReadNativeClient)' == 'true'" />
    <!-- Original Project Prime combat-feedback stingers. Embedded so single-file
         releases and Android all carry the same defaults without loose assets. -->
    <EmbeddedResource Include="Assets\Sounds\Combat\*.wav" />
  </ItemGroup>

  <Target Name="VerifyNativeClientToolkitBoundary" AfterTargets="ResolveReferences" Condition="'$(MphReadNativeClient)' == 'true'">
    <ItemGroup>
      <_NativeClientToolkitReference Include="@(ReferencePath)" Condition="$([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('Avalonia'))" />
    </ItemGroup>
    <Error Condition="'@(_NativeClientToolkitReference)' != ''" Text="The native-only game client must not reference Avalonia assemblies: @(_NativeClientToolkitReference)." />
  </Target>

  <ItemGroup Condition="'$(MphReadServer)' != 'true'">
    <!-- The backdrop again, as a plain embedded resource, for the same reason
         the mark is above: on the desktop the photograph is drawn by GL under
         the screens rather than rasterised into them (Mods/Render/
         LauncherPhoto.cs, which explains why), and that side of the window
         knows nothing about avares://. Not inside the Avalonia group: the
         server build carries no toolkit and still compiles the file. -->
    <EmbeddedResource Include="Assets\Backgrounds\launcher-bg.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Export\modules\__pycache__\**" />
    <EmbeddedResource Remove="Export\modules\__pycache__\**" />
    <None Remove="Export\modules\__pycache__\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="ReFuel.StbImage" Version="2.1.1" />
    <PackageReference Include="Ktx2.NET" Version="1.0.5"
                      Condition="'$(MphReadServer)' != 'true'" />
  </ItemGroup>

  <!-- Modern renderer bindings. Silk 2.23.0 and wgpu-native commit
       33133da4ec5a0174cb21539ef2d3346f75200411 are an ABI pair; update them
       together. Every client uses the repository-built additive recovery bridge;
       upstream runtimes abort on recoverable device/surface failures. -->
  <ItemGroup Condition="'$(MphReadServer)' != 'true'">
    <PackageReference Include="Silk.NET.WebGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU.Extensions.WGPU" Version="2.23.0" />
    <!-- MoltenVK itself exports the Vulkan loader ABI. Ship it under its
         canonical name and libvulkan.dylib so arm64 does not depend on the
         old x64-only Silk Vulkan-loader package. -->
    <PackageReference Include="Silk.NET.MoltenVK.Native" Version="2.23.0"
                      GeneratePathProperty="true" ExcludeAssets="all"
                      Condition="$(PrimeWgpuRid.StartsWith('osx'))" />
  </ItemGroup>

  <!-- Same alias trick Android already uses. From this point desktop renderer
       code calls Project Prime's compatibility front-end, not OpenTK.GL
       directly. GraphicsApi is initially an exact pass-through; WebGPU
       operations replace it incrementally behind this seam. -->
  <ItemGroup Condition="'$(MphReadServer)' != 'true'">
    <Using Include="MphRead.Mods.Render.GraphicsApi" Alias="GL" />
  </ItemGroup>

  <PropertyGroup>
    <PrimeWgpuRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</PrimeWgpuRid>
    <PrimeWgpuRid Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</PrimeWgpuRid>
    <PrimeWgpuName Condition="$(PrimeWgpuRid.StartsWith('win'))">wgpu_native.dll</PrimeWgpuName>
    <PrimeWgpuName Condition="$(PrimeWgpuRid.StartsWith('linux'))">libwgpu_native.so</PrimeWgpuName>
    <PrimeWgpuName Condition="$(PrimeWgpuRid.StartsWith('osx'))">libwgpu_native.dylib</PrimeWgpuName>
    <PrimeWgpuDirectory>$(MSBuildProjectDirectory)/../../artifacts/wgpu-native-desktop/$(PrimeWgpuRid)</PrimeWgpuDirectory>
    <PrimeWgpuDirectory Condition="$(PrimeWgpuRid.StartsWith('osx'))">$(MSBuildProjectDirectory)/../../artifacts/wgpu-native-macos/$(PrimeWgpuRid)</PrimeWgpuDirectory>
    <PrimeWgpuPath>$(PrimeWgpuDirectory)/$(PrimeWgpuName)</PrimeWgpuPath>
    <PrimeWgpuPython Condition="$([MSBuild]::IsOSPlatform('Windows'))">python</PrimeWgpuPython>
    <PrimeWgpuPython Condition="'$(PrimeWgpuPython)' == ''">python3</PrimeWgpuPython>
  </PropertyGroup>
  <ItemGroup Condition="'$(MphReadServer)' != 'true' and Exists('$(PrimeWgpuPath)') and Exists('$(PrimeWgpuDirectory)/PRIME-WGPU.json')">
    <None Include="$(PrimeWgpuPath)" Link="$(PrimeWgpuName)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PrimeWgpuDirectory)/PRIME-WGPU.json" Link="PRIME-WGPU.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="VerifyPrimeWgpuRuntime" BeforeTargets="ComputeFilesToPublish" Condition="'$(MphReadServer)' != 'true'">
    <Error Condition="'$(PrimeWgpuName)' == '' or !Exists('$(PrimeWgpuPath)') or !Exists('$(PrimeWgpuDirectory)/PRIME-WGPU.json')"
           Text="Patched wgpu-native runtime missing for $(PrimeWgpuRid). Run tools/wgpu/build-native.sh $(PrimeWgpuRid) before publishing." />
    <Exec Command="$(PrimeWgpuPython) &quot;$(MSBuildProjectDirectory)/../../tools/wgpu/verify-runtime.py&quot; &quot;$(PrimeWgpuPath)&quot;" />
  </Target>

  <PropertyGroup>
    <MphReadKtxRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MphReadKtxRid>
    <MphReadKtxRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(NETCoreSdkRuntimeIdentifier)</MphReadKtxRid>
  </PropertyGroup>
  <ItemGroup Condition="'$(MphReadServer)' != 'true' and $(MphReadKtxRid.StartsWith('osx')) and Exists('$(MSBuildProjectDirectory)\..\..\artifacts\ktx-native-macos\$(MphReadKtxRid)\libktx.dylib')">
    <None Include="$(MSBuildProjectDirectory)\..\..\artifacts\ktx-native-macos\$(MphReadKtxRid)\libktx.dylib"
          Link="libktx.dylib" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(MphReadServer)' != 'true' and $(PrimeWgpuRid.StartsWith('osx'))">
    <None Include="$(PkgSilk_NET_MoltenVK_Native)\runtimes\osx\native\libMoltenVK.dylib"
          Link="libMoltenVK.dylib" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgSilk_NET_MoltenVK_Native)\runtimes\osx\native\libMoltenVK.dylib"
          Link="libvulkan.dylib" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgSilk_NET_MoltenVK_Native)\runtimes\osx\native\MoltenVK_icd.json"
          Link="MoltenVK_icd.json" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- ash dlopens libvulkan.dylib by name. MoltenVK's original install name
       does not identify that alias, even after an absolute-path preload.
       Set the copied loader's identity so packaged apps need no DYLD override. -->
  <Target Name="IdentifyMacVulkanLoader" AfterTargets="CopyFilesToOutputDirectory;Publish"
          Condition="'$(MphReadServer)' != 'true' and $(PrimeWgpuRid.StartsWith('osx')) and $([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <_PrimeVulkanLoader Include="$(TargetDir)libvulkan.dylib" Condition="Exists('$(TargetDir)libvulkan.dylib')" />
      <_PrimeVulkanLoader Include="$(PublishDir)libvulkan.dylib" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)libvulkan.dylib')" />
    </ItemGroup>
    <Exec Command="install_name_tool -id libvulkan.dylib &quot;%(_PrimeVulkanLoader.Identity)&quot;" />
    <Exec Command="codesign --force --sign - &quot;%(_PrimeVulkanLoader.Identity)&quot;" />
  </Target>

  <!-- OpenAL Soft, for the sound effects.

       OpenTK ships the bindings only: opentk.audio.openal has no runtimes/
       folder and no native library at all. With nothing beside the exe and
       no system-wide OpenAL (the normal state of a Windows machine, since
       nothing installs oalinst.exe any more), ALC.OpenDevice fails and every
       sound effect silently does nothing, while the music keeps playing:
       that goes through SoundFlow, which ships its own miniaudio.dll.
       "Music works, no SFX" is exactly that split.

       The package is a file source, not a dependency (ExcludeAssets=all).
       Its own names are soft_oal.dll and libopenal.so, while OpenTK probes
       for openal32.dll and libopenal.so.1, so each is copied under the name
       the loader actually looks for. A server build has no audio at all. -->
  <ItemGroup Condition="'$(MphReadServer)' != 'true'">
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1"
                      GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <!-- Every game build gets it, under whichever name that platform's loader
       probes for: openal32.dll on Windows, libopenal.so.1 on Linux,
       libopenal.1.dylib on macOS. The RID picks the copy; a build with no RID
       at all (plain `dotnet build` on this machine) is treated as this
       machine's, which is what makes F5 produce a binary with sound. -->
  <PropertyGroup>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MphReadAudioRid>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</MphReadAudioRid>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</MphReadAudioRid>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(NETCoreSdkRuntimeIdentifier)</MphReadAudioRid>
  </PropertyGroup>

  <ItemGroup Condition="'$(MphReadServer)' != 'true' and $(MphReadAudioRid.StartsWith('win'))">
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)\runtimes\$(MphReadAudioRid)\native\soft_oal.dll"
          Link="openal32.dll" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(MphReadServer)' != 'true' and $(MphReadAudioRid.StartsWith('linux'))">
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)\runtimes\$(MphReadAudioRid)\native\libopenal.so"
          Link="libopenal.so.1" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(MphReadServer)' != 'true' and $(MphReadAudioRid.StartsWith('osx'))">
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)\runtimes\$(MphReadAudioRid)\native\libopenal.dylib"
          Link="libopenal.1.dylib" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NcsfPlay\NcsfPlay.csproj" />
  </ItemGroup>

  <!-- The in-repo network regression harness intentionally exercises a few
       internal policy helpers without making those helpers part of the public
       game API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="nettest" />
    <EmbeddedResource Include="Mods/Replay/ReplayWorldLayouts.json" LogicalName="MphRead.Mods.Replay.ReplayWorldLayouts.json" />
    <InternalsVisibleTo Include="settings-archive-check" />
    <InternalsVisibleTo Include="fidelity-oracle" />
    <InternalsVisibleTo Include="final-composite-check" />
    <InternalsVisibleTo Include="hud-ui-check" />
    <InternalsVisibleTo Include="material-pack" />
    <InternalsVisibleTo Include="map-editor-check" />
  </ItemGroup>

  <ItemGroup Condition="'$(MphReadServer)' != 'true'">
    <None Update="gamecontrollerdb.txt;gamecontrollerdb.LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native packages ship their own debug symbols, and since SkiaSharp 3
       (which Avalonia 12 binds) publish copies them: libSkiaSharp.pdb is 80 MB
       and libHarfBuzzSharp.pdb another 20, on a download that is otherwise
       about a hundred. Nobody debugging this program steps into Skia's C++,
       and the managed symbols are embedded in the binary (DebugType above).

       Filtered rather than switched off at the source: there is no package
       option for it, and AllowedReferenceRelatedFileExtensions only reaches
       *managed* references. Ours are left alone; what goes is only what came
       out of a package's runtimes/ folder, and that is still in the NuGet
       cache for anyone who wants it. -->
  <Target Name="MphReadDropNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' and '%(ResolvedFileToPublish.AssetType)' == 'native'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Update="paths.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Custom maps: the map file, and the level it converts. The room binaries
       are still generated on the player's machine, because they land where
       that machine's extracted files are, but everything needed to generate
       them ships, so a downloaded release has its custom maps ready and the
       first launch builds them.

       A map is handed out as one .ppmap bundle: recipe, level and baked
       textures in a single file, with the level trimmed to the lumps the
       importer reads (see Mods/MapGen/MapBundle.cs): 376 KB for de_dust2
       against the 2.8 MB its folder weighed. The folder is what a map is
       *worked on* as, so it is still copied to the build output for the loop
       of converting and testing one, but a .pk3 is somebody else's level in
       somebody else's container, and CopyToPublishDirectory keeps it out of
       what players download. The workflow cooks the bundle before it
       publishes. -->
  <ItemGroup>
    <!-- What ships: the bundles, and any map file loose at the top of maps/. -->
    <None Include="..\..\maps\**\*.ppmap;..\..\maps\*.json;..\..\maps\*.bsp;..\..\maps\*.tex;..\..\maps\*.obj" Link="maps\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- What a map is worked on as: a folder holding the recipe, somebody
         else's .pk3 and the textures baked from it. Copied to a build output,
         because that is the convert-and-test loop, and never published: a
         package carrying the folder as well as the bundle would carry the
         same map twice, one copy of it naming a .pk3 that is deliberately not
         there. -->
    <None Include="..\..\maps\**\*.json;..\..\maps\**\*.bsp;..\..\maps\**\*.tex;..\..\maps\**\*.pk3;..\..\maps\**\*.obj;..\..\maps\**\*.mtl"
          Exclude="..\..\maps\*.json;..\..\maps\*.bsp;..\..\maps\*.tex;..\..\maps\*.obj"
          Link="maps\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'%(Filename)' != 'aimlab'">Never</CopyToPublishDirectory>
      <CopyToPublishDirectory Condition="'%(Filename)' == 'aimlab'">PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(MphReadServer)' != 'true'">
    <EmbeddedResource Include="Assets/Cosmetics/**/*.png">
      <LogicalName>Cosmetics/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="'$(MphReadServer)' != 'true'">
    <EmbeddedResource Include="Mods/Render/Generated/*.wgsl" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MphRead.Protocol.Generator/MphRead.Protocol.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <None Include="../../tools/fidelity-oracle/baselines/*.json"
          Condition="'$(MphReadServer)' != 'true'"
          Link="fidelity-baselines/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
