<Project>
  <!--
    The Client project owns these source files. Android disables SDK default
    Compile items, so it imports this manifest to consume the same neutral
    input implementation without copying the list into Android.csproj.

    Keep platform adapters out of this manifest. GamepadDesktop, GamepadProbe,
    and DesktopStylusInput require desktop window/input bindings and remain
    desktop-only.
  -->
  <ItemGroup>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/AimGestureRecognizer.cs">
      <Link>Client/Input/AimGestureRecognizer.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/ControllerCapabilities.cs">
      <Link>Client/Input/ControllerCapabilities.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/ControllerDeviceLifecycle.cs">
      <Link>Client/Input/ControllerDeviceLifecycle.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/ControllerGlyphs.cs">
      <Link>Client/Input/ControllerGlyphs.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/ControllerPreset.cs">
      <Link>Client/Input/ControllerPreset.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/GamepadHaptics.cs">
      <Link>Client/Input/GamepadHaptics.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/GamepadInput.cs">
      <Link>Client/Input/GamepadInput.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/GamepadLookProfiles.cs">
      <Link>Client/Input/GamepadLookProfiles.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/GamepadLookProcessor.cs">
      <Link>Client/Input/GamepadLookProcessor.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/GamepadMovementProcessor.cs">
      <Link>Client/Input/GamepadMovementProcessor.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/GamepadState.cs">
      <Link>Client/Input/GamepadState.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/GyroLookProcessor.cs">
      <Link>Client/Input/GyroLookProcessor.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/InputBalanceTelemetry.cs">
      <Link>Client/Input/InputBalanceTelemetry.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/LookDeviceTracker.cs">
      <Link>Client/Input/LookDeviceTracker.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/LookInputCoordinator.cs">
      <Link>Client/Input/LookInputCoordinator.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/LookPredictionBuffer.cs">
      <Link>Client/Input/LookPredictionBuffer.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/MorphBallFlickDetectors.cs">
      <Link>Client/Input/MorphBallFlickDetectors.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/PadBindings.cs">
      <Link>Client/Input/PadBindings.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/PointerSample.cs">
      <Link>Client/Input/PointerSample.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/RenderLookAccumulator.cs">
      <Link>Client/Input/RenderLookAccumulator.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/StickProcessor.cs">
      <Link>Client/Input/StickProcessor.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/StylusBindings.cs">
      <Link>Client/Input/StylusBindings.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/StylusInput.cs">
      <Link>Client/Input/StylusInput.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/StylusState.cs">
      <Link>Client/Input/StylusState.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/TouchSettings.cs">
      <Link>Client/Input/TouchSettings.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/TriggerProcessor.cs">
      <Link>Client/Input/TriggerProcessor.cs</Link>
    </PrimeSharedInputCompile>
    <PrimeSharedInputCompile Include="$(MSBuildThisFileDirectory)Input/WeaponSelectionIntent.cs">
      <Link>Client/Input/WeaponSelectionIntent.cs</Link>
    </PrimeSharedInputCompile>
  </ItemGroup>

  <!-- Client keeps SDK default Compile items. Android disables them and gets
       the same files explicitly from this manifest. -->
  <ItemGroup Condition="'$(EnableDefaultCompileItems)' != 'true'">
    <Compile Include="@(PrimeSharedInputCompile)" />
  </ItemGroup>

  <!--
    Validate the evaluated project graph rather than relying on a manually
    maintained mirror. FullPath normalizes Client's default items and
    Android's linked items, so this catches missing sources and accidental
    duplicate Compile entries in either project.
  -->
  <Target Name="ValidatePrimeSharedInputCompileManifest" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PrimeSharedInputManifestPaths Include="@(PrimeSharedInputCompile->'%(FullPath)')" />
      <_PrimeSharedInputMissingSources Include="@(PrimeSharedInputCompile)"
          Condition="!Exists('%(PrimeSharedInputCompile.FullPath)')" />
      <_PrimeSharedInputCompiledPaths Include="@(Compile->'%(FullPath)')" />
      <_PrimeSharedInputNotManifest Include="@(_PrimeSharedInputCompiledPaths)" />
      <_PrimeSharedInputNotManifest Remove="@(_PrimeSharedInputManifestPaths)" />
      <_PrimeSharedInputCompiledPaths Remove="@(_PrimeSharedInputNotManifest)" />
      <_PrimeSharedInputMissing Include="@(_PrimeSharedInputManifestPaths)" />
      <_PrimeSharedInputMissing Remove="@(_PrimeSharedInputCompiledPaths)" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_PrimeSharedInputCompiledPaths)">
      <Output TaskParameter="Filtered" ItemName="_PrimeSharedInputUniqueCompiledPaths" />
    </RemoveDuplicates>
    <PropertyGroup>
      <_PrimeSharedInputCompiledCount>@(_PrimeSharedInputCompiledPaths->Count())</_PrimeSharedInputCompiledCount>
      <_PrimeSharedInputUniqueCount>@(_PrimeSharedInputUniqueCompiledPaths->Count())</_PrimeSharedInputUniqueCount>
    </PropertyGroup>
    <Error Condition="'@(_PrimeSharedInputMissingSources)' != ''"
           Text="Shared input manifest references missing source(s): @(_PrimeSharedInputMissingSources)" />
    <Error Condition="'@(_PrimeSharedInputMissing)' != ''"
           Text="Shared input manifest item(s) are missing from evaluated Compile: @(_PrimeSharedInputMissing)" />
    <Error Condition="$(_PrimeSharedInputCompiledCount) != $(_PrimeSharedInputUniqueCount)"
           Text="Shared input manifest contains duplicate evaluated Compile item(s)." />
  </Target>
</Project>
