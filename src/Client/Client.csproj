<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source files are physically owned by Client after extraction. There is no
    Compile Include pointing back to the old src/MphRead tree.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <OutputType Condition="!$(RuntimeIdentifier.StartsWith('win'))">Exe</OutputType>
    <RootNamespace>MphRead</RootNamespace>
    <AssemblyName>ProjectPrime</AssemblyName>
    <Product>Project Prime</Product>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(PrimeProtectClient)' != 'true'">embedded</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- PrimeShell is shared native Avalonia XAML; keep compilation enabled so
         desktop and Android consume the same generated resource tree. -->
    <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
    <ApplicationIcon Condition="$(RuntimeIdentifier.StartsWith('win'))">Assets/project-prime.ico</ApplicationIcon>
  </PropertyGroup>

  <Import Project="Client.SharedInput.props" />
  <Import Project="Client.SharedRuntime.props" />

  <ItemGroup>
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../MapPlatform/MapPlatform.csproj" />
    <ProjectReference Include="../Renderer/Renderer.csproj" />
    <ProjectReference Include="../Server.Shared/Server.Shared.csproj" />
    <ProjectReference Include="../Shared.Replay/Shared.Replay.csproj" />
    <ProjectReference Include="../Audio.Ncsf/Audio.Ncsf.csproj" />

    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <!-- Retain the patched transitive dependency across the UI rollback. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <!-- OpenTK math remains the simulation/presentation compatibility ABI.
         GraphicsLibraryFramework currently supplies only the existing
         key/mouse value types and controller input bridge; SDL
         owns every desktop window and graphics context. OpenAL is audio-only. -->
    <PackageReference Include="OpenTK.Mathematics" Version="4.9.4" />
    <PackageReference Include="OpenTK.Windowing.GraphicsLibraryFramework" Version="4.9.4" />
    <PackageReference Include="OpenTK.Audio.OpenAL" Version="4.9.4" />
    <!-- Client-side captures/thumbnails and image export still use STB. -->
    <PackageReference Include="ReFuel.StbImage" Version="2.1.1" />
    <!-- Keep the compatible ppy binding but exclude its SDL development-snapshot
         native binaries. Stable SDL 3.4.16 runtimes avoid intermittent black
         first-process Metal renders while preserving this binding's API. -->
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" ExcludeAssets="native" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.16" />
    <!-- File-source package; explicit items below preserve loader names. -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1"
                      GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/project-prime-title-screen.png" />
    <AvaloniaResource Include="Assets/project-prime-mark.png" />
    <None Update="paths.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Rendering/Shaders/Generated/**/*" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/Generated/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="Rendering/Shaders/scene_triangle.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/scene_triangle.hlsl" />
    <None Include="Rendering/Shaders/scene.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/scene.hlsl" />
    <None Include="Rendering/Shaders/shadow.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/shadow.hlsl" />
    <None Include="Rendering/Shaders/fullscreen.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/fullscreen.hlsl" />
    <None Include="Rendering/Shaders/hud.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/hud.hlsl" />
    <None Include="Rendering/Shaders/disruption.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/disruption.hlsl" />
    <None Include="Rendering/Shaders/cel.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/cel.hlsl" />
    <None Include="Rendering/Shaders/bloom.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/bloom.hlsl" />
    <None Include="Rendering/Shaders/tone_map.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/tone_map.hlsl" />
    <None Include="Rendering/Shaders/color_grade.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/color_grade.hlsl" />
    <None Include="Rendering/Shaders/surface.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/surface.hlsl" />
    <None Include="Rendering/Shaders/ssao.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/ssao.hlsl" />
    <None Include="Rendering/Shaders/distortion.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/distortion.hlsl" />
    <None Include="Rendering/Shaders/distortion_warp.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/distortion_warp.hlsl" />
    <None Include="Rendering/Shaders/visor.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/visor.hlsl" />
    <None Include="Rendering/Shaders/sky.hlsl" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Link="Rendering/Shaders/sky.hlsl" />
  </ItemGroup>

  <!-- Silk's source names differ from OpenTK's loader names. Keep these
       side-by-side native files: this is the layout used by prior publishes. -->
  <PropertyGroup>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MphReadAudioRid>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</MphReadAudioRid>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</MphReadAudioRid>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</MphReadAudioRid>
  </PropertyGroup>

  <ItemGroup Condition="$(MphReadAudioRid.StartsWith('win'))">
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)/runtimes/$(MphReadAudioRid)/native/soft_oal.dll"
          Link="openal32.dll" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$(MphReadAudioRid.StartsWith('linux'))">
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)/runtimes/$(MphReadAudioRid)/native/libopenal.so"
          Link="libopenal.so.1" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$(MphReadAudioRid.StartsWith('osx'))">
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)/runtimes/$(MphReadAudioRid)/native/libopenal.dylib"
          Link="libopenal.1.dylib" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Bundles ship; map work trees and .pk3 sources are output-only. -->
  <ItemGroup>
    <None Include="../../maps/**/*.fpmap;../../maps/*.json;../../maps/*.bsp;../../maps/*.tex"
          Link="maps/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="../../maps/**/*.json;../../maps/**/*.bsp;../../maps/**/*.tex;../../maps/**/*.pk3"
          Exclude="../../maps/*.json;../../maps/*.bsp;../../maps/*.tex"
          Link="maps/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>


  <ItemGroup>
    <Compile Remove="Rendering/Core/**/*.cs" />
    <Compile Remove="Rendering/Backends/RenderBackendContracts.cs" />
    <Compile Remove="Rendering/Backends/ISdlOffscreenToolBackend.cs" />
    <Compile Remove="Rendering/Backends/SdlGpu/**/*.cs" />
    <Compile Remove="Rendering/Enhanced/**/*.cs" />
    <Compile Remove="Rendering/Geometry/**/*.cs" />
    <Compile Remove="Rendering/Materials/**/*.cs" />
    <Compile Remove="Rendering/Lighting/**/*.cs" />
    <Compile Remove="Rendering/Environment/**/*.cs" />
    <Compile Remove="Rendering/FrameTiming.cs" />
    <Compile Remove="Runtime/RenderOptions.cs" />
    <Compile Remove="Runtime/MenuSettings.cs" />
    <Compile Include="../Shared/ContentImport/Extract.cs" Link="Shared/ContentImport/Extract.cs" />
    <Compile Include="../Shared/Transport/UdpTransport.cs" Link="Shared/Transport/UdpTransport.cs" />
    <Compile Include="../Shared/Hosting/BuildVersion.cs" Link="Shared/Hosting/BuildVersion.cs" />
    <Compile Include="../Shared/Hosting/ConsoleSetup.cs" Link="Shared/Hosting/ConsoleSetup.cs" />
    <Compile Include="../Shared/Hosting/RuntimePlatform.cs" Link="Shared/Hosting/RuntimePlatform.cs" />
  </ItemGroup>

  <!-- A direct client publish must not depend on a separately remembered
       map-cook command. CI still runs the same command as an explicit
       preflight; this target covers local and release-script publishes too. -->
  <Target Name="CookCustomMapBundles" AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipCustomMapBundleCook)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.."
          Command="dotnet run --project src/Tools/Tools.csproj -c $(Configuration) -- -mapdir maps -mapbundle all" />
    <!-- The SDK evaluates wildcard items before the target runs. Copy the
         freshly cooked files explicitly so a clean direct publish receives
         the same bundles as a publish after a manual cook. -->
    <ItemGroup>
      <_CustomMapBundle Include="$(MSBuildProjectDirectory)/../../maps/**/*.fpmap" />
    </ItemGroup>
    <Copy SourceFiles="@(_CustomMapBundle)"
          DestinationFiles="@(_CustomMapBundle->'$(PublishDir)maps/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Import Project="../../build/protection/ClientProtection.targets"
          Condition="'$(PrimeProtectClient)' == 'true'" />
</Project>
