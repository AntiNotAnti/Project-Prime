<Project Sdk="Microsoft.NET.Sdk">

  <!-- Client owns the desktop application and presentation host. Renderer
       implementation and shader assets are provided by ProjectPrime.Renderer. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <OutputType Condition="!$(RuntimeIdentifier.StartsWith('win'))">Exe</OutputType>
    <RootNamespace>MphRead</RootNamespace>
    <AssemblyName>ProjectPrime</AssemblyName>
    <Product>Project Prime</Product>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(PrimeProtectClient)' != 'true'">embedded</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <PublishSingleFile>true</PublishSingleFile>
    <PrimeMapOwnsMapArtifacts>true</PrimeMapOwnsMapArtifacts>
    <!-- PrimeShell is shared native Avalonia XAML; keep compilation enabled so
         desktop and Android consume the same generated resource tree. -->
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon Condition="$(RuntimeIdentifier.StartsWith('win'))">Assets/project-prime.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Client.Core/Client.Core.csproj" />
    <ProjectReference Include="../Client.Presentation/Client.Presentation.csproj" />
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../MapPlatform/MapPlatform.csproj" />
    <ProjectReference Include="../Renderer/Renderer.csproj" />
    <ProjectReference Include="../Server.Shared/Server.Shared.csproj" />
    <ProjectReference Include="../Shared.Replay/Shared.Replay.csproj" />
    <ProjectReference Include="../Audio.Ncsf/Audio.Ncsf.csproj" />

    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Retain the patched transitive dependency across the UI rollback. -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <!-- OpenTK math remains the simulation/presentation compatibility ABI.
         GraphicsLibraryFramework currently supplies only the existing
         key/mouse value types and controller input bridge; SDL
         owns every desktop window and graphics context. OpenAL is audio-only. -->
    <PackageReference Include="OpenTK.Mathematics" />
    <PackageReference Include="OpenTK.Windowing.GraphicsLibraryFramework" />
    <PackageReference Include="OpenTK.Audio.OpenAL" />
    <!-- Client-side captures/thumbnails and image export still use STB. -->
    <PackageReference Include="ReFuel.StbImage" />
    <!-- Keep the compatible ppy binding but exclude its SDL development-snapshot
         native binaries. Stable SDL 3.4.16 runtimes avoid intermittent black
         first-process Metal renders while preserving this binding's API. -->
    <PackageReference Include="ppy.SDL3-CS" ExcludeAssets="native" />
    <PackageReference Include="SDL3-CS.Windows" />
    <PackageReference Include="SDL3-CS.Linux" />
    <PackageReference Include="SDL3-CS.MacOS" />
    <!-- File-source package; explicit items below preserve loader names. -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native"
                      GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="**/*.axaml" />
    <None Include="../../WINDOWS_PREREQUISITES.txt"
          Condition="$(RuntimeIdentifier.StartsWith('win'))"
          Link="WINDOWS_PREREQUISITES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="paths.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Silk's source names differ from OpenTK's loader names. Keep these
       side-by-side native files: this is the layout used by prior publishes. -->
  <PropertyGroup>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MphReadAudioRid>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</MphReadAudioRid>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</MphReadAudioRid>
    <MphReadAudioRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</MphReadAudioRid>
  </PropertyGroup>

  <ItemGroup Condition="$(MphReadAudioRid.StartsWith('win'))">
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)/runtimes/$(MphReadAudioRid)/native/soft_oal.dll"
          Link="openal32.dll" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$(MphReadAudioRid.StartsWith('linux'))">
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)/runtimes/$(MphReadAudioRid)/native/libopenal.so"
          Link="libopenal.so.1" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$(MphReadAudioRid.StartsWith('osx'))">
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)/runtimes/$(MphReadAudioRid)/native/libopenal.dylib"
          Link="libopenal.1.dylib" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Map source trees and .pk3 files are output-only. The current cooked
       artifact directory is copied by Directory.Build.targets so every
       publish consumes the one explicitly-owned cook. -->
  <ItemGroup>
    <None Include="../../maps/**/*.json;../../maps/**/*.bsp;../../maps/**/*.tex;../../maps/**/*.pk3"
          Exclude="../../maps/*.json;../../maps/*.bsp;../../maps/*.tex"
          Link="maps/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>


  <ItemGroup>
    <Compile Include="../Shared/Hosting/ConsoleSetup.cs" Link="Shared/Hosting/ConsoleSetup.cs" />
  </ItemGroup>

  <!-- Desktop-only entry points, native hosts and platform adapters. The
       cross-platform implementation is compiled once by Client.Presentation. -->
  <ItemGroup>
    <Compile Include="Input/DesktopStylusInput.cs;Input/GamepadDesktop.cs;Input/GamepadProbe.cs;
      Accounts/ProtectedSessionStores.cs;
      Launcher/Gui/DesktopGameOverlayCoordinator.cs;Launcher/Gui/DesktopGameOverlayWindow.cs;Launcher/Gui/DesktopInputOwner.cs;Launcher/Gui/DesktopTransitionCoordinator.cs;Launcher/Gui/GuiLauncher.cs;Launcher/Gui/HomeWindow.cs;Launcher/Gui/PauseMenuPresenter.cs;Launcher/Gui/PauseMenuWindow.cs;Launcher/Gui/PostMatchSession.cs;Launcher/Gui/PostMatchWindow.cs;Launcher/Gui/SettingsWindow.cs;Launcher/Gui/UiCapture.cs;
      Launcher/Portable/MatchStart.cs;Launcher/Portable/TextLauncher.cs;Launcher/Shell/PostMatchCommandScope.cs;Launcher/Shell/PostMatchSelection.cs;Launcher/Shell/PostMatchView.cs;
      Networking/AuthoritativeCheck.cs;Networking/AuthoritativePlay.Desktop.cs;Networking/MapAudit.cs;Networking/NetCheckClient.cs;Networking/NetProbe.cs;Networking/ReplayPlaybackCheck.cs;Networking/WeaponDps.cs;
      Program.cs;Rendering/FrameTimingCheck.cs;Rendering/Platform/GameHostPresentationState.cs;Rendering/Platform/RenderToolHost.cs;Rendering/Platform/SceneHostLifetime.cs;Rendering/Platform/SdlCompatibilityInput.cs;Rendering/Platform/SdlGameHost.cs;Rendering/Platform/SdlWindowController.cs;Rendering/Platform/SdlInputHub.cs;Rendering/Platform/SdlGamepadHub.cs;Rendering/Platform/SdlPointerHub.cs;
      Runtime/AssemblyInfo.cs;Runtime/ConsoleWindow.cs;Runtime/DesktopPresentationServices.cs;Runtime/Menu.cs;Runtime/ModEntry.cs;Runtime/ModelPreviewCapture.cs;Runtime/PauseMenu.cs;Runtime/ThumbnailBatch.cs;Runtime/ThumbnailCapture.cs;Runtime/ThumbnailGenerator.Desktop.cs" />
    <Compile Include="Update/DesktopUpdate.cs;Update/DesktopUpdateInstaller.cs;Update/UpdateTransaction.cs" />
  </ItemGroup>

  <Import Project="../../build/protection/ClientProtection.targets"
          Condition="'$(PrimeProtectClient)' == 'true'" />
</Project>
