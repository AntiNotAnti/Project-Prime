<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prime="clr-namespace:MphRead.Mods.Launcher.Gui"
             x:Class="MphRead.Mods.Launcher.Gui.MatchTransitionView"
             x:Name="TransitionRoot"
             Focusable="True"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             MaxWidth="720">
  <UserControl.Styles>
    <StyleInclude Source="avares://ProjectPrime/Launcher/Theme/PrimeTheme.axaml" />
  </UserControl.Styles>

  <Border x:Name="TransitionCard"
          Background="{DynamicResource PrimeModalSurfaceBrush}"
          BorderBrush="{DynamicResource PrimeBrandBrush}"
          BorderThickness="2,1,1,1"
          CornerRadius="8"
          Padding="24">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          RowSpacing="16">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <prime:PrimeBrandMark Width="42" Height="42"
                              VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="3"
                    VerticalAlignment="Center">
          <TextBlock Text="PROJECT PRIME" Classes="prime-kicker" />
          <TextBlock x:Name="StageTitle" Classes="prime-title"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Height="1"
              Background="{DynamicResource PrimeGunmetalBrush}" />

      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
        <Border x:Name="MapPanel" Classes="prime-panel prime-panel-secondary"
                Padding="12">
          <StackPanel Spacing="3">
            <TextBlock Text="MAP" Classes="prime-label" />
            <TextBlock x:Name="MapText" Classes="prime-body"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border x:Name="ModePanel" Grid.Column="1"
                Classes="prime-panel prime-panel-secondary" Padding="12">
          <StackPanel Spacing="3">
            <TextBlock Text="MODE" Classes="prime-label" />
            <TextBlock x:Name="ModeText" Classes="prime-body"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border x:Name="HunterPanel" Grid.Column="2"
                Classes="prime-panel prime-panel-secondary" Padding="12">
          <StackPanel Spacing="3">
            <TextBlock Text="HUNTER" Classes="prime-label" />
            <TextBlock x:Name="HunterText" Classes="prime-body"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel x:Name="StageBody" Grid.Row="3" Spacing="10">
        <TextBlock x:Name="DetailText" Classes="prime-muted"
                   TextWrapping="Wrap" />
        <StackPanel x:Name="ChecklistPanel" Spacing="6" />
      </StackPanel>

      <Border x:Name="FailurePanel" Grid.Row="4" IsVisible="False"
              Classes="prime-panel prime-status-error" Padding="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="MATCH TRANSITION FAILED"
                       Classes="prime-label prime-status-error" />
            <TextBlock x:Name="FailureText" Classes="prime-body"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="ReturnToLobbyButton" Grid.Column="1"
                  Content="Return to Lobby"
                  Classes="prime-button prime-primary"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
