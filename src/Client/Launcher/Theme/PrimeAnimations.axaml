<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Animation is intentionally opt-in. The shell can replace these values
       with zero for reduced-motion users without changing its layout tree. -->
  <Styles.Resources>
    <!-- Values are seconds for XAML consumers; the code helper exposes the
         same contract as TimeSpan and clamps optional motion to 160-220ms. -->
    <x:Double x:Key="PrimeMotionFast">0.16</x:Double>
    <x:Double x:Key="PrimeMotionNormal">0.18</x:Double>
    <x:Double x:Key="PrimeMotionMaximum">0.22</x:Double>
    <x:Double x:Key="PrimeMotionTranslationDip">8</x:Double>
    <x:Boolean x:Key="PrimeReducedMotion">False</x:Boolean>
  </Styles.Resources>
</Styles>
