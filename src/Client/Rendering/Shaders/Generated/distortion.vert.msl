    _71.z = (_71.z + _71.w) * 0.5;
    out.gl_Position = _71;
    out.out_var_TEXCOORD0 = (float4(in.in_var_TEXCOORD3, 0.0, 1.0) * DrawConstants.texcoordMatrix).xy;
