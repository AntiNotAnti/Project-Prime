vertex main_vs_out main_vs(main_vs_in in [[stage_in]], constant type_FrameConstants& FrameConstants [[buffer(0)]], constant type_DrawConstants& DrawConstants [[buffer(1)]])
{
    main_vs_out out = {};
    float4x4 _57;
    if (DrawConstants.distortionDrawOptions.x > 0.5)
    {
        _57 = DrawConstants.matrixStack[min(in.in_var_TEXCOORD4, 30u)];
    }
