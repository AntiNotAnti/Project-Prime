<Project>
  <!--
    Portable online runtime sources are owned by Client. Android disables SDK
    default Compile items, so it imports this manifest instead of maintaining a
    second implementation of the runtime bridge.
  -->
  <ItemGroup>
    <PrimeSharedRuntimeCompile Include="$(MSBuildThisFileDirectory)Launcher/Shell/ClientSessionCoordinator.cs">
      <Link>Client/Launcher/Shell/ClientSessionCoordinator.cs</Link>
    </PrimeSharedRuntimeCompile>
    <PrimeSharedRuntimeCompile Include="$(MSBuildThisFileDirectory)Networking/ClientOnlineRuntime.cs">
      <Link>Client/Networking/ClientOnlineRuntime.cs</Link>
    </PrimeSharedRuntimeCompile>
    <PrimeSharedRuntimeCompile Include="$(MSBuildThisFileDirectory)Networking/PresentedCollisionFrame.cs">
      <Link>Client/Networking/PresentedCollisionFrame.cs</Link>
    </PrimeSharedRuntimeCompile>
  </ItemGroup>

  <!-- Client keeps SDK default Compile items. Android disables them and gets
       the same files explicitly from this manifest. -->
  <ItemGroup Condition="'$(EnableDefaultCompileItems)' != 'true'">
    <Compile Include="@(PrimeSharedRuntimeCompile)" />
  </ItemGroup>

  <Target Name="ValidatePrimeSharedRuntimeCompileManifest" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PrimeSharedRuntimeMissingSources Include="@(PrimeSharedRuntimeCompile)"
          Condition="!Exists('%(PrimeSharedRuntimeCompile.FullPath)')" />
      <_PrimeSharedRuntimeManifestPaths Include="@(PrimeSharedRuntimeCompile->'%(FullPath)')" />
      <_PrimeSharedRuntimeCompiledPaths Include="@(Compile->'%(FullPath)')" />
      <_PrimeSharedRuntimeNotManifest Include="@(_PrimeSharedRuntimeCompiledPaths)" />
      <_PrimeSharedRuntimeNotManifest Remove="@(_PrimeSharedRuntimeManifestPaths)" />
      <_PrimeSharedRuntimeCompiledManifest Include="@(_PrimeSharedRuntimeCompiledPaths)" />
      <_PrimeSharedRuntimeCompiledManifest Remove="@(_PrimeSharedRuntimeNotManifest)" />
      <_PrimeSharedRuntimeMissing Include="@(_PrimeSharedRuntimeManifestPaths)" />
      <_PrimeSharedRuntimeMissing Remove="@(_PrimeSharedRuntimeCompiledManifest)" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_PrimeSharedRuntimeCompiledManifest)">
      <Output TaskParameter="Filtered" ItemName="_PrimeSharedRuntimeUniqueCompiled" />
    </RemoveDuplicates>
    <PropertyGroup>
      <_PrimeSharedRuntimeCompiledCount>@(_PrimeSharedRuntimeCompiledManifest->Count())</_PrimeSharedRuntimeCompiledCount>
      <_PrimeSharedRuntimeUniqueCount>@(_PrimeSharedRuntimeUniqueCompiled->Count())</_PrimeSharedRuntimeUniqueCount>
    </PropertyGroup>
    <Error Condition="'@(_PrimeSharedRuntimeMissingSources)' != ''"
           Text="Shared runtime manifest references missing source(s): @(_PrimeSharedRuntimeMissingSources)" />
    <Error Condition="'@(_PrimeSharedRuntimeMissing)' != ''"
           Text="Shared runtime manifest item(s) are missing from evaluated Compile: @(_PrimeSharedRuntimeMissing)" />
    <Error Condition="$(_PrimeSharedRuntimeCompiledCount) != $(_PrimeSharedRuntimeUniqueCount)"
           Text="Shared runtime manifest contains duplicate evaluated Compile item(s)." />
  </Target>
</Project>
