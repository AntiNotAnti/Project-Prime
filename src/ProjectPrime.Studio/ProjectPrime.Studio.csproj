<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows')) or $(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <AssemblyName>ProjectPrimeStudio</AssemblyName>
    <RootNamespace>ProjectPrime.Studio</RootNamespace>
    <Product>Project Prime Studio</Product>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">local</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <ProjectReference Include="../ProjectPrime.Studio.Protocol/ProjectPrime.Studio.Protocol.csproj" />
    <!-- Studio is a separate toolkit application. Client build flags must not
         leak into its engine projection or copy the game's native UI payload. -->
    <ProjectReference Include="../MphRead/MphRead.StudioEngine.csproj"
                      GlobalPropertiesToRemove="MphReadRmlUiEnabled;MphReadNativeClient;MphReadNativeDefault;MphReadClientRid"
                      AdditionalProperties="MphReadAvalonia=true;MphReadRmlUi=false;MphReadRmlUiPoc=false;MphReadStudioEngine=true;MphReadServer=false" />
  </ItemGroup>
</Project>
