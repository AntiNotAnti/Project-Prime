<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ProjectPrimeStudio</AssemblyName>
    <RootNamespace>ProjectPrime.Studio</RootNamespace>
    <Product>Project Prime Studio</Product>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">local</InformationalVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>true</PublishSingleFile>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>..\MphRead\Assets\project-prime.ico</ApplicationIcon>
    <ApplicationIcon Condition="Exists('..\MphRead\Assets\project-prime-studio.ico')">..\MphRead\Assets\project-prime-studio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the game's complete dependency graph and entry point in this process.
         Pass MphReadRmlUiGlSmoke=true globally when publishing both desktop heads
         so their shared game assembly is built with the same native UI features. -->
    <ProjectReference Include="..\MphRead\MphRead.csproj" />
  </ItemGroup>
</Project>
