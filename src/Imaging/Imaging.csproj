<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MphRead</RootNamespace>
    <AssemblyName>ProjectPrime.Imaging</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType Condition="'$(PrimeProtectClient)' != 'true'">embedded</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MapPlatform/MapPlatform.csproj" />
    <PackageReference Include="ReFuel.StbImage" />
    <Compile Include="../Shared/Imaging/StbImageDecoder.cs" Link="StbImageDecoder.cs" />
  </ItemGroup>
</Project>
